            "raw_output": "6:  Handles index loading, temporal frame sampling, signum-log normalization, channel\n71:def _resolve_s3_mode(s3_mode, s3_download_to_temp, s3_use_simplecache) -> str:\n123:# Why signum-log?  Solar imagery (especially magnetograms and EUV channels)\n137:# THE THREE SPACES  (read this before writing any \"inverse transform\" code)\n149:#   signum-log     sign(x\u00b7s)\u00b7log1p(|x\u00b7s|). Still log-compressed, but channels are back\n154:#      |  StandardScaler.inverse_signum_log_transform()\n184:    \"\"\"Inverse signum-log normalization, Numba parallel implementation.\n247:    \"\"\"Inverse signum-log normalization for a single channel (pure NumPy).\n284:    def __init__(self, num_channels, num_mask_aia_channels, phase, drop_hmi_probability):\n289:    def __call__(self, input_tensor):\n341:            pool of historical offsets from which ``n_input_timestamps - 1`` frames are sampled\n359:        pooling: Spatial downsampling factor (average pooling). ``None`` or ``1`` means no pooling.\n396:    def __init__(\n409:        pooling: int | None = None,\n432:        self.pooling = pooling if pooling is not None else 1\n526:    def _filter_valid_indices(self) -> list:\n546:    def _ensure_logger(self):\n563:    def __len__(self) -> int:\n567:    def __getitem__(self, idx: int) -> dict:\n593:    def _load_and_stack_frames(self, timesteps) -> np.ndarray:\n602:        return np.stack(\n608:    def _get_index_data(self, idx: int) -> dict:\n638:            \"ts\": stacked_inputs,\n651:            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n668:    def load_nc_data(self, filepath: str, timestep: pd.Timestamp, channels: list[str]) -> np.ndarray:\n696:    def _load_s3_nc_data(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n737:    def _read_s3_via_download(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n771:    def _is_s3_path(self, path: str) -> bool:\n776:    def _suggested_cache_dir() -> str:\n784:    def _require_s3_cache_dir(self) -> None:\n794:    def _validate_s3_cache_dir(self, index_path: str) -> None:\n832:    def _get_s3fs(self):\n840:    def _s3_cache_path(self, s3_uri: str) -> str:\n853:    def _download_s3_object(self, s3_uri: str, local_path: str) -> None:\n870:                pool_size=max(32, self.s3_boto3_max_concurrency * 2),\n896:    def transform_data(self, data: np.ndarray) -> np.ndarray:\n897:        \"\"\"Apply spatial pooling (if configured) then signum-log normalization.\n903:            Normalized array of shape (C, H//pooling, W//pooling). See the module-level\n904:            comment for the signum-log math and the ``inverse_transform_data`` method\n908:        if self.pooling > 1:\n909:            data = skimage.measure.block_reduce(data, block_size=(1, self.pooling, self.pooling), func=np.mean)\n912:    def inverse_transform_data(self, data: np.ndarray) -> np.ndarray:\n913:        \"\"\"Invert signum-log normalization on a (C, H, W) array.\n915:        Note: this only inverts the *normalization*, not spatial pooling.",
