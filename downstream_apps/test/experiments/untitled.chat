r[idx], Xva, yva,\n234\t                               epochs=args.epochs, lr=args.lr, seed=seed)\n235\t            per_seed.append(fit)\n236\t        vl = [f[\"best_val_loss\"] for f in per_seed]\n237\t        au = [f[\"best_val_auroc\"] for f in per_seed]\n238\t        entry = {\n239\t            \"n_train\": n,\n240\t            \"best_val_loss_median\": float(np.median(vl)),\n241\t            \"best_val_loss_min\": float(np.min(vl)),\n242\t            \"best_val_loss_max\": float(np.max(vl)),\n243\t            \"best_val_auroc_median\": float(np.median(au)),\n244\t            \"final_train_loss_median\": float(np.median([f[\"final_train_loss\"] for f in per_seed])),\n245\t            \"seeds\": seeds,\n246\t            \"per_seed_val_loss\": [float(v) for v in vl],\n247\t            \"per_seed_val_auroc\": [float(a) for a in au],\n248\t        }\n249\t        curve.append(entry)\n250\t        print(f\"[curve] N={n:4d}  val_loss median {entry['best_val_loss_median']:.4f} \"\n251\t              f\"[{entry['best_val_loss_min']:.4f}, {entry['best_val_loss_max']:.4f}]  \"\n252\t              f\"AUROC {entry['best_val_auroc_median']:.3f}  \"\n253\t              f\"train_loss {entry['final_train_loss_median']:.4f}\")\n254\t    results[\"learning_curve\"] = curve\n255\t\n256\t    n_max = max(e[\"n_train\"] for e in curve)\n257\t\n258\t    # --- 3. weight decay ------------------------------------------------------\n259\t    wd_rows = []\n260\t    for wd in [float(v) for v in args.weight_decays.split(\",\")]:\n261\t        vl, au = [], []\n262\t        for seed in seeds:\n263\t            idx = event_subset_indices(events_tr, ytr, n_max, seed)\n264\t            fit = fit_logistic(Xtr[idx], ytr[idx], Xva, yva, epochs=args.epochs,\n265\t                               lr=args.lr, weight_decay=wd, seed=seed)"
