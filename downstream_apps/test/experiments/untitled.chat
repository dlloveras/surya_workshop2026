            "title": "cd test && sed -n '560,641p' experiments/wave_common.py | cat -n | awk '{printf \"%d\\t%s\\n\", NR+559, substr($0, index($0,\"\\t\")+1)}'",
            "status": "completed",
            "raw_output": "560\t        max_number_of_samples=None,\n561\t        label_transform=wave_label_transform,\n562\t        ds_wave_index_path=cfg.data.wave_index_path,\n563\t        ds_time_column=cfg.data.ds_time_column,\n564\t        ds_class_column=cfg.data.ds_class_column,\n565\t        ds_time_tolerance=cfg.data.ds_time_tolerance,\n566\t        ds_match_direction=cfg.data.ds_match_direction,\n567\t    )\n568\t\n569\t    train, val = build_helio_datasets(cfg, dataset_cls, scalers=scalers, **task_kwargs)\n570\t    if not include_test:\n571\t        return train, val\n572\t\n573\t    test_index = str(cfg.data.train_data_path).replace(\"_train.csv\", \"_test.csv\")\n574\t    if not os.path.isfile(test_index):\n575\t        raise FileNotFoundError(\n576\t            f\"Test index not found at {test_index}. It is derived from \"\n577\t            f\"data.train_data_path by swapping _train.csv for _test.csv.\"\n578\t        )\n579\t    original = cfg.data.valid_data_path\n580\t    try:\n581\t        cfg.data.valid_data_path = test_index\n582\t        _, test = build_helio_datasets(cfg, dataset_cls, scalers=scalers, **task_kwargs)\n583\t    finally:\n584\t        cfg.data.valid_data_path = original\n585\t    return train, val, test\n586\t\n587\t\n588\tdef build_wave_loader(\n589\t    dataset,\n590\t    batch_size: int,\n591\t    num_workers: int,\n592\t    prefetch_factor: int | None,\n593\t    seed: int,\n594\t    shuffle: bool,\n595\t    drop_last: bool,\n596\t):\n597\t    \"\"\"Build a DataLoader with the two knobs ``build_helio_dataloaders()`` does not expose.\n598\t\n599\t    ``build_helio_dataloaders()`` is the right entry point for a normal run, but it hard-codes\n600\t    ``drop_last=True`` for *both* loaders and does not expose ``prefetch_factor``. Both matter\n601\t    here:\n602\t\n603\t    * ``drop_last=True`` on a 24-sample validation set at batch 2 is survivable, but on any\n604\t      odd-sized split it silently discards a sample \u2014 1 of 27 is 3.7% of the metric that\n605\t      selects checkpoints.\n606\t    * ``prefetch_factor`` is the only bound on worker memory. ``ts`` is\n607\t      ``(B, 13, 2, 4096, 4096)`` fp32 = 1.74 GB per sample, so worst-case resident set is\n608\t      ``num_workers * prefetch_factor * batch_size * 1.74 GB``: 27.8 GB at\n609\t      ``8 x 1 x 2``, but 55.7 GB at PyTorch's default factor of 2.\n610\t\n611\t    Everything else \u2014 spawn (the dataset holds a boto3 handle that does not survive fork),\n612\t    persistent workers, the explicit generator and the per-worker seeding \u2014 matches\n613\t    ``build_helio_dataloaders()`` exactly, by reusing its ``_seed_worker``. That function is\n614\t    private but importing it is deliberate: its whole purpose is to displace Lightning's\n615\t    auto-injected worker init, which derives worker seeds from ambient global RNG state, and\n616\t    a second copy of it here could drift out of step with the datasets it seeds.\n617\t    \"\"\"\n618\t    from functools import partial\n619\t\n620\t    from torch.utils.data import DataLoader\n621\t    from workshop_infrastructure.datasets.builders import _seed_worker\n622\t\n623\t    kwargs = dict(\n624\t        batch_size=batch_size,\n625\t        num_workers=num_workers,\n626\t        pin_memory=True,\n627\t        drop_last=drop_last,\n628\t    )\n629\t    if num_workers > 0:\n630\t        kwargs[\"multiprocessing_context\"] = \"spawn\"\n631\t        kwargs[\"persistent_workers\"] = True\n632\t        kwargs[\"worker_init_fn\"] = partial(_seed_worker, base_seed=seed)\n633\t        if prefetch_factor is not None:\n634\t            kwargs[\"prefetch_factor\"] = prefetch_factor\n635\t\n636\t    if shuffle:\n637\t        generator = torch.Generator()\n638\t        generator.manual_seed(seed)\n639\t        kwargs[\"generator\"] = generator\n640\t\n641\t    return DataLoader(dataset, shuffle=shuffle, **kwargs)",
