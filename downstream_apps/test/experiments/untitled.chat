            "raw_output": "169:class DataConfig:\n170-    \"\"\"What data to load, how to sample it in time, and how to reach it on S3.\n171-\n172-    Task-specific fields (label catalogs, alignment parameters, \u2026) do not belong here.\n173-    Subclass this in your app and pass the subclass to ``load_config(data_cls=...)``.\n174-    \"\"\"\n175-\n176-    # Fields holding a filesystem path. Relative values are resolved against the config\n177-    # file's own directory, so a checked-in config works from any working directory and\n178-    # on any machine \u2014 no absolute paths pointing into one user's home.\n179-    # A subclass that adds a path field must extend this, e.g.:\n180-    #     PATH_FIELDS = DataConfig.PATH_FIELDS + (\"my_catalog_path\",)\n181-    PATH_FIELDS: ClassVar[tuple[str, ...]] = (\n182-        \"train_data_path\",\n183-        \"valid_data_path\",\n184-        \"scalers_path\",\n185-        \"sdo_data_root_path\",\n186-    )\n187-\n188-    # --- Paths (relative paths are resolved against the config file's directory) ---\n189-    train_data_path: str\n190-    valid_data_path: str\n191-    scalers_path: str\n192-\n193-    # --- Input channels and temporal sampling ---\n194-    channels: List[str]\n195-    time_delta_input_minutes: List[int]\n196-    time_delta_target_minutes: int\n197-\n198-    # --- Local data ---\n199-    # Root prepended to relative local paths in the index. Ignored for s3:// paths.\n200-    sdo_data_root_path: Optional[str] = None\n201-\n202-    # --- S3 (used only when the index contains s3:// paths) ---\n203-    s3_anon: bool = False\n204-    # One of VALID_S3_MODES (above). \"download\" is recommended for NetCDF/HDF5.\n205-    s3_mode: str = \"download\"\n206-    # Required unless s3_mode is \"stream\". Budget ~1 GB per unique timestep.\n207-    # Left unset here, load_config() falls back to $SURYA_WS_CACHE_DIR.\n208-    s3_cache_dir: Optional[str] = None\n209-    s3_boto3_max_concurrency: int = 4   # parallel threads per multipart download\n210-    s3_boto3_part_size_mb: int = 64     # part size in MB for multipart downloads\n211-\n212-    # --- Development ---\n213-    max_samples: Optional[int] = None\n214-\n215-    def __post_init__(self) -> None:\n216-        if self.s3_mode not in VALID_S3_MODES:\n217-            raise ValueError(\n218-                f\"Unknown data.s3_mode {self.s3_mode!r}. \"\n219-                f\"Valid modes are: {', '.join(VALID_S3_MODES)}.\"\n220-            )\n221-\n222-\n223-@dataclass\n224-class OutputConfig:\n225-    \"\"\"Paths and S3 settings for checkpoints and artifacts.\"\"\"\n226-    ckpt_dir: str = \"checkpoints\"\n227-    # S3 upload of best checkpoint (all three used together; leave s3_bucket null to disable)\n228-    s3_bucket: Optional[str] = None\n229-    s3_prefix: str = \"\"\n230-    s3_best_key: str = \"best.ckpt\"\n231-\n232-\n233-@dataclass\n234-class TrainingConfig:\n235-    \"\"\"Top-level configuration for a fine-tuning run.\"\"\"\n236-    job_id: str\n237-    data: DataConfig\n238-    model: ModelConfig\n239-    output: OutputConfig = field(default_factory=OutputConfig)",
