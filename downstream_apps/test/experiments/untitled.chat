            "raw_output": "120\t    if now is None:\n121\t        return None\n122\t    prev = nearest_frame(stamps, now - step)\n123\t    if prev is None or prev == now:\n124\t        return None\n125\t    achieved = (now - onset).total_seconds() / 60.0\n126\t    return prev, now, achieved\n127\t\n128\t\n129\tdef disk_mask(side: int) -> np.ndarray:\n130\t    \"\"\"Boolean mask of the solar disk for a ``side x side`` frame.\"\"\"\n131\t    y, x = np.ogrid[:side, :side]\n132\t    c = (side - 1) / 2.0\n133\t    return ((y - c) ** 2 + (x - c) ** 2) <= (DISK_FRACTION * side) ** 2\n134\t\n135\t\n136\tdef contrast_stats(rd: np.ndarray, mask: np.ndarray) -> dict:\n137\t    \"\"\"Contrast statistics for one running-difference map, on-disk only.\"\"\"\n138\t    on_disk = rd[mask]\n139\t    pooled = wc.repool(np.where(mask, rd, 0.0)[None].astype(np.float32), 32)[0]\n140\t    return {\n141\t        \"p999\": float(np.percentile(np.abs(on_disk), 99.9)),\n142\t        \"std\": float(on_disk.std()),\n143\t        \"pooled_max\": float(np.abs(pooled).max()),\n144\t    }\n145\t\n146\t\n147\tdef load_signum_log_frame(dataset, timestamp) -> np.ndarray:\n148\t    \"\"\"Return AIA193 at ``timestamp`` in **signum-log** space, shape ``(H, W)``.\n149\t\n150\t    Signum-log rather than physical units on purpose: it is the space the baseline's\n151\t    features live in and the space the running difference is taken in during training, so a\n152\t    contrast measured here is a contrast the model could actually use. ``transform_data``\n153\t    applies signum-log *and* the z-score, so the scaler's ``inverse_transform`` undoes only\n154\t    the second stage \u2014 see the THREE SPACES block in\n155\t    ``workshop_infrastructure/datasets/helio.py``.\n156\t    \"\"\"\n157\t    normalized = dataset.transform_data(\n158\t        dataset.load_nc_data(dataset.index.loc[timestamp, \"path\"], timestamp, [RD_CHANNEL])\n159\t    )\n160\t    return dataset.scalers[RD_CHANNEL].inverse_transform(normalized[0])\n161\t\n162\t\n163\tdef main() -> None:\n164\t    args = parse_args()\n165\t    offsets = [int(o) for o in args.offsets.split(\",\")]\n166\t\n167\t    if args.replot:\n168\t        csv = RESULTS_DIR / \"wave_visibility.csv\"\n169\t        if not csv.is_file():\n170\t            raise SystemExit(f\"--replot needs {csv}, which does not exist yet.\")\n171\t        print(f\"[scan] redrawing from {csv} \u2014 no frames read\")\n172\t        report(pd.read_csv(csv), offsets)\n173\t        return\n174\t\n175\t    cfg = load_wave_config(args.config)",
