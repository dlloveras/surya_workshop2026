            "raw_output": "380\t\n381\t\n382\tdef assert_lora_adapted_attention(model: torch.nn.Module) -> list[str]:\n383\t    \"\"\"Assert LoRA adapters reached attention, not just the feed-forward layers.\n384\t\n385\t    PEFT raises only when *no* ``target_modules`` entry matches anything, so a list of\n386\t    plausible-but-wrong names (``q_proj``, ``k_proj``, ``v_proj``, ``out_proj`` \u2014 none of\n387\t    which exist in Surya) is silently reduced to whatever else happened to match. That is\n388\t    how a run trained ``fc1``/``fc2`` alone and reported 2,666,241 trainable parameters\n389\t    where 3,157,761 was intended.\n390\t    \"\"\"\n391\t    adapted = sorted({\n392\t        name.split(\".lora_A\")[0].replace(\"base_model.model.\", \"\")\n393\t        for name, _ in model.named_parameters()\n394\t        if \".lora_A\" in name\n395\t    })\n396\t    missing = [\n397\t        needle for needle in (\"attn.qkv\", \"attn.proj\")\n398\t        if not any(a.endswith(needle) for a in adapted)\n399\t    ]\n400\t    if missing:\n401\t        raise AssertionError(\n402\t            f\"LoRA did not adapt {', '.join(missing)}. Surya fuses q/k/v into attn.qkv and \"\n403\t            f\"names the output projection attn.proj; PEFT silently ignores target_modules \"\n404\t            f\"entries that match nothing.\\nAdapted modules were: {adapted}\"\n405\t        )\n406\t    n_attn = sum(1 for a in adapted if \".attn.\" in a)\n407\t    print(f\"[PREFLIGHT] LoRA adapted {len(adapted)} modules, {n_attn} of them in attention\")\n408\t    return adapted\n409\t\n410\t\n411\tdef assert_trainable_count(model: torch.nn.Module, expected: int | None = None) -> int:\n412\t    \"\"\"Print (and optionally assert) the trainable parameter count.\n413\t\n414\t    Reference values for this task's config, pinned by ``tests/test_lora_setup.py``:\n415\t\n416\t    ==============================================  =========\n417\t    regime                                          trainable\n418\t    ==============================================  =========\n419\t    LoRA r=8, penultimate_linear_layer: false       1,518,081\n420\t    LoRA r=8, penultimate_linear_layer: true        3,157,761\n421\t    linear probe (head only), penultimate false         2,561\n422\t    ==============================================  =========\n423\t    \"\"\"\n424\t    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n425\t    total = sum(p.numel() for p in model.parameters())\n426\t    print(f\"[PREFLIGHT] trainable: {trainable:,} / {total:,} ({100 * trainable / total:.3f}%)\")\n427\t    if expected is not None and trainable != expected:\n428\t        raise AssertionError(\n429\t            f\"Expected {expected:,} trainable parameters, got {trainable:,}. Check \"\n430\t            f\"model.use_lora, model.lora_config.r, model.penultimate_linear_layer and the \"\n431\t            f\"head_* modules apply_peft_lora() reported as modules_to_save.\"\n432\t        )\n433\t    return trainable\n434\t\n435\t\n436\tdef assert_batch_shape(batch: dict, n_channels: int, n_timesteps: int, img_size: int) -> None:\n437\t    \"\"\"Assert the input stack has the shape the backbone's tokenizer was trained for.\"\"\"\n438\t    ts = batch[\"ts\"]\n439\t    expected = (n_channels, n_timesteps, img_size, img_size)\n440\t    if tuple(ts.shape[1:]) != expected:\n441\t        raise AssertionError(\n442\t            f\"batch['ts'] has shape {tuple(ts.shape)}; expected (B, {', '.join(map(str, expected))}). \"\n443\t            f\"ts.shape[2] is the number of input timesteps and must be 2 for this \"\n444\t            f\"checkpoint \u2014 it comes from model.time_embedding.time_dim and \"\n445\t            f\"data.time_delta_input_minutes.\"\n446\t        )\n447\t    print(f\"[PREFLIGHT] batch['ts'] shape {tuple(ts.shape)}, dtype {ts.dtype}\")\n448\t\n449\t\n450\t# ---------------------------------------------------------------------------"
          },
