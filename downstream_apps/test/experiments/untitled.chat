            "raw_output": "    p = argparse.ArgumentParser(description=__doc__,\n                                formatter_class=argparse.RawDescriptionHelpFormatter)\n    p.add_argument(\"--config\", default=str(DEFAULT_CONFIG),\n                   help=\"Run config YAML (default: this app's config_wave_full.yaml).\")\n    # Dev toggles\n    p.add_argument(\"--no-wandb\", action=\"store_true\")\n    p.add_argument(\"--train_baseline\", action=\"store_true\",\n                   help=\"Train the AIA193 running-difference logistic baseline instead of \"\n                        \"Surya, through these same DataLoaders.\")\n    p.add_argument(\"--no-eval-test\", action=\"store_true\",\n                   help=\"Skip the held-out test-split evaluation of the best checkpoint.\")\n    p.add_argument(\"--no-checkpoint\", action=\"store_true\",\n                   help=\"Do not write checkpoints. Each one is 1.7 GB (the state dict carries \"\n                        \"the frozen backbone, not just the adapters), so the LR probe \u2014 whose \"\n                        \"weights are never used \u2014 should not write three of them.\")\n    # Overrides that already exist on TrainingConfig\n    p.add_argument(\"--max-epochs\", type=int, default=None)\n    p.add_argument(\"--batch-size\", type=int, default=None)\n    p.add_argument(\"--num-workers\", type=int, default=None)\n    p.add_argument(\"--lr\", type=float, default=None,\n                   help=\"Override training.learning_rate. The config's 0.01 was tuned on \"\n                        \"the 16 K-param logistic baseline and DIVERGES Surya.\")\n    p.add_argument(\"--s3-cache-dir\", default=None)\n    p.add_argument(\"--deterministic\", choices=tuple(_DETERMINISTIC_CLI), default=None)\n    # Run-scale settings with no field on TrainingConfig\n    p.add_argument(\"--prefetch-factor\", type=int, default=1,\n=== cfg yaml 1-15 ===\n# =============================================================================\n# Surya workshop \u2014 wave classification, RUN-SCALE config\n#\n# Sibling of configs/config_script.yaml. Same five sections, same rules (paths are\n# relative to THIS file's directory; unrecognized keys are an error). The difference\n# is what it is for:\n#\n#   config_script.yaml    \u2014 the notebook / smoke-test config. max_samples: 10, and a\n#                           learning rate tuned for the 16 K-param logistic baseline.\n#   config_wave_full.yaml \u2014 the config the unattended scaling study runs from. Whole\n#                           matched dataset, Surya-scale learning rate.\n#\n# Both carry the same four fixes (see config_script.yaml for the full write-ups):\n#   time_delta_input_minutes/time_dim  \u2014 2 frames, so the checkpoint's 26-channel\n#                                        tokenizer actually loads (157/159 tensors)\n=== cfg 145-155 ===\n# -----------------------------------------------------------------------------\n# Training\n# -----------------------------------------------------------------------------\ntraining:\n  # 0.01 (the value config_script.yaml uses for the logistic baseline) DIVERGES Surya:\n  # losses of 10^2-10^4, exact 0.0 bf16 values, val accuracy and AUROC pinned at 0.5.\n  # 1e-4 is the starting point for the LR probe; --lr overrides per run.\n  learning_rate: 0.0001\n  # batch 2 is near-optimal, not a VRAM ceiling. One 65,536-token sample already saturates\n  # the L40S, so s/sample is flat in batch size. Measured on this GPU (44.4 GiB usable,\n  # LoRA + bf16 autocast + grad checkpointing on all 10 layers, fp32 inputs):\n=== summarize 225-245 ===\n            \"so one sample is 4.2% of the metric and differences smaller than roughly 0.05 \"\n            \"in BCE are not resolvable. The 48-sample test column is the more trustworthy \"\n            \"comparison, and it was looked at once, after checkpoint selection.\", \"\",\n        ]\n\n    if baseline and baseline.get(\"learning_curve\"):\n        curve = baseline[\"learning_curve\"]\n        b_first, b_last = curve[0], curve[-1]\n        lines += [\n            \"## Running-difference baseline, same axes\", \"\",\n            f\"| N | best val BCE (median of {len(b_first['seeds'])} seeds) | val AUROC |\",\n            \"|---|---|---|\",\n        ]\n        for c in curve:\n            lines.append(f\"| {c['n_train']} | {c['best_val_loss_median']:.4f} | \"\n                         f\"{c['best_val_auroc_median']:.3f} |\")\n        lines += [\"\",\n                  f\"The baseline goes {b_first['best_val_loss_median']:.4f} \u2192 \"\n                  f\"{b_last['best_val_loss_median']:.4f} over the same range. \"\n                  f\"`ConstantProbabilityModel`, which learns only the base rate, scores \"\n                  f\"{baseline['constant_probability']['val_loss']:.4f}.\", \"\"]\n\n    if ablations:\n        lines += [\"## Ablations\", \"\",\n=== sched 8-16 ===\n# cut short.\n#\n# Phase 4 (the LR probe) exists because a previous run at lr=0.01 diverged outright \u2014 losses\n# of 10^2-10^4, exact 0.0 values under bf16, val accuracy and AUROC pinned at 0.5. That LR\n# had been tuned on the 16 K-parameter logistic baseline. The probe keeps the largest LR\n# whose loss decreases without saturating, and Phase 5 uses it.\n#\n# Batch size is 2 with --accum 4 rather than the largest batch that fits: one 65,536-token\n# sample already saturates the GPU, so s/sample is flat-to-worse in batch size (3.05 at B=1,",
