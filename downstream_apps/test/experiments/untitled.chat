            "raw_output": " M downstream_apps/test/0_dataset_dataloader_template.ipynb\n M downstream_apps/test/2_finetune_template_1D.ipynb\n M downstream_apps/test/3_finetune_template_1D.py\n M downstream_apps/test/configs.py\n M downstream_apps/test/configs/config_script.yaml\n M downstream_apps/test/lightning_modules/pl_simple_baseline.py\n M downstream_apps/test/metrics/template_metrics.py\n M downstream_apps/test/models/simple_baseline.py\n?? downstream_apps/test/0_dataset_dataloader_template_diego.ipynb\n?? downstream_apps/test/1_baseline_template_diego.ipynb\n?? downstream_apps/test/2_finetune_template_1D_diego.ipynb\n?? downstream_apps/test/4_finetune_wave_1D.py\n?? downstream_apps/test/configs/config_wave_full.yaml\n?? downstream_apps/test/datasets/wave_dataset.py\n?? downstream_apps/test/datasets/wave_dataset_memory.py\n?? downstream_apps/test/experiments/\n?? downstream_apps/test/untitled.chat\n===LOG===\n14162de Merge branch 'main' into downstream/wave_classification\n89b751c Merge branch 'SwRI-IDEA-Lab:main' into main\n608be46 Merge pull request #18 from SwRI-IDEA-Lab/feature/fix_lora\nba5cdaa Add pip requirements.txt listing runtime dependencies\n60792ad Document the new config-load-time validations in CLAUDE.md\n3b5ef98 Validate cross-section invariants in TrainingConfig at config-load time\na5bff31 Validate ModelConfig's self-contained invariants at config-load time\nb6e9e9f Add regression tests for the nglo/pooling derivation\n1cec9b6 Extract shared tiny-model test helpers into conftest.py\nc5f3561 Derive nglo from pooling instead of a config field\n256e1cf Document the LoRA fix, head_ convention, and trainable parameter counts\na046b73 Add regression tests for the LoRA target_modules and head_ trainability fixes\n===DIFF simple_baseline===\ndiff --git a/downstream_apps/test/models/simple_baseline.py b/downstream_apps/test/models/simple_baseline.py\nindex 009017b..f716038 100644\n--- a/downstream_apps/test/models/simple_baseline.py\n+++ b/downstream_apps/test/models/simple_baseline.py\n@@ -73,4 +73,68 @@ class RegressionFlareModel(nn.Module):\n         # Rearrange in preparation for linear layer\n         x = rearrange(x, \"b c t -> b (c t)\")\n \n+        return self.linear(x)\n+\n+\n+class ConstantProbabilityModel(nn.Module):\n+    \"\"\"Trainable baseline: a single learned logit, independent of the input.\n+\n+    Learns the class base rate (the wave / no-wave prior) and nothing else \u2014 the\n+    simplest possible baseline against which any input-dependent model should be judged.\n+    \"\"\"\n+\n+    def __init__(self):\n+        super().__init__()\n+        self.logit = nn.Parameter(torch.zeros(1))\n+\n+    def forward(self, batch: dict) -> torch.Tensor:\n+        \"\"\"\n+        Args:\n+            batch (dict): Batch dict; only used to read the batch size from\n+                ``batch[\"forecast\"]`` (the target), since the model itself ignores\n+                the input entirely.\n+        \"\"\"\n+        batch_size = batch[\"forecast\"].shape[0]\n+        return self.logit.expand(batch_size, 1)\n+\n+\n+class RunningDifferenceLogisticModel(nn.Module):\n+    \"\"\"Trainable baseline: AIA193 running difference, mean-pooled, then logistic regression.\n+\n+    Computes AIA193(now) - AIA193(one cadence step earlier), applies a 32x32 mean pool\n+    (uniform kernel weights 1/1024), and feeds the flattened pooled map into a linear\n+    layer (BCEWithLogitsLoss supplies the logistic/sigmoid).\n+\n+    Note:\n+        Expects 'ts' in the batch dict with shape (B, C, T=2, H, W), where T is ordered\n+        [t_prev, t_now] \u2014 see HelioNetCDFDataset.__getitem__ sampling, where the last T\n+        index is always the \"now\" (offset 0) frame.\n+\n+        This model expects 'ts' in **signum-log** space (channel z-scores undone, log\n+        compression retained), same convention as RegressionFlareModel. Use\n+        destandardize_channels() to pre-process normalized SDO inputs before passing them\n+        here (e.g., via the preprocess_fn argument of FlareLightningModule).\n+    \"\"\"\n+\n+    def __init__(self, channel_index: int, img_size: int, pool_kernel: int = 32):\n+        \"\"\"\n+        Args:\n+            channel_index (int): Index of the AIA193 channel within the C dimension of 'ts'.\n+            img_size (int): Height/width of the (square) input frames.\n+            pool_kernel (int): Mean-pool kernel size (and stride). Defaults to 32.\n+        \"\"\"\n+        super().__init__()\n+        self.channel_index = channel_index\n+        self.pool = nn.AvgPool2d(kernel_size=pool_kernel)\n+        pooled_side = img_size // pool_kernel\n+        self.linear = nn.Linear(pooled_side * pooled_side, 1)\n+\n+    def forward(self, batch: dict) -> torch.Tensor:\n+        \"\"\"\n+        Args:\n+            batch (dict): Batch dict with 'ts' of shape (B, C, T=2, H, W) in signum-log space.\n+        \"\"\"\n+        x = batch[\"ts\"][:, self.channel_index, :, :, :]  # (B, T, H, W)\n+        x = x[:, -1] - x[:, 0]  # now - prev    # (B, T, H, W)\n+        x = self.pool(x.unsqueeze(1))  # (B, 1, H', W')\n         return self.linear(x)\n\\ No newline at end of file",
