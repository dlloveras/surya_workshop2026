          {
            "raw_output": "     1\t\"\"\"\n     2\tTemplate metrics for wave classification.\n     3\t\n     4\tWaveMetrics defines four metric sets:\n     5\t- \"train_loss\"    \u2014 differentiable loss that drives backpropagation (BCE-with-logits).\n     6\t- \"val_loss\"      \u2014 the quantity logged as `val_loss` and used to select checkpoints.\n     7\t                    Defaults to the same BCE as \"train_loss\"; override it when your task\n     8\t                    needs a different validation objective.\n     9\t- \"train_metrics\" \u2014 non-differentiable metrics logged during training (accuracy).\n    10\t- \"val_metrics\"   \u2014 metrics logged at validation for reporting only (accuracy + AUROC).\n    11\t                    These do NOT influence checkpoint selection \u2014 \"val_loss\" does.\n    12\t\n    13\tThe __call__ method selects the appropriate metric set based on the mode passed at\n    14\tconstruction time. The dictionary keys returned by each method become the metric names\n    15\tpropagated to the logger (e.g. WandB, CSV).\n    16\t\"\"\"\n    17\t\n    18\timport torch\n    19\timport torchmetrics as tm  # Lots of possible metrics in here https://lightning.ai/docs/torchmetrics/stable/all-metrics.html\n    20\t\n    21\t# Shape contract: predictions arrive as (B,) from HelioSpectformer1D or (B, 1) from the\n    22\t# linear baseline, while targets are always (B, 1). Every metric below flattens both with\n    23\t# reshape(-1) rather than squeeze(-1): squeeze is shape-dependent and collapses a\n    24\t# batch of one to a 0-d scalar, which then fails to broadcast against a (1,) target.\n    25\t#\n    26\t# All preds below are raw logits (no sigmoid applied). torchmetrics' Binary* metrics\n    27\t# auto-apply sigmoid whenever inputs fall outside [0, 1], matching what\n    28\t# binary_cross_entropy_with_logits sees, so no explicit .sigmoid() call is needed.\n    29\tclass WaveMetrics:\n    30\t    def __init__(self, mode: str):\n    31\t        \"\"\"\n    32\t        Initialize WaveMetrics class.\n    33\t\n    34\t        Args:\n    35\t            mode (str): Mode to use for metric evaluation. One of \"train_loss\",\n    36\t                        \"val_loss\", \"train_metrics\", or \"val_metrics\".\n    37\t        \"\"\"\n    38\t        self.mode = mode\n    39\t\n    40\t        # Cache torchmetrics instances once (instead of recreating each call)\n    41\t        self._accuracy = tm.classification.BinaryAccuracy()\n    42\t        self._auroc = tm.classification.BinaryAUROC()\n    43\t\n    44\t    def _ensure_device(self, preds: torch.Tensor) -> None:\n    45\t        \"\"\"Move torchmetrics modules to the same device as ``preds``, if needed.\"\"\"\n    46\t        if self._accuracy.device != preds.device:\n    47\t            self._accuracy = self._accuracy.to(preds.device)\n    48\t        if self._auroc.device != preds.device:\n    49\t            self._auroc = self._auroc.to(preds.device)\n    50\t\n    51\t    def train_loss(\n    52\t        self, preds: torch.Tensor, target: torch.Tensor\n    53\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n    54\t        \"\"\"\n    55\t        Calculate loss metrics for training.\n    56\t\n    57\t        Args:\n    58\t            preds (torch.Tensor): Model predictions.\n    59\t            target (torch.Tensor): Ground truth labels.\n    60\t\n    61\t        Returns:\n    62\t            tuple[dict[str, torch.Tensor], list[float]]:\n    63\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n    64\t                                        Keys are metric names (e.g., \"bce\"), and values are the\n    65\t                                        corresponding torch.Tensor values.\n    66\t                - list[float]: List of weights for each calculated metric.\n    67\t        \"\"\"\n    68\t\n    69\t        output_metrics = {}\n    70\t        output_weights = []\n    71\t\n    72\t        output_metrics[\"bce\"] = torch.nn.functional.binary_cross_entropy_with_logits(\n    73\t            preds.reshape(-1), target.reshape(-1)\n    74\t        )\n    75\t        output_weights.append(1)\n    76\t\n    77\t        return output_metrics, output_weights\n    78\t\n    79\t    def val_loss(\n    80\t        self, preds: torch.Tensor, target: torch.Tensor\n    81\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n    82\t        \"\"\"\n    83\t        Calculate the validation loss \u2014 the quantity logged as ``val_loss`` and used by\n    84\t        ModelCheckpoint to select the best model.\n    85\t\n    86\t        By default this delegates to ``train_loss``, so the monitored quantity has the same\n    87\t        form as the training objective and the two cannot drift apart by accident. This is\n    88\t        the hook to override when your task needs a different validation objective (a\n    89\t        different weighting, a metric that is meaningful only on held-out data, etc.).\n    90\t\n    91\t        Note that this is deliberately separate from ``val_metrics``: those are reported\n    92\t        for information only and do not affect checkpoint selection.\n    93\t\n    94\t        Args:\n    95\t            preds (torch.Tensor): Model predictions.\n    96\t            target (torch.Tensor): Ground truth labels.\n    97\t\n    98\t        Returns:\n    99\t            tuple[dict[str, torch.Tensor], list[float]]:\n   100\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n   101\t                - list[float]: List of weights for each calculated metric.\n   102\t        \"\"\"\n   103\t        return self.train_loss(preds, target)\n   104\t\n   105\t    def train_metrics(\n   106\t        self, preds: torch.Tensor, target: torch.Tensor\n   107\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n   108\t        \"\"\"\n   109\t        Calculate evaluation metrics for training.\n   110\t        IMPORTANT:  These metrics are only for reporting purposes and do not\n   111\t                    contribute to the training loss. Use only if you want to\n   112\t                    monitor additional metrics during training.\n   113\t\n   114\t        Args:\n   115\t            preds (torch.Tensor): Model predictions.\n   116\t            target (torch.Tensor): Ground truth labels.\n   117\t\n   118\t        Returns:\n   119\t            tuple[dict[str, torch.Tensor], list[float]]:\n   120\t                - dict[str, torch.Tensor]: Dictionary containing the calculated evaluation metrics.\n   121\t                                        Keys are metric names, and values are the corresponding torch.Tensor values.\n   122\t                - list[float]: List of weights for each calculated metric.\n   123\t        \"\"\"\n   124\t        output_metrics = {}\n   125\t        output_weights = []\n   126\t\n   127\t        self._ensure_device(preds)\n   128\t        output_metrics[\"accuracy\"] = self._accuracy(preds.reshape(-1), target.reshape(-1).long())\n   129\t        output_weights.append(1)\n   130\t\n   131\t        return output_metrics, output_weights\n   132\t\n   133\t    def val_metrics(\n   134\t        self, preds: torch.Tensor, target: torch.Tensor\n   135\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n   136\t        \"\"\"\n   137\t        Calculate metrics for validation.\n   138\t\n   139\t        Args:\n   140\t            preds (torch.Tensor): Model predictions.\n   141\t            target (torch.Tensor): Ground truth labels.\n   142\t\n   143\t        Returns:\n   144\t            tuple[dict[str, torch.Tensor], list[float]]:\n   145\t                - dict[str, torch.Tensor]: Dictionary containing the calculated metrics.\n   146\t                                        Keys are metric names (e.g., \"accuracy\"), and values are\n   147\t                                        the corresponding torch.Tensor values.\n   148\t                - list[float]: List of weights for each calculated metric.\n   149\t        \"\"\"\n   150\t\n   151\t        output_metrics = {}\n   152\t        output_weights = []\n   153\t\n   154\t        self._ensure_device(preds)\n   155\t        output_metrics[\"accuracy\"] = self._accuracy(preds.reshape(-1), target.reshape(-1).long())\n   156\t        output_weights.append(1)\n   157\t\n   158\t        output_metrics[\"auroc\"] = self._auroc(preds.reshape(-1), target.reshape(-1).long())\n   159\t        output_weights.append(1)\n   160\t\n   161\t        return output_metrics, output_weights\n   162\t\n   163\t    def __call__(\n   164\t        self, preds: torch.Tensor, target: torch.Tensor\n   165\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n   166\t        \"\"\"Evaluate metrics for the mode set at construction time.\n   167\t\n   168\t        Args:\n   169\t            preds: Model output tensor. Shape depends on the application.\n   170\t            target: Ground truth tensor to compare against.\n   171\t\n   172\t        Returns:\n   173\t            tuple[dict[str, torch.Tensor], list[float]]:\n   174\t                - Metric dictionary. Keys become logger metric names; values are\n   175\t                  scalar tensors aggregated over the batch.\n   176\t                - List of per-metric weights (used by WaveLightningModule to\n   177\t                  combine multiple loss terms into a single scalar).\n   178\t        \"\"\"\n   179\t\n   180\t        match self.mode.lower():\n   181\t\n   182\t            case \"train_loss\":\n   183\t                return self.train_loss(preds, target)\n   184\t\n   185\t            # No torch.no_grad() here, matching \"train_loss\": Lightning already disables\n   186\t            # gradients during validation, so wrapping it would differ gratuitously from\n   187\t            # the loss case this mirrors.\n   188\t            case \"val_loss\":\n   189\t                return self.val_loss(preds, target)\n   190\t\n   191\t            case \"train_metrics\":\n   192\t                with torch.no_grad():\n   193\t                    return self.train_metrics(preds, target)\n   194\t\n   195\t            case \"val_metrics\":\n   196\t                with torch.no_grad():\n   197\t                    return self.val_metrics(preds, target)\n   198\t\n   199\t            case _:\n   200\t                raise NotImplementedError(\n   201\t                    f\"{self.mode} is not implemented as a valid metric case.\"\n   202\t                )",
