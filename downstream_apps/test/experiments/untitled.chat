            "raw_output": "     1\t\"\"\"\n     2\tTask-specific configuration for the wave-classification app.\n     3\t\n     4\tEverything generic \u2014 paths, channels, temporal sampling, S3 settings, the model and\n     5\tLoRA configs, the training and logging sections, and ``load_config()`` itself \u2014 lives in\n     6\t``workshop_infrastructure/configs.py``. This file holds only what is specific to *this*\n     7\ttask: the wave catalog and how its events are aligned to the Surya index.\n     8\t\n     9\t**This is the pattern to copy when you fork the template.** Subclass ``DataConfig`` with\n    10\tyour task's fields, then bind ``load_config`` to it. You never maintain a copy of the\n    11\tbase config.\n    12\t\"\"\"\n    13\t\n    14\tfrom __future__ import annotations\n    15\t\n    16\tfrom dataclasses import dataclass\n    17\tfrom functools import partial\n    18\tfrom typing import ClassVar\n    19\t\n    20\tfrom workshop_infrastructure.configs import (  # re-exported for convenience\n    21\t    DataConfig,\n    22\t    LoraAdapterConfig,\n    23\t    ModelConfig,\n    24\t    OutputConfig,\n    25\t    TimeEmbeddingConfig,\n    26\t    TrainingConfig,\n    27\t    load_config,\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass WaveDataConfig(DataConfig):\n    33\t    \"\"\"DataConfig plus the wave-catalog alignment settings used by ``waveDSDataset``.\n    34\t\n    35\t    These four keys are what makes this app's ``data:`` section different from any other\n    36\t    downstream task's. Swap them for your own when you fork.\n    37\t    \"\"\"\n    38\t    # Path to the label catalog (relative paths resolve against the config file's dir).\n    39\t    wave_index_path: str = \"\"\n    40\t    # Column in the catalog holding the event timestamp.\n    41\t    ds_time_column: str = \"start_time\"\n    42\t    # Max allowed gap when matching catalog events to Surya timesteps.\n    43\t    ds_time_tolerance: str = \"4d\"\n    44\t    # \"forward\" uses the solar state *before* the event (causal prediction).\n    45\t    ds_match_direction: str = \"forward\"\n    46\t    # Column in the catalog holding the label (e.g. \"wave\" / \"no wave\").\n    47\t    ds_class_column: str = \"\"\n    48\t\n    49\t    # wave_index_path is a path, so it must join the base class's list to get the same\n    50\t    # relative-to-the-config-file resolution. Extend this whenever you add a path field.\n    51\t    PATH_FIELDS: ClassVar[tuple[str, ...]] = DataConfig.PATH_FIELDS + (\"wave_index_path\",)\n    52\t\n    53\t\n    54\t# The app's entry point. Identical to load_config() except that the data: section is\n    55\t# parsed into WaveDataConfig, so the four keys above are recognized instead of rejected.\n    56\tload_wave_config = partial(load_config, data_cls=WaveDataConfig)\n    57\t\n    58\t\n    59\t__all__ = [\n    60\t    \"WaveDataConfig\",\n    61\t    \"load_wave_config\",\n    62\t    # Re-exports so app code can import everything config-related from one place.\n    63\t    \"DataConfig\",\n    64\t    \"OutputConfig\",\n    65\t    \"TrainingConfig\",\n    66\t    \"ModelConfig\",\n    67\t    \"LoraAdapterConfig\",\n    68\t    \"TimeEmbeddingConfig\",\n    69\t    \"load_config\",\n    70\t]\n=====models/init=====\n=====lm/init=====",
