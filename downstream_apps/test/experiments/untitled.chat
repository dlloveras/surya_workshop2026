            "title": "cd surya_workshop2026 && python -c \" import numpy as np, sys sys.path.insert(0,'.') from downstream_apps.test.experiments import wave_common as wc from sklearn.linear_model import LogisticRegression from sklearn.metrics import roc_auc_score, log_loss d=np.load('downstream_apps/test/experiments/results/rd_features.npz',allow_pickle=False) for K in [32,128,512]: for tf in ['raw','log']: xtr=np.abs(wc.repool(d['X_train'],K//8)).mean(axis=(1,2)); ytr=d['y_train'] xva=np.abs(wc.repool(d['X_val'],K//8)).mean(axis=(1,2)); yva=d['y_val'] if tf=='log': xtr,xva=np.log(xtr),np.log(xva) m=LogisticRegression(C=1e6,max_iter=10000).fit(xtr[:,None],ytr) pv=m.predict_proba(xva[:,None])[:,1] pt=m.predict_proba(xtr[:,None])[:,1] print(f'K={K:4d} {tf:3s} w={m.coef_[0,0]:9.3f} b={m.intercept_[0]:7.3f} train bce={log_loss(ytr,pt):.4f} val bce={log_loss(yva,pv):.4f} val auroc={roc_auc_score(yva,pv):.3f}') print('ln2',np.log(2)) \"",
            "kind": "execute",
            "status": "completed",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python -c \"\nimport numpy as np, sys\nsys.path.insert(0,'.')\nfrom downstream_apps.test.experiments import wave_common as wc\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import roc_auc_score, log_loss\nd=np.load('downstream_apps/test/experiments/results/rd_features.npz',allow_pickle=False)\nfor K in [32,128,512]:\n  for tf in ['raw','log']:\n    xtr=np.abs(wc.repool(d['X_train'],K//8)).mean(axis=(1,2)); ytr=d['y_train']\n    xva=np.abs(wc.repool(d['X_val'],K//8)).mean(axis=(1,2)); yva=d['y_val']\n    if tf=='log': xtr,xva=np.log(xtr),np.log(xva)\n    m=LogisticRegression(C=1e6,max_iter=10000).fit(xtr[:,None],ytr)\n    pv=m.predict_proba(xva[:,None])[:,1]\n    pt=m.predict_proba(xtr[:,None])[:,1]\n    print(f'K={K:4d} {tf:3s} w={m.coef_[0,0]:9.3f} b={m.intercept_[0]:7.3f} train bce={log_loss(ytr,pt):.4f} val bce={log_loss(yva,pv):.4f} val auroc={roc_auc_score(yva,pv):.3f}')\nprint('ln2',np.log(2))\n\"",
