            "raw_output": "     1\t# Signum-log transforms (module-level so numba can JIT-compile them)\n     2\t# ---------------------------------------------------------------------------\n     3\t#\n     4\t# Why signum-log?  Solar imagery (especially magnetograms and EUV channels)\n     5\t# has values that span many orders of magnitude and are symmetric around zero.\n     6\t# A plain log is undefined for negative values; a standard z-score squashes the\n     7\t# large dynamic range unevenly.  Signum-log preserves sign, compresses extreme\n     8\t# values, and then standardizes:\n     9\t#\n    10\t#   forward:  y = sign(x * s) * log1p(|x * s|)   then  (y - \u03bc) / (\u03c3 + \u03b5)\n    11\t#   inverse:  y_raw = y * (\u03c3 + \u03b5) + \u03bc             then  sign(y_raw) * expm1(|y_raw|) / s\n    12\t#\n    13\t# where s = sl_scale_factor (per-channel amplitude scaling applied before the log).\n    14\t# \u03bc, \u03c3, \u03b5, and s are stored in the per-channel scaler objects built by\n    15\t# ``workshop_infrastructure/utils.py:build_scalers()``.\n    16\t#\n    17\t# ---------------------------------------------------------------------------\n    18\t# THE THREE SPACES  (read this before writing any \"inverse transform\" code)\n    19\t# ---------------------------------------------------------------------------\n    20\t#\n    21\t# The forward pipeline has two stages, so there are three meaningful spaces \u2014 and\n    22\t# therefore two different things \"undoing the transform\" can mean. Conflating them is\n    23\t# the easiest way to feed a model silently wrong numbers.\n    24\t#\n    25\t#   normalized     What the dataset returns and the model sees. Roughly zero-mean,\n    26\t#                  unit-variance per channel.\n    27\t#      |\n    28\t#      |  StandardScaler.inverse_transform()      <- undoes the z-score ONLY\n    29\t#      v\n    30\t#   signum-log     sign(x\u00b7s)\u00b7log1p(|x\u00b7s|). Still log-compressed, but channels are back\n    31\t#                  on their own scales. This is the linear baseline's feature space\n    32\t#                  (see downstream_apps/template/models/simple_baseline.py:\n    33\t#                  destandardize_channels).\n    34\t#      |\n    35\t#      |  StandardScaler.inverse_signum_log_transform()\n    36\t#      v\n    37\t#   physical       Raw instrument units \u2014 DN for AIA, Gauss for HMI, m/s for Doppler.\n    38\t#                  What you want for plotting with real colour limits, or for a loss\n    39\t#                  expressed in physical units.\n    40\t#\n    41\t# ``HelioNetCDFDataset.inverse_transform_data()`` goes from normalized all the way to\n    42\t# physical in one step (both stages), which is why notebook 0 can plot its output with\n    43\t# real DN percentiles and \u00b11000 G magnetogram limits.\n    44\t#\n    45\t# So: ``scaler.inverse_transform()`` is NOT the inverse of the dataset's ``transform()``.\n    46\t# It is the inverse of only the second stage. Name variables for the space they hold.\n    47\t#\n    48\t# ---------------------------------------------------------------------------\n    49\t#\n    50\t# The forward and inverse directions deliberately use different implementations:\n    51\t#\n    52\t#   forward  (``transform``, used by ``transform_data``) \u2014 pure NumPy. It runs inside\n    53\t#     DataLoader workers on every sample, and the Numba JIT has been observed to hang\n    54\t#     there on some GPU clusters. Correctness and reliability win over speed.\n    55\t#   inverse  (``fast_inverse_transform``, used by ``inverse_transform_data``) \u2014 Numba\n    56\t#     JIT, parallel across channels. It runs in the main process (plotting, physical-space\n    57\t#     metrics), never in a worker, so the hang risk does not apply and the speedup is free.\n    58\t#\n    59\t# ``inverse_transform_single_channel`` is the pure-NumPy inverse for one channel, used\n    60\t# where only a single channel needs undoing.\n    61\t# ---------------------------------------------------------------------------\n    62\t    # Dataset interface\n    63\t    # ------------------------------------------------------------------\n    64\t\n    65\t    def __len__(self) -> int:\n    66\t        \"\"\"Return the number of valid reference timesteps in this dataset.\"\"\"\n    67\t        return self.adjusted_length\n    68\t\n    69\t    def __getitem__(self, idx: int) -> dict:\n    70\t        \"\"\"\n    71\t        Load and return a single sample.\n    72\t\n    73\t        Args:\n    74\t            idx: Dataset index.\n    75\t\n    76\t        Returns:\n    77\t            Dictionary with keys:\n    78\t                ts (np.ndarray):               (C, T, H, W) \u2014 input frames\n    79\t                time_delta_input (np.ndarray): (T,) \u2014 input time offsets in hours (relative to \"now\")\n    80\t            When ``load_forecast_frames=True`` (default), also includes:\n    81\t                forecast (np.ndarray):         (C, L, H, W) \u2014 target frames\n    82\t                lead_time_delta (np.ndarray):  (L,) \u2014 lead times in hours (negative = future)\n    83\t            When ``use_latitude_in_learned_flow=True``, also includes:\n    84\t                input_latitudes (list[float])\n    85\t                forecast_latitude (list[float])  \u2014 only when ``load_forecast_frames=True``\n    86\t        \"\"\"\n    87\t        self._ensure_logger()\n    88\t        self.logger.info(f\"Retrieving index {idx}.\")\n    89\t        return self._get_index_data(idx)\n    90\t\n    91\t    # ------------------------------------------------------------------\n    92\t    # Internal data loading\n    93\t    # ------------------------------------------------------------------\n    94\t\n    95\t    def _load_and_stack_frames(self, timesteps) -> np.ndarray:\n    96\t        \"\"\"Load, normalize, and stack NetCDF frames into a (C, T, H, W) array.\n    97\t\n    98\t        Args:\n    99\t            timesteps: Sequence of timestamps; one NetCDF file is loaded per entry.\n   100\t\n   101\t        Returns:\n   102\t            NumPy array of shape (C, T, H, W).\n   103\t        \"\"\"\n   104\t        return np.stack(\n   105\t            [self.transform_data(self.load_nc_data(self.index.loc[ts, \"path\"], ts, self.channels))\n   106\t             for ts in timesteps],\n   107\t            axis=1,\n   108\t        )\n   109\t\n   110\t    def _get_index_data(self, idx: int) -> dict:\n   111\t        \"\"\"Build and return the sample dict for a single reference timestep.\n   112\t\n   113\t        Samples historical input frames randomly from ``time_delta_input_minutes``,\n   114\t        applies channel masking and optional vertical flip, then assembles the sample\n   115\t        dict described in ``__getitem__``.\n   116\t        \"\"\"\n   117\t        reference_timestep = self.valid_indices[idx]\n   118\t\n   119\t        # The last entry in time_delta_input_minutes is always the \"now\" frame (offset 0\n   120\t        # relative to the reference timestep). The remaining n-1 input frames are sampled\n   121\t        # randomly from the earlier offsets, giving the model varied historical context\n   122\t        # across training steps.\n   123\t        input_time_deltas = np.array(\n   124\t            sorted(random.sample(self.time_delta_input_minutes[:-1], self.n_input_timestamps - 1))\n   125\t            + [self.time_delta_input_minutes[-1]]\n   126\t        )\n   127\t        input_timesteps = reference_timestep + input_time_deltas\n   128\t        stacked_inputs = self._load_and_stack_frames(input_timesteps)\n   129\t\n   130\t        if self.num_mask_aia_channels > 0 or self.drop_hmi_probability:\n   131\t            stacked_inputs = self.masker(stacked_inputs)\n   132\t\n   133\t        # All time deltas are expressed relative to \"now\" (the last input frame), in hours.\n   134\t        now_delta = input_time_deltas[-1]\n   135\t        time_delta_input_float = (\n   136\t            (now_delta - input_time_deltas) / np.timedelta64(1, \"h\")\n   137\t        ).astype(np.float32)\n   138\t\n   139\t        sample = {\n   140\t            \"ts\": stacked_inputs,\n   141\t            \"time_delta_input\": time_delta_input_float,\n   142\t        }\n   143\t\n   144\t        if self.load_forecast_frames:\n   145\t            target_time_deltas = np.array(self.time_delta_target_minutes)\n   146\t            target_timesteps = reference_timestep + target_time_deltas\n   147\t            sample[\"forecast\"] = self._load_and_stack_frames(target_timesteps)\n   148\t            sample[\"lead_time_delta\"] = (\n   149\t                (now_delta - target_time_deltas) / np.timedelta64(1, \"h\")\n   150\t            ).astype(np.float32)\n   151\t\n   152\t        if self.random_vert_flip and torch.bernoulli(torch.ones(()) / 2) == 1:\n   153\t            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n   154\t            if self.load_forecast_frames:\n   155\t                sample[\"forecast\"] = np.flip(sample[\"forecast\"], axis=-2).copy()\n   156\t\n   157\t        if self.use_latitude_in_learned_flow:\n   158\t            from sunpy.coordinates.ephemeris import get_earth\n   159\t\n   160\t            sample[\"input_latitudes\"] = [get_earth(ts).lat.value for ts in input_timesteps]\n   161\t            if self.load_forecast_frames:\n   162\t                sample[\"forecast_latitude\"] = [get_earth(ts).lat.value for ts in target_timesteps]\n   163\t\n   164\t        return sample\n   165\t\n   166\t    # ------------------------------------------------------------------\n   167\t    # NetCDF loading\n   168\t    # ------------------------------------------------------------------\n   169\t\n   170\t    def load_nc_data(self, filepath: str, timestep: pd.Timestamp, channels: list[str]) -> np.ndarray:\n   171\t        \"\"\"\n   172\t        Load a NetCDF file and return channel-stacked data as a NumPy array.",
