              "description": "Inspect notebook cells using the running-diff model",
              "command": "cd /home/jovyan/surya_workshop2026/downstream_apps/test && python - <<'EOF'\nimport json\nnb=json.load(open('1_baseline_template_diego.ipynb'))\nfor i,c in enumerate(nb['cells']):\n    src=''.join(c['source'])\n    if 'RunningDifference' in src or 'model_running_diff' in src or 'logits' in src:\n        print('---CELL',i,c['cell_type'])\n        print(src[:1500])\n        for o in c.get('outputs',[]):\n            t=''.join(o.get('text',[])) if 'text' in o else str(o.get('data',{}).get('text/plain',''))\n            print('  OUT>',t[:800])\nEOF"
