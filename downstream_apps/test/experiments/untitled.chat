            "raw_output": "330\t    test_loader = wc.build_wave_loader(test_ds, shuffle=False, drop_last=False, **common)\n331\t    return train_loader, val_loader, test_loader, stats\n332\t\n333\t\n334\tdef build_metrics() -> dict:\n335\t    \"\"\"The four metric modes. ``val_loss`` is what ModelCheckpoint monitors.\"\"\"\n336\t    return {\n337\t        \"train_loss\": WaveMetrics(\"train_loss\"),\n338\t        \"val_loss\": WaveMetrics(\"val_loss\"),\n339\t        \"train_metrics\": WaveMetrics(\"train_metrics\"),\n340\t        \"val_metrics\": WaveMetrics(\"val_metrics\"),\n341\t    }\n342\t\n343\t\n344\tdef build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n345\t    \"\"\"Instantiate the model, run the pre-flight assertions, and wrap it for Lightning.\"\"\"\n346\t    metrics = build_metrics()\n347\t\n348\t    if train_baseline:\n349\t        from functools import partial\n350\t\n351\t        from downstream_apps.test.models.simple_baseline import (\n352\t            RunningDifferenceLogisticModel,\n353\t            destandardize_channels,\n354\t        )\n355\t        model = RunningDifferenceLogisticModel(\n356\t            channel_index=cfg.data.channels.index(\"aia193\"),\n357\t            img_size=cfg.model.img_size,\n358\t        )\n359\t        preprocess_fn = partial(\n360\t            destandardize_channels, channel_order=cfg.data.channels, scalers=scalers\n361\t        )\n362\t        print(f\"[MODEL] running-difference baseline, \"\n363\t              f\"{sum(p.numel() for p in model.parameters()):,} parameters\")\n364\t        return WaveLightningModule(model, metrics, lr=cfg.learning_rate,\n365\t                                   batch_size=cfg.batch_size, preprocess_fn=preprocess_fn)\n366\t\n367\t    from workshop_infrastructure.models.finetune_models import HelioSpectformer1D\n368\t    model = HelioSpectformer1D.from_config(\n369\t        cfg.model,\n370\t        num_outputs=1,\n371\t        dtype=cfg.dtype,\n372\t        use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n373\t    )\n374\t    load_pretrained_weights(model, cfg.model.pretrained_path)\n375\t    # Bug 1's guard: with time_dim=1 the tokenizer is Conv2d(13, ...) while the\n376\t    # checkpoint's is Conv2d(26, ...), the key is skipped, and every image is tokenized by\n377\t    # random weights for the whole run.\n378\t    wc.assert_tokenizer_loaded(model, cfg.model.pretrained_path)\n379\t\n380\t    if cfg.model.freeze_backbone:\n381\t        for name, param in model.named_parameters():\n382\t            if name.startswith(\"backbone.\"):\n383\t                param.requires_grad = False\n384\t    if cfg.model.use_lora:\n385\t        model = apply_peft_lora(model, cfg.model.lora_config)\n386\t        wc.assert_lora_adapted_attention(model)\n387\t\n388\t    key = (cfg.model.use_lora, cfg.model.lora_config.r,\n389\t           cfg.model.penultimate_linear_layer, cfg.model.freeze_backbone)\n390\t    wc.assert_trainable_count(model, _EXPECTED_TRAINABLE.get(key))\n391\t    if key not in _EXPECTED_TRAINABLE:\n392\t        print(f\"[PREFLIGHT] no pinned trainable count for {key}; reported, not asserted\")\n393\t\n394\t    return WaveLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size)\n395\t\n396\t\n397\tdef build_trainer(\n398\t    cfg: TrainingConfig,\n399\t    args: argparse.Namespace,\n400\t    run_name: str,",
