            },
            "status": "completed",
            "raw_output": "     1\t#!/usr/bin/env python3\n     2\t\"\"\"\n     3\tTask 1.1 \u2014 can a wave be seen at all, in the representation the baseline is given?\n     4\t\n     5\tFor each of a few matched wave / no-wave pairs, plots three panels per sample:\n     6\t\n     7\t1. **AIA193 at t**, the \"now\" frame the model receives.\n     8\t2. **The full-resolution running difference**, ``AIA193(t) - AIA193(t - 12 min)``.\n     9\t3. **The 32x32-mean-pooled 128x128 map**, which is what\n    10\t   ``RunningDifferenceLogisticModel`` actually consumes. Everything the baseline can\n    11\t   possibly use is in this panel; if the wave is not visible here, the baseline cannot see\n    12\t   it either.\n    13\t\n    14\tThe comparison is controlled: the negative sample is the *same event* one hour earlier\n    15\t(``start_time - 30 min`` against ``start_time + 30 min``), so the two rows differ in wave\n    16\tactivity and almost nothing else \u2014 same active region, same limb position, same epoch of\n    17\tthe solar cycle.\n    18\t\n    19\tFrame ordering is verified rather than assumed. ``HelioNetCDFDataset`` sorts\n    20\t``time_delta_input_minutes`` ascending and always places the offset-0 \"now\" frame last, so\n    21\t``x[:, -1] - x[:, 0]`` is genuinely now-minus-12-minutes and the plotted difference carries\n    22\tthe same sign as the feature the baseline trains on.\n    23\t\n    24\tReads the arrays ``extract_baseline_features.py`` wrote; run that first.\n    25\t\n    26\tUsage:\n    27\t    python -m downstream_apps.test.experiments.plot_task_1_1\n    28\t\"\"\"\n    29\t\n    30\tfrom __future__ import annotations\n    31\t\n    32\timport argparse\n    33\tfrom pathlib import Path\n    34\t\n    35\timport numpy as np\n    36\t\n    37\tRESULTS_DIR = Path(__file__).resolve().parent / \"results\"\n    38\tARRAYS_DIR = RESULTS_DIR / \"figure_arrays\"\n    39\t\n    40\t\n    41\tdef parse_args() -> argparse.Namespace:\n    42\t    p = argparse.ArgumentParser(description=__doc__,\n    43\t                                formatter_class=argparse.RawDescriptionHelpFormatter)\n    44\t    p.add_argument(\"--arrays-dir\", default=str(ARRAYS_DIR))\n    45\t    p.add_argument(\"--out\", default=str(RESULTS_DIR / \"task_1_1_wave_visibility.png\"))\n    46\t    p.add_argument(\"--rd-percentile\", type=float, default=99.5,\n    47\t                   help=\"Symmetric colour limit for the difference panels, as a percentile \"\n    48\t                        \"of |RD| over the pair. Shared within a pair so the two rows are \"\n    49\t                        \"directly comparable.\")\n    50\t    return p.parse_args()\n    51\t\n    52\t\n    53\tdef load_pairs(arrays_dir: Path) -> list[tuple[str, dict, dict]]:\n    54\t    \"\"\"Group the saved per-sample arrays into (event, wave, no_wave) triples.\"\"\"\n    55\t    pairs = {}\n    56\t    for path in sorted(arrays_dir.glob(\"*.npz\")):\n    57\t        stem = path.stem\n    58\t        # Order matters: \"_wave\" is a suffix of \"_no_wave\", so test the longer one first.\n    59\t        for suffix, label in ((\"_no_wave\", \"no_wave\"), (\"_wave\", \"wave\")):\n    60\t            if stem.endswith(suffix):\n    61\t                event_key = stem[: -len(suffix)]\n    62\t                pairs.setdefault(event_key, {})[label] = dict(\n    63\t                    np.load(path, allow_pickle=False))\n    64\t                break\n    65\t    complete = [(k, v[\"wave\"], v[\"no_wave\"]) for k, v in sorted(pairs.items())\n    66\t                if \"wave\" in v and \"no_wave\" in v]\n    67\t    if not complete:\n    68\t        raise SystemExit(\n    69\t            f\"No complete wave/no-wave pairs found in {arrays_dir}. Run \"\n    70\t            f\"extract_baseline_features.py with --figure-events >= 1 first.\"\n    71\t        )\n    72\t    return complete\n    73\t\n    74\t\n    75\tdef main() -> None:\n    76\t    args = parse_args()\n    77\t    import matplotlib\n    78\t    matplotlib.use(\"Agg\")\n    79\t    import matplotlib.pyplot as plt\n    80\t\n    81\t    # SunPy registers the instrument colour maps (\"sdoaia193\", ...) on import. Worth having:\n    82\t    # the AIA193 map is what a solar physicist reads without having to think about it. The\n    83\t    # frames are in signum-log space rather than DN, so the colour bar is labelled as such.\n    84\t    try:\n    85\t        import sunpy.visualization.colormaps  # noqa: F401\n    86\t    except Exception:\n    87\t        pass\n    88\t    intensity_cmap = \"sdoaia193\" if \"sdoaia193\" in plt.colormaps() else \"inferno\"\n    89\t\n    90\t    pairs = load_pairs(Path(args.arrays_dir))\n    91\t    print(f\"[1.1] {len(pairs)} matched pairs: {[p[0] for p in pairs]}\")\n    92\t\n    93\t    n_rows = 2 * len(pairs)\n    94\t    fig, axes = plt.subplots(n_rows, 3, figsize=(11.5, 3.9 * n_rows),\n    95\t                             constrained_layout=True)\n    96\t    axes = np.atleast_2d(axes)\n    97\t\n    98\t    for i, (event, wave, no_wave) in enumerate(pairs):\n    99\t        # One colour scale per pair, from both samples, so \"brighter\" means brighter and\n   100\t        # not \"differently normalized\".\n   101\t        both = np.concatenate([np.abs(wave[\"running_diff\"]).ravel(),\n   102\t                               np.abs(no_wave[\"running_diff\"]).ravel()])\n   103\t        rd_lim = float(np.percentile(both, args.rd_percentile))\n   104\t        pool_lim = float(np.percentile(\n   105\t            np.abs(np.concatenate([wave[\"pooled_32\"].ravel(), no_wave[\"pooled_32\"].ravel()])),\n   106\t            99.9))\n   107\t\n   108\t        for j, (label, sample) in enumerate([(\"wave\", wave), (\"no wave\", no_wave)]):\n   109\t            row = 2 * i + j\n   110\t            now = sample[\"now\"].astype(np.float32)\n   111\t            vmin, vmax = np.percentile(now, [1, 99.5])\n   112\t\n   113\t            im = axes[row, 0].imshow(now, origin=\"lower\", cmap=intensity_cmap,\n   114\t                                     vmin=vmin, vmax=vmax)\n   115\t            axes[row, 0].set_title(f\"{label} \u2014 AIA193 at t\\n{str(sample['ds_index'])}\",\n   116\t                                   fontsize=9)\n   117\t            fig.colorbar(im, ax=axes[row, 0], fraction=0.046, label=\"signum-log DN\")\n   118\t\n   119\t            im = axes[row, 1].imshow(sample[\"running_diff\"].astype(np.float32),\n   120\t                                     origin=\"lower\", cmap=\"RdBu_r\",\n   121\t                                     vmin=-rd_lim, vmax=rd_lim)\n   122\t            axes[row, 1].set_title(f\"{label} \u2014 running difference\\n\"\n   123\t                                   f\"AIA193(t) \u2212 AIA193(t\u221212 min), 4096\u00b2\", fontsize=9)\n   124\t            fig.colorbar(im, ax=axes[row, 1], fraction=0.046)\n   125\t\n   126\t            im = axes[row, 2].imshow(sample[\"pooled_32\"], origin=\"lower\", cmap=\"RdBu_r\",\n   127\t                                     vmin=-pool_lim, vmax=pool_lim, interpolation=\"nearest\")\n   128\t            axes[row, 2].set_title(f\"{label} \u2014 32\u00d7 mean-pooled, 128\u00b2\\n\"\n   129\t                                   f\"(what the baseline sees)\", fontsize=9)\n   130\t            fig.colorbar(im, ax=axes[row, 2], fraction=0.046)\n   131\t\n   132\t            for ax in axes[row]:\n   133\t                ax.set_xticks([])\n   134\t                ax.set_yticks([])\n   135\t        axes[2 * i, 0].set_ylabel(f\"event {event}\", fontsize=9)\n   136\t\n   137\t    fig.suptitle(\"Task 1.1 \u2014 matched wave / no-wave pairs of the same event, one hour apart.\\n\"\n   138\t                 \"Each pair shares its colour limits; the right column is the only \"\n   139\t                 \"information the running-difference baseline receives.\", fontsize=11)\n   140\t    out = Path(args.out)\n   141\t    out.parent.mkdir(parents=True, exist_ok=True)\n   142\t    fig.savefig(out, dpi=120)\n   143\t    plt.close(fig)\n   144\t    print(f\"[out] {out}\")\n   145\t\n   146\t    # A number to go with the picture: how much bigger is the pooled signal in the\n   147\t    # positive sample than in its own matched negative?\n   148\t    print(\"\\n[1.1] pooled-map contrast, wave vs its matched no-wave control\")\n   149\t    for event, wave, no_wave in pairs:\n   150\t        w = float(np.abs(wave[\"pooled_32\"]).max())\n   151\t        n = float(np.abs(no_wave[\"pooled_32\"]).max())\n   152\t        print(f\"  {event}: max|pooled| wave {w:.4f}  no wave {n:.4f}  ratio {w / n:.2f}\")\n   153\t\n   154\t\n   155\tif __name__ == \"__main__\":\n   156\t    main()",
            "title": "cat -n plot_task_1_1.py",
            "kind": "execute",
            "tool_call_id": "toolu_bdrk_01CJ8N6HjbwDpx6eq3phhKwy"
          },
          {
            "tool_call_id": "toolu_bdrk_013f5jmiiLEskZTfzoKW4AjC",
            "raw_input": {
              "description": "Read extract_baseline_features.py",
              "command": "cat -n /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/extract_baseline_features.py"
            },
            "kind": "execute",
            "status": "completed",
            "title": "cat -n extract_baseline_features.py",
            "raw_output": "     1\t#!/usr/bin/env python3\n     2\t\"\"\"\n     3\tPhase 1 \u2014 one data pass that does three jobs.\n     4\t\n     5\tRun this first. It is the only script here that touches S3 in bulk, and everything\n     6\tdownstream (the 1.1 figures, the whole baseline arm, and the Surya runs' warm cache)\n     7\tdepends on what it leaves behind.\n     8\t\n     9\tThe three jobs:\n    10\t\n    11\t1. **Warm the S3 cache.** The full 13-channel NetCDF files are downloaded, because the\n    12\t   Surya runs need all 13 channels later and a cached file costs nothing to re-open. Only\n    13\t   ~2% of the frames this task needs were already cached.\n    14\t2. **Cache the running-difference baseline's features.** Only AIA193 is *decoded* \u2014 the\n    15\t   channel the baseline uses \u2014 which is what makes this pass cheap: 1.2 s of CPU per\n    16\t   sample against 15.2 s for all 13 channels (0.40 s/frame to read one channel vs 4.69 s,\n    17\t   plus 0.39 s of signum-log against 4.67 s). The result is a small ``.npz`` that makes\n    18\t   every baseline fit in Phase 3 instant.\n    19\t3. **Save full-resolution arrays for the task 1.1 figures**, for a few matched\n    20\t   wave/no-wave pairs.\n    21\t\n    22\tThe cache is exactly equivalent to reading the live dataset: no augmentation is active on\n    23\tthis path, so there is no random draw to freeze. ``num_mask_aia_channels`` defaults to 0\n    24\tand is never passed, ``drop_hmi_probability`` is 0.0, and ``random_vert_flip`` defaults to\n    25\tFalse \u2014 so ``phase=\"train\"`` and ``phase=\"val\"`` differ only in which index they read.\n    26\t\n    27\tFeatures are cached at ``--pool-kernel 8`` (512x512, 1 MB/sample) rather than at the\n    28\tbaseline's 32 (128x128, 64 KB/sample). Mean pooling composes exactly \u2014 pooling a\n    29\tkernel-8 map by a further 4 is identical to pooling the original by 32 \u2014 so the larger\n    30\tcache costs ~0.5 GB in total and buys the pooling-kernel sweep for free.\n    31\t\n    32\tUsage:\n    33\t    python -m downstream_apps.test.experiments.extract_baseline_features \\\n    34\t        --config downstream_apps/test/configs/config_wave_full.yaml \\\n    35\t        --train-n 384 --num-workers 12\n    36\t\"\"\"\n    37\t\n    38\tfrom __future__ import annotations\n    39\t\n    40\timport argparse\n    41\timport json\n    42\timport time\n    43\tfrom pathlib import Path\n    44\t\n    45\timport numpy as np\n    46\timport pandas as pd\n    47\t\n    48\tfrom downstream_apps.test.configs import load_wave_config\n    49\tfrom downstream_apps.test.experiments import wave_common as wc\n    50\tfrom downstream_apps.test.models.simple_baseline import destandardize_channels\n    51\tfrom workshop_infrastructure.assets import ensure_assets\n    52\tfrom workshop_infrastructure.utils import build_scalers\n    53\t\n    54\t# The channel the running-difference baseline uses, and the only one decoded here.\n    55\tRD_CHANNEL = \"aia193\"\n    56\t\n    57\tDEFAULT_CONFIG = Path(__file__).resolve().parents[1] / \"configs\" / \"config_wave_full.yaml\"\n    58\tRESULTS_DIR = Path(__file__).resolve().parent / \"results\"\n    59\t\n    60\t\n    61\tdef parse_args() -> argparse.Namespace:\n    62\t    p = argparse.ArgumentParser(description=__doc__,\n    63\t                                formatter_class=argparse.RawDescriptionHelpFormatter)\n    64\t    p.add_argument(\"--config\", default=str(DEFAULT_CONFIG))\n    65\t    p.add_argument(\"--train-n\", type=int, default=384,\n    66\t                   help=\"Training samples to extract (even; event-level stratified).\")\n    67\t    p.add_argument(\"--subset-seed\", type=int, default=42,\n    68\t                   help=\"Selects which events. Must match the value the Surya runs use.\")\n    69\t    p.add_argument(\"--num-workers\", type=int, default=12,\n    70\t                   help=\"At one channel a sample is 0.134 GB, so 12 workers cost ~2 GB.\")\n    71\t    p.add_argument(\"--prefetch-factor\", type=int, default=1)\n    72\t    p.add_argument(\"--batch-size\", type=int, default=4)\n    73\t    p.add_argument(\"--pool-kernel\", type=int, default=8,\n    74\t                   help=\"Base mean-pool kernel for the cached features. Must divide \"\n    75\t                        \"img_size, and 32 // this must be an integer.\")\n    76\t    p.add_argument(\"--figure-events\", type=int, default=3,\n    77\t                   help=\"Matched pairs to also save at full resolution, for task 1.1.\")\n    78\t    p.add_argument(\"--out\", default=str(RESULTS_DIR / \"rd_features.npz\"))\n    79\t    p.add_argument(\"--splits\", default=\"train,val,test\",\n    80\t                   help=\"Comma-separated. Add 'repro' for the pseudo-split that \"\n    81\t                        \"reproduces what data.max_samples selects.\")\n    82\t    p.add_argument(\"--repro-samples\", type=int, default=10,\n    83\t                   help=\"Size of the 'repro' pseudo-split, matching the max_samples \"\n    84\t                        \"value being reproduced.\")\n    85\t    p.add_argument(\"--force\", action=\"store_true\",\n    86\t                   help=\"Re-extract a split even if its per-split .npz already exists.\")\n    87\t    p.add_argument(\"--disk-cache\", action=\"store_true\",\n    88\t                   help=\"Use the stock s3_mode read path (writes every frame to \"\n    89\t                        \"s3_cache_dir) instead of reading through RAM.\")\n    90\t    return p.parse_args()\n    91\t\n    92\t\n    93\tdef extract_split(name, dataset, args, scalers, figure_events, figures_dir):\n    94\t    \"\"\"Run one pass over ``dataset``, returning the cached feature arrays.\"\"\"\n    95\t    loader = wc.build_wave_loader(\n    96\t        dataset,\n    97\t        batch_size=args.batch_size,\n    98\t        num_workers=args.num_workers,\n    99\t        prefetch_factor=args.prefetch_factor,\n   100\t        seed=args.subset_seed,\n   101\t        shuffle=False,       # order must match df_valid_indices so labels line up\n   102\t        drop_last=False,     # every sample is wanted\n   103\t    )\n   104\t\n   105\t    meta = dataset.df_valid_indices\n   106\t    events = meta[wc.EVENT_COL].to_numpy()\n   107\t    expected_index = [pd.Timestamp(t).isoformat() for t in meta[\"ds_index\"]]\n   108\t\n   109\t    cached, total = wc.cache_coverage(dataset)\n   110\t    print(f\"[{name}] {len(dataset)} samples, {total} distinct frames, \"\n   111\t          f\"{cached} already cached ({100 * cached / max(total, 1):.1f}%)\")\n   112\t\n   113\t    feats, labels, indices = [], [], []\n   114\t    pos = 0\n   115\t    t0 = time.time()\n   116\t    for batch in loader:\n   117\t        signum_log = destandardize_channels(batch, channel_order=[RD_CHANNEL], scalers=scalers)\n   118\t        pooled = wc.pooled_running_difference(\n   119\t            signum_log[\"ts\"], channel_index=0, pool_kernel=args.pool_kernel\n   120\t        )\n   121\t        feats.append(pooled.numpy().astype(np.float32))\n   122\t        labels.append(batch[\"forecast\"].numpy().astype(np.float32))\n   123\t        indices.extend(batch[\"ds_index\"])\n   124\t\n   125\t        # Full-resolution arrays for the task 1.1 figures. Written from this same pass so\n   126\t        # the plotted difference is the one the baseline trains on, not a re-derivation.\n   127\t        for i in range(pooled.shape[0]):\n   128\t            if name == \"train\" and events[pos + i] in figure_events:\n   129\t                save_figure_arrays(\n   130\t                    figures_dir, signum_log[\"ts\"][i], meta.iloc[pos + i], args.pool_kernel\n   131\t                )\n   132\t        pos += pooled.shape[0]\n   133\t\n   134\t        done = pos\n   135\t        rate = done / (time.time() - t0)\n   136\t        print(f\"[{name}] {done}/{len(dataset)} samples  {rate:.2f} samples/s  \"\n   137\t              f\"eta {(len(dataset) - done) / max(rate, 1e-9) / 60:.1f} min\", flush=True)\n   138\t\n   139\t    X = np.concatenate(feats)\n   140\t    y = np.concatenate(labels)\n   141\t    if list(indices) != expected_index:\n   142\t        raise AssertionError(\n   143\t            f\"[{name}] sample order drifted from df_valid_indices, so labels and features \"\n   144\t            f\"may be mismatched. First divergence at \"\n   145\t            f\"{next(i for i, (a, b) in enumerate(zip(indices, expected_index)) if a != b)}.\"\n   146\t        )\n   147\t    if not np.array_equal(y, meta[\"label\"].to_numpy().astype(np.float32)):\n   148\t        raise AssertionError(f\"[{name}] collected labels differ from the dataset's labels.\")\n   149\t    print(f\"[{name}] done in {(time.time() - t0) / 60:.1f} min \u2014 \"\n   150\t          f\"X {X.shape} {X.nbytes / 2**20:.0f} MiB, y balance {y.mean():.3f}\")\n   151\t    return X, y, np.array(indices), events\n   152\t\n   153\t\n   154\tdef save_figure_arrays(figures_dir, ts_signum_log, row, pool_kernel):\n   155\t    \"\"\"Write one sample's full-resolution AIA193 frames, running difference and pooled map.\n   156\t\n   157\t    float16 on purpose: these arrays exist to be plotted, and at 4096x4096 each float32\n   158\t    frame is 67 MiB. The physics is unaffected at plotting precision, and the pooled map\n   159\t    the baseline actually consumes is written from the float32 computation above.\n   160\t    \"\"\"\n   161\t    frames = ts_signum_log.numpy()                     # (1, T, H, W), signum-log space\n   162\t    prev, now = frames[0, 0], frames[0, -1]\n   163\t    diff = (now - prev).astype(np.float32)\n   164\t    pooled = wc.repool(diff[None], pool_kernel)[0]\n   165\t    pooled32 = wc.repool(diff[None], 32)[0]\n   166\t    label = \"wave\" if float(row[\"label\"]) == 1.0 else \"no_wave\"\n   167\t    stem = f\"{pd.Timestamp(row[wc.EVENT_COL]).strftime('%Y%m%dT%H%M')}_{label}\"\n   168\t    out = figures_dir / f\"{stem}.npz\"\n   169\t    np.savez(\n   170\t        out,\n   171\t        now=now.astype(np.float16),\n   172\t        prev=prev.astype(np.float16),\n   173\t        running_diff=diff.astype(np.float16),\n   174\t        pooled_base=pooled.astype(np.float32),\n   175\t        pooled_32=pooled32.astype(np.float32),\n   176\t        ds_index=str(row[\"ds_index\"]),\n   177\t        event=str(row[wc.EVENT_COL]),\n   178\t        label=float(row[\"label\"]),\n   179\t        pool_kernel=pool_kernel,\n   180\t    )\n   181\t    print(f\"[fig] wrote {out.name}\")\n   182\t\n   183\t\n   184\tdef main() -> None:\n   185\t    args = parse_args()\n   186\t    if 32 % args.pool_kernel:\n   187\t        raise SystemExit(f\"--pool-kernel {args.pool_kernel} must divide 32 so the cached \"\n   188\t                         f\"map can be re-pooled to the baseline's 32.\")\n   189\t\n   190\t    cfg = load_wave_config(args.config)\n   191\t    ensure_assets(cfg, which=[\"scalers\"])\n   192\t    scalers = build_scalers(info=cfg.data.scalers_path)\n   193\t\n   194\t    # Decode one channel instead of thirteen. The .nc files are downloaded whole either\n   195\t    # way (s3_mode=\"download\" fetches the object, then xarray extracts variables), so the\n   196\t    # Surya runs still get a warm cache while this pass pays 1.2 s/sample instead of 15.2.\n   197\t    cfg.data.channels = [RD_CHANNEL]\n   198\t    print(f\"[cfg] decoding channels={cfg.data.channels}, \"\n   199\t          f\"frames={cfg.data.time_delta_input_minutes}, \"\n   200\t          f\"tolerance={cfg.data.ds_time_tolerance}\")\n   201\t\n   202\t    train, val, test = wc.build_wave_datasets(\n   203\t        cfg, scalers, include_test=True, in_memory=not args.disk_cache\n   204\t    )\n   205\t\n   206\t    # \"repro\" is a fourth pseudo-split: the chronologically first N samples of the\n   207\t    # UNSUBSETTED train match, which is exactly what data.max_samples selects (waveDSDataset\n   208\t    # head-slices a frame sorted by ds_index). It is kept separate from the train split\n   209\t    # because the event-level subset's earliest samples are a different, later set of events,\n   210\t    # so reproducing a max_samples run from the subset would not be reproducing it at all.\n   211\t    repro = None\n   212\t    if \"repro\" in args.splits:\n   213\t        import copy\n   214\t\n   215\t        repro = copy.copy(train)\n   216\t        repro.valid_indices = list(train.valid_indices)\n   217\t        repro.df_valid_indices = train.df_valid_indices.iloc[: args.repro_samples]\n   218\t        repro.valid_indices = repro.valid_indices[: args.repro_samples]\n   219\t        repro.adjusted_length = len(repro.valid_indices)\n   220\t\n   221\t    print(f\"[cfg] read path: {'stock s3_mode=' + cfg.data.s3_mode if args.disk_cache else 'in-memory (BytesIO -> h5netcdf)'}\")\n   222\t    subsets = {}\n   223\t    for name, ds, n in [(\"train\", train, args.train_n), (\"val\", val, None), (\"test\", test, None)]:\n   224\t        info = wc.event_stratified_subset(ds, n_samples=n, seed=args.subset_seed)\n   225\t        subsets[name] = (ds, info)\n   226\t        print(f\"[{name}] {info.describe()}\")\n   227\t    if repro is not None:\n   228\t        labels = repro.df_valid_indices[\"label\"].to_numpy()\n   229\t        dates = sorted({str(d)[:10] for d in repro.df_valid_indices[wc.EVENT_COL]})\n   230\t        subsets[\"repro\"] = (repro, None)\n   231\t        print(f\"[repro] {len(repro)} earliest samples of the unsubsetted match \"\n   232\t              f\"({int(labels.sum())} wave, {int((1 - labels).sum())} no wave), \"\n   233\t              f\"events {dates[0]}..{dates[-1]}\")\n   234\t\n   235\t    # This pass reads every frame exactly once, so nothing benefits from being pinned to\n   236\t    # local disk during it. It is pinned anyway, for the *next* consumer: the Surya runs\n   237\t    # re-read the validation split on every epoch, and warming it here costs nothing extra.\n   238\t    n_pinned = wc.pin_frames(val)\n   239\t    print(f\"[cache] pinned {n_pinned} validation frames to {cfg.data.s3_cache_dir}\")\n   240\t\n   241\t    figures_dir = RESULTS_DIR / \"figure_arrays\"\n   242\t    figures_dir.mkdir(parents=True, exist_ok=True)\n   243\t    # Take the figure pairs from the *training* subset: task 1.1 is an illustration of\n   244\t    # what the model is fitted on, and it keeps val/test unlooked-at.\n   245\t    train_events = subsets[\"train\"][0].df_valid_indices[wc.EVENT_COL].unique()\n   246\t    figure_events = set(train_events[: args.figure_events])\n   247\t    print(f\"[fig] full-resolution arrays for {sorted(figure_events)}\")\n   248\t\n   249\t    # Each split is written as soon as it finishes, and reused if already on disk. This pass\n   250\t    # is long enough, and shares bandwidth with enough else, that losing a completed split to\n   251\t    # a restart is a real cost \u2014 and the splits are independent, so there is no reason to.\n   252\t    out = {}\n   253\t    out_path = Path(args.out)\n   254\t    wanted = [s.strip() for s in args.splits.split(\",\") if s.strip()]\n   255\t    for name in wanted:\n   256\t        part_path = out_path.with_name(f\"{out_path.stem}_{name}.npz\")\n   257\t        if part_path.exists() and not args.force:\n   258\t            part = np.load(part_path, allow_pickle=False)\n   259\t            out.update({k: part[k] for k in part.files})\n   260\t            print(f\"[{name}] reusing {part_path.name} \"\n   261\t                  f\"({part[f'X_{name}'].shape[0]} samples) \u2014 pass --force to re-extract\")\n   262\t            continue\n   263\t        ds, info = subsets[name]\n   264\t        X, y, idx, events = extract_split(\n   265\t            name, ds, args, scalers, figure_events if name == \"train\" else set(), figures_dir\n   266\t        )\n   267\t        part = {\n   268\t            f\"X_{name}\": X,\n   269\t            f\"y_{name}\": y,\n   270\t            f\"index_{name}\": idx,\n   271\t            f\"event_{name}\": events.astype(str),\n   272\t        }\n   273\t        part_path.parent.mkdir(parents=True, exist_ok=True)\n   274\t        np.savez(part_path, **part)\n   275\t        print(f\"[{name}] wrote {part_path.name}\")\n   276\t        out.update(part)\n   277\t\n   278\t    # The merged file is rebuilt from EVERY per-split file on disk, not only the splits this\n   279\t    # invocation was asked for. Otherwise `--splits repro` would replace a merged cache\n   280\t    # containing train/val/test with one containing only the 10-sample repro split \u2014 the\n   281\t    # per-split files survive, but every consumer reads the merged one.\n   282\t    for part_path in sorted(out_path.parent.glob(f\"{out_path.stem}_*.npz\")):\n   283\t        part = np.load(part_path, allow_pickle=False)\n   284\t        for key in part.files:\n   285\t            out.setdefault(key, part[key])\n   286\t\n   287\t    out[\"pool_kernel\"] = np.array(args.pool_kernel)\n   288\t    out[\"subset_seed\"] = np.array(args.subset_seed)\n   289\t    out[\"channel\"] = np.array(RD_CHANNEL)\n   290\t\n   291\t    out_path.parent.mkdir(parents=True, exist_ok=True)\n   292\t    np.savez(out_path, **out)\n   293\t    splits_in = sorted(k[2:] for k in out if k.startswith(\"X_\"))\n   294\t    print(f\"[out] wrote {out_path} ({out_path.stat().st_size / 2**20:.1f} MiB) \"\n   295\t          f\"containing splits: {', '.join(splits_in)}\")\n   296\t\n   297\t    summary = {\n   298\t        name: {\n   299\t            \"n_samples\": int(info.n_samples),\n   300\t            \"n_events\": int(info.n_events),\n   301\t            \"n_positive\": int(info.n_positive),\n   302\t            \"n_negative\": int(info.n_negative),\n   303\t            \"n_dropped_unpaired\": int(info.n_dropped_unpaired),\n   304\t            \"n_events_available\": int(info.n_events_available),\n   305\t        }\n   306\t        for name, (_, info) in subsets.items() if info is not None\n   307\t    }\n   308\t    summary[\"pool_kernel\"] = args.pool_kernel\n   309\t    summary[\"subset_seed\"] = args.subset_seed\n   310\t    summary[\"ds_time_tolerance\"] = cfg.data.ds_time_tolerance\n   311\t    (RESULTS_DIR / \"dataset_summary.json\").write_text(json.dumps(summary, indent=2))\n   312\t    print(json.dumps(summary, indent=2))\n   313\t\n   314\t\n   315\tif __name__ == \"__main__\":\n   316\t    main()"
