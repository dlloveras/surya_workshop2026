            },
            "title": "cat > bench_gpu.py <<'PY' import sys, time, os sys.path.insert(0, \"/home/jovyan/surya_workshop2026\") os.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\") import torch from downstream_apps.test.configs import load_wave_config from downstream_apps.test.experiments import wave_common as wc from workshop_infrastructure.models.finetune_models import HelioSpectformer1D from workshop_infrastructure.utils import apply_peft_lora, load_pretrained_weights torch.set_float32_matmul_precision(\"medium\") cfg = load_wave_config(\"/home/jovyan/surya_workshop2026/downstream_apps/test/configs/config_wave_full.yaml\") model = HelioSpectformer1D.from_config(cfg.model, num_outputs=1, dtype=cfg.dtype) load_pretrained_weights(model, cfg.model.pretrained_path) wc.assert_tokenizer_loaded(model, cfg.model.pretrained_path) model = apply_peft_lora(model, cfg.model.lora_config) wc.assert_lora_adapted_attention(model) wc.assert_trainable_count(model, 1_518_081) model = model.cuda() opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4) loss_fn = torch.nn.functional.binary_cross_entropy_with_logits print(f\"total VRAM {torch.cuda.get_device_properties(0).total_memory/2**30:.1f} GiB\") for B in (1, 2, 3): torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats() try: ts = torch.randn(B, 13, 2, 4096, 4096, device=\"cuda\") batch = {\"ts\": ts, \"time_delta_input\": torch.tensor([[0.2, 0.0]]*B, device=\"cuda\"), \"forecast\": torch.randint(0, 2, (B,), device=\"cuda\").float()} times = [] for i in range(4): torch.cuda.synchronize(); t0 = time.time() opt.zero_grad(set_to_none=True) with torch.autocast(\"cuda\", dtype=torch.bfloat16): out = model(batch) loss = loss_fn(out.float().reshape(-1), batch[\"forecast\"].reshape(-1)) loss.backward(); opt.step() torch.cuda.synchronize(); times.append(time.time()-t0) steady = sum(times[1:])/len(times[1:]) print(f\"B={B} {steady:5.2f} s/step {steady/B:5.2f} s/sample \" f\"peak alloc {torch.cuda.max_memory_allocated()/2**30:5.1f} GiB \" f\"reserved {torch.cuda.max_memory_reserved()/2**30:5.1f} GiB\", flush=True) del ts, batch, out, loss except torch.OutOfMemoryError: print(f\"B={B} OOM\", flush=True) break PY cd surya_workshop2026 && nohup python -u bench_gpu.py > bench_gpu.log 2>&1 & echo started",
