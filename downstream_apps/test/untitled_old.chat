              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python - <<'PY'\nimport pandas as pd, numpy as np\ncat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\", usecols=[\"start_time\",\"mid_time\",\"class\",\"AR\",\"Date\"])\ncat[\"ds_index\"]=pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\")\ncat=cat.sort_values(\"ds_index\")\nfor sp in [\"train\",\"val\",\"test\"]:\n    idx=pd.read_csv(f\"data/indices/surya_aws_s3_{sp}.csv\")\n    idx=idx[idx[\"present\"]==1]\n    ts=pd.to_datetime(idx[\"timestep\"]).values.astype(\"datetime64[ns]\")\n    tset=set(ts)\n    dt=np.timedelta64(-12,\"m\")\n    valid=[t for t in np.sort(ts) if (t+dt) in tset]\n    dfv=pd.DataFrame({\"valid_indices\":valid}).sort_values(\"valid_indices\")\n    m=pd.merge_asof(dfv,cat,right_on=\"ds_index\",left_on=\"valid_indices\",direction=\"forward\")\n    m[\"index_delta\"]=np.abs(m[\"valid_indices\"]-m[\"ds_index\"])\n    m=m.sort_values([\"ds_index\",\"index_delta\"]).drop_duplicates(subset=\"ds_index\",keep=\"first\")\n    m=m[m[\"index_delta\"]<=pd.Timedelta(\"4d\")]\n    print(f\"== {sp}: valid_indices={len(valid)}  matched samples={len(m)}  classes={m['class'].value_counts().to_dict()}\")\n    d=m[\"index_delta\"]\n    print(\"   delta: <=12min:\",int((d<=pd.Timedelta('12min')).sum()),\n          \" 12min-1h:\",int(((d>pd.Timedelta('12min'))&(d<=pd.Timedelta('1h'))).sum()),\n          \" 1h-1d:\",int(((d>pd.Timedelta('1h'))&(d<=pd.Timedelta('1d'))).sum()),\n          \" >1d:\",int((d>pd.Timedelta('1d')).sum()), \" max:\",str(d.max()))\n    bad=m[d>pd.Timedelta('1h')]\n    if len(bad): print(bad[[\"valid_indices\",\"ds_index\",\"class\",\"index_delta\"]].head(10).to_string())\nPY",
              "description": "Measure merge deltas per split"
            },
