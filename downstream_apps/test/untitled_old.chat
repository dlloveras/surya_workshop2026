614', '13663', '13664', '13666', '13680', '13685', '13697', '13730', '13738', '13762', '13765', '13767', '13768', '13777', '13784', '13813', '13825', '13842', '13843', '13848', '13869', '13873', '13883', '13889', '13901', '13906', '13912', '13932', 'N-AR', 'U-AR']\nval ['11149', '11957', '11967', '12800', '13559', 'N-AR', 'U-AR']\ntest ['11158', '11161', '11667', '11973', '11974', '12282', '12497', '13575', '13576', 'U-AR']\ntrain\u2229val {'N-AR', 'U-AR'} train\u2229test {'U-AR'} val\u2229test {'U-AR'}",
            "tool_call_id": "toolu_bdrk_01HXLx8SpWzDXqsUMPZ7QKp3",
            "title": "cd surya_workshop2026 && python - <<'PY' import pandas as pd, numpy as np cat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\", usecols=[\"mid_time\",\"class\",\"AR\"]) cat[\"ds_index\"]=pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\"); cat=cat.sort_values(\"ds_index\") sets={} for sp in [\"train\",\"val\",\"test\"]: idx=pd.read_csv(f\"data/indices/surya_aws_s3_{sp}.csv\"); idx=idx[idx[\"present\"]==1] ts=pd.to_datetime(idx[\"timestep\"]).values.astype(\"datetime64[ns]\"); tset=set(ts) valid=[t for t in np.sort(ts) if (t+np.timedelta64(-12,\"m\")) in tset] m=pd.merge_asof(pd.DataFrame({\"valid_indices\":valid}),cat,right_on=\"ds_index\",left_on=\"valid_indices\",direction=\"forward\") m[\"index_delta\"]=np.abs(m[\"valid_indices\"]-m[\"ds_index\"]) m=m.sort_values([\"ds_index\",\"index_delta\"]).drop_duplicates(subset=\"ds_index\",keep=\"first\") m=m[m[\"index_delta\"]<=pd.Timedelta(\"12min\")] sets[sp]=set(m[\"AR\"].dropna().unique()) print(sp, sorted(sets[sp])) print(\"train\u2229val\", sets[\"train\"]&sets[\"val\"], \"train\u2229test\", sets[\"train\"]&sets[\"test\"], \"val\u2229test\", sets[\"val\"]&sets[\"test\"]) PY",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python - <<'PY'\nimport pandas as pd, numpy as np\ncat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\", usecols=[\"mid_time\",\"class\",\"AR\"])\ncat[\"ds_index\"]=pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\"); cat=cat.sort_values(\"ds_index\")\nsets={}\nfor sp in [\"train\",\"val\",\"test\"]:\n    idx=pd.read_csv(f\"data/indices/surya_aws_s3_{sp}.csv\"); idx=idx[idx[\"present\"]==1]\n    ts=pd.to_datetime(idx[\"timestep\"]).values.astype(\"datetime64[ns]\"); tset=set(ts)\n    valid=[t for t in np.sort(ts) if (t+np.timedelta64(-12,\"m\")) in tset]\n    m=pd.merge_asof(pd.DataFrame({\"valid_indices\":valid}),cat,right_on=\"ds_index\",left_on=\"valid_indices\",direction=\"forward\")\n    m[\"index_delta\"]=np.abs(m[\"valid_indices\"]-m[\"ds_index\"])\n    m=m.sort_values([\"ds_index\",\"index_delta\"]).drop_duplicates(subset=\"ds_index\",keep=\"first\")\n    m=m[m[\"index_delta\"]<=pd.Timedelta(\"12min\")]\n    sets[sp]=set(m[\"AR\"].dropna().unique())\n    print(sp, sorted(sets[sp]))\nprint(\"train\u2229val\", sets[\"train\"]&sets[\"val\"], \"train\u2229test\", sets[\"train\"]&sets[\"test\"], \"val\u2229test\", sets[\"val\"]&sets[\"test\"])\nPY",
