rw-rw-r--. 1 jovyan users 4482 Sep 16 18:46 output.log\n-rw-rw-r--. 1 jovyan users 5298 Sep 16 15:26 requirements.txt\n-rw-rw-r--. 1 jovyan users 1036 Sep 16 15:26 wandb-metadata.json\n--- /home/jovyan/surya_workshop2026/downstream_apps/test/wandb/wandb_tmp/wandb/run-20260916_204339-vy1af90b/\ntotal 32\ndrwxrwsr-x. 2 jovyan users 4096 Sep 16 21:12 .\ndrwxrwsr-x. 5 jovyan users 4096 Sep 16 20:43 ..\n-rw-rw-r--. 1 jovyan users 2343 Sep 16 21:12 config.yaml\n-rw-rw-r--. 1 jovyan users  769 Sep 16 21:12 output.log\n-rw-rw-r--. 1 jovyan users 5298 Sep 16 20:43 requirements.txt\n-rw-rw-r--. 1 jovyan users 1036 Sep 16 20:43 wandb-metadata.json\n-rw-rw-r--. 1 jovyan users  280 Sep 16 21:12 wandb-summary.json",
