              "command": "/home/jovyan/envs/surya_WS/bin/python - <<'EOF'\nimport json\nnb=json.load(open('1_baseline_template_diego.ipynb'))\nfor i,c in enumerate(nb['cells']):\n    src=''.join(c['source'])\n    if not src.strip(): continue\n    print(f\"--- cell {i} [{c['cell_type']}] exec={c.get('execution_count')}\")\n    print(src)\n    print()\nEOF",
