            "title": "cd surya_workshop2026 && timeout 900 python - <<'EOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\\|^\\[LoRA\\] \" | tail -50 import os, time, torch, sys sys.path.insert(0,\".\") from downstream_apps.test.configs import load_wave_config from workshop_infrastructure.models.finetune_models import HelioSpectformer1D from workshop_infrastructure.utils import load_pretrained_weights, apply_peft_lora cfg = load_wave_config(\"downstream_apps/test/configs/config_script.yaml\") cfg.model.time_embedding.time_dim = 2 # correct: matches 26-ch ckpt cfg.model.lora_config.target_modules = [\"fc1\",\"fc2\",\"attn.qkv\",\"attn.proj\"] # correct targets t0=time.time() model = HelioSpectformer1D.from_config(cfg.model, num_outputs=1) load_pretrained_weights(model, cfg.model.pretrained_path) model = apply_peft_lora(model, cfg.model.lora_config) print(f\"[build+load+lora] {time.time()-t0:.1f}s\") model = model.cuda().train() opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4) def probe(B, steps=3): torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats() try: ts = torch.randn(B,13,2,4096,4096, device=\"cuda\") dt = torch.zeros(B,2, device=\"cuda\") tgt = torch.randint(0,2,(B,1),device=\"cuda\").float() ts_gb = ts.numel()*4/1e9 times=[] for i in range(steps): torch.cuda.synchronize(); s=time.time() with torch.autocast(\"cuda\", dtype=torch.bfloat16): out = model({\"ts\":ts,\"time_delta_input\":dt}) loss = torch.nn.functional.binary_cross_entropy_with_logits( out.reshape(-1).float(), tgt.reshape(-1)) loss.backward(); opt.step(); opt.zero_grad(set_to_none=True) torch.cuda.synchronize(); times.append(time.time()-s) pk_a = torch.cuda.max_memory_allocated()/1e9 pk_r = torch.cuda.max_memory_reserved()/1e9 st = min(times[1:]) if len(times)>1 else times[0] print(f\" B={B}: input {ts_gb:.2f}GB | peak alloc {pk_a:.1f}GB reserved {pk_r:.1f}GB \" f\"| {st:.2f}s/step = {st/B:.2f}s/sample | steps {[round(t,2) for t in times]}\") del ts,dt,tgt,out,loss return st except torch.cuda.OutOfMemoryError as e: print(f\" B={B}: *** CUDA OOM ***\") opt.zero_grad(set_to_none=True); torch.cuda.empty_cache() return None print(f\"\\n=== VRAM total {torch.cuda.get_device_properties(0).total_memory/1e9:.1f} GB ===\") for B in (1,2,4,6): if probe(B) is None: break EOF",
            "tool_call_id": "toolu_bdrk_01F18JtQLdWtoQEBEfeEaLA6",
            "raw_output": "Loading pretrained weights from /home/jovyan/surya_workshop2026/downstream_apps/test/assets/surya.366m.v1.pt.\nLoaded 157 / 159 pretrained weights.\nApplying PEFT LoRA: r=8, alpha=8, dropout=0.1, modules=['fc1', 'fc2', 'attn.qkv', 'attn.proj']\n[LoRA] Adapted modules (36):\n[LoRA] Trainable head modules (modules_to_save): ['head_cls_token', 'head_linear', 'head_unembed']\ntrainable params: 3,157,761 || all params: 366,726,914 || trainable%: 0.86%\n[build+load+lora] 4.3s\n\n=== VRAM total 47.7 GB ===\n  B=1: input 1.74GB | peak alloc 17.5GB reserved 21.1GB | 3.05s/step = 3.05s/sample | steps [4.11, 3.05, 3.05]\n  B=2: input 3.49GB | peak alloc 33.4GB reserved 42.4GB | 6.23s/step = 3.12s/sample | steps [6.27, 6.23, 6.24]\n  B=4: *** CUDA OOM ***\nShell cwd was reset to /home/jovyan/surya_workshop2026/downstream_apps/test",
            "kind": "execute",
            "status": "completed",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && timeout 900 /home/jovyan/envs/surya_WS/bin/python - <<'EOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\\|^\\[LoRA\\]   \" | tail -50\nimport os, time, torch, sys\nsys.path.insert(0,\".\")\nfrom downstream_apps.test.configs import load_wave_config\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer1D\nfrom workshop_infrastructure.utils import load_pretrained_weights, apply_peft_lora\n\ncfg = load_wave_config(\"downstream_apps/test/configs/config_script.yaml\")\ncfg.model.time_embedding.time_dim = 2                       # correct: matches 26-ch ckpt\ncfg.model.lora_config.target_modules = [\"fc1\",\"fc2\",\"attn.qkv\",\"attn.proj\"]  # correct targets\n\nt0=time.time()\nmodel = HelioSpectformer1D.from_config(cfg.model, num_outputs=1)\nload_pretrained_weights(model, cfg.model.pretrained_path)\nmodel = apply_peft_lora(model, cfg.model.lora_config)\nprint(f\"[build+load+lora] {time.time()-t0:.1f}s\")\nmodel = model.cuda().train()\nopt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4)\n\ndef probe(B, steps=3):\n    torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n    try:\n        ts = torch.randn(B,13,2,4096,4096, device=\"cuda\")\n        dt = torch.zeros(B,2, device=\"cuda\")\n        tgt = torch.randint(0,2,(B,1),device=\"cuda\").float()\n        ts_gb = ts.numel()*4/1e9\n        times=[]\n        for i in range(steps):\n            torch.cuda.synchronize(); s=time.time()\n            with torch.autocast(\"cuda\", dtype=torch.bfloat16):\n                out = model({\"ts\":ts,\"time_delta_input\":dt})\n                loss = torch.nn.functional.binary_cross_entropy_with_logits(\n                    out.reshape(-1).float(), tgt.reshape(-1))\n            loss.backward(); opt.step(); opt.zero_grad(set_to_none=True)\n            torch.cuda.synchronize(); times.append(time.time()-s)\n        pk_a = torch.cuda.max_memory_allocated()/1e9\n        pk_r = torch.cuda.max_memory_reserved()/1e9\n        st = min(times[1:]) if len(times)>1 else times[0]\n        print(f\"  B={B}: input {ts_gb:.2f}GB | peak alloc {pk_a:.1f}GB reserved {pk_r:.1f}GB \"\n              f\"| {st:.2f}s/step = {st/B:.2f}s/sample | steps {[round(t,2) for t in times]}\")\n        del ts,dt,tgt,out,loss\n        return st\n    except torch.cuda.OutOfMemoryError as e:\n        print(f\"  B={B}: *** CUDA OOM ***\")\n        opt.zero_grad(set_to_none=True); torch.cuda.empty_cache()\n        return None\n\nprint(f\"\\n=== VRAM total {torch.cuda.get_device_properties(0).total_memory/1e9:.1f} GB ===\")\nfor B in (1,2,4,6):\n    if probe(B) is None: break\nEOF"
