            "raw_output": "47:from downstream_apps.template.lightning_modules.pl_simple_baseline import FlareLightningModule\n77:    parser.add_argument(\"--train_baseline\", action=\"store_true\",\n78:                        help=\"Train the simple linear baseline instead of HelioSpectformer.\")\n134:def build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n137:    ``scalers`` is only needed by the linear baseline, which consumes its inputs in\n148:    if train_baseline:\n150:        from downstream_apps.template.models.simple_baseline import (\n266:    # Fetch scalers, and the backbone weights unless we are training the baseline.\n267:    ensure_assets(cfg, which=[\"scalers\"] if args.train_baseline else [\"scalers\", \"weights\"])\n269:    # Built once and shared: the dataset normalizes with these, and the linear baseline\n274:    lit_model = build_model(cfg, scalers, train_baseline=args.train_baseline)",
