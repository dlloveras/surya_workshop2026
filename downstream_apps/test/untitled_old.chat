            "title": "python - <<'PY' from pathlib import Path p = Path(\"experiments/run_baseline_study.py\") s = p.read_text() # 1. Minibatch support, so the version_3 reproduction can use its actual batch size. old = ''' epochs: int, lr: float, weight_decay: float = 0.0, seed: int = 0, ) -> dict: \"\"\"Fit the linear readout and return its per-epoch history plus the best-epoch metrics. Full-batch Adam rather than the minibatch loop Lightning ran: on <=384 samples that is the same objective with less gradient noise, and it makes the learning curve a property of the data rather than of the batch schedule. ``version_3`` is reproduced with its own minibatch size separately (see ``reproduce_overfit``), so the diagnostic comparison is like-for-like. \"\"\"''' new = ''' epochs: int, lr: float, weight_decay: float = 0.0, seed: int = 0, batch_size: int | None = None, ) -> dict: \"\"\"Fit the linear readout and return its per-epoch history plus the best-epoch metrics. ``batch_size=None`` means full-batch gradient descent, which is the right default for the learning curve: on <=384 samples it optimizes the same objective with less gradient noise, so a change in the curve is a property of the data rather than of the batch schedule. Pass an explicit ``batch_size`` to reproduce a specific Lightning run, whose minibatch schedule is part of what produced its behaviour. \"\"\"''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' history = [] for epoch in range(epochs): model.train() opt.zero_grad() out = model(xt) loss = loss_fn(out, yt) loss.backward() opt.step() with torch.no_grad():''' new = ''' generator = torch.Generator().manual_seed(seed) history = [] for epoch in range(epochs): model.train() if batch_size is None: opt.zero_grad() out = model(xt) loss = loss_fn(out, yt) loss.backward() opt.step() else: order = torch.randperm(len(xt), generator=generator) for start in range(0, len(order), batch_size): sel = order[start: start + batch_size] opt.zero_grad() loss = loss_fn(model(xt[sel]), yt[sel]) loss.backward() opt.step() # Report the epoch's training loss over the whole set, so it is comparable with # the validation loss below rather than being the last minibatch's value. with torch.no_grad(): out = model(xt) loss = loss_fn(out, yt) with torch.no_grad():''' assert s.count(old) == 1 s = s.replace(old, new) # 2. Be exact about what the reproduction does and does not share with version_3. old = '''def reproduce_overfit(data, Xtr, ytr, Xva, yva, args) -> dict: \"\"\"Refit on the 10 samples ``max_samples: 10`` actually selects, and check the signature. ``waveDSDataset`` head-slices a frame sorted by ``ds_index``, so the cap gives the 10 chronologically earliest samples \u2014 the 5 earliest event pairs, all from mid-2010. The cached features are in that same order, so ``[:10]`` reproduces the selection exactly. \"\"\" order = np.argsort(data[\"index_train\"])[:10] fit = fit_logistic(Xtr[order], ytr[order], Xva, yva, epochs=15, lr=args.lr, seed=42)''' new = '''def reproduce_overfit(data, Xtr, ytr, Xva, yva, args) -> dict: \"\"\"Refit on 10 chronologically-earliest samples and test for the memorization signature. This reproduces version_3's *regime*, not its exact inputs, and the difference is worth being clear about. It matches: 10 training samples chosen the way ``max_samples: 10`` chooses them (``waveDSDataset`` head-slices a frame sorted by ``ds_index``, so the cap yields the earliest 5 event pairs rather than a sample), 16,385 parameters, lr=0.01, Adam, batch size 2, 15 epochs. It does not match: the 10 samples are the earliest of the seeded 384-sample subset rather than of all 1,210 matches, and validation is this study's 24-sample balanced split rather than version_3's 27-sample one at the looser 4-day tolerance. So the numbers will differ; what is being tested is whether the *signature* reappears \u2014 training loss collapsing while validation loss rises and validation AUROC stays exactly frozen, which together say the model memorized rather than miscalibrated. \"\"\" order = np.argsort(data[\"index_train\"])[:10] fit = fit_logistic(Xtr[order], ytr[order], Xva, yva, epochs=15, lr=args.lr, seed=42, batch_size=2)''' assert s.count(old) == 1 s = s.replace(old, new) # 3. Full-batch needs more steps than a minibatch epoch to converge; these are milliseconds. s = s.replace('p.add_argument(\"--epochs\", type=int, default=200,', 'p.add_argument(\"--epochs\", type=int, default=500,') s = s.replace('\"Full-batch gradient descent on <=384 samples, so \"\\n' ' \"these are cheap; the curve is read off the best epoch, not the last.\")', '\"Full-batch gradient descent on <=384 samples, so \"\\n' ' \"one epoch is one step and 500 of them are milliseconds. The curve \"\\n' ' \"is read off the best epoch, not the last, so overshooting is safe.\")') p.write_text(s) print(\"baseline study patched\") PY python -m py_compile experiments/run_baseline_study.py && echo \"compiles ok\"; tail -1 phase1_extract.log",
