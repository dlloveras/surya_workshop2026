              "command": "/home/jovyan/envs/surya_WS/bin/python - <<'PY'\n# Verify the disk mask against real data rather than trusting the plate scale arithmetic.\nimport numpy as np, sys\nsys.path.insert(0,'/home/jovyan/surya_workshop2026')\nfrom downstream_apps.test.experiments.wave_visibility_scan import disk_mask, DISK_FRACTION\nf = np.load('experiments/results/figure_arrays/20100612T0030_wave.npz')\nnow = f['now'].astype(np.float32)\nm = disk_mask(now.shape[0])\n# The disk is bright, the corners are near the floor. Compare inside/outside the mask.\nprint(f\"DISK_FRACTION={DISK_FRACTION}  mask covers {100*m.mean():.1f}% of the frame\")\nprint(f\"  median inside mask  {np.median(now[m]):.4f}\")\nprint(f\"  median outside mask {np.median(now[~m]):.4f}\")\n# Find the actual limb: radial profile of where brightness drops to 20% of disk median\nc = (now.shape[0]-1)/2\ny, x = np.ogrid[:now.shape[0], :now.shape[1]]\nr = np.sqrt((y-c)**2 + (x-c)**2)\ninner = np.median(now[r < 800])\nprof = [np.median(now[(r >= rr) & (r < rr+40)]) for rr in range(1400, 1800, 40)]\nedges = list(range(1400, 1800, 40))\nprint(\"  radial median (px -> value), disk median %.3f:\" % inner)\nfor rr, v in zip(edges, prof):\n    print(f\"    {rr:5d}  {v:.4f}  ({v/inner:.2f} of disk)  frac={rr/now.shape[0]:.3f}\")\nPY",
