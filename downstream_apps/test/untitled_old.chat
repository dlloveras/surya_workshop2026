              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"4_finetune_wave_1D.py\")\ns = p.read_text()\n\nold = '''    # The shape assertion needs a real batch, and reading one costs a sample's worth of\n    # I/O. Worth it: ts.shape[2] is the number of input timesteps, and getting it wrong is\n    # bug 1 \u2014 a silently random tokenizer.\n    wc.assert_batch_shape(\n        next(iter(val_loader)),\n        n_channels=len(cfg.data.channels),\n        n_timesteps=cfg.model.time_embedding.time_dim,\n        img_size=cfg.model.img_size,\n    )\n'''\nnew = '''    # The shape assertion needs a real batch. Read it through a throwaway single-process\n    # loader rather than `next(iter(val_loader))`: taking one batch from the real loader\n    # would spawn its 8 persistent workers and fill their prefetch queues, which at 1.74 GB\n    # a sample is ~28 GB of RAM committed before training has started. One sample from the\n    # local cache costs a second.\n    wc.assert_batch_shape(\n        next(iter(wc.build_wave_loader(\n            val_loader.dataset, batch_size=1, num_workers=0, prefetch_factor=None,\n            seed=cfg.seed, shuffle=False, drop_last=False,\n        ))),\n        n_channels=len(cfg.data.channels),\n        n_timesteps=cfg.model.time_embedding.time_dim,\n        img_size=cfg.model.img_size,\n    )\n'''\nassert s.count(old) == 1\ns = s.replace(old, new)\np.write_text(s)\nprint(\"patched\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile 4_finetune_wave_1D.py && echo ok; tail -1 /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/phase1_extract.log"
