pt `FlareDataConfig` lives in `workshop_infrastructure/configs.py`**\", \"**Everything except `WaveDataConfig` lives in `workshop_infrastructure/configs.py`**\", \"config table note\") replace_in(8, \"@dataclass\\nclass FlareDataConfig(DataConfig):\\n\" \" flare_index_path: str = \\\"\\\"\\n\" \" ds_time_column: str = \\\"start_time\\\"\\n\" \" ds_time_tolerance: str = \\\"4d\\\"\\n\" \" ds_match_direction: str = \\\"forward\\\"\\n\", \"@dataclass\\nclass WaveDataConfig(DataConfig):\\n\" \" wave_index_path: str = \\\"\\\"\\n\" \" ds_time_column: str = \\\"start_time\\\"\\n\" \" ds_time_tolerance: str = \\\"4d\\\"\\n\" \" ds_match_direction: str = \\\"forward\\\"\\n\" \" ds_class_column: str = \\\"\\\"\\n\", \"config subclass example\") print(json.dumps({\"stage\": \"cells 5-8 done\", \"fixes\": fixes})) p.write_text(json.dumps(nb, indent=1) + \"\\n\") PY",
