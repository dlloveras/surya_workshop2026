pin_memory=True,\n627-        drop_last=drop_last,\n628-    )\n629-    if num_workers > 0:\n630-        kwargs[\"multiprocessing_context\"] = \"spawn\"\n631-        kwargs[\"persistent_workers\"] = True\n632-        kwargs[\"worker_init_fn\"] = partial(_seed_worker, base_seed=seed)\n633-        if prefetch_factor is not None:\n634-            kwargs[\"prefetch_factor\"] = prefetch_factor\n635-\n636-    if shuffle:\n637-        generator = torch.Generator()\n638-        generator.manual_seed(seed)\n639-        kwargs[\"generator\"] = generator\n640-\n641-    return DataLoader(dataset, shuffle=shuffle, **kwargs)",
