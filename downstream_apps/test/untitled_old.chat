            "raw_input": {
              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"experiments/plot_task_1_1.py\")\ns = p.read_text()\n\nold = '''    pairs = {}\n    for path in sorted(arrays_dir.glob(\"*.npz\")):\n        stem = path.stem\n        event_key, _, label = stem.rpartition(\"_\")\n        if label not in (\"wave\",) and not stem.endswith(\"_no_wave\"):\n            continue\n        if stem.endswith(\"_no_wave\"):\n            event_key, label = stem[: -len(\"_no_wave\")], \"no_wave\"\n        else:\n            label = \"wave\"\n        pairs.setdefault(event_key, {})[label] = dict(np.load(path, allow_pickle=False))'''\nnew = '''    pairs = {}\n    for path in sorted(arrays_dir.glob(\"*.npz\")):\n        stem = path.stem\n        # Order matters: \"_wave\" is a suffix of \"_no_wave\", so test the longer one first.\n        for suffix, label in ((\"_no_wave\", \"no_wave\"), (\"_wave\", \"wave\")):\n            if stem.endswith(suffix):\n                event_key = stem[: -len(suffix)]\n                pairs.setdefault(event_key, {})[label] = dict(\n                    np.load(path, allow_pickle=False))\n                break'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''    import matplotlib\n    matplotlib.use(\"Agg\")\n    import matplotlib.pyplot as plt\n\n    pairs = load_pairs(Path(args.arrays_dir))'''\nnew = '''    import matplotlib\n    matplotlib.use(\"Agg\")\n    import matplotlib.pyplot as plt\n\n    # SunPy registers the instrument colour maps (\"sdoaia193\", ...) on import. Worth having:\n    # the AIA193 map is what a solar physicist reads without having to think about it. The\n    # frames are in signum-log space rather than DN, so the colour bar is labelled as such.\n    try:\n        import sunpy.visualization.colormaps  # noqa: F401\n    except Exception:\n        pass\n    intensity_cmap = \"sdoaia193\" if \"sdoaia193\" in plt.colormaps() else \"inferno\"\n\n    pairs = load_pairs(Path(args.arrays_dir))'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''            im = axes[row, 0].imshow(now, origin=\"lower\", cmap=\"sdoaia193\"\n                                     if \"sdoaia193\" in plt.colormaps() else \"inferno\",\n                                     vmin=vmin, vmax=vmax)'''\nnew = '''            im = axes[row, 0].imshow(now, origin=\"lower\", cmap=intensity_cmap,\n                                     vmin=vmin, vmax=vmax)'''\nassert s.count(old) == 1\ns = s.replace(old, new)\np.write_text(s)\nprint(\"plot_task_1_1 cleaned\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile experiments/plot_task_1_1.py && echo ok; grep -vE \"Warning|warn|^\\[LoRA\\]   \" /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/smoke_n8.log | tail -4",
