            "title": "cd surya_workshop2026 && PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True timeout 900 python - <<'EOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\\|^\\[LoRA\\] \" | tail -22 import torch,time,sys; sys.path.insert(0,\".\") from downstream_apps.test.configs import load_wave_config from workshop_infrastructure.models.finetune_models import HelioSpectformer1D from workshop_infrastructure.utils import load_pretrained_weights, apply_peft_lora cfg=load_wave_config(\"downstream_apps/test/configs/config_script.yaml\") cfg.model.time_embedding.time_dim=2 cfg.model.lora_config.target_modules=[\"fc1\",\"fc2\",\"attn.qkv\",\"attn.proj\"] cfg.model.penultimate_linear_layer=False # drop the redundant 1.64M-param layer m=HelioSpectformer1D.from_config(cfg.model,num_outputs=1) load_pretrained_weights(m,cfg.model.pretrained_path) m=apply_peft_lora(m,cfg.model.lora_config).cuda().train() opt=torch.optim.Adam([p for p in m.parameters() if p.requires_grad],lr=1e-4) def probe(B,dt_in): torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats() try: ts=torch.randn(B,13,2,4096,4096,device=\"cuda\",dtype=dt_in) d=torch.zeros(B,2,device=\"cuda\"); tg=torch.randint(0,2,(B,),device=\"cuda\").float() tt=[] for i in range(3): torch.cuda.synchronize(); s=time.time() with torch.autocast(\"cuda\",dtype=torch.bfloat16): o=m({\"ts\":ts,\"time_delta_input\":d}) l=torch.nn.functional.binary_cross_entropy_with_logits(o.reshape(-1).float(),tg) l.backward(); opt.step(); opt.zero_grad(set_to_none=True) torch.cuda.synchronize(); tt.append(time.time()-s) st=min(tt[1:]) print(f\" B={B} in={str(dt_in):14s}: {st:.2f}s/step {st/B:.2f}s/sample | peak {torch.cuda.max_memory_allocated()/1e9:.1f}GB alloc {torch.cuda.max_memory_reserved()/1e9:.1f}GB resv\") del ts,d,tg,o,l; return True except torch.cuda.OutOfMemoryError: print(f\" B={B} in={str(dt_in):14s}: OOM\"); opt.zero_grad(set_to_none=True); torch.cuda.empty_cache(); return False print(\"\\n=== with expandable_segments + penultimate_linear_layer=False ===\") for B in (1,2,3,4): probe(B, torch.float32) print() for B in (2,3,4): probe(B, torch.bfloat16) EOF",
            "raw_output": "Loading pretrained weights from /home/jovyan/surya_workshop2026/downstream_apps/test/assets/surya.366m.v1.pt.\nLoaded 157 / 159 pretrained weights.\nApplying PEFT LoRA: r=8, alpha=8, dropout=0.1, modules=['fc1', 'fc2', 'attn.qkv', 'attn.proj']\n[LoRA] Adapted modules (36):\n[LoRA] Trainable head modules (modules_to_save): ['head_cls_token', 'head_unembed']\ntrainable params: 1,518,081 || all params: 363,447,554 || trainable%: 0.42%\n\n=== with expandable_segments + penultimate_linear_layer=False ===\n  B=1 in=torch.float32 : 3.05s/step 3.05s/sample | peak 17.5GB alloc 18.0GB resv\n  B=2 in=torch.float32 : 6.22s/step 3.11s/sample | peak 33.4GB alloc 34.6GB resv\n  B=3 in=torch.float32 : OOM\n  B=4 in=torch.float32 : OOM\n\n  B=2 in=torch.bfloat16: 6.22s/step 3.11s/sample | peak 31.6GB alloc 32.8GB resv\n  B=3 in=torch.bfloat16: 10.76s/step 3.59s/sample | peak 46.5GB alloc 47.0GB resv\n  B=4 in=torch.bfloat16: OOM\n[W917 14:44:03.773513941 AllocatorConfig.cpp:28] Warning: PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead (function operator())\nShell cwd was reset to /home/jovyan/surya_workshop2026/downstream_apps/test",
            "status": "completed",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True timeout 900 /home/jovyan/envs/surya_WS/bin/python - <<'EOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\\|^\\[LoRA\\]   \" | tail -22\nimport torch,time,sys; sys.path.insert(0,\".\")\nfrom downstream_apps.test.configs import load_wave_config\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer1D\nfrom workshop_infrastructure.utils import load_pretrained_weights, apply_peft_lora\ncfg=load_wave_config(\"downstream_apps/test/configs/config_script.yaml\")\ncfg.model.time_embedding.time_dim=2\ncfg.model.lora_config.target_modules=[\"fc1\",\"fc2\",\"attn.qkv\",\"attn.proj\"]\ncfg.model.penultimate_linear_layer=False          # drop the redundant 1.64M-param layer\nm=HelioSpectformer1D.from_config(cfg.model,num_outputs=1)\nload_pretrained_weights(m,cfg.model.pretrained_path)\nm=apply_peft_lora(m,cfg.model.lora_config).cuda().train()\nopt=torch.optim.Adam([p for p in m.parameters() if p.requires_grad],lr=1e-4)\ndef probe(B,dt_in):\n    torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n    try:\n        ts=torch.randn(B,13,2,4096,4096,device=\"cuda\",dtype=dt_in)\n        d=torch.zeros(B,2,device=\"cuda\"); tg=torch.randint(0,2,(B,),device=\"cuda\").float()\n        tt=[]\n        for i in range(3):\n            torch.cuda.synchronize(); s=time.time()\n            with torch.autocast(\"cuda\",dtype=torch.bfloat16):\n                o=m({\"ts\":ts,\"time_delta_input\":d})\n                l=torch.nn.functional.binary_cross_entropy_with_logits(o.reshape(-1).float(),tg)\n            l.backward(); opt.step(); opt.zero_grad(set_to_none=True)\n            torch.cuda.synchronize(); tt.append(time.time()-s)\n        st=min(tt[1:])\n        print(f\"  B={B} in={str(dt_in):14s}: {st:.2f}s/step {st/B:.2f}s/sample | peak {torch.cuda.max_memory_allocated()/1e9:.1f}GB alloc {torch.cuda.max_memory_reserved()/1e9:.1f}GB resv\")\n        del ts,d,tg,o,l; return True\n    except torch.cuda.OutOfMemoryError:\n        print(f\"  B={B} in={str(dt_in):14s}: OOM\"); opt.zero_grad(set_to_none=True); torch.cuda.empty_cache(); return False\nprint(\"\\n=== with expandable_segments + penultimate_linear_layer=False ===\")\nfor B in (1,2,3,4): probe(B, torch.float32)\nprint()\nfor B in (2,3,4): probe(B, torch.bfloat16)\nEOF"
            },
            "kind": "execute"
          }
        ]
