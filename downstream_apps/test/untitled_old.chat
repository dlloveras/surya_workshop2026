            "title": "cd surya_workshop2026 && python - <<'PY' import pandas as pd, numpy as np cat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\", usecols=[\"start_time\",\"mid_time\",\"class\",\"AR\",\"Date\"]) cat[\"ds_index\"]=pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\") cat=cat.sort_values(\"ds_index\") for sp in [\"train\",\"val\",\"test\"]: idx=pd.read_csv(f\"data/indices/surya_aws_s3_{sp}.csv\") idx=idx[idx[\"present\"]==1] ts=pd.to_datetime(idx[\"timestep\"]).values.astype(\"datetime64[ns]\") tset=set(ts) dt=np.timedelta64(-12,\"m\") valid=[t for t in np.sort(ts) if (t+dt) in tset] dfv=pd.DataFrame({\"valid_indices\":valid}).sort_values(\"valid_indices\") m=pd.merge_asof(dfv,cat,right_on=\"ds_index\",left_on=\"valid_indices\",direction=\"forward\") m[\"index_delta\"]=np.abs(m[\"valid_indices\"]-m[\"ds_index\"]) m=m.sort_values([\"ds_index\",\"index_delta\"]).drop_duplicates(subset=\"ds_index\",keep=\"first\") m=m[m[\"index_delta\"]<=pd.Timedelta(\"4d\")] print(f\"== {sp}: valid_indices={len(valid)} matched samples={len(m)} classes={m['class'].value_counts().to_dict()}\") d=m[\"index_delta\"] print(\" delta: <=12min:\",int((d<=pd.Timedelta('12min')).sum()), \" 12min-1h:\",int(((d>pd.Timedelta('12min'))&(d<=pd.Timedelta('1h'))).sum()), \" 1h-1d:\",int(((d>pd.Timedelta('1h'))&(d<=pd.Timedelta('1d'))).sum()), \" >1d:\",int((d>pd.Timedelta('1d')).sum()), \" max:\",str(d.max())) bad=m[d>pd.Timedelta('1h')] if len(bad): print(bad[[\"valid_indices\",\"ds_index\",\"class\",\"index_delta\"]].head(10).to_string()) PY",
