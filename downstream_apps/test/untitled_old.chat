'''\nassert s.count(old) == 1\ns = s.replace(old, new)\np.write_text(s)\nprint(\"  ok  probe writes no checkpoints\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile 4_finetune_wave_1D.py && bash -n experiments/run_surya_schedule.sh && echo \"compiles ok\""
