            "raw_output": "    def transform_data(self, data: np.ndarray) -> np.ndarray:\n        \"\"\"Apply spatial pooling (if configured) then signum-log normalization.\n\n        Args:\n            data: Raw channel array of shape (C, H, W).\n\n        Returns:\n            Normalized array of shape (C, H//pooling, W//pooling). See the module-level\n            comment for the signum-log math and the ``inverse_transform_data`` method\n            to reverse the normalization.\n        \"\"\"\n        assert data.ndim == 3\n        if self.pooling > 1:\n            data = skimage.measure.block_reduce(data, block_size=(1, self.pooling, self.pooling), func=np.mean)\n        return transform(data, self._means, self._stds, self._sl_scale_factors, self._epsilons)\n\n    def inverse_transform_data(self, data: np.ndarray) -> np.ndarray:\n        \"\"\"Invert signum-log normalization on a (C, H, W) array.\n\n        Note: this only inverts the *normalization*, not spatial pooling.\n        Pooling (applied in ``transform_data``) is not invertible.\n        \"\"\"\n        assert data.ndim == 3\n        return fast_inverse_transform(data, self._means, self._stds, self._sl_scale_factors, self._epsilons)\n=== transform ===\n213:def transform(\n214-    data: np.ndarray,\n215-    means: np.ndarray,\n216-    stds: np.ndarray,\n217-    sl_scale_factors: np.ndarray,\n218-    epsilons: np.ndarray,\n219-) -> np.ndarray:\n220-    \"\"\"Signum-log normalization, pure NumPy. Drop-in replacement for ``fast_transform``.\n221-\n222-    Safe to use with DataLoader workers on any platform. See the module-level comment\n223-    for the mathematical definition.\n224-\n225-    Args:\n226-        data: NumPy array of shape (C, H, W).\n227-        means: Per-channel means, shape (C,).\n228-        stds: Per-channel standard deviations, shape (C,).\n229-        sl_scale_factors: Per-channel amplitude scaling factors, shape (C,).\n230-        epsilons: Per-channel small constants that prevent division by zero, shape (C,).\n231-\n232-    Returns:\n233-        Normalized array of shape (C, H, W).\n234-    \"\"\"\n235-    means = means.reshape(*means.shape, 1, 1)\n236-    stds = stds.reshape(*stds.shape, 1, 1)\n237-    sl_scale_factors = sl_scale_factors.reshape(*sl_scale_factors.shape, 1, 1)\n238-    epsilons = epsilons.reshape(*epsilons.shape, 1, 1)\n239-\n240-    data = data * sl_scale_factors\n241-    data = np.sign(data) * np.log1p(np.abs(data))\n242-    data = (data - means) / (stds + epsilons)\n243-    return data\nShell cwd was reset to /home/jovyan/surya_workshop2026/downstream_apps/test",
