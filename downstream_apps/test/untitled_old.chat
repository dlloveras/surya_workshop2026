ormalization added\") PY python -c \" import sys; sys.path.insert(0,'/home/jovyan/surya_workshop2026') import importlib.util as u spec = u.spec_from_file_location('ft','/home/jovyan/surya_workshop2026/downstream_apps/test/4_finetune_wave_1D.py') m = u.module_from_spec(spec); spec.loader.exec_module(m) for v in ['01:50:00','00:04:40:00','25:00','00:25:00',None]: print(f'{v!r:16} -> {m.normalize_max_time(v)!r}') try: m.normalize_max_time('bogus') except ValueError as e: print('bogus ->', e) \" 2>&1 | grep -v Warning"
