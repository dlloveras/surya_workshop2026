      "raw_time": false,
      "metadata": {
        "tool_calls": [
          {
            "status": "failed",
            "title": "mcp__Jupyter_MCP_Server__read_notebook_cells",
            "raw_output": "Error calling tool 'read_notebook_cells': [Errno 2] No such file or directory: '/home/jovyan/downstream_apps/test/1_baseline_template_diego.ipynb'",
            "kind": "other",
