              "command": "python - <<'PY'\nimport json\nfrom pathlib import Path\n\np = Path(\"2_finetune_template_1D_diego.ipynb\")\nnb = json.loads(p.read_text())\ncells = nb[\"cells\"]\nfixes = 0\n\ndef replace_in(i, old, new, label):\n    global fixes\n    src = \"\".join(cells[i][\"source\"])\n    assert old in src, f\"[{i}] {label}: pattern not found:\\n{old[:120]}\"\n    src = src.replace(old, new)\n    cells[i][\"source\"] = src.splitlines(keepends=True)\n    fixes += 1\n    print(f\"  ok  [{i}] {label}\")\n\n# --- Cell 5: the loader's name ------------------------------------------------\nreplace_in(5,\n    \"# The config is the single source of truth. load_flare_config() parses it into a typed\\n\"\n    \"# object, exactly as the training script 3_finetune_template_1D.py does, so the same YAML\\n\"\n    \"# behaves identically here and in production. Notebook 0 walks through what it contains.\",\n    \"# The config is the single source of truth. load_wave_config() parses it into a typed\\n\"\n    \"# object, exactly as the training script 4_finetune_wave_1D.py does, so the same YAML\\n\"\n    \"# behaves identically here and in production. Notebook 0 walks through what it contains.\",\n    \"load_wave_config comment\")\n\n# --- Cell 8: the typed-config markdown still describes the flare template -----\nreplace_in(8,\n    \"`load_flare_config()` reads `configs/config_script.yaml` and returns a typed `TrainingConfig`.\\n\"\n    \"This notebook and `3_finetune_template_1D.py` call the same function on the same file, so\\n\"\n    \"there is no notebook-versus-script divergence to reason about.\",\n    \"`load_wave_config()` reads `configs/config_script.yaml` and returns a typed `TrainingConfig`.\\n\"\n    \"This notebook and `4_finetune_wave_1D.py` call the same function on the same file, so\\n\"\n    \"there is no notebook-versus-script divergence to reason about.\",\n    \"typed-config intro\")\nreplace_in(8,\n    \"| `data:` | `cfg.data.*` | `FlareDataConfig` (this app) |\",\n    \"| `data:` | `cfg.data.*` | `WaveDataConfig` (this app) |\",\n    \"config table row\")\nreplace_in(8,\n    \"**Everything except `FlareDataConfig` lives in `workshop_infrastructure/configs.py`**\",\n    \"**Everything except `WaveDataConfig` lives in `workshop_infrastructure/configs.py`**\",\n    \"config table note\")\nreplace_in(8,\n    \"@dataclass\\nclass FlareDataConfig(DataConfig):\\n\"\n    \"    flare_index_path: str = \\\"\\\"\\n\"\n    \"    ds_time_column: str = \\\"start_time\\\"\\n\"\n    \"    ds_time_tolerance: str = \\\"4d\\\"\\n\"\n    \"    ds_match_direction: str = \\\"forward\\\"\\n\",\n    \"@dataclass\\nclass WaveDataConfig(DataConfig):\\n\"\n    \"    wave_index_path: str = \\\"\\\"\\n\"\n    \"    ds_time_column: str = \\\"start_time\\\"\\n\"\n    \"    ds_time_tolerance: str = \\\"4d\\\"\\n\"\n    \"    ds_match_direction: str = \\\"forward\\\"\\n\"\n    \"    ds_class_column: str = \\\"\\\"\\n\",\n    \"config subclass example\")\n\nprint(json.dumps({\"stage\": \"cells 5-8 done\", \"fixes\": fixes}))\np.write_text(json.dumps(nb, indent=1) + \"\\n\")\nPY",
