              "command": "python3 -c \"\nimport pandas as pd\np='/home/jovyan/surya_workshop2026/downstream_apps/test/data/lcpf_aia_waves.csv'\nd=pd.read_csv(p, low_memory=False)\nd['st']=pd.to_datetime(d['start_time']); d['mt']=pd.to_datetime(d['mid_time'])\nprint('rows per start_time value_counts:'); print(d['st'].value_counts().value_counts())\nprint()\ng=d.groupby('class')\nfor k,v in g:\n    dt=(v['mt']-v['st'])\n    print('class=',k,'n=',len(v))\n    print('  (mid-start) describe:'); print(dt.describe())\n    print('  unique offsets (top 10):'); print(dt.value_counts().head(10))\n    print('  mid_time min/max:', v['mt'].min(), v['mt'].max())\n    print('  start_time min/max:', v['st'].min(), v['st'].max())\nprint()\nprint('--- first 6 rows, key cols only ---')\nprint(d[['Date','Time','GOES','Location','AR','start_time','mid_time','class']].head(8).to_string())\n\"\n",
