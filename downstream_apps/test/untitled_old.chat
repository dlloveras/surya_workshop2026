            "title": "cd surya_workshop2026 && python - <<'PY' import pandas as pd, numpy as np cat = pd.read_csv('downstream_apps/test/data/lcpf_aia_waves.csv', usecols=['start_time','mid_time','class']) cat['ds_index'] = pd.to_datetime(cat['mid_time']).values.astype('datetime64[ns]') cat = cat.sort_values('ds_index') cat['label'] = (cat['class'] == 'wave').astype(float) offsets = [np.timedelta64(-12,'m'), np.timedelta64(0,'m')] for split in ['train','val','test']: idx = pd.read_csv(f'data/indices/surya_aws_s3_{split}.csv', usecols=['timestep','present']) idx = idx[idx['present']==1] ts = pd.to_datetime(idx['timestep']).values.astype('datetime64[ns]') tset = set(ts) valid = np.array(sorted(t for t in ts if all(t+d in tset for d in offsets))) dfv = pd.DataFrame({'valid_indices': valid}).sort_values('valid_indices') m = pd.merge_asof(dfv, cat, right_on='ds_index', left_on='valid_indices', direction='forward') m['index_delta'] = (m['valid_indices'] - m['ds_index']).abs() m = m.sort_values(['ds_index','index_delta']).drop_duplicates(subset='ds_index', keep='first') for tol in ['4d','15min']: mm = m[m['index_delta'] <= pd.Timedelta(tol)] vc = mm['class'].value_counts().to_dict() print(f'{split:5s} tol={tol:6s} n={len(mm):5d} {vc} events={mm.start_time.nunique()}') # loosest matches mm4 = m[m['index_delta'] <= pd.Timedelta('4d')] loose = mm4.nlargest(10,'index_delta')[['index_delta','class']] print(f' loosest10 {split}:', loose['class'].value_counts().to_dict(), 'max', mm4['index_delta'].max(), '| frac<=15min', f\"{(mm4['index_delta']<=pd.Timedelta('15min')).mean():.4f}\") PY",
            "tool_call_id": "toolu_bdrk_01RMq1uDRWQbEXT1BZZbGdq5",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && python - <<'PY'\nimport pandas as pd, numpy as np\n\ncat = pd.read_csv('downstream_apps/test/data/lcpf_aia_waves.csv',\n                  usecols=['start_time','mid_time','class'])\ncat['ds_index'] = pd.to_datetime(cat['mid_time']).values.astype('datetime64[ns]')\ncat = cat.sort_values('ds_index')\ncat['label'] = (cat['class'] == 'wave').astype(float)\n\noffsets = [np.timedelta64(-12,'m'), np.timedelta64(0,'m')]\n\nfor split in ['train','val','test']:\n    idx = pd.read_csv(f'data/indices/surya_aws_s3_{split}.csv', usecols=['timestep','present'])\n    idx = idx[idx['present']==1]\n    ts = pd.to_datetime(idx['timestep']).values.astype('datetime64[ns]')\n    tset = set(ts)\n    valid = np.array(sorted(t for t in ts if all(t+d in tset for d in offsets)))\n    dfv = pd.DataFrame({'valid_indices': valid}).sort_values('valid_indices')\n    m = pd.merge_asof(dfv, cat, right_on='ds_index', left_on='valid_indices', direction='forward')\n    m['index_delta'] = (m['valid_indices'] - m['ds_index']).abs()\n    m = m.sort_values(['ds_index','index_delta']).drop_duplicates(subset='ds_index', keep='first')\n    for tol in ['4d','15min']:\n        mm = m[m['index_delta'] <= pd.Timedelta(tol)]\n        vc = mm['class'].value_counts().to_dict()\n        print(f'{split:5s} tol={tol:6s} n={len(mm):5d}  {vc}  events={mm.start_time.nunique()}')\n    # loosest matches\n    mm4 = m[m['index_delta'] <= pd.Timedelta('4d')]\n    loose = mm4.nlargest(10,'index_delta')[['index_delta','class']]\n    print(f'   loosest10 {split}:', loose['class'].value_counts().to_dict(),\n          'max', mm4['index_delta'].max(), '| frac<=15min',\n          f\"{(mm4['index_delta']<=pd.Timedelta('15min')).mean():.4f}\")\nPY",
              "description": "Verify match counts across splits and tolerances"
            },
            "status": "completed"
