            "raw_output": "8:- ``RandomChannelMaskerTransform`` \u2014 callable that randomly zeros input channels to\n21:import random\n71:def _resolve_s3_mode(s3_mode, s3_download_to_temp, s3_use_simplecache) -> str:\n183:def fast_inverse_transform(data, means, stds, sl_scale_factors, epsilons):\n213:def transform(\n246:def inverse_transform_single_channel(data, mean, std, sl_scale_factor, epsilon):\n279:        num_mask_aia_channels: Number of AIA channels to randomly zero-out per sample.\n280:        phase: Dataset phase (e.g., ``\"train\"``). Included for future phase-specific logic.\n284:    def __init__(self, num_channels, num_mask_aia_channels, phase, drop_hmi_probability):\n289:    def __call__(self, input_tensor):\n290:        \"\"\"Apply random channel masking to a (C, T, H, W) image stack.\n292:        Zeros out ``num_mask_aia_channels`` randomly chosen channels uniformly across all\n304:        channels_to_mask = random.sample(range(C), self.num_mask_aia_channels)\n309:        if self.drop_hmi_probability > random.random():\n342:            randomly per call to ``__getitem__``.\n354:        num_mask_aia_channels: Number of AIA channels to randomly mask during training.\n358:        phase: Dataset phase label (e.g., ``\"train\"``, ``\"val\"``).\n360:        random_vert_flip: If True, randomly flip images vertically during training.\n367:              need random seeks that streaming cannot always serve.\n371:              ``\"download\"`` on a full SDO frame) because random access turns into many\n396:    def __init__(\n408:        phase: str = \"train\",\n410:        random_vert_flip: bool = False,\n426:        self.phase = phase\n433:        self.random_vert_flip = random_vert_flip\n471:        self.masker = RandomChannelMaskerTransform(\n474:            phase=self.phase,\n526:    def _filter_valid_indices(self) -> list:\n546:    def _ensure_logger(self):\n556:            name=f\"{timestamp}_{self.rank:>03}_data_{self.phase}_{pid}\",\n563:    def __len__(self) -> int:\n567:    def __getitem__(self, idx: int) -> dict:\n593:    def _load_and_stack_frames(self, timesteps) -> np.ndarray:\n608:    def _get_index_data(self, idx: int) -> dict:\n611:        Samples historical input frames randomly from ``time_delta_input_minutes``,\n612:        applies channel masking and optional vertical flip, then assembles the sample\n619:        # randomly from the earlier offsets, giving the model varied historical context\n622:            sorted(random.sample(self.time_delta_input_minutes[:-1], self.n_input_timestamps - 1))\n629:            stacked_inputs = self.masker(stacked_inputs)\n650:        if self.random_vert_flip and torch.bernoulli(torch.ones(()) / 2) == 1:\n651:            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n653:                sample[\"forecast\"] = np.flip(sample[\"forecast\"], axis=-2).copy()\n668:    def load_nc_data(self, filepath: str, timestep: pd.Timestamp, channels: list[str]) -> np.ndarray:\n696:    def _load_s3_nc_data(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n737:    def _read_s3_via_download(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n771:    def _is_s3_path(self, path: str) -> bool:\n776:    def _suggested_cache_dir() -> str:\n784:    def _require_s3_cache_dir(self) -> None:\n794:    def _validate_s3_cache_dir(self, index_path: str) -> None:\n829:            \"(not recommended for NetCDF/HDF5 \u2014 it requires random seeks).\"\n832:    def _get_s3fs(self):\n840:    def _s3_cache_path(self, s3_uri: str) -> str:\n853:    def _download_s3_object(self, s3_uri: str, local_path: str) -> None:\n896:    def transform_data(self, data: np.ndarray) -> np.ndarray:\n912:    def inverse_transform_data(self, data: np.ndarray) -> np.ndarray:",
