            "raw_output": "16:    def transform(self, data: xr.DataArray):\n20:    def inverse_transform(self, data: xr.DataArray):\n79:    def transform(self, data: xr.DataArray) -> xr.DataArray:\n90:    def inverse_transform(self, data):\n129:class StandardScaler(Transformation):\n135:        self.epsilon = epsilon\n141:        self._sl_scale_factor = None\n160:    def sl_scale_factor(self) -> float:\n161:        return self._sl_scale_factor\n180:        return (data - self.mean) / (self.std + self.epsilon)\n183:        data = data * self.sl_scale_factor\n187:        assert self.mean is not None and self.std is not None, \"You must run fit first.\"\n193:    def transform(self, data: xr.DataArray):\n194:        assert self.mean is not None and self.std is not None, \"You must run fit first.\"\n203:    def inverse_transform(self, data):\n206:                torch.Tensor([self.std]).to(data.device)\n207:                + torch.Tensor([self.epsilon]).to(data.device)\n208:            ) + torch.Tensor([self.mean]).to(data.device)\n210:            return data * (self.std + self.epsilon) + self.mean\n217:                / torch.Tensor([self.sl_scale_factor]).to(data.device)\n220:            return np.sign(data) * np.expm1(np.abs(data)) / self.sl_scale_factor\n226:            \"epsilon\": str(self.epsilon),\n227:            \"mean\": str(self.mean),\n228:            \"std\": str(self.std),\n232:            \"sl_scale_factor\": str(self.sl_scale_factor),\nShell cwd was reset to /home/jovyan/surya_workshop2026/downstream_apps/test",
