            "raw_output": "0_dataset_dataloader_template.ipynb\n0_dataset_dataloader_template_diego.ipynb\n1_baseline_template.ipynb\n1_baseline_template_diego.ipynb\n2_finetune_template_1D.ipynb\n2_finetune_template_1D_diego.ipynb\n3_finetune_template_1D.py\n4_finetune_wave_1D.py\nADAPTING.md\nA_shapes_and_broadcasting.ipynb\n__pycache__\nassets\nconfigs\nconfigs.py\ndata\ndatasets\ndownload_scalers.sh\ndownload_scalers_and_weights.sh\nexperiments\nlightning_modules\nlogs\nmetrics\nmodels\nruns\nuntitled.chat\nuntitled_old.chat\nwandb\n---\n__init__.py\n__pycache__\nbuilders.py\nhelio.py\ntransformations.py",
