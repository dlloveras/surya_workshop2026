ttps://aia.lmsal.com/aia_euvi/20100504_0620_aia0193_euvib195_bdiff_euvi/AIA0193_EUVIB195_BDIFF_EUVI_20100504_0620.html,https://aia.lmsal.com/aia_euvi/20100504_0620_aia0193_euvia195_euvi/AIA0193_EUVIA195_EUVI_20100504_0620.html,https://aia.lmsal.com/aia_euvi/20100504_0620_aia0193_euvia195_rdiff_euvi/AIA0193_EUVIA195_RDIFF_EUVI_20100504_0620.html,https://aia.lmsal.com/aia_euvi/20100504_0620_aia0193_euvia195_bdiff_euvi/AIA0193_EUVIA195_BDIFF_EUVI_20100504_0620.html,2010-05-04T06:30:00,2010-05-04T07:00:00,wave",
