            "raw_output": "130\t        ds_match_direction=cfg.data.ds_match_direction,\n131\t    )\n132\t\n133\t\n134\tdef build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n135\t    \"\"\"Instantiate the model and wrap it in a LightningModule.\n136\t\n137\t    ``scalers`` is only needed by the linear baseline, which consumes its inputs in\n138\t    signum-log space; the HelioSpectformer path works directly on normalized inputs.\n139\t    \"\"\"\n140\t    metrics = {\n141\t        \"train_loss\": FlareMetrics(\"train_loss\"),\n142\t        # val_loss is what ModelCheckpoint monitors; val_metrics are reported only.\n143\t        \"val_loss\": FlareMetrics(\"val_loss\"),\n144\t        \"train_metrics\": FlareMetrics(\"train_metrics\"),\n145\t        \"val_metrics\": FlareMetrics(\"val_metrics\"),\n146\t    }\n147\t\n148\t    if train_baseline:\n149\t        from functools import partial\n150\t        from downstream_apps.template.models.simple_baseline import (\n151\t            RegressionFlareModel,\n152\t            destandardize_channels,\n153\t        )\n154\t        n_input_timestamps = cfg.model.time_embedding.time_dim\n155\t        n_channels = len(cfg.data.channels)\n156\t        model = RegressionFlareModel(n_input_timestamps * n_channels)\n157\t        preprocess_fn = partial(destandardize_channels, channel_order=cfg.data.channels, scalers=scalers)\n158\t        return FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size, preprocess_fn=preprocess_fn)\n159\t    else:\n160\t        from workshop_infrastructure.models.finetune_models import HelioSpectformer1D\n161\t        model = HelioSpectformer1D.from_config(\n162\t            cfg.model,\n163\t            num_outputs=1,\n164\t            dtype=cfg.dtype,\n165\t            use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n166\t        )\n167\t        load_pretrained_weights(model, cfg.model.pretrained_path)\n168\t\n169\t        # Three fine-tuning regimes, selected from the model: section of the YAML:\n170\t        #   use_lora: true                        -> LoRA adapters (default)\n171\t        #   use_lora: false, freeze_backbone: true  -> linear probe (head only)\n172\t        #   use_lora: false, freeze_backbone: false -> full fine-tuning\n173\t        if cfg.model.freeze_backbone:\n174\t            for name, param in model.named_parameters():\n175\t                if name.startswith(\"backbone.\"):\n176\t                    param.requires_grad = False\n177\t        if cfg.model.use_lora:\n178\t            model = apply_peft_lora(model, cfg.model.lora_config)\n179\t\n180\t        _log_trainable_parameters(model)\n181\t\n182\t    return FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size)\n183\t\n184\t\n185\tdef _log_trainable_parameters(model) -> None:\n186\t    \"\"\"Print the trainable/total parameter counts, so the chosen regime is visible in the log.\"\"\"\n187\t    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n188\t    total = sum(p.numel() for p in model.parameters())\n189\t    pct = 100.0 * trainable / total if total else 0.0\n190\t    print(f\"[MODEL] Trainable parameters: {trainable:,} / {total:,} ({pct:.2f}%)\")\n191\t\n192\t\n193\tdef build_trainer(\n194\t    cfg: TrainingConfig,\n195\t    no_wandb: bool = False,\n196\t    max_epochs_override: int | None = None,\n197\t) -> Tuple[L.Trainer, ModelCheckpoint]:\n198\t    \"\"\"Configure loggers, callbacks, and the Lightning Trainer.\"\"\"\n199\t    max_epochs = max_epochs_override if max_epochs_override is not None else cfg.max_epochs"
          },
