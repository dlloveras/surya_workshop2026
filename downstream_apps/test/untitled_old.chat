            "raw_output": "############ /home/jovyan/surya_workshop2026/downstream_apps/test/wandb/wandb_tmp/wandb/run-20260916_140024-l6g73kau/\n--- wandb-summary.json ---\n{\"_runtime\":0,\"_wandb\":{\"runtime\":0}}\n############ /home/jovyan/surya_workshop2026/downstream_apps/test/wandb/wandb_tmp/wandb/run-20260916_142431-hqu41y5y/\n--- wandb-summary.json ---\n{\"_wandb\":{\"runtime\":0},\"_runtime\":0}\n############ /home/jovyan/surya_workshop2026/downstream_apps/test/wandb/wandb_tmp/wandb/run-20260916_143052-vab9n0kt/\n--- wandb-summary.json ---\n{\"_wandb\":{\"runtime\":0},\"_runtime\":0}\n############ /home/jovyan/surya_workshop2026/downstream_apps/test/wandb/wandb_tmp/wandb/run-20260916_144729-60d6k5b2/\n--- wandb-summary.json ---\n{\"trainer/global_step\":1,\"val_metric_accuracy\":0.5,\"val_loss_bce\":0.6931471824645996,\"_timestamp\":1.789571806569068e+09,\"_step\":14,\"train_loss\":0.695987343788147,\"_wandb\":{\"runtime\":1794},\"epoch\":0,\"train_loss_bce\":0.695987343788147,\"val_loss\":0.6931471824645996,\"train_metric_accuracy\":0,\"val_metric_auroc\":0.5,\"_runtime\":1794}\n--- config.yaml ---\n_wandb:\n    value:\n        cli_version: 0.23.1\n        e:\n            jt9irc6pmaq3r1x11qdpt4sme480gv2x:\n                cpu_count: 16\n                cpu_count_logical: 32\n                cudaVersion: \"13.0\"\n                disk:\n                    /:\n                        total: \"85819633664\"\n                        used: \"21030637568\"\n                email: lloverasdiego@gmail.com\n                executable: /home/jovyan/envs/surya_WS/bin/python\n                git:\n                    commit: 49f5eb7b0dd7fcb2263b395248469cb0ad1e51ba\n                    remote: https://github.com/dlloveras/surya_workshop2026.git\n                gpu: NVIDIA L40S\n                gpu_count: 1\n                gpu_nvidia:\n                    - architecture: Ada\n                      cudaCores: 18176\n                      memoryTotal: \"48305799168\"\n                      name: NVIDIA L40S\n                      uuid: GPU-6329be93-2349-33af-1c4e-8a0b6749582d\n                host: jupyter-dlloveras\n                memory:\n                    total: \"266693251072\"\n                os: Linux-6.12.103-127.188.amzn2023.x86_64-x86_64-with-glibc2.35\n                program: <python with no main file>\n                python: CPython 3.12.14\n                root: ./wandb/wandb_tmp\n                startedAt: \"2026-09-16T14:47:29.299227Z\"\n                writerId: jt9irc6pmaq3r1x11qdpt4sme480gv2x\n        m:\n            - \"1\": trainer/global_step\n              \"6\":\n                - 3\n              \"7\": []\n            - \"2\": '*'\n              \"5\": 1\n              \"6\":\n                - 1\n              \"7\": []\n        python_version: 3.12.14\n        t:\n            \"1\":\n                - 1\n                - 5\n                - 11\n                - 41\n                - 49\n                - 53\n                - 54\n                - 71\n                - 106\n            \"2\":\n                - 1\n                - 5\n                - 11\n                - 41\n                - 49\n                - 53\n                - 54\n                - 71\n                - 106\n            \"3\":\n                - 2\n                - 7\n                - 13\n                - 66\n            \"4\": 3.12.14\n            \"5\": 0.23.1\n            \"6\": 4.57.6\n            \"8\":\n                - 1\n            \"12\": 0.23.1\n            \"13\": linux-x86_64\n\n--- wandb-metadata.json ---\n{\n  \"os\":  \"Linux-6.12.103-127.188.amzn2023.x86_64-x86_64-with-glibc2.35\",\n  \"python\":  \"CPython 3.12.14\",\n  \"startedAt\":  \"2026-09-16T14:47:29.299227Z\",\n  \"program\":  \"<python with no main file>\",\n  \"git\":  {\n    \"remote\":  \"https://github.com/dlloveras/surya_workshop2026.git\",\n    \"commit\":  \"49f5eb7b0dd7fcb2263b395248469cb0ad1e51ba\"\n  },\n  \"email\":  \"llo