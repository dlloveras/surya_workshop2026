            "raw_input": {
              "description": "Wire cache planning into the trainer",
              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"4_finetune_wave_1D.py\")\ns = p.read_text()\n\nold = '''    # Pin only the validation frames: val is re-read every epoch, and 48 frames is ~28 GB\n    # against 77 GB of local disk. The train split is far too large to cache, so leaving it\n    # streaming is also what stops it evicting val.\n    n_pinned = wc.pin_frames(val_ds, extra_datasets=(train_ds, test_ds))\n    if n_pinned:\n        print(f\"[DATA] pinned {n_pinned} validation frames to {cfg.data.s3_cache_dir}\")\n'''\nnew = '''    # Decide what goes on fast local storage. The read path sustains ~175-420 MB/s from S3\n    # against ~3.1 s of GPU per sample, so a fully-streaming run is data-bound; local disk is\n    # 350 MB/s but there is only ~66 GB of it against a 481 GB working set. The budget goes\n    # to the validation split (re-read every epoch) and then to the smallest nested training\n    # subset, whose frames every larger run also reads. See plan_pinned_frames().\n    pinned, pin_report = wc.plan_pinned_frames(\n        val_ds, train_ds,\n        budget_gb=args.cache_budget_gb,\n        train_priority_n=args.cache_priority_n,\n        subset_seed=args.subset_seed,\n    )\n    n_pinned = wc.pin_frames(val_ds, extra_datasets=(train_ds, test_ds), uris=pinned)\n    if n_pinned:\n        print(f\"[DATA] pinned {n_pinned} frames (~{pin_report['estimated_gb']} GB) to \"\n              f\"{cfg.data.s3_cache_dir}: {pin_report['val_frames_pinned']}/\"\n              f\"{pin_report['val_frames_total']} val + \"\n              f\"{pin_report['train_frames_pinned']} train \"\n              f\"(priority N={pin_report['train_priority_n']})\")\n    stats[\"cache_plan\"] = pin_report\n'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\ns = s.replace(\n    '    p.add_argument(\"--disk-cache\", action=\"store_true\",\\n',\n    '    p.add_argument(\"--cache-budget-gb\", type=float, default=60.0,\\n'\n    '                   help=\"Bytes of fast local storage to spend on pinned frames. Must \"\\n'\n    '                        \"stay under the free space on data.s3_cache_dir\\'s filesystem.\")\\n'\n    '    p.add_argument(\"--cache-priority-n\", type=int, default=48,\\n'\n    '                   help=\"After the validation split, pin this nested training prefix. \"\\n'\n    '                        \"Because the event subsets are nested, frames pinned for N=48 \"\\n'\n    '                        \"are also read by every larger run. 0 disables train pinning.\")\\n'\n    '    p.add_argument(\"--disk-cache\", action=\"store_true\",\\n')\ns = s.replace(\n    \"        train_priority_n=args.cache_priority_n,\",\n    \"        train_priority_n=args.cache_priority_n or None,\")\np.write_text(s)\nprint(\"trainer patched\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile 4_finetune_wave_1D.py && echo \"compiles ok\"; grep -vE \"Warning|warn\" /tmp/bench_pattern.log"
