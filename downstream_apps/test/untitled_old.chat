            "status": "completed",
            "title": "cd surya_workshop2026 && python - <<'EOF' 2>&1 | tail -40 import pandas as pd, numpy as np, os, re, glob # --- cached frame timestamps --- cache = glob.glob(\"/home/jovyan/scratch_space/surya_cache/*.nc\") cts = set() for f in cache: m = re.search(r\"__(\\d{8})_(\\d{4})\\.nc$\", f) if m: cts.add(pd.Timestamp(f\"{m.group(1)[:4]}-{m.group(1)[4:6]}-{m.group(1)[6:]} {m.group(2)[:2]}:{m.group(2)[2:]}\")) print(f\"cache: {len(cache)} files -> {len(cts)} distinct timestamps\") cat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\") cat[\"ds_index\"] = pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\") cat = cat.sort_values(\"ds_index\") for split in (\"train\",\"val\",\"test\"): idx = pd.read_csv(f\"data/indices/surya_aws_s3_{split}.csv\") idx = idx[idx[\"present\"]==1] idx[\"timestep\"] = pd.to_datetime(idx[\"timestep\"]) have = set(idx[\"timestep\"]) # T=2 filter: need t-12min and t valid = sorted(t for t in have if (t - pd.Timedelta(\"12min\")) in have) dfv = pd.DataFrame({\"valid_indices\": valid}).sort_values(\"valid_indices\") m = pd.merge_asof(dfv, cat[[\"ds_index\",\"class\",\"start_time\"]], left_on=\"valid_indices\", right_on=\"ds_index\", direction=\"forward\") m[\"d\"] = (m[\"valid_indices\"]-m[\"ds_index\"]).abs() m = m.sort_values([\"ds_index\",\"d\"]).drop_duplicates(\"ds_index\", keep=\"first\") m = m[m[\"d\"] <= pd.Timedelta(\"4d\")].dropna(subset=[\"ds_index\"]) need = set(m[\"valid_indices\"]) | set(m[\"valid_indices\"]-pd.Timedelta(\"12min\")) hit = len(need & cts) print(f\"\\n{split:5s}: valid_idx(T=2)={len(valid):7d} matched={len(m):5d} \" f\"({(m['class']=='wave').sum()} wave / {(m['class']=='no wave').sum()} no-wave)\") print(f\" frames needed={len(need):5d} CACHED={hit:5d} ({100*hit/max(len(need),1):.1f}%) \" f\"to download={len(need)-hit:5d} (~{(len(need)-hit)*0.56:.0f} GB)\") EOF",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python - <<'EOF' 2>&1 | tail -40\nimport pandas as pd, numpy as np, os, re, glob\n\n# --- cached frame timestamps ---\ncache = glob.glob(\"/home/jovyan/scratch_space/surya_cache/*.nc\")\ncts = set()\nfor f in cache:\n    m = re.search(r\"__(\\d{8})_(\\d{4})\\.nc$\", f)\n    if m: cts.add(pd.Timestamp(f\"{m.group(1)[:4]}-{m.group(1)[4:6]}-{m.group(1)[6:]} {m.group(2)[:2]}:{m.group(2)[2:]}\"))\nprint(f\"cache: {len(cache)} files -> {len(cts)} distinct timestamps\")\n\ncat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\")\ncat[\"ds_index\"] = pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\")\ncat = cat.sort_values(\"ds_index\")\n\nfor split in (\"train\",\"val\",\"test\"):\n    idx = pd.read_csv(f\"data/indices/surya_aws_s3_{split}.csv\")\n    idx = idx[idx[\"present\"]==1]\n    idx[\"timestep\"] = pd.to_datetime(idx[\"timestep\"])\n    have = set(idx[\"timestep\"])\n    # T=2 filter: need t-12min and t\n    valid = sorted(t for t in have if (t - pd.Timedelta(\"12min\")) in have)\n    dfv = pd.DataFrame({\"valid_indices\": valid}).sort_values(\"valid_indices\")\n    m = pd.merge_asof(dfv, cat[[\"ds_index\",\"class\",\"start_time\"]], left_on=\"valid_indices\",\n                      right_on=\"ds_index\", direction=\"forward\")\n    m[\"d\"] = (m[\"valid_indices\"]-m[\"ds_index\"]).abs()\n    m = m.sort_values([\"ds_index\",\"d\"]).drop_duplicates(\"ds_index\", keep=\"first\")\n    m = m[m[\"d\"] <= pd.Timedelta(\"4d\")].dropna(subset=[\"ds_index\"])\n    need = set(m[\"valid_indices\"]) | set(m[\"valid_indices\"]-pd.Timedelta(\"12min\"))\n    hit = len(need & cts)\n    print(f\"\\n{split:5s}: valid_idx(T=2)={len(valid):7d}  matched={len(m):5d}  \"\n          f\"({(m['class']=='wave').sum()} wave / {(m['class']=='no wave').sum()} no-wave)\")\n    print(f\"        frames needed={len(need):5d}  CACHED={hit:5d} ({100*hit/max(len(need),1):.1f}%)  \"\n          f\"to download={len(need)-hit:5d}  (~{(len(need)-hit)*0.56:.0f} GB)\")\nEOF"
