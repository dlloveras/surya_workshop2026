              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python - <<'PY'\nimport pandas as pd, numpy as np\ncat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\")\ncat[\"start_time\"]=pd.to_datetime(cat[\"start_time\"]); cat[\"mid_time\"]=pd.to_datetime(cat[\"mid_time\"])\nprint(\"rows\", len(cat), cat[\"class\"].value_counts().to_dict())\ng = cat.groupby(\"start_time\")[\"class\"].agg(lambda s: tuple(sorted(s)))\nprint(\"pair signature counts:\", g.value_counts().to_dict())\n# day sets per split\ndays={}\nfor sp in [\"train\",\"val\",\"test\"]:\n    idx = pd.read_csv(f\"data/indices/surya_aws_s3_{sp}.csv\", usecols=[\"timestep\",\"present\"])\n    ts = pd.to_datetime(idx[\"timestep\"])\n    days[sp]=set(ts.dt.floor(\"D\").unique())\n    print(sp, \"n_rows\", len(idx), \"n_days\", len(days[sp]), \"present sum\", int(idx['present'].sum()))\ndef which(t):\n    d=np.datetime64(pd.Timestamp(t).floor(\"D\"))\n    out=[s for s in days if d in days[s]]\n    return out[0] if out else None\ncat[\"split\"]=cat[\"mid_time\"].map(which)\nprint(cat.groupby([\"split\",\"class\"]).size())\n# pairs straddling splits\npv = cat.pivot_table(index=\"start_time\", columns=\"class\", values=\"split\", aggfunc=\"first\")\npv = pv.dropna(how=\"all\")\nmismatch = pv[(pv[\"wave\"]!=pv[\"no wave\"])]\nprint(\"pairs whose two members land in DIFFERENT splits:\", len(mismatch))\nprint(mismatch.head(20))\nPY"
