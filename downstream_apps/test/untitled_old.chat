              "command": "/home/jovyan/envs/surya_WS/bin/python - <<'PY'\nimport numpy as np, sys\nsys.path.insert(0,'/home/jovyan/surya_workshop2026')\nfrom downstream_apps.test.experiments.wave_common import repool\nd = np.load('experiments/results/rd_features_val.npz', allow_pickle=False)\nX, y, ev, ix = d['X_val'], d['y_val'], d['event_val'], d['index_val']\nprint(\"Phase 1 verification on the val split\")\nprint(f\"  rows            {X.shape[0]}  (expect 24)\")\nprint(f\"  feature map     {X.shape[1:]}  cached at kernel 8 -> repool 4 -> {repool(X,4).shape[1:]}\")\nprint(f\"  label balance   {y.mean():.3f}  (expect 0.500);  counts {int(y.sum())}/{int((1-y).sum())}\")\nprint(f\"  finite          {np.isfinite(X).all()}\")\nprint(f\"  non-constant    {(X.std(axis=(1,2))>0).all()}  min std {X.std(axis=(1,2)).min():.5f}\")\nprint(f\"  events          {len(set(ev))} distinct, each with 2 samples: \"\n      f\"{all(list(ev).count(e)==2 for e in set(ev))}\")\nprint(f\"  chronological   {list(ix)==sorted(ix)}\")\n# every event must contribute exactly one wave and one no-wave\nimport collections\nper = collections.defaultdict(list)\nfor e, lab in zip(ev, y): per[e].append(lab)\nprint(f\"  matched pairs   {all(sorted(v)==[0.0,1.0] for v in per.values())}\")\nPY",
