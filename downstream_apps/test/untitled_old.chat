      "metadata": {
        "tool_calls": [
          {
            "raw_output": "compiles ok\n--- smoke ---\n    \"n_negative\": 24,\n    \"n_dropped_unpaired\": 2,\n    \"n_events_available\": 24\n  },\n  \"pool_kernel\": 8,\n  \"subset_seed\": 42,\n  \"ds_time_tolerance\": \"15min\"\n}",
            "kind": "execute",
