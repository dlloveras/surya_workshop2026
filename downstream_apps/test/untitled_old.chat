          {
            "raw_output": "1\t\"\"\"\n2\tPyTorch dataset for SDO (Solar Dynamics Observatory) NetCDF files.\n3\t\n4\tThis module provides:\n5\t- ``HelioNetCDFDataset`` \u2014 the base dataset class used by all Surya downstream tasks.\n6\t  Handles index loading, temporal frame sampling, signum-log normalization, channel\n7\t  masking, and transparent local/S3 file access.\n8\t- ``RandomChannelMaskerTransform`` \u2014 callable that randomly zeros input channels to\n9\t  improve robustness to missing observations.\n10\t- Signum-log transform functions (``transform``, ``fast_inverse_transform``,\n11\t  ``inverse_transform_single_channel``) used to normalize solar imagery before passing\n12\t  it to the model, and to undo that normalization for plotting or physical-space losses.\n13\t\n14\tWhen writing a downstream task, subclass ``HelioNetCDFDataset`` and override\n15\t``__getitem__`` to attach your task-specific labels to the sample dict returned by\n16\t``super().__getitem__()``.\n17\t\"\"\"\n18\t\n19\timport os\n20\timport re\n21\timport random\n22\timport hashlib\n23\timport warnings\n24\tfrom datetime import datetime\n25\tfrom uuid import uuid4\n26\timport torch\n27\timport numpy as np\n28\timport skimage.measure\n29\timport xarray as xr\n30\timport pandas as pd\n31\tfrom logging import Logger\n32\tfrom torch.utils.data import Dataset\n33\tfrom workshop_infrastructure.configs import VALID_S3_MODES\n34\tfrom workshop_infrastructure.utils import (\n35\t    get_rank,\n36\t    create_logger,\n37\t    detect_ec2_region,\n38\t    make_s3_client,\n39\t    parse_s3_uri,\n40\t)\n41\t\n42\t# Optional S3 support via fsspec/s3fs (read-through streaming)\n43\ttry:\n44\t    import fsspec\n45\t    import s3fs\n46\texcept Exception:  # pragma: no cover\n47\t    fsspec = None\n48\t    s3fs = None\n49\t\n50\t# Optional S3 support via boto3 (recommended: faster whole-object downloads).\n51\t# Client construction itself lives in workshop_infrastructure.utils.make_s3_client so\n52\t# the dataset and the S3 benchmark stay in sync.\n53\ttry:\n54\t    import boto3\n55\t    from boto3.s3.transfer import TransferConfig\n56\texcept Exception:  # pragma: no cover\n57\t    boto3 = None\n58\t    TransferConfig = None\n59\t\n60\tfrom numba import njit, prange\n61\t\n62\timport hdf5plugin  # noqa: F401  # side-effect import: registers HDF5 compression filters\n63\t\n64\t\n65\t# ---------------------------------------------------------------------------\n66\t# S3 access modes \u2014 the mode list itself lives in workshop_infrastructure.configs\n67\t# (VALID_S3_MODES) so the config layer can reject a bad value before any dataset\n68\t# is constructed.\n69\t# ---------------------------------------------------------------------------\n70\t\n71\tdef _resolve_s3_mode(s3_mode, s3_download_to_temp, s3_use_simplecache) -> str:\n72\t    \"\"\"Resolve the S3 access mode, honouring the deprecated boolean flags.\n73\t\n74\t    ``s3_download_to_temp`` and ``s3_use_simplecache`` are the legacy API. They were\n75\t    error-prone: ``s3_download_to_temp`` defaulted to True and short-circuited the\n76\t    dispatch, so setting ``s3_use_simplecache=True`` silently did nothing. They are\n77\t    still accepted (with a DeprecationWarning) so existing callers keep working.\n78\t    \"\"\"\n79\t    legacy_used = s3_download_to_temp is not None or s3_use_simplecache is not None\n80\t\n81\t    if legacy_used and s3_mode is not None:\n82\t        raise ValueError(\n83\t            \"Pass either s3_mode or the deprecated s3_download_to_temp/s3_use_simplecache \"\n84\t            f\"flags, not both (got s3_mode={s3_mode!r}, s3_download_to_temp=\"\n85\t            f\"{s3_download_to_temp!r}, s3_use_simplecache={s3_use_simplecache!r}).\"\n86\t        )\n87\t\n88\t    if legacy_used:\n89\t        # Reproduce the old precedence exactly: download_to_temp defaulted to True\n90\t        # and won over simplecache.\n91\t        download = True if s3_download_to_temp is None else bool(s3_download_to_temp)\n92\t        if download:\n93\t            resolved = \"download\"\n94\t        elif s3_use_simplecache:\n95\t            resolved = \"simplecache\"\n96\t        else:\n97\t            resolved = \"stream\"\n98\t        warnings.warn(\n99\t            \"s3_download_to_temp/s3_use_simplecache are deprecated; use \"\n100\t            f\"s3_mode={resolved!r} instead. Valid modes: {', '.join(VALID_S3_MODES)}.\",\n101\t            DeprecationWarning,\n102\t            stacklevel=3,\n103\t        )\n104\t        return resolved\n105\t\n106\t    if s3_mode is None:\n107\t        return \"download\"\n108\t\n109\t    if s3_mode not in VALID_S3_MODES:\n110\t        raise ValueError(\n111\t            f\"Unknown s3_mode {s3_mode!r}. Valid modes are: {', '.join(VALID_S3_MODES)}.\\n\"\n112\t            \"  download    \u2014 whole-object download to s3_cache_dir, then open locally (recommended)\\n\"\n113\t            \"  simplecache \u2014 fsspec read-through cache into s3_cache_dir\\n\"\n114\t            \"  stream      \u2014 direct s3fs handle, no local cache (unreliable for NetCDF/HDF5)\"\n115\t        )\n116\t    return s3_mode\n117\t\n118\t\n119\t# ---------------------------------------------------------------------------\n120\t# Signum-log transforms (module-level so numba can JIT-compile them)\n121\t# ---------------------------------------------------------------------------\n122\t#\n123\t# Why signum-log?  Solar imagery (especially magnetograms and EUV channels)\n124\t# has values that span many orders of magnitude and are symmetric around zero.\n125\t# A plain log is undefined for negative values; a standard z-score squashes the\n126\t# large dynamic range unevenly.  Signum-log preserves sign, compresses extreme\n127\t# values, and then standardizes:\n128\t#\n129\t#   forward:  y = sign(x * s) * log1p(|x * s|)   then  (y - \u03bc) / (\u03c3 + \u03b5)\n130\t#   inverse:  y_raw = y * (\u03c3 + \u03b5) + \u03bc             then  sign(y_raw) * expm1(|y_raw|) / s\n131\t#\n132\t# where s = sl_scale_factor (per-channel amplitude scaling applied before the log).\n133\t# \u03bc, \u03c3, \u03b5, and s are stored in the per-channel scaler objects built by\n134\t# ``workshop_infrastructure/utils.py:build_scalers()``.\n135\t#\n136\t# ---------------------------------------------------------------------------\n137\t# THE THREE SPACES  (read this before writing any \"inverse transform\" code)\n138\t# ---------------------------------------------------------------------------\n139\t#\n140\t# The forward pipeline has two stages, so there are three meaningful spaces \u2014 and\n141\t# therefore two different things \"undoing the transform\" can mean. Conflating them is\n142\t# the easiest way to feed a model silently wrong numbers.\n143\t#\n144\t#   normalized     What the dataset returns and the model sees. Roughly zero-mean,\n145\t#                  unit-variance per channel.\n146\t#      |\n147\t#      |  StandardScaler.inverse_transform()      <- undoes the z-score ONLY\n148\t#      v\n149\t#   signum-log     sign(x\u00b7s)\u00b7log1p(|x\u00b7s|). Still log-compressed, but channels are back\n150\t#                  on their own scales. This is the linear baseline's feature space\n151\t#                  (see downstream_apps/template/models/simple_baseline.py:\n152\t#                  destandardize_channels).\n153\t#      |\n154\t#      |  StandardScaler.inverse_signum_log_transform()\n155\t#      v\n156\t#   physical       Raw instrument units \u2014 DN for AIA, Gauss for HMI, m/s for Doppler.\n157\t#                  What you want for plotting with real colour limits, or for a loss\n158\t#                  expressed in physical units.\n159\t#\n160\t# ``HelioNetCDFDataset.inverse_transform_data()`` goes from normalized all the way to\n161\t# physical in one step (both stages), which is why notebook 0 can plot its output with\n162\t# real DN percentiles and \u00b11000 G magnetogram limits.\n163\t#\n164\t# So: ``scaler.inverse_transform()`` is NOT the inverse of the dataset's ``transform()``.\n165\t# It is the inverse of only the second stage. Name variables for the space they hold.\n166\t#\n167\t# ---------------------------------------------------------------------------\n168\t#\n169\t# The forward and inverse directions deliberately use different implementations:\n170\t#\n171\t#   forward  (``transform``, used by ``transform_data``) \u2014 pure NumPy. It runs inside\n172\t#     DataLoader workers on every sample, and the Numba JIT has been observed to hang\n173\t#     there on some GPU clusters. Correctness and reliability win over speed.\n174\t#   inverse  (``fast_inverse_transform``, used by ``inverse_transform_data``) \u2014 Numba\n175\t#     JIT, parallel across channels. It runs in the main process (plotting, physical-space\n176\t#     metrics), never in a worker, so the hang risk does not apply and the speedup is free.\n177\t#\n178\t# ``inverse_transform_single_channel`` is the pure-NumPy inverse for one channel, used\n179\t# where only a single channel needs undoing.\n180\t# ---------------------------------------------------------------------------\n181\t\n182\t@njit(parallel=True)\n183\tdef fast_inverse_transform(data, means, stds, sl_scale_factors, epsilons):\n184\t    \"\"\"Inverse signum-log normalization, Numba parallel implementation.\n185\t\n186\t    See the module-level comment for the mathematical definition.\n187\t\n188\t    Args:\n189\t        data: Normalized array of shape (C, H, W).\n190\t        means: Per-channel means, shape (C,).\n191\t        stds: Per-channel standard deviations, shape (C,).\n192\t        sl_scale_factors: Per-channel amplitude scaling factors, shape (C,).\n193\t        epsilons: Per-channel small constants that prevent division by zero, shape (C,).\n194\t\n195\t    Returns:\n196\t        Reconstructed array of shape (C, H, W), dtype float32.\n197\t    \"\"\"\n198\t    C, H, W = data.shape\n199\t    out = np.empty((C, H, W), dtype=np.float32)\n200\t    for c in prange(C):\n201\t        mean = means[c]\n202\t        std = stds[c]\n203\t        eps = epsilons[c]\n204\t        sl_scale_factor = sl_scale_factors[c]\n205\t        for i in range(H):\n206\t            for j in range(W):\n207\t                val = data[c, i, j] * (std + eps) + mean\n208\t                val = np.expm1(val) if val >= 0 else -np.expm1(-val)\n209\t                out[c, i, j] = val / sl_scale_factor\n210\t    return out\n211\t\n212\t\n213\tdef transform(\n214\t    data: np.ndarray,\n215\t    means: np.ndarray,\n216\t    stds: np.ndarray,\n217\t    sl_scale_factors: np.ndarray,\n218\t    epsilons: np.ndarray,\n219\t) -> np.ndarray:\n220\t    \"\"\"Signum-log normalization, pure NumPy. Drop-in replacement for ``fast_transform``.\n221\t\n222\t    Safe to use with DataLoader workers on any platform. See the module-level comment\n223\t    for the mathematical definition.\n224\t\n225\t    Args:\n226\t        data: NumPy array of shape (C, H, W).\n227\t        means: Per-channel means, shape (C,).\n228\t        stds: Per-channel standard deviations, shape (C,).\n229\t        sl_scale_factors: Per-channel amplitude scaling factors, shape (C,).\n230\t        epsilons: Per-channel small constants that prevent division by zero, shape (C,).\n231\t\n232\t    Returns:\n233\t        Normalized array of shape (C, H, W).\n234\t    \"\"\"\n235\t    means = means.reshape(*means.shape, 1, 1)\n236\t    stds = stds.reshape(*stds.shape, 1, 1)\n237\t    sl_scale_factors = sl_scale_factors.reshape(*sl_scale_factors.shape, 1, 1)\n238\t    epsilons = epsilons.reshape(*epsilons.shape, 1, 1)\n239\t\n240\t    data = data * sl_scale_factors\n241\t    data = np.sign(data) * np.log1p(np.abs(data))\n242\t    data = (data - means) / (stds + epsilons)\n243\t    return data\n244\t\n245\t\n246\tdef inverse_transform_single_channel(data, mean, std, sl_scale_factor, epsilon):\n247\t    \"\"\"Inverse signum-log normalization for a single channel (pure NumPy).\n248\t\n249\t    Convenience wrapper for per-channel post-processing (e.g. model output visualization).\n250\t    For full (C, H, W) arrays use ``fast_inverse_transform`` or invert via\n251\t    ``HelioNetCDFDataset.inverse_transform_data()``.\n252\t\n253\t    Args:\n254\t        data: NumPy array of shape (H, W).\n255\t        mean: Scalar mean.\n256\t        std: Scalar standard deviation.\n257\t        sl_scale_factor: Scalar amplitude scaling factor.\n258\t        epsilon: Small constant that prevents division by zero.\n259\t\n260\t    Returns:\n261\t        Reconstructed array of shape (H, W).\n262\t    \"\"\"\n263\t    data = data * (std + epsilon) + mean\n264\t    data = np.sign(data) * np.expm1(np.abs(data))\n265\t    return data / sl_scale_factor\n266\t\n267\t\n268\t# ---------------------------------------------------------------------------\n269\t# Channel masking transform\n270\t# ---------------------------------------------------------------------------\n271\t\n272\tclass RandomChannelMaskerTransform:\n273\t    \"\"\"Randomly zero-out AIA channels and optionally the HMI channel.\n274\t\n275\t    Used during pretraining to improve robustness to missing inputs.\n276\t\n277\t    Args:\n278\t        num_channels: Total number of channels in the input tensor.\n279\t        num_mask_aia_channels: Number of AIA channels to randomly zero-out per sample.\n280\t        phase: Dataset phase (e.g., ``\"train\"``). Included for future phase-specific logic.\n281\t        drop_hmi_probability: Probability of zeroing the last (HMI) channel.\n282\t    \"\"\"\n283\t\n284\t    def __init__(self, num_channels, num_mask_aia_channels, phase, drop_hmi_probability):\n285\t        self.num_channels = num_channels\n286\t        self.num_mask_aia_channels = num_mask_aia_channels\n287\t        self.drop_hmi_probability = drop_hmi_probability\n288\t\n289\t    def __call__(self, input_tensor):\n290\t        \"\"\"Apply random channel masking to a (C, T, H, W) image stack.\n291\t\n292\t        Zeros out ``num_mask_aia_channels`` randomly chosen channels uniformly across all\n293\t        timesteps, and independently drops the last channel (HMI) with probability\n294\t        ``drop_hmi_probability``.\n295\t\n296\t        Args:\n297\t            input_tensor: Array of shape (C, T, H, W).\n298\t\n299\t        Returns:\n300\t            Masked array of the same shape.\n301\t        \"\"\"\n302\t        C, T, H, W = input_tensor.shape\n303\t\n304\t        channels_to_mask = random.sample(range(C), self.num_mask_aia_channels)\n305\t        mask = torch.ones((C, 1, 1, 1))\n306\t        mask[channels_to_mask, ...] = 0\n307\t        masked_tensor = input_tensor * mask\n308\t\n309\t        if self.drop_hmi_probability > random.random():\n310\t            masked_tensor[-1, ...] = 0\n311\t\n312\t        return masked_tensor\n313\t\n314\t\n315\t# ---------------------------------------------------------------------------\n316\t# Dataset\n317\t# ---------------------------------------------------------------------------\n318\t\n319\tclass HelioNetCDFDataset(Dataset):\n320\t    \"\"\"\n321\t    PyTorch dataset for SDO NetCDF files, supporting both local and S3 storage.\n322\t\n323\t    Loads multi-channel (AIA + HMI) solar image stacks and pairs them with\n324\t    forecast targets for temporal prediction tasks. Handles variable input\n325\t    timestep sampling and is compatible with downstream fine-tuning.\n326\t\n327\t    Index format (CSV with columns: timestep, path, present):\n328\t\n329\t        timestep                    path                                present\n330\t        2011-01-01 00:00:00  s3://bucket/2011/01/sample.nc              1\n331\t        2011-01-01 00:12:00  s3://bucket/2011/01/sample.nc              1\n332\t        ...\n333\t\n334\t    Valid samples are timesteps for which all required input and target\n335\t    offsets can be resolved in the index.\n336\t\n337\t    Args:\n338\t        index_path: Path to the CSV index file.\n339\t        time_delta_input_minutes: List of candidate input time offsets in minutes, sorted ascending.\n340\t            The **last entry must be 0** (the \"now\" frame, always included). Earlier entries are the\n341\t            pool of historical offsets from which ``n_input_timestamps - 1`` frames are sampled\n342\t            randomly per call to ``__getitem__``.\n343\t        time_delta_target_minutes: Step size in minutes between forecast frames.\n344\t            Forecast targets are at offsets 1\u00d7, 2\u00d7, \u2026 (``rollout_steps + 1``)\u00d7 this value.\n345\t            Only used when ``load_forecast_frames=True``.\n346\t        n_input_timestamps: Number of input frames to include per sample. Must be\n347\t            \u2264 ``len(time_delta_input_minutes)``.\n348\t        rollout_steps: Number of additional forecast steps beyond the first target frame.\n349\t            ``rollout_steps=0`` produces one target frame; ``rollout_steps=N`` produces N+1.\n350\t            Only used when ``load_forecast_frames=True``.\n351\t        scalers: Per-channel normalization statistics produced by\n352\t            ``workshop_infrastructure/utils.py:build_scalers()``. Each entry must expose\n353\t            ``.mean``, ``.std``, ``.epsilon``, and ``.sl_scale_factor``.\n354\t        num_mask_aia_channels: Number of AIA channels to randomly mask during training.\n355\t        drop_hmi_probability: Probability of dropping the HMI channel during training.\n356\t        use_latitude_in_learned_flow: If True, include heliographic latitude in the output dict.\n357\t        channels: List of NetCDF variable names to load. Defaults to 8 AIA + HMI channels.\n358\t        phase: Dataset phase label (e.g., ``\"train\"``, ``\"val\"``).\n359\t        pooling: Spatial downsampling factor (average pooling). ``None`` or ``1`` means no pooling.\n360\t        random_vert_flip: If True, randomly flip images vertically during training.\n361\t        sdo_data_root_path: Optional root directory prepended to relative local paths.\n362\t        s3_storage_options: Options forwarded to fsspec/s3fs (e.g., ``{'anon': True}`` for public buckets).\n363\t        s3_mode: How S3 objects are read. One of:\n364\t\n365\t            - ``\"download\"`` (default) \u2014 fetch the whole object into ``s3_cache_dir`` with boto3\n366\t              (parallel multipart), then open it locally. Recommended for NetCDF/HDF5, which\n367\t              need random seeks that streaming cannot always serve.\n368\t            - ``\"simplecache\"`` \u2014 fsspec read-through cache into ``s3_cache_dir``.\n369\t            - ``\"stream\"`` \u2014 direct s3fs handle; nothing is written to disk and ``s3_cache_dir``\n370\t              is not required. Much slower for NetCDF/HDF5 (measured ~9x slower than\n371\t              ``\"download\"`` on a full SDO frame) because random access turns into many\n372\t              small ranged GETs. Use only when disk space is the binding constraint.\n373\t\n374\t        s3_cache_dir: **Required unless ``s3_mode=\"stream\"``.** Local directory where S3 files are\n375\t            cached. There is no default \u2014 you must set this explicitly. Each full-resolution SDO\n376\t            NetCDF file is approximately 1 GB, so make sure the target filesystem has sufficient\n377\t            space (budget ~1 GB \u00d7 number of unique timesteps in your dataset). Validated at\n378\t            construction time: if the index contains ``s3://`` paths and this is unset, the\n379\t            constructor raises rather than failing later inside a DataLoader worker.\n380\t        s3fs_kwargs: Additional kwargs passed to ``s3fs.S3FileSystem``.\n381\t        s3_download_to_temp: **Deprecated** \u2014 use ``s3_mode`` instead. Kept for backward\n382\t            compatibility; passing it emits a ``DeprecationWarning``.\n383\t        s3_use_simplecache: **Deprecated** \u2014 use ``s3_mode`` instead. Kept for backward\n384\t            compatibility; passing it emits a ``DeprecationWarning``.\n385\t        s3_temp_dir: Internal override for the download directory. Defaults to ``s3_cache_dir``,\n386\t            which is the single public knob.\n387\t        s3_boto3_max_concurrency: Number of parallel threads for boto3 multipart downloads.\n388\t        s3_boto3_part_size_mb: Part size in MB for boto3 multipart downloads.\n389\t        load_forecast_frames: If True (default), load both input and forecast frames and include\n390\t            ``forecast`` and ``lead_time_delta`` in the returned sample. Set to False for downstream\n391\t            tasks that supply their own target labels (e.g., flare intensity from a separate catalog),\n392\t            so that future frames are never fetched from disk or S3. This also relaxes the index\n393\t            validity check \u2014 only input-frame timestamps need to be present.\n394\t    \"\"\"\n395\t\n396\t    def __init__(\n397\t        self,\n398\t        index_path: str,\n399\t        time_delta_input_minutes: list[int],\n400\t        time_delta_target_minutes: int,\n401\t        n_input_timestamps: int,\n402\t        rollout_steps: int,\n403\t        scalers=None,\n404\t        num_mask_aia_channels: int = 0,\n405\t        drop_hmi_probability: float = 0.0,\n406\t        use_latitude_in_learned_flow: bool = False,\n407\t        channels: list[str] | None = None,\n408\t        phase: str = \"train\",\n409\t        pooling: int | None = None,\n410\t        random_vert_flip: bool = False,\n411\t        sdo_data_root_path: str | None = None,\n412\t        # S3 options (only used when index contains s3:// URIs)\n413\t        s3_storage_options: dict | None = None,\n414\t        s3_mode: str | None = None,\n415\t        s3_cache_dir: str | None = None,\n416\t        s3fs_kwargs: dict | None = None,\n417\t        s3_temp_dir: str | None = None,\n418\t        # Deprecated aliases for s3_mode \u2014 see _resolve_s3_mode().\n419\t        s3_use_simplecache: bool | None = None,\n420\t        s3_download_to_temp: bool | None = None,\n421\t        s3_boto3_max_concurrency: int = 4,\n422\t        s3_boto3_part_size_mb: int = 64,\n423\t        load_forecast_frames: bool = True,\n424\t    ):\n425\t        self.scalers = scalers\n426\t        self.phase = phase\n427\t        self.num_mask_aia_channels = num_mask_aia_channels\n428\t        self.drop_hmi_probability = drop_hmi_probability\n429\t        self.n_input_timestamps = n_input_timestamps\n430\t        self.rollout_steps = rollout_steps\n431\t        self.use_latitude_in_learned_flow = use_latitude_in_learned_flow\n432\t        self.pooling = pooling if pooling is not None else 1\n433\t        self.random_vert_flip = random_vert_flip\n434\t        self.sdo_data_root_path = sdo_data_root_path\n435\t\n436\t        self.s3_storage_options = s3_storage_options or {}\n437\t        self.s3_mode = _resolve_s3_mode(s3_mode, s3_download_to_temp, s3_use_simplecache)\n438\t        self.s3_cache_dir = s3_cache_dir\n439\t        self.s3fs_kwargs = s3fs_kwargs or {}\n440\t        self.s3_temp_dir = s3_temp_dir if s3_temp_dir is not None else s3_cache_dir\n441\t        # s3_cache_dir may legitimately be None for local-only indices (and for\n442\t        # s3_mode=\"stream\"). _validate_s3_cache_dir() checks it against the actual\n443\t        # index right after the index is loaded, so misconfiguration surfaces at\n444\t        # construction time rather than inside a DataLoader worker mid-training.\n445\t        self.s3_boto3_max_concurrency = s3_boto3_max_concurrency\n446\t        self.s3_boto3_part_size_mb = s3_boto3_part_size_mb\n447\t        self._s3fs = None  # lazily initialized per process\n448\t        self.load_forecast_frames = load_forecast_frames\n449\t\n450\t        if scalers is None:\n451\t            raise ValueError(\n452\t                \"scalers is required. Build it once with:\\n\"\n453\t                \"    from workshop_infrastructure.utils import build_scalers\\n\"\n454\t                \"    scalers = build_scalers(info=<path to assets/scalers.yaml>)\\n\"\n455\t                \"and pass it as scalers=... . (It has no usable default: the per-channel \"\n456\t                \"mean/std/epsilon/sl_scale_factor are read during __init__.)\"\n457\t            )\n458\t\n459\t        if channels is None:\n460\t            raise ValueError(\n461\t                \"channels is required. Pass the NetCDF variable names to load, e.g. the 13 \"\n462\t                \"Surya channels:\\n\"\n463\t                \"    ['aia94', 'aia131', 'aia171', 'aia193', 'aia211', 'aia304', 'aia335',\\n\"\n464\t                \"     'aia1600', 'hmi_m', 'hmi_bx', 'hmi_by', 'hmi_bz', 'hmi_v']\\n\"\n465\t                \"The names must match the keys in your scalers.yaml.\"\n466\t            )\n467\t\n468\t        self.channels = channels\n469\t        self.in_channels = len(self.channels)\n470\t\n471\t        self.masker = RandomChannelMaskerTransform(\n472\t            num_channels=self.in_channels,\n473\t            num_mask_aia_channels=self.num_mask_aia_channels,\n474\t            phase=self.phase,\n475\t            drop_hmi_probability=self.drop_hmi_probability,\n476\t        )\n477\t\n478\t        self.time_delta_input_minutes = sorted(\n479\t            np.timedelta64(t, \"m\") for t in time_delta_input_minutes\n480\t        )\n481\t        # range(1, rollout_steps + 2): starts at 1\u00d7 (first target), ends at (rollout_steps + 1)\u00d7.\n482\t        # rollout_steps=0 \u2192 one target frame; rollout_steps=N \u2192 N+1 target frames.\n483\t        self.time_delta_target_minutes = [\n484\t            np.timedelta64(iroll * time_delta_target_minutes, \"m\")\n485\t            for iroll in range(1, rollout_steps + 2)\n486\t        ]\n487\t\n488\t        self.index = pd.read_csv(index_path)\n489\t        self.index = self.index[self.index[\"present\"] == 1]\n490\t        self.index[\"timestep\"] = pd.to_datetime(self.index[\"timestep\"]).values.astype(\"datetime64[ns]\")\n491\t        self.index.set_index(\"timestep\", inplace=True)\n492\t        self.index.sort_index(inplace=True)\n493\t\n494\t        self._validate_s3_cache_dir(index_path)\n495\t\n496\t        self.valid_indices = self._filter_valid_indices()\n497\t        self.adjusted_length = len(self.valid_indices)\n498\t\n499\t        self.rank = get_rank()\n500\t        self.logger: Logger | None = None\n501\t\n502\t        # Every requested channel must have a scaler. Checking here turns what would\n503\t        # otherwise be a bare `KeyError: 'aia1700'` from the comprehension below into a\n504\t        # message naming the config key, the missing channels, and the valid ones.\n505\t        missing = [ch for ch in self.channels if ch not in self.scalers]\n506\t        if missing:\n507\t            raise ValueError(\n508\t                f\"No scaler found for channel(s): {', '.join(missing)}.\\n\"\n509\t                \"Every entry in data.channels must have matching statistics in your \"\n510\t                \"scalers file (data.scalers_path).\\n\"\n511\t                f\"Channels available in the scalers: {', '.join(sorted(self.scalers))}.\\n\"\n512\t                \"Either correct the channel name in the config or use a scalers file that \"\n513\t                \"covers it.\"\n514\t            )\n515\t\n516\t        # Pre-compute normalization arrays once (avoids repeated dict lookups per sample).\n517\t        self._means = np.array([self.scalers[ch].mean for ch in self.channels])\n518\t        self._stds = np.array([self.scalers[ch].std for ch in self.channels])\n519\t        self._epsilons = np.array([self.scalers[ch].epsilon for ch in self.channels])\n520\t        self._sl_scale_factors = np.array([self.scalers[ch].sl_scale_factor for ch in self.channels])\n521\t\n522\t    # ------------------------------------------------------------------\n523\t    # Index filtering\n524\t    # ------------------------------------------------------------------\n525\t\n526\t    def _filter_valid_indices(self) -> list:\n527\t        \"\"\"Return the list of reference timesteps for which all required offsets are present.\n528\t\n529\t        When ``load_forecast_frames=False``, only input-frame offsets are checked, so the\n530\t        index does not need to contain future timestamps.\n531\t        \"\"\"\n532\t        if self.load_forecast_frames:\n533\t            # `+` concatenates two Python lists of np.timedelta64 objects before deduplication.\n534\t            time_deltas = np.unique(self.time_delta_input_minutes + self.time_delta_target_minutes)\n535\t        else:\n536\t            time_deltas = np.unique(self.time_delta_input_minutes)\n537\t        return [\n538\t            ts for ts in self.index.index\n539\t            if all(ts + dt in self.index.index for dt in time_deltas)\n540\t        ]\n541\t\n542\t    # ------------------------------------------------------------------\n543\t    # Logging\n544\t    # ------------------------------------------------------------------\n545\t\n546\t    def _ensure_logger(self):\n547\t        \"\"\"Create a per-process logger on first use.\"\"\"\n548\t        if self.logger is not None:\n549\t            return\n550\t        os.makedirs(\"logs/data\", exist_ok=True)\n551\t        timestamp = datetime.now().strftime(\"%Y%m%dT%H%M%SZ\")\n552\t        pid = os.getpid()\n553\t        self.logger = create_logger(\n554\t            output_dir=\"logs/data\",\n555\t            dist_rank=self.rank,\n556\t            name=f\"{timestamp}_{self.rank:>03}_data_{self.phase}_{pid}\",\n557\t        )\n558\t\n559\t    # ------------------------------------------------------------------\n560\t    # Dataset interface\n561\t    # ------------------------------------------------------------------\n562\t\n563\t    def __len__(self) -> int:\n564\t        \"\"\"Return the number of valid reference timesteps in this dataset.\"\"\"\n565\t        return self.adjusted_length\n566\t\n567\t    def __getitem__(self, idx: int) -> dict:\n568\t        \"\"\"\n569\t        Load and return a single sample.\n570\t\n571\t        Args:\n572\t            idx: Dataset index.\n573\t\n574\t        Returns:\n575\t            Dictionary with keys:\n576\t                ts (np.ndarray):               (C, T, H, W) \u2014 input frames\n577\t                time_delta_input (np.ndarray): (T,) \u2014 input time offsets in hours (relative to \"now\")\n578\t            When ``load_forecast_frames=True`` (default), also includes:\n579\t                forecast (np.ndarray):         (C, L, H, W) \u2014 target frames\n580\t                lead_time_delta (np.ndarray):  (L,) \u2014 lead times in hours (negative = future)\n581\t            When ``use_latitude_in_learned_flow=True``, also includes:\n582\t                input_latitudes (list[float])\n583\t                forecast_latitude (list[float])  \u2014 only when ``load_forecast_frames=True``\n584\t        \"\"\"\n585\t        self._ensure_logger()\n586\t        self.logger.info(f\"Retrieving index {idx}.\")\n587\t        return self._get_index_data(idx)\n588\t\n589\t    # ------------------------------------------------------------------\n590\t    # Internal data loading\n591\t    # ------------------------------------------------------------------\n592\t\n593\t    def _load_and_stack_frames(self, timesteps) -> np.ndarray:\n594\t        \"\"\"Load, normalize, and stack NetCDF frames into a (C, T, H, W) array.\n595\t\n596\t        Args:\n597\t            timesteps: Sequence of timestamps; one NetCDF file is loaded per entry.\n598\t\n599\t        Returns:\n600\t            NumPy array of shape (C, T, H, W).\n601\t        \"\"\"\n602\t        return np.stack(\n603\t            [self.transform_data(self.load_nc_data(self.index.loc[ts, \"path\"], ts, self.channels))\n604\t             for ts in timesteps],\n605\t            axis=1,\n606\t        )\n607\t\n608\t    def _get_index_data(self, idx: int) -> dict:\n609\t        \"\"\"Build and return the sample dict for a single reference timestep.\n610\t\n611\t        Samples historical input frames randomly from ``time_delta_input_minutes``,\n612\t        applies channel masking and optional vertical flip, then assembles the sample\n613\t        dict described in ``__getitem__``.\n614\t        \"\"\"\n615\t        reference_timestep = self.valid_indices[idx]\n616\t\n617\t        # The last entry in time_delta_input_minutes is always the \"now\" frame (offset 0\n618\t        # relative to the reference timestep). The remaining n-1 input frames are sampled\n619\t        # randomly from the earlier offsets, giving the model varied historical context\n620\t        # across training steps.\n621\t        input_time_deltas = np.array(\n622\t            sorted(random.sample(self.time_delta_input_minutes[:-1], self.n_input_timestamps - 1))\n623\t            + [self.time_delta_input_minutes[-1]]\n624\t        )\n625\t        input_timesteps = reference_timestep + input_time_deltas\n626\t        stacked_inputs = self._load_and_stack_frames(input_timesteps)\n627\t\n628\t        if self.num_mask_aia_channels > 0 or self.drop_hmi_probability:\n629\t            stacked_inputs = self.masker(stacked_inputs)\n630\t\n631\t        # All time deltas are expressed relative to \"now\" (the last input frame), in hours.\n632\t        now_delta = input_time_deltas[-1]\n633\t        time_delta_input_float = (\n634\t            (now_delta - input_time_deltas) / np.timedelta64(1, \"h\")\n635\t        ).astype(np.float32)\n636\t\n637\t        sample = {\n638\t            \"ts\": stacked_inputs,\n639\t            \"time_delta_input\": time_delta_input_float,\n640\t        }\n641\t\n642\t        if self.load_forecast_frames:\n643\t            target_time_deltas = np.array(self.time_delta_target_minutes)\n644\t            target_timesteps = reference_timestep + target_time_deltas\n645\t            sample[\"forecast\"] = self._load_and_stack_frames(target_timesteps)\n646\t            sample[\"lead_time_delta\"] = (\n647\t                (now_delta - target_time_deltas) / np.timedelta64(1, \"h\")\n648\t            ).astype(np.float32)\n649\t\n650\t        if self.random_vert_flip and torch.bernoulli(torch.ones(()) / 2) == 1:\n651\t            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n652\t            if self.load_forecast_frames:\n653\t                sample[\"forecast\"] = np.flip(sample[\"forecast\"], axis=-2).copy()\n654\t\n655\t        if self.use_latitude_in_learned_flow:\n656\t            from sunpy.coordinates.ephemeris import get_earth\n657\t\n658\t            sample[\"input_latitudes\"] = [get_earth(ts).lat.value for ts in input_timesteps]\n659\t            if self.load_forecast_frames:\n660\t                sample[\"forecast_latitude\"] = [get_earth(ts).lat.value for ts in target_timesteps]\n661\t\n662\t        return sample\n663\t\n664\t    # ------------------------------------------------------------------\n665\t    # NetCDF loading\n666\t    # ------------------------------------------------------------------\n667\t\n668\t    def load_nc_data(self, filepath: str, timestep: pd.Timestamp, channels: list[str]) -> np.ndarray:\n669\t        \"\"\"\n670\t        Load a NetCDF file and return channel-stacked data as a NumPy array.\n671\t\n672\t        Supports both local filesystem paths and S3 URIs (``s3://bucket/key``).\n673\t        How S3 objects are read is controlled by ``s3_mode`` (default: download the\n674\t        whole object into ``s3_cache_dir``, then open it locally).\n675\t\n676\t        Args:\n677\t            filepath: Local path or S3 URI.\n678\t            timestep: Timestamp for the file (used for logging).\n679\t            channels: List of variable names to extract, stacked into (C, H, W).\n680\t\n681\t        Returns:\n682\t            NumPy array of shape (C, H, W).\n683\t        \"\"\"\n684\t        self._ensure_logger()\n685\t        self.logger.info(f\"Reading file {filepath}.\")\n686\t\n687\t        if not self._is_s3_path(filepath) and self.sdo_data_root_path and not os.path.isabs(filepath):\n688\t            filepath = os.path.join(self.sdo_data_root_path, filepath)\n689\t\n690\t        if self._is_s3_path(filepath):\n691\t            return self._load_s3_nc_data(filepath, channels)\n692\t\n693\t        with xr.open_dataset(filepath, engine=\"h5netcdf\", chunks=None, cache=False) as ds:\n694\t            return ds[channels].to_array().load().to_numpy()\n695\t\n696\t    def _load_s3_nc_data(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n697\t        \"\"\"Load a NetCDF file from S3 and return the requested channels as a NumPy array.\n698\t\n699\t        Dispatches on ``self.s3_mode`` \u2014 see ``VALID_S3_MODES`` in\n700\t        ``workshop_infrastructure.configs`` for what each mode does and when to use it.\n701\t        \"\"\"\n702\t        if boto3 is None and fsspec is None:\n703\t            raise ImportError(\n704\t                \"S3 support requires either 'boto3' or 'fsspec'+'s3fs'. \"\n705\t                \"Install via: pip install boto3  or  pip install s3fs fsspec\"\n706\t            )\n707\t\n708\t        if self.s3_mode == \"download\":\n709\t            return self._read_s3_via_download(s3_uri, channels)\n710\t\n711\t        # Both remaining modes go through fsspec/s3fs.\n712\t        if fsspec is None:\n713\t            raise ImportError(\n714\t                \"s3_mode='%s' requires 'fsspec' and 's3fs'. \"\n715\t                \"Install via: pip install s3fs fsspec\" % self.s3_mode\n716\t            )\n717\t\n718\t        if self.s3_mode == \"simplecache\":\n719\t            # Same requirement as \"download\": fsspec needs somewhere to put the cache.\n720\t            # Normally already caught by _validate_s3_cache_dir() at construction; this\n721\t            # backstops an index whose s3:// rows were not visible then.\n722\t            self._require_s3_cache_dir()\n723\t            s3_options = {**self.s3_storage_options, **self.s3fs_kwargs}\n724\t            opener = fsspec.open(\n725\t                f\"simplecache::{s3_uri}\",\n726\t                mode=\"rb\",\n727\t                cache_storage=self.s3_cache_dir,\n728\t                s3=s3_options,\n729\t            )\n730\t        else:  # \"stream\"\n731\t            opener = self._get_s3fs().open(s3_uri, mode=\"rb\")\n732\t\n733\t        with opener as f:\n734\t            with xr.open_dataset(f, engine=\"h5netcdf\", chunks=None, cache=False) as ds:\n735\t                return ds[channels].to_array().load().to_numpy()\n736\t\n737\t    def _read_s3_via_download(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n738\t        \"\"\"Download the whole object to the local cache, then open it with xarray.\n739\t\n740\t        The download is written to a process-unique ``.partial`` file and then renamed\n741\t        into place. The uniqueness matters: with ``num_workers>0`` and/or several DDP\n742\t        ranks sharing one ``s3_cache_dir``, two processes can pick the same timestep at\n743\t        the same time. A shared temp name would let one process clobber or delete the\n744\t        file another is still writing, and the rename would then publish a truncated\n745\t        object into the cache permanently.\n746\t        \"\"\"\n747\t        self._require_s3_cache_dir()\n748\t\n749\t        cache_path = self._s3_cache_path(s3_uri)\n750\t        os.makedirs(os.path.dirname(cache_path) or \".\", exist_ok=True)\n751\t\n752\t        if not os.path.exists(cache_path):\n753\t            tmp_path = f\"{cache_path}.{os.getpid()}.{uuid4().hex}.partial\"\n754\t            try:\n755\t                self._download_s3_object(s3_uri, tmp_path)\n756\t                # os.replace is atomic on POSIX: a concurrent writer either wins or\n757\t                # loses the race, but the published file is always complete.\n758\t                os.replace(tmp_path, cache_path)\n759\t            except BaseException:\n760\t                if os.path.exists(tmp_path):\n761\t                    os.remove(tmp_path)\n762\t                raise\n763\t\n764\t        with xr.open_dataset(cache_path, engine=\"h5netcdf\", chunks=None, cache=False) as ds:\n765\t            return ds[channels].to_array().load().to_numpy()\n766\t\n767\t    # ------------------------------------------------------------------\n768\t    # S3 helpers\n769\t    # ------------------------------------------------------------------\n770\t\n771\t    def _is_s3_path(self, path: str) -> bool:\n772\t        \"\"\"Return True if ``path`` is an S3 URI (starts with ``s3://``).\"\"\"\n773\t        return isinstance(path, str) and path.startswith(\"s3://\")\n774\t\n775\t    @staticmethod\n776\t    def _suggested_cache_dir() -> str:\n777\t        \"\"\"Return a plausible cache directory for this machine, for use in error messages.\"\"\"\n778\t        for env_var in (\"SCRATCH\", \"TMPDIR\"):\n779\t            root = os.environ.get(env_var)\n780\t            if root:\n781\t                return os.path.join(root, \"helio_s3_cache\")\n782\t        return os.path.join(os.path.expanduser(\"~\"), \".cache\", \"surya_workshop\", \"helio_s3_cache\")\n783\t\n784\t    def _require_s3_cache_dir(self) -> None:\n785\t        \"\"\"Raise if a cache directory is needed but not configured.\"\"\"\n786\t        if self.s3_cache_dir is None:\n787\t            raise ValueError(\n788\t                f\"s3_cache_dir must be set when s3_mode={self.s3_mode!r}.\\n\"\n789\t                f\"Suggested value for this machine: {self._suggested_cache_dir()}\\n\"\n790\t                \"Each full-resolution SDO NetCDF file is ~1 GB, so budget roughly \"\n791\t                \"1 GB x (number of unique timesteps) of free space.\"\n792\t            )\n793\t\n794\t    def _validate_s3_cache_dir(self, index_path: str) -> None:\n795\t        \"\"\"Fail at construction time if the index needs a cache dir that is not configured.\n796\t\n797\t        The index is already in memory in the main process, so this check is cheap and\n798\t        exact. Without it the same error only fires on the first ``__getitem__`` inside a\n799\t        spawned DataLoader worker \u2014 after asset downloads, model construction and Lightning\n800\t        setup \u2014 surfacing as a worker-exit traceback minutes into a run.\n801\t\n802\t        ``s3_mode=\"stream\"`` writes nothing to disk and is therefore exempt.\n803\t        \"\"\"\n804\t        if self.s3_cache_dir is not None or self.s3_mode == \"stream\":\n805\t            return\n806\t\n807\t        paths = self.index[\"path\"].astype(str)\n808\t        if not paths.str.startswith(\"s3://\").any():\n809\t            return  # local-only index: no cache dir needed\n810\t\n811\t        example = paths[paths.str.startswith(\"s3://\")].iloc[0]\n812\t        raise ValueError(\n813\t            f\"The index {index_path} contains s3:// paths (e.g. {example}) but \"\n814\t            f\"s3_cache_dir is not set (s3_mode={self.s3_mode!r}).\\n\"\n815\t            \"\\n\"\n816\t            \"Set it in the data: section of your config YAML:\\n\"\n817\t            \"\\n\"\n818\t            \"    data:\\n\"\n819\t            f\"      s3_cache_dir: {self._suggested_cache_dir()}\\n\"\n820\t            \"\\n\"\n821\t            \"...or, to keep the config machine-independent, set it outside the config:\\n\"\n822\t            \"\\n\"\n823\t            f\"    export SURYA_WS_CACHE_DIR={self._suggested_cache_dir()}\\n\"\n824\t            \"    # or pass --s3-cache-dir <path> to the training script\\n\"\n825\t            \"\\n\"\n826\t            \"Each full-resolution SDO NetCDF file is ~1 GB, so pick a filesystem with \"\n827\t            \"roughly 1 GB x (number of unique timesteps) free.\\n\"\n828\t            \"Alternatively set s3_mode: stream to read without a local cache \"\n829\t            \"(not recommended for NetCDF/HDF5 \u2014 it requires random seeks).\"\n830\t        )\n831\t\n832\t    def _get_s3fs(self):\n833\t        \"\"\"Lazily create and cache an ``s3fs.S3FileSystem`` instance (per process).\"\"\"\n834\t        if s3fs is None:\n835\t            raise ImportError(\"s3fs is required. Install via: pip install s3fs fsspec\")\n836\t        if self._s3fs is None:\n837\t            self._s3fs = s3fs.S3FileSystem(**self.s3fs_kwargs, **self.s3_storage_options)\n838\t        return self._s3fs\n839\t\n840\t    def _s3_cache_path(self, s3_uri: str) -> str:\n841\t        \"\"\"Build a stable, human-readable local cache path for an S3 object.\"\"\"\n842\t        bucket, key = parse_s3_uri(s3_uri)\n843\t        base = os.path.basename(key) or \"object\"\n844\t        base_safe = re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", base).strip(\"._-\") or \"object\"\n845\t        _, ext = os.path.splitext(base_safe)\n846\t        suffix = ext if ext else \".nc\"\n847\t        key_hash = hashlib.sha1(f\"{bucket}/{key}\".encode()).hexdigest()\n848\t        fname = f\"{bucket}__{key_hash}__{base_safe}\"\n849\t        if not fname.endswith(suffix):\n850\t            fname += suffix\n851\t        return os.path.join(self.s3_temp_dir, fname)\n852\t\n853\t    def _download_s3_object(self, s3_uri: str, local_path: str) -> None:\n854\t        \"\"\"Download an S3 object to ``local_path``.\n855\t\n856\t        Uses boto3's transfer manager when available (parallel multipart downloads),\n857\t        otherwise falls back to streaming via s3fs.\n858\t        \"\"\"\n859\t        os.makedirs(os.path.dirname(local_path) or \".\", exist_ok=True)\n860\t\n861\t        if boto3 is not None:\n862\t            anon = bool(self.s3_storage_options.get(\"anon\") or self.s3fs_kwargs.get(\"anon\"))\n863\t            region = (os.environ.get(\"AWS_REGION\")\n864\t                      or os.environ.get(\"AWS_DEFAULT_REGION\")\n865\t                      or detect_ec2_region())\n866\t            client = make_s3_client(\n867\t                anon=anon,\n868\t                region=region,\n869\t                # Pool must exceed the thread count or multipart threads contend.\n870\t                pool_size=max(32, self.s3_boto3_max_concurrency * 2),\n871\t                # Retry hard: a failed read kills the training run.\n872\t                max_attempts=10,\n873\t            )\n874\t\n875\t            transfer_cfg = TransferConfig(\n876\t                multipart_threshold=self.s3_boto3_part_size_mb * 1024 * 1024,\n877\t                multipart_chunksize=self.s3_boto3_part_size_mb * 1024 * 1024,\n878\t                max_concurrency=self.s3_boto3_max_concurrency,\n879\t                use_threads=True,\n880\t                io_chunksize=1024 * 1024,\n881\t            )\n882\t            bucket, key = parse_s3_uri(s3_uri)\n883\t            client.download_file(bucket, key, local_path, Config=transfer_cfg)\n884\t            return\n885\t\n886\t        # Fallback: stream via s3fs\n887\t        fs = self._get_s3fs()\n888\t        with fs.open(s3_uri, \"rb\") as src, open(local_path, \"wb\") as dst:\n889\t            for chunk in iter(lambda: src.read(8 * 1024 * 1024), b\"\"):\n890\t                dst.write(chunk)\n891\t\n892\t    # ------------------------------------------------------------------\n893\t    # Normalization\n894\t    # ------------------------------------------------------------------\n895\t\n896\t    def transform_data(self, data: np.ndarray) -> np.ndarray:\n897\t        \"\"\"Apply spatial pooling (if configured) then signum-log normalization.\n898\t\n899\t        Args:\n900\t            data: Raw channel array of shape (C, H, W).\n901\t\n902\t        Returns:\n903\t            Normalized array of shape (C, H//pooling, W//pooling). See the module-level\n904\t            comment for the signum-log math and the ``inverse_transform_data`` method\n905\t            to reverse the normalization.\n906\t        \"\"\"\n907\t        assert data.ndim == 3\n908\t        if self.pooling > 1:\n909\t            data = skimage.measure.block_reduce(data, block_size=(1, self.pooling, self.pooling), func=np.mean)\n910\t        return transform(data, self._means, self._stds, self._sl_scale_factors, self._epsilons)\n911\t\n912\t    def inverse_transform_data(self, data: np.ndarray) -> np.ndarray:\n913\t        \"\"\"Invert signum-log normalization on a (C, H, W) array.\n914\t\n915\t        Note: this only inverts the *normalization*, not spatial pooling.\n916\t        Pooling (applied in ``transform_data``) is not invertible.\n917\t        \"\"\"\n918\t        assert data.ndim == 3\n919\t        return fast_inverse_transform(data, self._means, self._stds, self._sl_scale_factors, self._epsilons)\n920\t",
