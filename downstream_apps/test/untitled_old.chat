lush=True)\\n        last_status = status\\n\\n    if outputs:\\n        errored = any(o.get(\\\"output_type\\\") == \\\"error\\\" for o in outputs)\\n        if errored:\\n            err = next(o for o in outputs if o.get(\\\"output_type\\\") == \\\"error\\\")\\n            print(f\\\"FIT_CELL_ERROR: {err.get('ename')}: {err.get('evalue')}\\\", flush=True)\\n        else:\\n            print(\\\"FIT_CELL_DONE_NO_ERROR\\\", flush=True)\\n        break\\n\\n    time.sleep(4)\\nPYEOF\"}"
