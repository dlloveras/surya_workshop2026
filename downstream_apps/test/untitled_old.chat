            "raw_input": {
              "command": "python - <<'PY'\nfrom pathlib import Path\n\np = Path(\"configs/config_script.yaml\")\ns = p.read_text()\n\ndef sub(old, new, label):\n    global s\n    n = s.count(old)\n    assert n == 1, f\"{label}: expected 1 occurrence, found {n}\"\n    s = s.replace(old, new)\n    print(f\"  ok  {label}\")\n\n# --- Bug 1: the pretrained tokenizer was silently discarded -------------------\nsub(\n    \"  time_delta_input_minutes: [0]   # Offsets (minutes) of input frames relative to reference timestep\\n\",\n    \"  # time_delta_input_minutes: [0]  # previous value. Combined with time_dim: 1 below it\\n\"\n    \"  #   built a 13-channel patch embedding, while the checkpoint's is Conv2d(26, 1280, 16, 16)\\n\"\n    \"  #   -- 13 channels x 2 timesteps. The shapes disagreed, so load_pretrained_weights()\\n\"\n    \"  #   skipped the tokenizer and it stayed RANDOM (156/159 tensors loaded instead of 157).\\n\"\n    \"  # The bucket's modal frame spacing is 12 min, so [-12, 0] is exactly one consecutive\\n\"\n    \"  # frame step -- which is also what the running-difference baseline needs.\\n\"\n    \"  time_delta_input_minutes: [-12, 0]   # Offsets (minutes) of input frames relative to reference timestep\\n\",\n    \"bug 1: time_delta_input_minutes\",\n)\nsub(\n    \"    time_dim: 1         # Number of input timesteps (must match time_delta_input_minutes length)\\n\",\n    \"    # time_dim: 1       # previous value -- see time_delta_input_minutes above: it is half of\\n\"\n    \"    #   what the checkpoint's tokenizer expects, so the tokenizer was silently left random.\\n\"\n    \"    time_dim: 2         # Number of input timesteps (must match time_delta_input_minutes length)\\n\",\n    \"bug 1: time_dim\",\n)\n\n# --- Bug 2: LoRA never adapted attention -------------------------------------\nsub(\n    \"    target_modules: [q_proj, v_proj, k_proj, out_proj, fc1, fc2]\\n\",\n    \"    # previous value: [q_proj, v_proj, k_proj, out_proj, fc1, fc2]\\n\"\n    \"    #   Surya has none of those names -- q/k/v are fused into attn.qkv and the output\\n\"\n    \"    #   projection is attn.proj. PEFT only raises when *nothing* matches, so only fc1/fc2\\n\"\n    \"    #   were adapted: 2,666,241 trainable instead of 3,157,761. Attention never trained.\\n\"\n    \"    target_modules: [fc1, fc2, attn.qkv, attn.proj]\\n\",\n    \"bug 2: target_modules\",\n)\n\n# --- Bug 6: the penultimate linear layer adds no capacity --------------------\nsub(\n    \"  penultimate_linear_layer: true\\n\",\n    \"  # penultimate_linear_layer: true  # previous value. head_linear (1280->1280) feeds\\n\"\n    \"  #   head_unembed (1280->1) with no nonlinearity between them, so at eval the pair is\\n\"\n    \"  #   exactly one linear map: its 1,639,680 params add zero representational capacity\\n\"\n    \"  #   while being 52% of all trainable weights. Off by default -- less to overfit on a\\n\"\n    \"  #   few-hundred-sample training set. Head: 2,561 params; total trainable 1,518,081.\\n\"\n    \"  penultimate_linear_layer: false\\n\",\n    \"bug 6: penultimate_linear_layer\",\n)\n\n# --- Match tolerance --------------------------------------------------------\nsub(\n    \"  ds_time_tolerance: 4d           # Max allowed gap between catalog and Surya timestamps\\n\",\n    \"  # ds_time_tolerance: 4d         # previous value. 98.3% of train matches already land\\n\"\n    \"  #   within 15 min; the loosest ones (up to 1 day) are 9-to-1 \\\"no wave\\\", which is what\\n\"\n    \"  #   skewed the class balance to 612/619. Tightening it gives 606/604 (train), 25 val,\\n\"\n    \"  #   50 test -- see downstream_apps/test/experiments/results/ for the counts.\\n\"\n    \"  ds_time_tolerance: 15min        # Max allowed gap between catalog and Surya timestamps\\n\",\n    \"match tolerance\",\n)\n\np.write_text(s)\nprint(\"wrote\", p)\nPY",
              "description": "Apply Phase 0 config fixes"
