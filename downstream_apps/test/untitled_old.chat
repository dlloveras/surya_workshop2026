            "raw_output": "=== test/ tree ===\n/home/jovyan/surya_workshop2026/downstream_apps/test/.ipynb_checkpoints/0_dataset_dataloader_template-checkpoint.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/.ipynb_checkpoints/0_dataset_dataloader_template_diego-checkpoint.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/.ipynb_checkpoints/1_baseline_template_diego-checkpoint.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/0_dataset_dataloader_template.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/0_dataset_dataloader_template_diego.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/1_baseline_template.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/1_baseline_template_diego.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/2_finetune_template_1D.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/3_finetune_template_1D.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/ADAPTING.md\n/home/jovyan/surya_workshop2026/downstream_apps/test/A_shapes_and_broadcasting.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/test/__pycache__/configs.cpython-312.pyc\n/home/jovyan/surya_workshop2026/downstream_apps/test/assets/.gitkeep\n/home/jovyan/surya_workshop2026/downstream_apps/test/assets/scalers.yaml\n/home/jovyan/surya_workshop2026/downstream_apps/test/configs.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/configs/config_script.yaml\n/home/jovyan/surya_workshop2026/downstream_apps/test/data/.ipynb_checkpoints/hek_flare_catalog-checkpoint.csv\n/home/jovyan/surya_workshop2026/downstream_apps/test/data/.ipynb_checkpoints/lcpf_aia_waves-checkpoint.csv\n/home/jovyan/surya_workshop2026/downstream_apps/test/data/hek_flare_catalog.csv\n/home/jovyan/surya_workshop2026/downstream_apps/test/data/lcpf_aia_waves.csv\n/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/__pycache__/__init__.cpython-312.pyc\n/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/__pycache__/template_dataset.cpython-312.pyc\n/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/__pycache__/wave_dataset.cpython-312.pyc\n/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/template_dataset.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/wave_dataset.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/download_scalers.sh\n/home/jovyan/surya_workshop2026/downstream_apps/test/download_scalers_and_weights.sh\n/home/jovyan/surya_workshop2026/downstream_apps/test/lightning_modules/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/lightning_modules/pl_simple_baseline.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/logs/data/20260914T181722Z_000_data_train_2530.log\n/home/jovyan/surya_workshop2026/downstream_apps/test/logs/data/20260915T134848Z_000_data_train_828.log\n/home/jovyan/surya_workshop2026/downstream_apps/test/metrics/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/metrics/template_metrics.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/models/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/models/simple_baseline.py\n/home/jovyan/surya_workshop2026/downstream_apps/test/untitled.chat\n\n=== template/ tree ===\n/home/jovyan/surya_workshop2026/downstream_apps/template/0_dataset_dataloader_template.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/template/1_baseline_template.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/template/2_finetune_template_1D.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/template/3_finetune_template_1D.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/ADAPTING.md\n/home/jovyan/surya_workshop2026/downstream_apps/template/A_shapes_and_broadcasting.ipynb\n/home/jovyan/surya_workshop2026/downstream_apps/template/__pycache__/configs.cpython-312.pyc\n/home/jovyan/surya_workshop2026/downstream_apps/template/assets/.gitkeep\n/home/jovyan/surya_workshop2026/downstream_apps/template/configs.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/configs/config_script.yaml\n/home/jovyan/surya_workshop2026/downstream_apps/template/data/.ipynb_checkpoints/hek_flare_catalog-checkpoint.csv\n/home/jovyan/surya_workshop2026/downstream_apps/template/data/hek_flare_catalog.csv\n/home/jovyan/surya_workshop2026/downstream_apps/template/datasets/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/datasets/template_dataset.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/download_scalers.sh\n/home/jovyan/surya_workshop2026/downstream_apps/template/download_scalers_and_weights.sh\n/home/jovyan/surya_workshop2026/downstream_apps/template/lightning_modules/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/lightning_modules/pl_simple_baseline.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/metrics/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/metrics/template_metrics.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/models/__init__.py\n/home/jovyan/surya_workshop2026/downstream_apps/template/models/simple_baseline.py",
            "status": "completed"
          }
        ]
