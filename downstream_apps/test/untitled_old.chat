            "raw_input": {
              "command": "python3 - <<'EOF'\nimport numpy as np, pandas as pd\nWAVE='/home/jovyan/surya_workshop2026/downstream_apps/test/data/lcpf_aia_waves.csv'\nds=pd.read_csv(WAVE, low_memory=False)\nds['ds_index']=pd.to_datetime(ds['mid_time']).values.astype('datetime64[ns]')\nds=ds.sort_values('ds_index'); ds['label']=ds['class']\nkeep=['ds_index','label','start_time']\n\ndef vidx(split):\n    idx=pd.read_csv(f'/home/jovyan/surya_workshop2026/data/indices/surya_aws_s3_{split}.csv')\n    idx=idx[idx['present']==1]\n    idx['timestep']=pd.to_datetime(idx['timestep']).values.astype('datetime64[ns]')\n    return idx.set_index('timestep').sort_index().index\n\ndef matched(split, tol):\n    v=vidx(split)\n    dfv=pd.DataFrame({'valid_indices':list(v)}).sort_values('valid_indices')\n    m=pd.merge_asof(dfv, ds[keep], right_on='ds_index', left_on='valid_indices', direction='forward')\n    m['index_delta']=np.abs(m['valid_indices']-m['ds_index'])\n    m=m.sort_values(['ds_index','index_delta']).drop_duplicates(subset='ds_index',keep='first')\n    return m.loc[m['index_delta']<=pd.Timedelta(tol)]\n\n# ---- accounting for train misses\ntr=matched('train','4d')\nmiss=ds[~ds['ds_index'].isin(set(tr['ds_index']))].copy()\nvd=set(pd.Series(list(vidx('val'))).dt.floor('D')); td=set(pd.Series(list(vidx('test'))).dt.floor('D'))\ntrd=set(pd.Series(list(vidx('train'))).dt.floor('D'))\ntmin, tmax = vidx('train').min(), vidx('train').max()\ndef reason(r):\n    y=r['ds_index'].year; d=r['ds_index'].floor('D')\n    if y in (2012,2022): return 'year 2012/2022 absent from all splits'\n    if r['ds_index']>tmax: return 'after train index end (2025-2026)'\n    if r['ds_index']<tmin: return 'before train index start'\n    if d in vd: return 'falls on a VAL day'\n    if d in td: return 'falls on a TEST day'\n    if d not in trd: return 'day missing from train index (other gap)'\n    return 'in-coverage but no forward match <=4d'\nmiss['reason']=miss.apply(reason,axis=1)\nprint('TRAIN unmatched (4d) =', len(miss), 'of', len(ds))\nprint(miss.groupby(['reason','label']).size().unstack(fill_value=0).assign(total=lambda x:x.sum(1)).to_string())\nprint()\n\n# ---- test + full index for reference\nfor split in ['test','full_index']:\n    for tol in ['15min','4d']:\n        f=matched(split,tol)\n        print(f'{split:10s} tol={tol:>6}: n={len(f):5d} class={f[\"label\"].value_counts().to_dict()}')\nprint()\n# ---- what if ds_time_column were start_time\nds2=pd.read_csv(WAVE, low_memory=False)\nds2['ds_index']=pd.to_datetime(ds2['start_time']).values.astype('datetime64[ns]')\nds2=ds2.sort_values('ds_index'); ds2['label']=ds2['class']\nv=list(vidx('train')); dfv=pd.DataFrame({'valid_indices':v}).sort_values('valid_indices')\nm=pd.merge_asof(dfv, ds2[['ds_index','label']], right_on='ds_index', left_on='valid_indices', direction='forward')\nm['index_delta']=np.abs(m['valid_indices']-m['ds_index'])\nm=m.sort_values(['ds_index','index_delta']).drop_duplicates(subset='ds_index',keep='first')\nf=m.loc[m['index_delta']<=pd.Timedelta('4d')]\nprint('IF ds_time_column=start_time (train, 4d): n=',len(f), f['label'].value_counts().to_dict())\nEOF\n",
              "description": "Accounting of unmatched rows plus test/full index and start_time variant"
            },
            "tool_call_id": "toolu_bdrk_011A56kFnZWFqRwTV3jHxioH",
            "title": "python3 - <<'EOF' import numpy as np, pandas as pd WAVE='/home/jovyan/surya_workshop2026/downstream_apps/test/data/lcpf_aia_waves.csv' ds=pd.read_csv(WAVE, low_memory=False) ds['ds_index']=pd.to_datetime(ds['mid_time']).values.astype('datetime64[ns]') ds=ds.sort_values('ds_index'); ds['label']=ds['class'] keep=['ds_index','label','start_time'] def vidx(split): idx=pd.read_csv(f'/home/jovyan/surya_workshop2026/data/indices/surya_aws_s3_{split}.csv') idx=idx[idx['present']==1] idx['timestep']=pd.to_datetime(idx['timestep']).values.astype('datetime64[ns]') return idx.set_index('timestep').sort_index().index def matched(split, tol): v=vidx(split) dfv=pd.DataFrame({'valid_indices':list(v)}).sort_values('valid_indices') m=pd.merge_asof(dfv, ds[keep], right_on='ds_index', left_on='valid_indices', direction='forward') m['index_delta']=np.abs(m['valid_indices']-m['ds_index']) m=m.sort_values(['ds_index','index_delta']).drop_duplicates(subset='ds_index',keep='first') return m.loc[m['index_delta']<=pd.Timedelta(tol)] # ---- accounting for train misses tr=matched('train','4d') miss=ds[~ds['ds_index'].isin(set(tr['ds_index']))].copy() vd=set(pd.Series(list(vidx('val'))).dt.floor('D')); td=set(pd.Series(list(vidx('test'))).dt.floor('D')) trd=set(pd.Series(list(vidx('train'))).dt.floor('D')) tmin, tmax = vidx('train').min(), vidx('train').max() def reason(r): y=r['ds_index'].year; d=r['ds_index'].floor('D') if y in (2012,2022): return 'year 2012/2022 absent from all splits' if r['ds_index']>tmax: return 'after train index end (2025-2026)' if r['ds_index']<tmin: return 'before train index start' if d in vd: return 'falls on a VAL day' if d in td: return 'falls on a TEST day' if d not in trd: return 'day missing from train index (other gap)' return 'in-coverage but no forward match <=4d' miss['reason']=miss.apply(reason,axis=1) print('TRAIN unmatched (4d) =', len(miss), 'of', len(ds)) print(miss.groupby(['reason','label']).size().unstack(fill_value=0).assign(total=lambda x:x.sum(1)).to_string()) print() # ---- test + full index for reference for split in ['test','full_index']: for tol in ['15min','4d']: f=matched(split,tol) print(f'{split:10s} tol={tol:>6}: n={len(f):5d} class={f[\"label\"].value_counts().to_dict()}') print() # ---- what if ds_time_column were start_time ds2=pd.read_csv(WAVE, low_memory=False) ds2['ds_index']=pd.to_datetime(ds2['start_time']).values.astype('datetime64[ns]') ds2=ds2.sort_values('ds_index'); ds2['label']=ds2['class'] v=list(vidx('train')); dfv=pd.DataFrame({'valid_indices':v}).sort_values('valid_indices') m=pd.merge_asof(dfv, ds2[['ds_index','label']], right_on='ds_index', left_on='valid_indices', direction='forward') m['index_delta']=np.abs(m['valid_indices']-m['ds_index']) m=m.sort_values(['ds_index','index_delta']).drop_duplicates(subset='ds_index',keep='first') f=m.loc[m['index_delta']<=pd.Timedelta('4d')] print('IF ds_time_column=start_time (train, 4d): n=',len(f), f['label'].value_counts().to_dict()) EOF",
            "raw_output": "TRAIN unmatched (4d) = 596 of 1828\nlabel                                     no wave  wave  total\nreason                                                        \nafter train index end (2025-2026)              79    79    158\nbefore train index start                        3     3      6\nday missing from train index (other gap)       46    48     94\nfalls on a TEST day                            25    25     50\nfalls on a VAL day                             14    14     28\nin-coverage but no forward match <=4d           0     6      6\nyear 2012/2022 absent from all splits         127   127    254\n\ntest       tol= 15min: n=   51 class={'no wave': 26, 'wave': 25}\ntest       tol=    4d: n=   54 class={'no wave': 29, 'wave': 25}\nfull_index tol= 15min: n= 1638 class={'wave': 820, 'no wave': 818}\nfull_index tol=    4d: n= 1650 class={'no wave': 829, 'wave': 821}\n\nIF ds_time_column=start_time (train, 4d): n= 620 {'wave': 328, 'no wave': 292}"
