        "tool_calls": [
          {
            "raw_input": {
              "command": "cat > /tmp/bench_gpu.py <<'PY'\nimport sys, time, os\nsys.path.insert(0, \"/home/jovyan/surya_workshop2026\")\nos.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\nimport torch\nfrom downstream_apps.test.configs import load_wave_config\nfrom downstream_apps.test.experiments import wave_common as wc\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer1D\nfrom workshop_infrastructure.utils import apply_peft_lora, load_pretrained_weights\n\ntorch.set_float32_matmul_precision(\"medium\")\ncfg = load_wave_config(\"/home/jovyan/surya_workshop2026/downstream_apps/test/configs/config_wave_full.yaml\")\nmodel = HelioSpectformer1D.from_config(cfg.model, num_outputs=1, dtype=cfg.dtype)\nload_pretrained_weights(model, cfg.model.pretrained_path)\nwc.assert_tokenizer_loaded(model, cfg.model.pretrained_path)\nmodel = apply_peft_lora(model, cfg.model.lora_config)\nwc.assert_lora_adapted_attention(model)\nwc.assert_trainable_count(model, 1_518_081)\nmodel = model.cuda()\nopt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4)\nloss_fn = torch.nn.functional.binary_cross_entropy_with_logits\nprint(f\"total VRAM {torch.cuda.get_device_properties(0).total_memory/2**30:.1f} GiB\")\n\nfor B in (1, 2, 3):\n    torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n    try:\n        ts = torch.randn(B, 13, 2, 4096, 4096, device=\"cuda\")\n        batch = {\"ts\": ts,\n                 \"time_delta_input\": torch.tensor([[0.2, 0.0]]*B, device=\"cuda\"),\n                 \"forecast\": torch.randint(0, 2, (B,), device=\"cuda\").float()}\n        times = []\n        for i in range(4):\n            torch.cuda.synchronize(); t0 = time.time()\n            opt.zero_grad(set_to_none=True)\n            with torch.autocast(\"cuda\", dtype=torch.bfloat16):\n                out = model(batch)\n                loss = loss_fn(out.float().reshape(-1), batch[\"forecast\"].reshape(-1))\n            loss.backward(); opt.step()\n            torch.cuda.synchronize(); times.append(time.time()-t0)\n        steady = sum(times[1:])/len(times[1:])\n        print(f\"B={B}  {steady:5.2f} s/step  {steady/B:5.2f} s/sample  \"\n              f\"peak alloc {torch.cuda.max_memory_allocated()/2**30:5.1f} GiB  \"\n              f\"reserved {torch.cuda.max_memory_reserved()/2**30:5.1f} GiB\", flush=True)\n        del ts, batch, out, loss\n    except torch.OutOfMemoryError:\n        print(f\"B={B}  OOM\", flush=True)\n        break\nPY\ncd /home/jovyan/surya_workshop2026 && nohup /home/jovyan/envs/surya_WS/bin/python -u /tmp/bench_gpu.py > /tmp/bench_gpu.log 2>&1 & echo started",
