            "raw_output": "{\"result\":[{\"cellType\":\"code\",\"source\":\"#max_epochs = 4  # previous value: hardcoded, ignored cfg.max_epochs entirely\\nmax_epochs = cfg.max_epochs  # now driven by training.max_epochs in config_script.yaml\\n\\n# -------------------------------------------------------------------------\\n# Trainer \u2014 one per baseline, so each gets its own checkpoint/logger state and their\\n# validation metrics are directly comparable side by side.\\n# -------------------------------------------------------------------------\\ntrainer_constant = L.Trainer(\\n    max_epochs=max_epochs,\\n    accelerator=\\\"auto\\\",\\n    devices=\\\"auto\\\",\\n    logger=make_loggers(\\\"baseline_constant_prob\\\"),\\n    callbacks=[ModelCheckpoint(monitor=\\\"val_loss\\\", mode=\\\"min\\\", save_top_k=1)],\\n    log_every_n_steps=2,\\n)\\n\\ntrainer_running_diff = L.Trainer(\\n    max_epochs=max_epochs,\\n    accelerator=\\\"auto\\\",\\n    devices=\\\"auto\\\",\\n    logger=make_loggers(\\\"baseline_running_diff\\\"),\\n    callbacks=[ModelCheckpoint(monitor=\\\"val_loss\\\", mode=\\\"min\\\", save_top_k=1)],\\n    log_every_n_steps=2,\\n)\\n\",\"execution_count\":28,\"cell_id\":\"b008c604\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"GPU available: True (cuda), used: True\\n\"},{\"output_type\":\"stream\",\"text\":\"TPU available: False, using: 0 TPU cores\\n\"},{\"output_type\":\"stream\",\"text\":\"\ud83d\udca1 Tip: For seamless cloud logging and experiment tracking, try installing [litlogger](https://pypi.org/project/litlogger/) to enable LitLogger, which logs metrics and artifacts automatically to the Lightning Experiments platform.\\n\"},{\"output_type\":\"stream\",\"text\":\"GPU available: True (cuda), used: True\\n\"},{\"output_type\":\"stream\",\"text\":\"TPU available: False, using: 0 TPU cores\\n\"},{\"output_type\":\"stream\",\"text\":\"\ud83d\udca1 Tip: For seamless cloud logging and experiment tracking, try installing [litlogger](https://pypi.org/project/litlogger/) to enable LitLogger, which logs metrics and artifacts automatically to the Lightning Experiments platform.\\n\"}]}]}",
