              "description": "Launch memory-path benchmark",
              "command": "cat > /tmp/bench_mem.py <<'PY'\nimport sys, os, io, time\nsys.path.insert(0,'/home/jovyan/surya_workshop2026')\nimport numpy as np, pandas as pd, xarray as xr, hdf5plugin  # noqa\nfrom concurrent.futures import ThreadPoolExecutor\nfrom boto3.s3.transfer import TransferConfig\nfrom workshop_infrastructure.utils import make_s3_client\n\nCH13 = ['aia94','aia131','aia171','aia193','aia211','aia304','aia335','aia1600',\n        'hmi_m','hmi_bx','hmi_by','hmi_bz','hmi_v']\nidx = pd.read_csv('/home/jovyan/surya_workshop2026/data/indices/surya_aws_s3_train.csv',\n                  usecols=['path','present'])\nuris = [p for p in idx[idx['present']==1]['path'].tolist()[::911]][:24]\nclient = make_s3_client(anon=True, region='us-east-1', pool_size=128, max_attempts=3)\ncfg = TransferConfig(multipart_threshold=64*2**20, multipart_chunksize=64*2**20,\n                     max_concurrency=8, use_threads=True)\n\ndef fetch(uri):\n    b, k = uri[5:].split('/', 1)\n    buf = io.BytesIO()\n    client.download_fileobj(b, k, buf, Config=cfg)\n    return buf\n\nprint(\"--- single frame: fetch to memory, then decode ---\", flush=True)\nt0=time.time(); buf=fetch(uris[0]); t1=time.time()\nbuf.seek(0)\nwith xr.open_dataset(buf, engine='h5netcdf', chunks=None, cache=False) as ds:\n    a = ds[CH13].to_array().load().to_numpy()\nt2=time.time()\nbuf.seek(0)\nwith xr.open_dataset(buf, engine='h5netcdf', chunks=None, cache=False) as ds:\n    a1 = ds[['aia193']].to_array().load().to_numpy()\nt3=time.time()\nnb = buf.getbuffer().nbytes\nprint(f\"  fetch {nb/2**20:.0f} MiB in {t1-t0:.2f}s = {nb/(t1-t0)/2**20:.0f} MB/s\", flush=True)\nprint(f\"  decode 13ch {t2-t1:.2f}s shape {a.shape} dtype {a.dtype}\", flush=True)\nprint(f\"  decode  1ch {t3-t2:.2f}s shape {a1.shape}\", flush=True)\n\nfor n in (4, 8, 12):\n    sel = uris[1:1+n]\n    t0=time.time()\n    with ThreadPoolExecutor(max_workers=n) as ex:\n        bufs = list(ex.map(fetch, sel))\n    dt=time.time()-t0\n    tot=sum(b.getbuffer().nbytes for b in bufs)\n    print(f\"--- {n} frames in parallel: {tot/2**30:.1f} GiB in {dt:.1f}s \"\n          f\"= {tot/dt/2**20:.0f} MB/s aggregate ({dt/n:.2f} s/frame)\", flush=True)\n    del bufs\nPY\nnohup /home/jovyan/envs/surya_WS/bin/python -u /tmp/bench_mem.py > /tmp/bench_mem.log 2>&1 &\necho \"started\""
            },
