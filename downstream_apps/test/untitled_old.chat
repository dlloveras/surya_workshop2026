            "raw_output": "{\"result\":[{\"cellType\":\"code\",\"source\":\"train_dataset = waveDSDataset(\\n    #### All these lines are required by the parent HelioNetCDFDataset class\\n    index_path=cfg.data.train_data_path,\\n    time_delta_input_minutes=cfg.data.time_delta_input_minutes,\\n    time_delta_target_minutes=cfg.data.time_delta_target_minutes,\\n    n_input_timestamps=cfg.model.time_embedding.time_dim,\\n    rollout_steps=cfg.rollout_steps,\\n    channels=cfg.data.channels,\\n    drop_hmi_probability=cfg.drop_hmi_probability,\\n    use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\\n    scalers=scalers,\\n    phase=\\\"train\\\",          # \\\"val\\\" disables random channel masking and flips\\n    # How s3:// paths in the index are read: \\\"download\\\" (default) | \\\"simplecache\\\" | \\\"stream\\\".\\n    # \\\"download\\\" fetches each file into s3_cache_dir first \u2014 recommended for NetCDF.\\n    s3_mode=cfg.data.s3_mode,\\n    s3_storage_options={\\\"anon\\\": cfg.data.s3_anon},\\n    s3_cache_dir=cfg.data.s3_cache_dir,\\n    #### Put your downstream (DS) specific parameters below this line\\n    return_surya_stack=False,\\n    max_number_of_samples=6,\\n    ds_flare_index_path=cfg.data.flare_index_path,\\n    ds_time_column=cfg.data.ds_time_column,\\n    ds_class_column=cfg.data.ds_class_column,\\n    ds_time_tolerance=cfg.data.ds_time_tolerance,\\n    ds_match_direction=cfg.data.ds_match_direction,\\n    # Encode the \\\"wave\\\" / \\\"no wave\\\" label as a binary float: wave -> 1.0, no wave -> 0.0.\\n    label_transform=lambda s: (s == \\\"wave\\\").astype(np.float32),\\n)\\n\\n# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\n# workshop_infrastructure/datasets/builders.py fills in everything above the\\n# \\\"downstream specific\\\" line straight from the config.\\n\",\"execution_count\":4,\"cell_id\":\"f76d377c\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"error\",\"text\":\"NameError: name 'scalers' is not defined\\n\\u001b[0;31m---------------------------------------------------------------------------\\u001b[0m\\n\\u001b[0;31mNameError\\u001b[0m                                 Traceback (most recent call last)\\nCell \\u001b[0;32mIn[4], line 11\\u001b[0m\\n\\u001b[1;32m      1\\u001b[0m train_dataset \\u001b[38;5;241m=\\u001b[39m waveDSDataset(\\n\\u001b[1;32m      2\\u001b[0m     \\u001b[38;5;66;03m#### All these lines are required by the parent HelioNetCDFDataset class\\u001b[39;00m\\n\\u001b[1;32m      3\\u001b[0m     index_path\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mtrain_data_path,\\n\\u001b[1;32m      4\\u001b[0m     time_delta_input_minutes\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mtime_delta_input_minutes,\\n\\u001b[1;32m      5\\u001b[0m     time_delta_target_minutes\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mtime_delta_target_minutes,\\n\\u001b[1;32m      6\\u001b[0m     n_input_timestamps\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mmodel\\u001b[38;5;241m.\\u001b[39mtime_embedding\\u001b[38;5;241m.\\u001b[39mtime_dim,\\n\\u001b[1;32m      7\\u001b[0m     rollout_steps\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mrollout_steps,\\n\\u001b[1;32m      8\\u001b[0m     channels\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mchannels,\\n\\u001b[1;32m      9\\u001b[0m     drop_hmi_probability\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdrop_hmi_probability,\\n\\u001b[1;32m     10\\u001b[0m     use_latitude_in_learned_flow\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39muse_latitude_in_learned_flow,\\n\\u001b[0;32m---> 11\\u001b[0m     scalers\\u001b[38;5;241m=\\u001b[39m\\u001b[43mscalers\\u001b[49m,\\n\\u001b[1;32m     12\\u001b[0m     phase\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124mtrain\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m,          \\u001b[38;5;66;03m# \\\"val\\\" disables random channel masking and flips\\u001b[39;00m\\n\\u001b[1;32m     13\\u001b[0m     \\u001b[38;5;66;03m# How s3:// paths in the index are read: \\\"download\\\" (default) | \\\"simplecache\\\" | \\\"stream\\\".\\u001b[39;00m\\n\\u001b[1;32m     14\\u001b[0m     \\u001b[38;5;66;03m# \\\"download\\\" fetches each file into s3_cache_dir first \u2014 recommended for NetCDF.\\u001b[39;00m\\n\\u001b[1;32m     15\\u001b[0m     s3_mode\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39ms3_mode,\\n\\u001b[1;32m     16\\u001b[0m     s3_storage_options\\u001b[38;5;241m=\\u001b[39m{\\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124manon\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m: cfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39ms3_anon},\\n\\u001b[1;32m     17\\u001b[0m     s3_cache_dir\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39ms3_cache_dir,\\n\\u001b[1;32m     18\\u001b[0m     \\u001b[38;5;66;03m#### Put your downstream (DS) specific parameters below this line\\u001b[39;00m\\n\\u001b[1;32m     19\\u001b[0m     return_surya_stack\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;28;01mFalse\\u001b[39;00m,\\n\\u001b[1;32m     20\\u001b[0m     max_number_of_samples\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;241m6\\u001b[39m,\\n\\u001b[1;32m     21\\u001b[0m     ds_flare_index_path\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mflare_index_path,\\n\\u001b[1;32m     22\\u001b[0m     ds_time_column\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_time_column,\\n\\u001b[1;32m     23\\u001b[0m     ds_class_column\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_class_column,\\n\\u001b[1;32m     24\\u001b[0m     ds_time_tolerance\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_time_tolerance,\\n\\u001b[1;32m     25\\u001b[0m     ds_match_direction\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_match_direction,\\n\\u001b[1;32m     26\\u001b[0m     \\u001b[38;5;66;03m# Encode the \\\"wave\\\" / \\\"no wave\\\" label as a binary float: wave -> 1.0, no wave -> 0.0.\\u001b[39;00m\\n\\u001b[1;32m     27\\u001b[0m     label_transform\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;28;01mlambda\\u001b[39;00m s: (s \\u001b[38;5;241m==\\u001b[39m \\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124mwave\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m)\\u001b[38;5;241m.\\u001b[39mastype(np\\u001b[38;5;241m.\\u001b[39mfloat32),\\n\\u001b[1;32m     28\\u001b[0m )\\n\\u001b[1;32m     30\\u001b[0m \\u001b[38;5;66;03m# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\u001b[39;00m\\n\\u001b[1;32m     31\\u001b[0m \\u001b[38;5;66;03m# workshop_infrastructure/datasets/builders.py fills in everything above the\\u001b[39;00m\\n\\u001b[1;32m     32\\u001b[0m \\u001b[38;5;66;03m# \\\"downstream specific\\\" line straight from the config.\\u001b[39;00m\\n\\n\\u001b[0;31mNameError\\u001b[0m: name 'scalers' is not defined\"}]}]}",
            "kind": "other",
            "title": "mcp__Jupyter_MCP_Server__read_notebook_cells",
            "tool_call_id": "toolu_bdrk_013cvXvMdaY8pYXiCZwQM5uW"
          },
          {
            "raw_input": {
              "notebook_path": "surya_workshop2026/downstream_apps/test/0_dataset_dataloader_template_diego.ipynb"
            },
            "title": "mcp__Jupyter_MCP_Server__read_notebook_cells",
            "raw_output": "{\"result\":[{\"cellType\":\"markdown\",\"source\":\"# PyTorch dataset template\\n\\nby Andr\u00e9s Mu\u00f1oz-Jaramillo\\n\\nThis notebook is meant to act as a template to create a custom dataset based on a downstream application (DS) index.\\n\\nIt requires an DS index file to be combined with a HelioFM index.  It also shows how to create a child database class based on HelioFM's database class so that all the code related to the input data is handled transparently, while the new code focuses exclusively in adding the DS information\\n\\nThis template uses a flare forecasting dataset as an example, casting the problem as an X-ray flux regression problem\",\"execution_count\":null,\"cell_id\":\"d651fb69\"},{\"cellType\":\"code\",\"source\":\"# Must be set BEFORE torch is imported: cuBLAS reads this once, when it initializes, so\\n# setting it later has no effect. It is what lets training.deterministic work without a\\n# cuBLAS warning on every run. (Restart the kernel if torch was already imported.)\\nimport os\\nos.environ.setdefault(\\\"CUBLAS_WORKSPACE_CONFIG\\\", \\\":4096:8\\\")\\n\\nimport numpy as np\\nimport sys\\nfrom torch.utils.data import DataLoader\\nimport matplotlib.pyplot as plt\\nimport sunpy.visualization.colormaps as cm\\nimport matplotlib.gridspec as gridspec\\n\\nimport yaml\\n\\n# Append base path.  May need to be modified if the folder structure changes.\\n# It gives the notebook access to the wokshop_infrastructure folder.\\nsys.path.append(\\\"../../\\\")\\n \\n# Append Surya path. May need to be modified if the folder structure changes.\\n# It gives the notebook access to surya's release code.\\n\\nfrom workshop_infrastructure.utils import build_scalers  # Data scaling utilities for Surya stacks\",\"execution_count\":1,\"cell_id\":\"4ed04321\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Load configuration\\n\\nSurya was designed to read a configuration file that defines many aspects of the model\\nincluding the data it uses we use this config file to set default values that do not\\nneed to be modified, but also to define values specific to our downstream application\",\"execution_count\":null,\"cell_id\":\"04135ff7\"},{\"cellType\":\"code\",\"source\":\"# The config is the single source of truth. load_flare_config() parses it into a typed\\n# object, exactly as the training script 3_finetune_template_1D.py does, so the same YAML\\n# behaves identically in the notebook and in production.\\n#\\n# Typed means: cfg.data.channels instead of config[\\\"data\\\"][\\\"channels\\\"] \u2014 you get IDE\\n# completion, and a misspelled key fails here with a list of the valid ones instead of\\n# silently doing nothing.\\nfrom downstream_apps.test.configs import load_flare_config\\n\\ncfg = load_flare_config(\\\"./configs/config_script.yaml\\\")\\nprint(f\\\"Loaded config for job: {cfg.job_id}\\\")\\n\\n# Paths in the YAML are relative to the config file, and come back resolved:\\nprint(f\\\"  train index : {cfg.data.train_data_path}\\\")\\nprint(f\\\"  scalers     : {cfg.data.scalers_path}\\\")\\n\",\"execution_count\":2,\"cell_id\":\"63c1fe60\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"Loaded config for job: wave_classification\\n  train index : /home/jovyan/surya_workshop2026/data/indices/surya_aws_s3_train.csv\\n  scalers     : /home/jovyan/surya_workshop2026/downstream_apps/test/assets/scalers.yaml\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Download assets\\n\\nThe config says where the assets belong, so it is loaded first. `ensure_assets()` fetches only what is missing from HuggingFace, so re-running this is free.\\n\",\"execution_count\":null,\"cell_id\":\"cdce2fa8\"},{\"cellType\":\"code\",\"source\":\"# One implementation, shared by the notebooks, the training script and the\\n# download_*.sh wrappers: workshop_infrastructure/assets.py.\\n# This notebook only needs the scalers - no backbone is loaded.\\nfrom workshop_infrastructure.assets import ensure_assets\\n\\nensure_assets(cfg, which=[\\\"scalers\\\"])\\n\\n# Now that scalers.yaml is guaranteed to be on disk, load it. build_scalers()\\n# accepts the resolved path directly.\\nscalers = build_scalers(info=cfg.data.scalers_path)\\nprint(f\\\"Loaded scalers for {len(scalers)} channels.\\\")\\n\",\"execution_count\":3,\"cell_id\":\"92901c1e\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"Loaded scalers for 13 channels.\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Define DS dataset\\n\\nThis child class takes as input all expected HelioFM parameters, plus additonal parameters relevant to the downstream application.  Here we focus in particular to the DS index and parameters necessary to combine it with the HelioFM index.\\n\\nAnother important component of creating a dataset class for your DS is normalization.  Here we use a log normalization on xray flux that will act as the output target.  Making log10(xray_flux) strictly positive and having 66% of its values between 0 and 1\\n\\nSince we are going to use this dataset moving forward, it is better to develop it as script and not as a notebook.\",\"execution_count\":null,\"cell_id\":\"af6574dc\"},{\"cellType\":\"code\",\"source\":\"from downstream_apps.test.datasets.wave_dataset import waveDSDataset\",\"execution_count\":3,\"cell_id\":\"34db2cc6\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Initialize class without Surya stacks\\n\\nAll the parameters that define a HelioFM dataset are contained within the test config file.  Scalers used to normalize HelioFm's input data are also necessary\\n\\n**_Important: This first initalization is set not to return the full Surya stack so that we can verify that the target is returning what we expect. This is so that you can check things quickly without having to pull full stacks until you need them._**\\n\\n_We do this by setting return_surya_stack=False_\\n\\nMake sure to set return_surya_stack=True if you need the full surya stack at this stage, otherwise we'll reinitialize the dataset shortly.\\n\\n**_Important:  In this notebook we sets max_number_of_samples=6 to potentially avoid going through the whole dataset as we explore it.  Keep in mind this for the future in case the database seems smaller than you expect_**\\n\",\"execution_count\":null,\"cell_id\":\"e319a7e4\"},{\"cellType\":\"code\",\"source\":\"train_dataset = waveDSDataset(\\n    #### All these lines are required by the parent HelioNetCDFDataset class\\n    index_path=cfg.data.train_data_path,\\n    time_delta_input_minutes=cfg.data.time_delta_input_minutes,\\n    time_delta_target_minutes=cfg.data.time_delta_target_minutes,\\n    n_input_timestamps=cfg.model.time_embedding.time_dim,\\n    rollout_steps=cfg.rollout_steps,\\n    channels=cfg.data.channels,\\n    drop_hmi_probability=cfg.drop_hmi_probability,\\n    use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\\n    scalers=scalers,\\n    phase=\\\"train\\\",          # \\\"val\\\" disables random channel masking and flips\\n    # How s3:// paths in the index are read: \\\"download\\\" (default) | \\\"simplecache\\\" | \\\"stream\\\".\\n    # \\\"download\\\" fetches each file into s3_cache_dir first \u2014 recommended for NetCDF.\\n    s3_mode=cfg.data.s3_mode,\\n    s3_storage_options={\\\"anon\\\": cfg.data.s3_anon},\\n    s3_cache_dir=cfg.data.s3_cache_dir,\\n    #### Put your downstream (DS) specific parameters below this line\\n    return_surya_stack=False,\\n    max_number_of_samples=6,\\n    ds_flare_index_path=cfg.data.flare_index_path,\\n    ds_time_column=cfg.data.ds_time_column,\\n    ds_class_column=cfg.data.ds_class_column,\\n    ds_time_tolerance=cfg.data.ds_time_tolerance,\\n    ds_match_direction=cfg.data.ds_match_direction,\\n    # Encode the \\\"wave\\\" / \\\"no wave\\\" label as a binary float: wave -> 1.0, no wave -> 0.0.\\n    label_transform=lambda s: (s == \\\"wave\\\").astype(np.float32),\\n)\\n\\n# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\n# workshop_infrastructure/datasets/builders.py fills in everything above the\\n# \\\"downstream specific\\\" line straight from the config.\\n\",\"execution_count\":4,\"cell_id\":\"f76d377c\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"error\",\"text\":\"NameError: name 'scalers' is not defined\\n\\u001b[0;31m---------------------------------------------------------------------------\\u001b[0m\\n\\u001b[0;31mNameError\\u001b[0m                                 Traceback (most recent call last)\\nCell \\u001b[0;32mIn[4], line 11\\u001b[0m\\n\\u001b[1;32m      1\\u001b[0m train_dataset \\u001b[38;5;241m=\\u001b[39m waveDSDataset(\\n\\u001b[1;32m      2\\u001b[0m     \\u001b[38;5;66;03m#### All these lines are required by the parent HelioNetCDFDataset class\\u001b[39;00m\\n\\u001b[1;32m      3\\u001b[0m     index_path\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mtrain_data_path,\\n\\u001b[1;32m      4\\u001b[0m     time_delta_input_minutes\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mtime_delta_input_minutes,\\n\\u001b[1;32m      5\\u001b[0m     time_delta_target_minutes\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mtime_delta_target_minutes,\\n\\u001b[1;32m      6\\u001b[0m     n_input_timestamps\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mmodel\\u001b[38;5;241m.\\u001b[39mtime_embedding\\u001b[38;5;241m.\\u001b[39mtime_dim,\\n\\u001b[1;32m      7\\u001b[0m     rollout_steps\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mrollout_steps,\\n\\u001b[1;32m      8\\u001b[0m     channels\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mchannels,\\n\\u001b[1;32m      9\\u001b[0m     drop_hmi_probability\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdrop_hmi_probability,\\n\\u001b[1;32m     10\\u001b[0m     use_latitude_in_learned_flow\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39muse_latitude_in_learned_flow,\\n\\u001b[0;32m---> 11\\u001b[0m     scalers\\u001b[38;5;241m=\\u001b[39m\\u001b[43mscalers\\u001b[49m,\\n\\u001b[1;32m     12\\u001b[0m     phase\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124mtrain\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m,          \\u001b[38;5;66;03m# \\\"val\\\" disables random channel masking and flips\\u001b[39;00m\\n\\u001b[1;32m     13\\u001b[0m     \\u001b[38;5;66;03m# How s3:// paths in the index are read: \\\"download\\\" (default) | \\\"simplecache\\\" | \\\"stream\\\".\\u001b[39;00m\\n\\u001b[1;32m     14\\u001b[0m     \\u001b[38;5;66;03m# \\\"download\\\" fetches each file into s3_cache_dir first \u2014 recommended for NetCDF.\\u001b[39;00m\\n\\u001b[1;32m     15\\u001b[0m     s3_mode\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39ms3_mode,\\n\\u001b[1;32m     16\\u001b[0m     s3_storage_options\\u001b[38;5;241m=\\u001b[39m{\\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124manon\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m: cfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39ms3_anon},\\n\\u001b[1;32m     17\\u001b[0m     s3_cache_dir\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39ms3_cache_dir,\\n\\u001b[1;32m     18\\u001b[0m     \\u001b[38;5;66;03m#### Put your downstream (DS) specific parameters below this line\\u001b[39;00m\\n\\u001b[1;32m     19\\u001b[0m     return_surya_stack\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;28;01mFalse\\u001b[39;00m,\\n\\u001b[1;32m     20\\u001b[0m     max_number_of_samples\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;241m6\\u001b[39m,\\n\\u001b[1;32m     21\\u001b[0m     ds_flare_index_path\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mflare_index_path,\\n\\u001b[1;32m     22\\u001b[0m     ds_time_column\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_time_column,\\n\\u001b[1;32m     23\\u001b[0m     ds_class_column\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_class_column,\\n\\u001b[1;32m     24\\u001b[0m     ds_time_tolerance\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_time_tolerance,\\n\\u001b[1;32m     25\\u001b[0m     ds_match_direction\\u001b[38;5;241m=\\u001b[39mcfg\\u001b[38;5;241m.\\u001b[39mdata\\u001b[38;5;241m.\\u001b[39mds_match_direction,\\n\\u001b[1;32m     26\\u001b[0m     \\u001b[38;5;66;03m# Encode the \\\"wave\\\" / \\\"no wave\\\" label as a binary float: wave -> 1.0, no wave -> 0.0.\\u001b[39;00m\\n\\u001b[1;32m     27\\u001b[0m     label_transform\\u001b[38;5;241m=\\u001b[39m\\u001b[38;5;28;01mlambda\\u001b[39;00m s: (s \\u001b[38;5;241m==\\u001b[39m \\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124mwave\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m)\\u001b[38;5;241m.\\u001b[39mastype(np\\u001b[38;5;241m.\\u001b[39mfloat32),\\n\\u001b[1;32m     28\\u001b[0m )\\n\\u001b[1;32m     30\\u001b[0m \\u001b[38;5;66;03m# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\u001b[39;00m\\n\\u001b[1;32m     31\\u001b[0m \\u001b[38;5;66;03m# workshop_infrastructure/datasets/builders.py fills in everything above the\\u001b[39;00m\\n\\u001b[1;32m     32\\u001b[0m \\u001b[38;5;66;03m# \\\"downstream specific\\\" line straight from the config.\\u001b[39;00m\\n\\n\\u001b[0;31mNameError\\u001b[0m: name 'scalers' is not defined\"}]},{\"cellType\":\"markdown\",\"source\":\"## Test length and structure\\n\\nNow we can test that the database is properly initialized and returns what is expected. In th case of the template, there are 6294 flares that take place during the training split\",\"execution_count\":null,\"cell_id\":\"82762d57\"},{\"cellType\":\"code\",\"source\":\"train_dataset.__len__()\",\"execution_count\":13,\"cell_id\":\"677d7c02\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"item = train_dataset.__getitem__(0)\\nitem.keys()\",\"execution_count\":null,\"cell_id\":\"8530a021\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"Note that the dataset returns a single item and it's always the same item according to the index used:\",\"execution_count\":null,\"cell_id\":\"a09615b0\"},{\"cellType\":\"code\",\"source\":\"train_dataset.__getitem__(0)\",\"execution_count\":null,\"cell_id\":\"8d2287e7\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"train_dataset.__getitem__(3)\",\"execution_count\":null,\"cell_id\":\"09cab5b9\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"train_dataset.__getitem__(3)\",\"execution_count\":null,\"cell_id\":\"ed680710\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Define dataloader\\n\\nWith a working dataset we can define a dataloader.  A dataloader is simply a wrapper around a dataset that includes a sampling strategy to turn your dataset into batches.   Once we request a batch, the dataloader will return a dictionary like the dataset, but data inside will have a batch dimension\",\"execution_count\":null,\"cell_id\":\"719afb0d\"},{\"cellType\":\"code\",\"source\":\"data_loader = DataLoader(\\n                dataset=train_dataset,\\n                batch_size=5,\\n                num_workers=8\\n            )\",\"execution_count\":null,\"cell_id\":\"19f7caf5\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"batch = next(iter(data_loader))\\nbatch.keys()\",\"execution_count\":null,\"cell_id\":\"399c8553\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"Now the batch will have more than one item\",\"execution_count\":null,\"cell_id\":\"d6dad7b0\"},{\"cellType\":\"code\",\"source\":\"batch\",\"execution_count\":null,\"cell_id\":\"b93f7a50\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"Typically we set dataloaders to shufle the data so that the model sees data in different order during training.  This means that in general we don't want and don't expect the batch to return the same sequence of events.\",\"execution_count\":null,\"cell_id\":\"31bce301\"},{\"cellType\":\"code\",\"source\":\"data_loader = DataLoader(\\n                dataset=train_dataset,\\n                batch_size=5,\\n                shuffle=True,\\n            )\\n\\nnext(iter(data_loader))\",\"execution_count\":null,\"cell_id\":\"c3acdc4b\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Initialize class with Surya stacks\\n\\nNow we initalize the database to return full surya stacks to visualize them by setting _return_surya_stack=True_\",\"execution_count\":null,\"cell_id\":\"307aaa56\"},{\"cellType\":\"code\",\"source\":\"train_dataset = waveDSDataset(\\n    #### All these lines are required by the parent HelioNetCDFDataset class\\n    index_path=cfg.data.train_data_path,\\n    time_delta_input_minutes=cfg.data.time_delta_input_minutes,\\n    time_delta_target_minutes=cfg.data.time_delta_target_minutes,\\n    n_input_timestamps=cfg.model.time_embedding.time_dim,\\n    rollout_steps=cfg.rollout_steps,\\n    channels=cfg.data.channels,\\n    drop_hmi_probability=cfg.drop_hmi_probability,\\n    use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\\n    scalers=scalers,\\n    phase=\\\"train\\\",          # \\\"val\\\" disables random channel masking and flips\\n    # How s3:// paths in the index are read: \\\"download\\\" (default) | \\\"simplecache\\\" | \\\"stream\\\".\\n    # \\\"download\\\" fetches each file into s3_cache_dir first \u2014 recommended for NetCDF.\\n    s3_mode=cfg.data.s3_mode,\\n    s3_storage_options={\\\"anon\\\": cfg.data.s3_anon},\\n    s3_cache_dir=cfg.data.s3_cache_dir,\\n    #### Put your downstream (DS) specific parameters below this line\\n    return_surya_stack=True,\\n    max_number_of_samples=6,\\n    ds_flare_index_path=cfg.data.flare_index_path,\\n    ds_time_column=cfg.data.ds_time_column,\\n    ds_class_column=cfg.data.ds_class_column,\\n    ds_time_tolerance=cfg.data.ds_time_tolerance,\\n    ds_match_direction=cfg.data.ds_match_direction,\\n    # Encode the \\\"wave\\\" / \\\"no wave\\\" label as a binary float: wave -> 1.0, no wave -> 0.0.\\n    label_transform=lambda s: (s == \\\"wave\\\").astype(np.float32),\\n)\\n\\n# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\n# workshop_infrastructure/datasets/builders.py fills in everything above the\\n# \\\"downstream specific\\\" line straight from the config.\\n\",\"execution_count\":null,\"cell_id\":\"70e9c5b2\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"In surya's convention an item contains the following elements:\\n- 'ts': input tensor.\\n- 'time_delta_input': minutes with respect to the present in the time dimension of the input tensor.\\n- 'forecast': target SDO stack.\\n- 'lead_time_delta': how many minutes into the future is the target stack with respect to the present.\\n\",\"execution_count\":null,\"cell_id\":\"18403f11\"},{\"cellType\":\"code\",\"source\":\"item = train_dataset.__getitem__(0)\\nitem.keys()\",\"execution_count\":null,\"cell_id\":\"a9108229\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"The shape of the input tensors has dimensions [C, T, H, W], where\\n- C: instrument channels.\\n- T: timestamps.\\n- H: Height.\\n- W: Width.\",\"execution_count\":null,\"cell_id\":\"31ba5cc8\"},{\"cellType\":\"code\",\"source\":\"item['ts'].shape\",\"execution_count\":null,\"cell_id\":\"5fce6a63\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Plotting input stack\\n\\nBefore plotting, it is necessary to undo the z-score and logarithmic normalization.\",\"execution_count\":null,\"cell_id\":\"a6f0731f\"},{\"cellType\":\"code\",\"source\":\"unnormalized_ts = train_dataset.inverse_transform_data(item['ts'][:,0,...])\\nchannel_order = cfg.data.channels\\nfig = plt.figure(figsize=np.array([4,4]), dpi=300)\\ngs = gridspec.GridSpec(4, 4, figure=fig, wspace=0, hspace=0)\\n\\nlimits = {}\\n\\nfor i in range(4):\\n    for j in range(4):\\n        n = i*4 + j\\n        if n < len(channel_order):\\n\\n            ax = fig.add_subplot(gs[i,j])\\n            channel = channel_order[n]\\n            if 'hmi' not in channel:\\n                lim = np.percentile(unnormalized_ts[n,...][unnormalized_ts[n,...]!=0], 99)\\n                ax.imshow(unnormalized_ts[n,...], cmap=f'sdo{channel}', vmin=0, vmax=lim)\\n                font_color = 'w'\\n\\n            else:\\n                font_color = 'k'\\n                if \\\"_v\\\" not in channel:\\n                    lim = 1000\\n                    ax.imshow(unnormalized_ts[n,...], cmap=f'hmimag', vmin = -lim, vmax=lim)\\n                else:\\n                    lim = 1000\\n                    ax.imshow(unnormalized_ts[n,...], cmap=f'coolwarm', vmin = -lim, vmax=lim)                    \\n\\n            ax.text(0.01, 0.99, channel, transform=ax.transAxes, horizontalalignment='left', verticalalignment='top', color=font_color, fontsize=5)  \\n            ax.set_xticks([])\\n            ax.set_yticks([])             \\n\",\"execution_count\":null,\"cell_id\":\"0ecf04d8\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Define dataloader\\n\\nNow the dataloader will return also a surya stack alongside our flaring data\",\"execution_count\":null,\"cell_id\":\"bb13f88b\"},{\"cellType\":\"code\",\"source\":\"data_loader = DataLoader(\\n                dataset=train_dataset,\\n                batch_size=2\\n            )\",\"execution_count\":null,\"cell_id\":\"ffc696b6\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"batch = next(iter(data_loader))\\nbatch.keys()\",\"execution_count\":null,\"cell_id\":\"f3716611\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"And now it will also have a batch dimension of 2 (batch dimensions are typically the leftmost dimension in a tensor's shape)\",\"execution_count\":null,\"cell_id\":\"4c92a13a\"},{\"cellType\":\"code\",\"source\":\"batch['ts'].shape\",\"execution_count\":null,\"cell_id\":\"368b242f\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Conclusions\\n\\nOnce this notebook runs successfully you have a dataset and dataloaders done and ready to train a DS application. The next step continues in 1_baseline_template.ipynb which will involve putting together a simple baseline including metrics and a training loop that can be used to compare with Surya.\",\"execution_count\":null,\"cell_id\":\"4b56b26e\"},{\"cellType\":\"markdown\",\"source\":\"\",\"execution_count\":null,\"cell_id\":\"1f3f76e5\"},{\"cellType\":\"code\",\"source\":\"import cv2\\nimport numpy as np\\nimport matplotlib.pyplot as plt\\n\\ndef detect_euv_wave_classical(diff_image, k_sigma=3.0, min_area=100, min_aspect_ratio=2.0):\\n    \\\"\\\"\\\"\\n    Classical baseline for EUV wave detection using statistical thresholding\\n    and morphological connected component analysis.\\n    \\n    Parameters:\\n    - diff_image: 2D numpy array (float) representing the running difference image.\\n    - k_sigma: Multiplier for standard deviation to set the threshold.\\n    - min_area: Minimum pixel area to consider a component as a valid structure.\\n    - min_aspect_ratio: Minimum aspect ratio (max(w/h, h/w)) to distinguish \\n                        a diffuse, elongated wave arc from a compact flare.\\n                        \\n    Returns:\\n    - wave_mask: Binary mask of detected wave fronts.\\n    - dimming_mask: Binary mask of detected coronal dimmings.\\n    - bounding_boxes: List of (x, y, w, h) for detected wave fronts.\\n    \\\"\\\"\\\"\\n    # 1. Statistical Thresholding\\n    mu = np.mean(diff_image)\\n    sigma = np.std(diff_image)\\n    \\n    # Wave fronts are bright (positive tail), dimmings are dark (negative tail)\\n    thresh_bright = mu + (k_sigma * sigma)\\n    thresh_dark = mu - (k_sigma * sigma)\\n    \\n    # Create binary masks (convert to uint8 for OpenCV)\\n    mask_bright = (diff_image > thresh_bright).astype(np.uint8) * 255\\n    mask_dark = (diff_image < thresh_dark).astype(np.uint8) * 255\\n    \\n    # 2. Morphological Cleaning\\n    # Use an elliptical kernel to remove isolated \\\"hot pixels\\\" (cosmic rays)\\n    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\\n    \\n    # Opening = Erosion followed by Dilation (removes small noise)\\n    bright_clean = cv2.morphologyEx(mask_bright, cv2.MORPH_OPEN, kernel)\\n    dark_clean = cv2.morphologyEx(mask_dark, cv2.MORPH_OPEN, kernel)\\n    \\n    # 3. Connected Components Analysis on the bright mask (Wave fronts)\\n    # connectivity=8 looks at all surrounding pixels including diagonals\\n    num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(\\n        bright_clean, connectivity=8, ltype=cv2.CV_32S\\n    )\\n    \\n    final_wave_mask = np.zeros_like(bright_clean)\\n    valid_bboxes = []\\n    \\n    # 4. Filter by Shape and Size (Skip label 0, which is the background)\\n    for i in range(1, num_labels):\\n        x = stats[i, cv2.CC_STAT_LEFT]\\n        y = stats[i, cv2.CC_STAT_TOP]\\n        w = stats[i, cv2.CC_STAT_WIDTH]\\n        h = stats[i, cv2.CC_STAT_HEIGHT]\\n        area = stats[i, cv2.CC_STAT_AREA]\\n        \\n        # Calculate aspect ratio (longer side / shorter side)\\n        aspect_ratio = max(w / float(h), h / float(w))\\n        \\n        # Filter condition: Must be large enough AND elongated (not a circular flare)\\n        if area >= min_area and aspect_ratio >= min_aspect_ratio:\\n            # If it passes, add this component to our final mask\\n            final_wave_mask[labels == i] = 255\\n            valid_bboxes.append((x, y, w, h))\\n            \\n    return final_wave_mask, dark_clean, valid_bboxes\\n\\n\\n# ==========================================\\n# Test the pipeline with a synthetic image\\n# ==========================================\\nif __name__ == \\\"__main__\\\":\\n    # Create a noisy background centered around 0 (running diff background)\\n    synthetic_diff = np.random.normal(loc=0.0, scale=10.0, size=(512, 512))\\n    \\n    # Add a \\\"Flare\\\" (Compact, highly bright blob - should be rejected by aspect ratio)\\n    cv2.circle(synthetic_diff, (256, 256), 20, 150.0, -1)\\n    \\n    # Add a \\\"Dimming\\\" (Dark blob behind the wave)\\n    cv2.circle(synthetic_diff, (256, 256), 60, -80.0, 25)\\n    \\n    # Add an \\\"EUV Wave\\\" (Elongated, curved bright arc - should be accepted)\\n    cv2.ellipse(synthetic_diff, (256, 256), (120, 150), 45, 0, 120, 90.0, 15)\\n    \\n    # Run our baseline detector\\n    wave_mask, dimming_mask, bboxes = detect_euv_wave_classical(\\n        synthetic_diff, k_sigma=3.0, min_area=100, min_aspect_ratio=2.0\\n    )\\n    \\n    # Visualization\\n    fig, axs = plt.subplots(1, 3, figsize=(15, 5))\\n    \\n    # 1. Original\\n    axs[0].imshow(synthetic_diff, cmap='gray', vmin=-100, vmax=100)\\n    axs[0].set_title(\\\"Synthetic Running Difference\\\")\\n    \\n    # 2. Dimming Mask\\n    axs[1].imshow(dimming_mask, cmap='gray')\\n    axs[1].set_title(\\\"Detected Dimming (Negative Tail)\\\")\\n    \\n    # 3. Wave Mask with Bounding Boxes\\n    axs[2].imshow(wave_mask, cmap='gray')\\n    axs[2].set_title(\\\"Detected Wave (Elongated + Positive Tail)\\\")\\n    \\n    import matplotlib.patches as patches\\n    for (x, y, w, h) in bboxes:\\n        rect = patches.Rectangle((x, y), w, h, linewidth=2, edgecolor='red', facecolor='none')\\n        axs[2].add_patch(rect)\\n        \\n    plt.tight_layout()\\n    plt.show()\",\"execution_count\":null,\"cell_id\":\"cab4bda1-c0c9-4794-a0ee-ee5a557c1b53\",\"language\":\"python\"}]}",
            "kind": "other",
            "tool_call_id": "toolu_bdrk_01FmjaoZLMP6VRpR41dxwDek",
            "status": "completed"
          }
        ]
