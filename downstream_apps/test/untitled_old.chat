              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"experiments/wave_visibility_scan.py\")\ns = p.read_text()\n\n# The median line was plotted at REQUESTED offsets while per-event traces used ACHIEVED\n# ones, and the +30 verdict interpolated on the requested axis. Snapping moves an offset by\n# up to 6 min, so those are different x-axes.\nold = '''    df = pd.DataFrame(rows)\n    RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n    df.to_csv(RESULTS_DIR / \"wave_visibility.csv\", index=False)\n\n    summary = df.groupby(\"offset_min\")[[\"p999_snr\", \"std_snr\", \"pooled_max_snr\"]].agg(\n        [\"median\", \"mean\", \"std\"])\n    print(\"\\\\n[scan] SNR vs onset offset (1.0 = indistinguishable from the same event \"\n          \"one hour earlier)\")\n    print(summary.round(3).to_string())\n\n    med = df.groupby(\"offset_min\")[\"pooled_max_snr\"].median()\n    best_offset = int(med.idxmax())\n    # The sampled window for offset o is [o - step, o]; the catalog's positive sits at +30.\n    at_30 = float(np.interp(30, med.index.to_numpy(dtype=float), med.to_numpy()))\n    verdict = {\n        \"offsets\": offsets,'''\nnew = '''    df = pd.DataFrame(rows)\n    RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n    df.to_csv(RESULTS_DIR / \"wave_visibility.csv\", index=False)\n    report(df, offsets)\n\n\ndef report(df: pd.DataFrame, offsets: list[int]) -> None:\n    \"\"\"Summarize the scan, write the verdict, and draw the figure.\"\"\"\n    summary = df.groupby(\"offset_min\")[[\"p999_snr\", \"std_snr\", \"pooled_max_snr\"]].agg(\n        [\"median\", \"mean\", \"std\"])\n    print(\"\\\\n[scan] SNR vs onset offset (1.0 = indistinguishable from the same event \"\n          \"one hour earlier)\")\n    print(summary.round(3).to_string())\n\n    # Everything below is on the ACHIEVED offset axis. Snapping to the 12-minute cadence moves\n    # a requested offset by up to 6 min, so the requested value is only a grouping label \u2014\n    # interpolating the +30 verdict on it would read the curve at the wrong place.\n    med = df.groupby(\"offset_min\")[\"pooled_max_snr\"].median()\n    x = df.groupby(\"offset_min\")[\"achieved_offset_min\"].median()\n    best_offset = float(x.loc[med.idxmax()])\n    at_30 = float(np.interp(30, x.to_numpy(dtype=float), med.to_numpy()))\n    verdict = {\n        \"offsets\": offsets,\n        \"achieved_offsets_median\": {int(k): float(v) for k, v in x.items()},'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''        \"n_events\": len(usable),\n        \"events\": [str(e) for e in usable],\n        \"median_pooled_snr_by_offset\": {int(k): float(v) for k, v in med.items()},\n        \"best_offset_min\": best_offset,'''\nnew = '''        \"n_events\": int(df[\"event\"].nunique()),\n        \"events\": sorted(df[\"event\"].unique().tolist()),\n        \"median_pooled_snr_by_offset\": {int(k): float(v) for k, v in med.items()},\n        \"best_offset_min\": best_offset,'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''        \"verdict\": (\n            f\"Signal peaks at +{best_offset} min (median pooled SNR \"'''\nnew = '''        \"verdict\": (\n            f\"Signal peaks at +{best_offset:.0f} min (median pooled SNR \"'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''    Path(args.out).write_text(json.dumps(verdict, indent=2))\n    print(f\"\\\\n[scan] {verdict['verdict']}\")\n    print(f\"[out] {args.out}\")\n\n    plot(df, med, best_offset, at_30)'''\nnew = '''    (RESULTS_DIR / \"wave_visibility.json\").write_text(json.dumps(verdict, indent=2))\n    print(f\"\\\\n[scan] {verdict['verdict']}\")\n    print(f\"[out] {RESULTS_DIR / 'wave_visibility.json'}\")\n\n    plot(df, med, x, best_offset, at_30)'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''def plot(df: pd.DataFrame, med: pd.Series, best_offset: int, at_30: float) -> None:'''\nnew = '''def plot(df: pd.DataFrame, med: pd.Series, x: pd.Series,\n         best_offset: float, at_30: float) -> None:'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''        m = df.groupby(\"offset_min\")[key].median()\n        ax.plot(m.index, m.values, \"-o\", lw=2.5, color=\"C0\", label=\"median\")'''\nnew = '''        m = df.groupby(\"offset_min\")[key].median()\n        # Median plotted at the median ACHIEVED offset, so it lies on the same axis as the\n        # per-event traces above rather than up to 6 min away from them.\n        ax.plot(x.reindex(m.index).to_numpy(), m.to_numpy(), \"-o\", lw=2.5, color=\"C0\",\n                label=\"median\")'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''    fig.suptitle(\"Running-difference contrast vs where the positive sample is taken \"\n                 f\"(peak +{best_offset} min, +30 min at {at_30:.2f})\")'''\nnew = '''    fig.suptitle(\"Running-difference contrast vs where the positive sample is taken \"\n                 f\"(peak +{best_offset:.0f} min, +30 min at {at_30:.2f})\")'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\n# A --replot mode, so the verdict and figure can be redrawn from the CSV without re-reading\n# ~7 GB of frames from S3.\nold = '''def main() -> None:\n    args = parse_args()\n    offsets = [int(o) for o in args.offsets.split(\",\")]'''\nnew = '''def main() -> None:\n    args = parse_args()\n    offsets = [int(o) for o in args.offsets.split(\",\")]\n\n    if args.replot:\n        csv = RESULTS_DIR / \"wave_visibility.csv\"\n        if not csv.is_file():\n            raise SystemExit(f\"--replot needs {csv}, which does not exist yet.\")\n        print(f\"[scan] redrawing from {csv} \u2014 no frames read\")\n        report(pd.read_csv(csv), offsets)\n        return\n'''\nassert s.count(old) == 1\ns = s.replace(old, new)\ns = s.replace('    p.add_argument(\"--out\", default=str(RESULTS_DIR / \"wave_visibility.json\"))',\n              '    p.add_argument(\"--replot\", action=\"store_true\",\\n'\n              '                   help=\"Recompute the verdict and redraw the figure from the \"\\n'\n              '                        \"existing wave_visibility.csv, reading no frames.\")')\np.write_text(s)\nprint(\"verdict and plot now share the achieved-offset axis; --replot added\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile experiments/wave_visibility_scan.py && echo \"compiles ok\""
            },
