              "command": "cd /home/jovyan/surya_workshop2026 && cat > /tmp/pw_check.py <<'PY'\nimport torch\nfrom torch.utils.data import DataLoader, Dataset\n\nclass D(Dataset):\n    def __len__(self): return 8\n    def __getitem__(self, i): return torch.tensor([float(i)])\n\ndef probe(pw):\n    dl = DataLoader(D(), batch_size=2, num_workers=2,\n                    multiprocessing_context=\"spawn\", persistent_workers=pw)\n    for _ in range(2):                      # two \"fits\" over the same loader object\n        n = sum(1 for _ in dl)\n    print(f\"persistent_workers={pw}: two passes ok ({n} batches each), \"\n          f\"_iterator is {'retained (stateful)' if dl._iterator is not None else 'None (fresh pool each iter)'}\")\n\nif __name__ == \"__main__\":\n    probe(True)\n    probe(False)\nPY\n/home/jovyan/envs/surya_WS/bin/python /tmp/pw_check.py",
