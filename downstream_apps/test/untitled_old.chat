            "raw_output": "diff --git a/downstream_apps/test/configs/config_script.yaml b/downstream_apps/test/configs/config_script.yaml\nindex 586e251..986586b 100644\n--- a/downstream_apps/test/configs/config_script.yaml\n+++ b/downstream_apps/test/configs/config_script.yaml\n@@ -24,7 +24,7 @@\n #   --deterministic warn   (reproducible run; see training.deterministic below)\n # =============================================================================\n \n-job_id: solar_flare_forecasting\n+job_id: wave_classification\n \n \n # -----------------------------------------------------------------------------\n@@ -40,14 +40,14 @@ data:\n   channels: [aia94, aia131, aia171, aia193, aia211, aia304, aia335, aia1600,\n              hmi_m, hmi_bx, hmi_by, hmi_bz, hmi_v]\n   time_delta_input_minutes: [0]   # Offsets (minutes) of input frames relative to reference timestep\n-  time_delta_target_minutes: 60   # Step size (minutes) between forecast frames\n+  time_delta_target_minutes: 10   # Step size (minutes) between forecast frames\n \n   # -- Downstream label alignment (flare catalog \u2192 Surya index) --\n-  flare_index_path: ../data/hek_flare_catalog.csv\n-  ds_time_column: start_time      # Column in the flare catalog used as the event timestamp\n+  flare_index_path: ../data/lcpf_aia_waves.csv\n+  ds_time_column: mid_time      # Column in the flare catalog used as the event timestamp\n   ds_time_tolerance: 4d           # Max allowed gap between catalog and Surya timestamps\n   ds_match_direction: forward     # \"forward\": use solar state *before* the flare (causal)\n-\n+  ds_class_column: class #Class added wave or on wave by Diego.\n   # -- Local data (only needed when the index contains relative local paths) --\n   # sdo_data_root_path: /path/to/sdo   # Prepended to relative local paths; ignored for s3://\n \n@@ -79,7 +79,7 @@ data:\n   #\n   # If none is set and the index contains s3:// paths, the run fails immediately with a\n   # suggested path \u2014 not part-way through the first epoch. ~ and $ENV_VARS are expanded.\n-  s3_cache_dir: null\n+  s3_cache_dir: /home/jovyan/scratch_space/surya_cache/\n \n   # -- S3 transfer tuning --\n   # These control boto3's multipart download: how many threads download parts in\n@@ -208,5 +208,5 @@ output:\n # Logging\n # -----------------------------------------------------------------------------\n logging:\n-  wandb_project: template_flare_regression\n+  wandb_project: wave_classification\n   wandb_entity: null      # WandB team/org name; null to log to your personal account"
