            "raw_output": "1\timport numpy as np\n2\timport pandas as pd\n3\tfrom typing import Callable, Literal\n4\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n5\t\n6\t\n7\tclass waveDSDataset(HelioNetCDFDataset):\n8\t    \"\"\"\n9\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n10\t    Extends the base class with a wave/no-wave label aligned to the Surya index.\n11\t\n12\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n13\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n14\t    ``load_forecast_frames`` defaults to ``False`` here (this task supplies its own labels,\n15\t    so future Surya frames are never fetched); pass it explicitly to override.\n16\t\n17\t    Additional Args:\n18\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n19\t            Set to False to return only the wave/no-wave label (useful for label inspection).\n20\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n21\t        label_transform: Optional callable applied to the column named by ``ds_class_column``\n22\t            to produce the ``label`` column. Signature:\n23\t            ``(series: pd.Series) -> pd.Series``.  If ``None``, the raw column values are\n24\t            used as-is. Define this at the call site (e.g., in ``build_datasets()``) to keep\n25\t            normalization logic out of the dataset class.\n26\t        ds_wave_index_path: Path to the downstream wave/no-wave CSV index.\n27\t        ds_time_column: Column name in the wave index to use as the event timestamp.\n28\t        ds_class_column: Column name in the wave index holding the label (e.g. intensity,\n29\t            or a class string such as \"wave\" / \"no wave\") to pass through ``label_transform``.\n30\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n31\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n32\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n33\t            for causal prediction (predict from prior solar state).\n34\t\n35\t    Raises:\n36\t        ValueError: If ``ds_wave_index_path`` or ``ds_class_column`` is not provided, or if\n37\t            no overlap exists between the Surya and DS indices within the specified tolerance.\n38\t    \"\"\"\n39\t\n40\t    def __init__(\n41\t        self,\n42\t        # Downstream-specific parameters\n43\t        return_surya_stack: bool = True,\n44\t        max_number_of_samples: int | None = None,\n45\t        label_transform: Callable[[pd.Series], pd.Series] | None = None,\n46\t        ds_wave_index_path: str | None = None,\n47\t        ds_time_column: str | None = None,\n48\t        ds_class_column: str | None = None,\n49\t        ds_time_tolerance: str | None = None,\n50\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n51\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n52\t        **kwargs,\n53\t    ):\n54\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n55\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n56\t        if ds_class_column is None:\n57\t            raise ValueError(\"ds_class_column must be provided for waveDSDataset\")\n58\t\n59\t        # load_forecast_frames defaults to False here: this task supplies its own labels,\n60\t        # so future Surya frames never need to be fetched from disk/S3.\n61\t        kwargs.setdefault(\"load_forecast_frames\", False)\n62\t        super().__init__(**kwargs)\n63\t\n64\t        self.return_surya_stack = return_surya_stack\n65\t\n66\t        # Load ds index and find intersection with Surya index\n67\t        if ds_wave_index_path is not None:\n68\t            self.ds_index = pd.read_csv(ds_wave_index_path)\n69\t        else:\n70\t            raise ValueError(\"ds_wave_index_path must be provided for waveDSDataset\")\n71\t\n72\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n73\t            self.ds_index[ds_time_column]\n74\t        ).values.astype(\"datetime64[ns]\")\n75\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n76\t\n77\t        # Apply label transform if provided; otherwise use raw column values.\n78\t        if label_transform is not None:\n79\t            self.ds_index[\"label\"] = label_transform(self.ds_index[ds_class_column])\n80\t        else:\n81\t            self.ds_index[\"label\"] = self.ds_index[ds_class_column]\n82\t\n83\t        # Create Surya valid indices and find closest match to DS index\n84\t        self.df_valid_indices = pd.DataFrame(\n85\t            {\"valid_indices\": self.valid_indices}\n86\t        ).sort_values(\"valid_indices\")\n87\t        self.df_valid_indices = pd.merge_asof(\n88\t            self.df_valid_indices,\n89\t            self.ds_index,\n90\t            right_on=\"ds_index\",\n91\t            left_on=\"valid_indices\",\n92\t            direction=ds_match_direction,\n93\t        )\n94\t        # Remove duplicates keeping closest match\n95\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n96\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n97\t        )\n98\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n99\t            [\"ds_index\", \"index_delta\"]\n100\t        )\n101\t        self.df_valid_indices.drop_duplicates(\n102\t            subset=\"ds_index\", keep=\"first\", inplace=True\n103\t        )\n104\t        # Enforce a maximum time tolerance for matches\n105\t        if ds_time_tolerance is not None:\n106\t            self.df_valid_indices = self.df_valid_indices.loc[\n107\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n108\t                :,\n109\t            ]\n110\t            if len(self.df_valid_indices) == 0:\n111\t                raise ValueError(\"No intersection between Surya and DS indices\")\n112\t\n113\t        # Override valid indices variables to reflect matches between Surya and DS\n114\t        self.valid_indices = [\n115\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n116\t        ]\n117\t        self.adjusted_length = len(self.valid_indices)\n118\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n119\t\n120\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n121\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n122\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n123\t            self.adjusted_length = max_number_of_samples\n124\t\n125\t    def __len__(self):\n126\t        return self.adjusted_length\n127\t\n128\t    def __getitem__(self, idx: int) -> dict:\n129\t        \"\"\"\n130\t        Args:\n131\t            idx: Dataset index.\n132\t\n133\t        Returns:\n134\t            Dictionary containing:\n135\t                forecast (np.float32): Wave/no-wave label (1.0 / 0.0).\n136\t                ds_index (str): ISO-format timestamp from the wave index.\n137\t            When ``return_surya_stack=True``, also includes all keys from\n138\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n139\t        \"\"\"\n140\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n141\t        sample[\"forecast\"] = self.df_valid_indices.iloc[idx][\"label\"].astype(np.float32)\n142\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n143\t        return sample\n144\t",
            "title": "Read datasets/wave_dataset.py",
            "locations": [
              "/home/jovyan/surya_workshop2026/downstream_apps/test/datasets/wave_dataset.py"
