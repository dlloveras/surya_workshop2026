            "raw_output": "{\"requestId\":\"45237e46-728c-4b3c-8bdc-8048227e9666\",\"success\":true,\"result\":{\"success\":true,\"commandCount\":11,\"commands\":[{\"id\":\"hub:restart\",\"label\":\"Restart Server\",\"caption\":\"Request that the Hub restart this server\",\"args\":{\"type\":\"object\",\"properties\":{}}},{\"id\":\"kernelmenu:restart\",\"label\":\"Restart Kernel\u2026\",\"caption\":\"Restart the kernel\",\"args\":{\"type\":\"object\",\"properties\":{}}},{\"id\":\"kernelmenu:restart-and-clear\",\"label\":\"Restart Kernel and Clear\u2026\",\"args\":{\"type\":\"object\",\"properties\":{}}},{\"id\":\"runmenu:restart-and-run-all\",\"label\":\"Restart Kernel and Run All\",\"caption\":\"Restart Kernel and Run All\",\"args\":{\"type\":\"object\",\"properties\":{}}},{\"id\":\"notebook:restart-kernel\",\"label\":\"Restart Kernel\u2026\",\"caption\":\"Restart the kernel\",\"args\":{\"type\":\"object\",\"properties\":{\"toolbar\":{\"type\":\"boolean\",\"description\":\"Whether the command is being executed from the toolbar\"}}}},{\"id\":\"notebook:restart-clear-output\",\"label\":\"Restart Kernel and Clear Outputs of All Cells\u2026\",\"caption\":\"Restart the kernel and clear all outputs of all cells\",\"args\":{\"type\":\"object\",\"properties\":{}}},{\"id\":\"notebook:restart-and-run-to-selected\",\"label\":\"Restart Kernel and Run up to Selected Cell\u2026\",\"args\":{\"type\":\"object\",\"properties\":{\"activate\":{\"type\":\"boolean\",\"description\":\"Whether to activate the notebook after execution\"}}}},{\"id\":\"notebook:restart-run-all\",\"label\":\"Restart Kernel and Run All Cells\u2026\",\"caption\":\"Restart the kernel and run all cells\",\"args\":{\"type\":\"object\",\"properties\":{\"toolbar\":{\"type\":\"boolean\",\"description\":\"Whether the command is being executed from the toolbar\"},\"activate\":{\"type\":\"boolean\",\"description\":\"Whether to activate the notebook after execution\"}}}},{\"id\":\"console:restart-kernel\",\"label\":\"Res