            "title": "python - <<'PY' # Verify the disk mask against real data rather than trusting the plate scale arithmetic. import numpy as np, sys sys.path.insert(0,'/home/jovyan/surya_workshop2026') from downstream_apps.test.experiments.wave_visibility_scan import disk_mask, DISK_FRACTION f = np.load('experiments/results/figure_arrays/20100612T0030_wave.npz') now = f['now'].astype(np.float32) m = disk_mask(now.shape[0]) # The disk is bright, the corners are near the floor. Compare inside/outside the mask. print(f\"DISK_FRACTION={DISK_FRACTION} mask covers {100*m.mean():.1f}% of the frame\") print(f\" median inside mask {np.median(now[m]):.4f}\") print(f\" median outside mask {np.median(now[~m]):.4f}\") # Find the actual limb: radial profile of where brightness drops to 20% of disk median c = (now.shape[0]-1)/2 y, x = np.ogrid[:now.shape[0], :now.shape[1]] r = np.sqrt((y-c)**2 + (x-c)**2) inner = np.median(now[r < 800]) prof = [np.median(now[(r >= rr) & (r < rr+40)]) for rr in range(1400, 1800, 40)] edges = list(range(1400, 1800, 40)) print(\" radial median (px -> value), disk median %.3f:\" % inner) for rr, v in zip(edges, prof): print(f\" {rr:5d} {v:.4f} ({v/inner:.2f} of disk) frac={rr/now.shape[0]:.3f}\") PY",
