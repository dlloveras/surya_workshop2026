              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"experiments/run_baseline_study.py\")\ns = p.read_text()\n\n# 1. Minibatch support, so the version_3 reproduction can use its actual batch size.\nold = '''    epochs: int,\n    lr: float,\n    weight_decay: float = 0.0,\n    seed: int = 0,\n) -> dict:\n    \"\"\"Fit the linear readout and return its per-epoch history plus the best-epoch metrics.\n\n    Full-batch Adam rather than the minibatch loop Lightning ran: on <=384 samples that is\n    the same objective with less gradient noise, and it makes the learning curve a property\n    of the data rather than of the batch schedule. ``version_3`` is reproduced with its own\n    minibatch size separately (see ``reproduce_overfit``), so the diagnostic comparison is\n    like-for-like.\n    \"\"\"'''\nnew = '''    epochs: int,\n    lr: float,\n    weight_decay: float = 0.0,\n    seed: int = 0,\n    batch_size: int | None = None,\n) -> dict:\n    \"\"\"Fit the linear readout and return its per-epoch history plus the best-epoch metrics.\n\n    ``batch_size=None`` means full-batch gradient descent, which is the right default for the\n    learning curve: on <=384 samples it optimizes the same objective with less gradient noise,\n    so a change in the curve is a property of the data rather than of the batch schedule.\n    Pass an explicit ``batch_size`` to reproduce a specific Lightning run, whose minibatch\n    schedule is part of what produced its behaviour.\n    \"\"\"'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''    history = []\n    for epoch in range(epochs):\n        model.train()\n        opt.zero_grad()\n        out = model(xt)\n        loss = loss_fn(out, yt)\n        loss.backward()\n        opt.step()\n        with torch.no_grad():'''\nnew = '''    generator = torch.Generator().manual_seed(seed)\n    history = []\n    for epoch in range(epochs):\n        model.train()\n        if batch_size is None:\n            opt.zero_grad()\n            out = model(xt)\n            loss = loss_fn(out, yt)\n            loss.backward()\n            opt.step()\n        else:\n            order = torch.randperm(len(xt), generator=generator)\n            for start in range(0, len(order), batch_size):\n                sel = order[start: start + batch_size]\n                opt.zero_grad()\n                loss = loss_fn(model(xt[sel]), yt[sel])\n                loss.backward()\n                opt.step()\n            # Report the epoch's training loss over the whole set, so it is comparable with\n            # the validation loss below rather than being the last minibatch's value.\n            with torch.no_grad():\n                out = model(xt)\n                loss = loss_fn(out, yt)\n        with torch.no_grad():'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\n# 2. Be exact about what the reproduction does and does not share with version_3.\nold = '''def reproduce_overfit(data, Xtr, ytr, Xva, yva, args) -> dict:\n    \"\"\"Refit on the 10 samples ``max_samples: 10`` actually selects, and check the signature.\n\n    ``waveDSDataset`` head-slices a frame sorted by ``ds_index``, so the cap gives the 10\n    chronologically earliest samples \u2014 the 5 earliest event pairs, all from mid-2010. The\n    cached features are in that same order, so ``[:10]`` reproduces the selection exactly.\n    \"\"\"\n    order = np.argsort(data[\"index_train\"])[:10]\n    fit = fit_logistic(Xtr[order], ytr[order], Xva, yva,\n                       epochs=15, lr=args.lr, seed=42)'''\nnew = '''def reproduce_overfit(data, Xtr, ytr, Xva, yva, args) -> dict:\n    \"\"\"Refit on 10 chronologically-earliest samples and test for the memorization signature.\n\n    This reproduces version_3's *regime*, not its exact inputs, and the difference is worth\n    being clear about. It matches: 10 training samples chosen the way ``max_samples: 10``\n    chooses them (``waveDSDataset`` head-slices a frame sorted by ``ds_index``, so the cap\n    yields the earliest 5 event pairs rather than a sample), 16,385 parameters, lr=0.01, Adam,\n    batch size 2, 15 epochs. It does not match: the 10 samples are the earliest of the seeded\n    384-sample subset rather than of all 1,210 matches, and validation is this study's\n    24-sample balanced split rather than version_3's 27-sample one at the looser 4-day\n    tolerance. So the numbers will differ; what is being tested is whether the *signature*\n    reappears \u2014 training loss collapsing while validation loss rises and validation AUROC\n    stays exactly frozen, which together say the model memorized rather than miscalibrated.\n    \"\"\"\n    order = np.argsort(data[\"index_train\"])[:10]\n    fit = fit_logistic(Xtr[order], ytr[order], Xva, yva,\n                       epochs=15, lr=args.lr, seed=42, batch_size=2)'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\n# 3. Full-batch needs more steps than a minibatch epoch to converge; these are milliseconds.\ns = s.replace('p.add_argument(\"--epochs\", type=int, default=200,',\n              'p.add_argument(\"--epochs\", type=int, default=500,')\ns = s.replace('\"Full-batch gradient descent on <=384 samples, so \"\\n'\n              '                        \"these are cheap; the curve is read off the best epoch, not the last.\")',\n              '\"Full-batch gradient descent on <=384 samples, so \"\\n'\n              '                        \"one epoch is one step and 500 of them are milliseconds. The curve \"\\n'\n              '                        \"is read off the best epoch, not the last, so overshooting is safe.\")')\np.write_text(s)\nprint(\"baseline study patched\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile experiments/run_baseline_study.py && echo \"compiles ok\"; tail -1 /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/phase1_extract.log"
            }
