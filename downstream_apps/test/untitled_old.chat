            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python - <<'PY'\nimport pandas as pd, numpy as np\ncat = pd.read_csv(\"downstream_apps/test/data/lcpf_aia_waves.csv\", usecols=[\"start_time\",\"mid_time\",\"class\",\"AR\"])\ncat[\"ds_index\"]=pd.to_datetime(cat[\"mid_time\"]).values.astype(\"datetime64[ns]\")\ncat[\"start_time\"]=pd.to_datetime(cat[\"start_time\"])\ncat=cat.sort_values(\"ds_index\")\nfor tol in [\"12min\",\"30min\"]:\n  print(f\"########## tolerance {tol}\")\n  for sp in [\"train\",\"val\",\"test\"]:\n    idx=pd.read_csv(f\"data/indices/surya_aws_s3_{sp}.csv\"); idx=idx[idx[\"present\"]==1]\n    ts=pd.to_datetime(idx[\"timestep\"]).values.astype(\"datetime64[ns]\"); tset=set(ts)\n    valid=[t for t in np.sort(ts) if (t+np.timedelta64(-12,\"m\")) in tset]\n    m=pd.merge_asof(pd.DataFrame({\"valid_indices\":valid}),cat,right_on=\"ds_index\",left_on=\"valid_indices\",direction=\"forward\")\n    m[\"index_delta\"]=np.abs(m[\"valid_indices\"]-m[\"ds_index\"])\n    m=m.sort_values([\"ds_index\",\"index_delta\"]).drop_duplicates(subset=\"ds_index\",keep=\"first\")\n    m=m[m[\"index_delta\"]<=pd.Timedelta(tol)]\n    vc=m[\"class\"].value_counts().to_dict()\n    pairs=m.groupby(\"start_time\")[\"class\"].nunique()\n    print(f\"  {sp}: n={len(m)} {vc} complete_pairs={(pairs==2).sum()} singletons={(pairs==1).sum()} uniq_AR={m['AR'].nunique()}\")\n    if sp!=\"train\":\n        print(\"     unique frames needed:\", len(set(m['valid_indices'])|set(m['valid_indices']-pd.Timedelta('12min'))))\n    else:\n        print(\"     unique frames needed:\", len(set(m['valid_indices'])|set(m['valid_indices']-pd.Timedelta('12min'))))\nPY",
