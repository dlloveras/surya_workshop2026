            "title": "cd surya_workshop2026 && cat > pw_check.py <<'PY' import torch from torch.utils.data import DataLoader, Dataset class D(Dataset): def __len__(self): return 8 def __getitem__(self, i): return torch.tensor([float(i)]) def probe(pw): dl = DataLoader(D(), batch_size=2, num_workers=2, multiprocessing_context=\"spawn\", persistent_workers=pw) for _ in range(2): # two \"fits\" over the same loader object n = sum(1 for _ in dl) print(f\"persistent_workers={pw}: two passes ok ({n} batches each), \" f\"_iterator is {'retained (stateful)' if dl._iterator is not None else 'None (fresh pool each iter)'}\") if __name__ == \"__main__\": probe(True) probe(False) PY python pw_check.py",
