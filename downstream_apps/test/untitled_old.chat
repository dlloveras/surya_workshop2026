            "tool_call_id": "toolu_bdrk_01Spx26MetsfvNVQ8XyuibUJ",
            "title": "Read models/simple_baseline.py",
            "locations": [
              "/home/jovyan/surya_workshop2026/downstream_apps/test/models/simple_baseline.py"
            ],
            "kind": "read",
            "raw_output": "1\t\"\"\"\n2\tA simple linear regression model to be used as a baseline for flare forecasting.\n3\t\"\"\"\n4\t\n5\timport torch\n6\timport torch.nn as nn\n7\tfrom einops import rearrange\n8\t\n9\t\n10\tdef destandardize_channels(batch: dict, channel_order: list, scalers: dict) -> dict:\n11\t    \"\"\"Return a new batch dict with 'ts' moved from normalized space to signum-log space.\n12\t\n13\t    This undoes the per-channel z-score ONLY. The signum-log compression applied by the\n14\t    dataset is deliberately left in place, so the result is\n15\t    ``sign(x*s) * log1p(|x*s|)`` \u2014 not raw DN/Gauss. Values spanning many orders of\n16\t    magnitude make poor features for a single linear layer, so log space is what the\n17\t    baseline wants.\n18\t\n19\t    If you need true physical units (plotting, a physical-space loss), use\n20\t    ``HelioNetCDFDataset.inverse_transform_data()`` instead, which undoes both stages.\n21\t    See the \"THE THREE SPACES\" block in ``workshop_infrastructure/datasets/helio.py``.\n22\t\n23\t    Args:\n24\t        batch: Batch dict containing at minimum a 'ts' key with shape (B, C, T, H, W).\n25\t        channel_order: Channel names in the same order as the C dimension of 'ts'.\n26\t        scalers: Dict mapping channel name -> scaler with an inverse_transform method.\n27\t\n28\t    Returns:\n29\t        A new batch dict with 'ts' replaced by the de-standardized (signum-log) tensor.\n30\t    \"\"\"\n31\t    x = batch[\"ts\"].clone()\n32\t    with torch.no_grad():\n33\t        for i, channel in enumerate(channel_order):\n34\t            x[:, i, ...] = scalers[channel].inverse_transform(x[:, i, ...])\n35\t    return {**batch, \"ts\": x}\n36\t\n37\t\n38\tclass RegressionFlareModel(nn.Module):\n39\t    def __init__(self, input_dim: int):\n40\t        \"\"\"\n41\t        Initializes the RegressionFlareModel.\n42\t\n43\t        Args:\n44\t            input_dim (int): The size of the input vector after channel and time dimensions are flattened.\n45\t\n46\t        Note:\n47\t            This model expects 'ts' in the batch dict to already be in **signum-log** space\n48\t            (channel z-scores undone, log compression retained). Use\n49\t            destandardize_channels() to pre-process normalized SDO inputs before passing\n50\t            them here (e.g., via the preprocess_fn argument of FlareLightningModule).\n51\t        \"\"\"\n52\t        super().__init__()\n53\t        self.linear = nn.Linear(input_dim, 1)\n54\t\n55\t    def forward(self, x: dict) -> torch.Tensor:\n56\t        \"\"\"\n57\t        Performs a forward pass through the model.\n58\t\n59\t        Args:\n60\t            x (dict): Batch dict with 'ts' of shape (B, C, T, H, W) in signum-log space.\n61\t\n62\t        B - Batch size\n63\t        C - Channels\n64\t        T - Time steps\n65\t        H - Height\n66\t        W - Width\n67\t        \"\"\"\n68\t        x = x[\"ts\"]\n69\t\n70\t        # Collapse input stack spatially and take absolute value for strictly positive flare fluxes\n71\t        x = x.abs().mean(dim=[3, 4])\n72\t\n73\t        # Rearrange in preparation for linear layer\n74\t        x = rearrange(x, \"b c t -> b (c t)\")\n75\t\n76\t        return self.linear(x)\n77\t\n78\t\n79\tclass ConstantProbabilityModel(nn.Module):\n80\t    \"\"\"Trainable baseline: a single learned logit, independent of the input.\n81\t\n82\t    Learns the class base rate (the wave / no-wave prior) and nothing else \u2014 the\n83\t    simplest possible baseline against which any input-dependent model should be judged.\n84\t    \"\"\"\n85\t\n86\t    def __init__(self):\n87\t        super().__init__()\n88\t        self.logit = nn.Parameter(torch.zeros(1))\n89\t\n90\t    def forward(self, batch: dict) -> torch.Tensor:\n91\t        \"\"\"\n92\t        Args:\n93\t            batch (dict): Batch dict; only used to read the batch size from\n94\t                ``batch[\"forecast\"]`` (the target), since the model itself ignores\n95\t                the input entirely.\n96\t        \"\"\"\n97\t        batch_size = batch[\"forecast\"].shape[0]\n98\t        return self.logit.expand(batch_size, 1)\n99\t\n100\t\n101\tclass RunningDifferenceLogisticModel(nn.Module):\n102\t    \"\"\"Trainable baseline: AIA193 running difference, mean-pooled, then logistic regression.\n103\t\n104\t    Computes AIA193(now) - AIA193(one cadence step earlier), applies a 32x32 mean pool\n105\t    (uniform kernel weights 1/1024), and feeds the flattened pooled map into a linear\n106\t    layer (BCEWithLogitsLoss supplies the logistic/sigmoid).\n107\t\n108\t    Note:\n109\t        Expects 'ts' in the batch dict with shape (B, C, T=2, H, W), where T is ordered\n110\t        [t_prev, t_now] \u2014 see HelioNetCDFDataset.__getitem__ sampling, where the last T\n111\t        index is always the \"now\" (offset 0) frame.\n112\t\n113\t        This model expects 'ts' in **signum-log** space (channel z-scores undone, log\n114\t        compression retained), same convention as RegressionFlareModel. Use\n115\t        destandardize_channels() to pre-process normalized SDO inputs before passing them\n116\t        here (e.g., via the preprocess_fn argument of FlareLightningModule).\n117\t    \"\"\"\n118\t\n119\t    def __init__(self, channel_index: int, img_size: int, pool_kernel: int = 32):\n120\t        \"\"\"\n121\t        Args:\n122\t            channel_index (int): Index of the AIA193 channel within the C dimension of 'ts'.\n123\t            img_size (int): Height/width of the (square) input frames.\n124\t            pool_kernel (int): Mean-pool kernel size (and stride). Defaults to 32.\n125\t        \"\"\"\n126\t        super().__init__()\n127\t        self.channel_index = channel_index\n128\t        self.pool = nn.AvgPool2d(kernel_size=pool_kernel)\n129\t        pooled_side = img_size // pool_kernel\n130\t        self.linear = nn.Linear(pooled_side * pooled_side, 1)\n131\t\n132\t    def forward(self, batch: dict) -> torch.Tensor:\n133\t        \"\"\"\n134\t        Args:\n135\t            batch (dict): Batch dict with 'ts' of shape (B, C, T=2, H, W) in signum-log space.\n136\t        \"\"\"\n137\t        x = batch[\"ts\"][:, self.channel_index, :, :, :]  # (B, T, H, W)\n138\t        diff = x[:, -1] - x[:, 0]  # now - prev\n139\t        pooled = self.pool(diff.unsqueeze(1))  # (B, 1, H', W')\n140\t        return self.linear(pooled.flatten(start_dim=1))"
          },
          {
            "raw_input": {
              "file_path": "/home/jovyan/surya_workshop2026/downstream_apps/test/lightning_modules/pl_simple_baseline.py"
            },
            "raw_output": "1\t\"\"\"\n2\tpl_simple_baseline.py\n3\t\n4\tA minimal PyTorch Lightning wrapper for training a wave classification model.\n5\t\n6\tThis module defines a single LightningModule (WaveLightningModule) that:\n7\t  - Calls a user-provided PyTorch model on batched inputs (batch[\"ts\"])\n8\t  - Computes one or more training/validation losses via a user-provided loss function\n9\t  - Logs scalar losses and evaluation metrics using Lightning's built-in logging\n10\t  - Configures a simple Adam optimizer\n11\t\n12\tIntended use:\n13\t  - Provide a clean, readable baseline training loop in Lightning\n14\t  - Separate \"model architecture\" from \"training mechanics\"\n15\t  - Demonstrate how to log multiple losses/metrics consistently\n16\t\n17\tKey batch contract:\n18\t  - batch[\"ts\"]       : torch.Tensor input stack (e.g., [B, C, T, H, W])\n19\t  - batch[\"forecast\"] : torch.Tensor target values (e.g., [B] or [B,])\n20\t\n21\tOptional preprocessing:\n22\t  - If ``preprocess_fn`` is provided to ``__init__``, it is called on the batch dict\n23\t    before every model call. This is the intended hook for input transformations (such\n24\t    as inverse-normalizing SDO channels) that should not live inside the model.\n25\t\n26\tKey metrics contract (the `metrics` dict passed to __init__):\n27\t  - metrics[\"train_loss\"]    : callable(output, target) -> (loss_dict, weight_list)\n28\t        Backpropagated. Logged as \"train_loss\".\n29\t  - metrics[\"val_loss\"]      : callable(output, target) -> (loss_dict, weight_list)\n30\t        Optional. Logged as \"val_loss\" and therefore what ModelCheckpoint monitors.\n31\t        Falls back to metrics[\"train_loss\"] when absent.\n32\t  - metrics[\"train_metrics\"] : callable(output, target) -> (metric_dict, weight_list)\n33\t  - metrics[\"val_metrics\"]   : callable(output, target) -> (metric_dict, weight_list)\n34\t        Reported only. These do NOT affect checkpoint selection \u2014 \"val_loss\" does.\n35\t\n36\tWhere:\n37\t  - loss_dict / metric_dict map string names -> torch scalar tensors\n38\t  - weight_list is a list-like of floats (or tensors) aligned with the dict iteration order\n39\t    used by this baseline to form a weighted sum loss.\n40\t\"\"\"\n41\t\n42\tfrom __future__ import annotations\n43\t\n44\tfrom typing import Any, Callable, Dict, Mapping, Optional, Tuple\n45\t\n46\timport lightning as L\n47\timport torch\n48\t\n49\t\n50\t# Type aliases for clarity in documentation / teaching.\n51\tLossDict = Mapping[str, torch.Tensor]\n52\tMetricDict = Mapping[str, torch.Tensor]\n53\tWeights = Any  # often a list[float] or list[torch.Tensor]\n54\t\n55\t\n56\tclass WaveLightningModule(L.LightningModule):\n57\t    \"\"\"\n58\t    PyTorch LightningModule for wave classification training.\n59\t\n60\t    This class wraps:\n61\t      (1) a user-provided PyTorch model (nn.Module-like) and\n62\t      (2) a set of loss/metric callables packaged in the `metrics` dictionary.\n63\t\n64\t    Parameters\n65\t    ----------\n66\t    model:\n67\t        A callable model (typically torch.nn.Module) that accepts the batch input tensor\n68\t        `x = batch[\"ts\"]` and returns predictions `output`.\n69\t\n70\t    metrics:\n71\t        Dictionary containing the training loss function and metric functions.\n72\t\n73\t        Required keys:\n74\t          - \"train_loss\": callable(output, target) -> (losses, weights)\n75\t              losses: dict[str, torch.Tensor] scalar losses\n76\t              weights: list-like aligned with iteration order of losses.keys()\n77\t          - \"train_metrics\": callable(output, target) -> (metrics, weights)\n78\t          - \"val_metrics\": callable(output, target) -> (metrics, weights)\n79\t\n80\t        Optional key:\n81\t          - \"val_loss\": callable(output, target) -> (losses, weights)\n82\t              The validation objective. Defaults to \"train_loss\" when not supplied, so\n83\t              older metrics dicts keep working unchanged.\n84\t\n85\t        The module uses:\n86\t          - train_loss in training_step, backpropagated and logged as \"train_loss\"\n87\t          - val_loss in validation_step, logged as \"val_loss\" \u2014 the quantity\n88\t            ModelCheckpoint monitors\n89\t          - train_metrics logged during training_step (if weights is non-empty)\n90\t          - val_metrics logged during validation_step (if weights is non-empty).\n91\t            Reported only; they do not influence checkpoint selection.\n92\t\n93\t    lr:\n94\t        Learning rate for the Adam optimizer.\n95\t\n96\t    batch_size:\n97\t        Optional batch size passed to Lightning's `self.log(..., batch_size=...)`.\n98\t        This improves correct averaging behavior when using distributed settings\n99\t        or variable batch sizes.\n100\t\n101\t    preprocess_fn:\n102\t        Optional callable applied to the batch dict before every model call.\n103\t        Signature: ``(batch: dict) -> dict``. Use this to apply input\n104\t        transformations (e.g., ``destandardize_channels``) without\n105\t        embedding them in the model itself.\n106\t    \"\"\"\n107\t\n108\t    def __init__(\n109\t        self,\n110\t        model: torch.nn.Module,\n111\t        metrics: Dict[str, Callable[..., Tuple[Dict[str, torch.Tensor], Weights]]],\n112\t        lr: float,\n113\t        batch_size: Optional[int] = None,\n114\t        preprocess_fn: Optional[Callable[[Dict], Dict]] = None,\n115\t    ):\n116\t        super().__init__()\n117\t        self.batch_size = batch_size\n118\t        self.model = model\n119\t        self.preprocess_fn = preprocess_fn\n120\t\n121\t        # Loss callables: return (loss_dict, weight_list)\n122\t        self.training_loss = metrics[\"train_loss\"]\n123\t        # \"val_loss\" is optional: falling back to train_loss keeps a metrics dict written\n124\t        # before this key existed working, with identical behavior.\n125\t        self.validation_loss = metrics.get(\"val_loss\", metrics[\"train_loss\"])\n126\t\n127\t        # Metric callables: return (metric_dict, weight_list)\n128\t        self.training_evaluation = metrics[\"train_metrics\"]\n129\t        self.validation_evaluation = metrics[\"val_metrics\"]\n130\t\n131\t        self.lr = lr\n132\t\n133\t    @staticmethod\n134\t    def _combine_losses(loss_dict: LossDict, weights: Weights) -> torch.Tensor:\n135\t        \"\"\"Return a weighted sum of the losses in ``loss_dict``.\n136\t\n137\t        ``weights`` must be aligned with ``loss_dict.keys()`` iteration order.\n138\t        Raises ``ValueError`` if ``loss_dict`` is empty.\n139\t        \"\"\"\n140\t        loss = None\n141\t        for n, key in enumerate(loss_dict.keys()):\n142\t            component = loss_dict[key] * weights[n]\n143\t            loss = component if loss is None else (loss + component)\n144\t        if loss is None:\n145\t            raise ValueError(\"loss_dict is empty; cannot compute a scalar loss.\")\n146\t        return loss\n147\t\n148\t    def forward(self, batch: dict) -> torch.Tensor:\n149\t        \"\"\"\n150\t        Forward pass used by Lightning and by explicit calls in steps.\n151\t\n152\t        Parameters\n153\t        ----------\n154\t        batch:\n155\t            Batch dict (at minimum contains ``\"ts\"`` and ``\"forecast\"``).\n156\t\n157\t        Returns\n158\t        -------\n159\t        torch.Tensor\n160\t            Model predictions for the batch.\n161\t        \"\"\"\n162\t        return self.model(batch)\n163\t\n164\t    def training_step(self, batch: Dict[str, Any], batch_idx: int) -> torch.Tensor:\n165\t        \"\"\"\n166\t        Runs one training step on a single batch.\n167\t\n168\t        Workflow\n169\t        --------\n170\t        1) Extract inputs and targets from the batch:\n171\t              x = batch[\"ts\"]\n172\t              target = batch[\"forecast\"]\n173\t        2) Compute model output:\n174\t              output = self(x)\n175\t        3) Compute per-component losses and combine via provided weights:\n176\t              training_losses, training_loss_weights = training_loss(output, target)\n177\t        4) Log:\n178\t              - total weighted loss as \"train_loss\" (progress bar)\n179\t              - each component loss as \"train_loss_<name>\"\n180\t              - training metrics as \"train_metric_<name>\" (if any)\n181\t\n182\t        Notes\n183\t        -----\n184\t        - Targets are reshaped to shape [B, 1] by unsqueeze(1) to match a common\n185\t          \"single output per sample\" convention.\n186\t        - The loss combination depends on dict iteration order; ensure loss dict\n187\t          insertion order is consistent if that matters.\n188\t\n189\t        Returns\n190\t        -------\n191\t        torch.Tensor\n192\t            The scalar training loss used for backpropagation.\n193\t        \"\"\"\n194\t        target = batch[\"forecast\"].unsqueeze(1).float()\n195\t\n196\t        if self.preprocess_fn is not None:\n197\t            batch = self.preprocess_fn(batch)\n198\t        output = self(batch)\n199\t        training_losses, training_loss_weights = self.training_loss(output, target)\n200\t        loss = self._combine_losses(training_losses, training_loss_weights)\n201\t\n202\t        # Log aggregate loss and component losses.\n203\t        self.log(\"train_loss\", loss, prog_bar=True, batch_size=self.batch_size, sync_dist=True)\n204\t        for key in training_losses.keys():\n205\t            self.log(f\"train_loss_{key}\", training_losses[key], prog_bar=False, batch_size=self.batch_size, sync_dist=True)\n206\t\n207\t        # Log evaluation metrics (optional).\n208\t        training_evaluation_metrics, training_evaluation_weights = self.training_evaluation(output, target)\n209\t        if len(training_evaluation_weights) > 0:\n210\t            for key in training_evaluation_metrics.keys():\n211\t                self.log(f\"train_metric_{key}\", training_evaluation_metrics[key], prog_bar=False, batch_size=self.batch_size, sync_dist=True)\n212\t\n213\t        return loss\n214\t\n215\t    def validation_step(self, batch: Dict[str, Any], batch_idx: int) -> None:\n216\t        \"\"\"\n217\t        Runs one validation step on a single batch.\n218\t\n219\t        Workflow\n220\t        --------\n221\t        1) Extract inputs and targets\n222\t        2) Compute output\n223\t        3) Compute validation losses and combine via weights\n224\t        4) Log:\n225\t              - total weighted loss as \"val_loss\" (progress bar)\n226\t              - each component loss as \"val_loss_<name>\"\n227\t              - validation metrics as \"val_metric_<name>\" (if any)\n228\t\n229\t        Notes\n230\t        -----\n231\t        - The loss is computed with `self.validation_loss`, which comes from\n232\t          metrics[\"val_loss\"] and falls back to metrics[\"train_loss\"] when that key is\n233\t          absent. Supply a distinct \"val_loss\" callable to monitor something other than\n234\t          the training objective.\n235\t        - \"val_loss\" is what ModelCheckpoint monitors. The `val_metrics` logged at the end\n236\t          of this method are reported only and do not affect checkpoint selection.\n237\t        - No value is returned (Lightning uses logs for validation tracking).\n238\t        \"\"\"\n239\t        target = batch[\"forecast\"].unsqueeze(1).float()\n240\t\n241\t        if self.preprocess_fn is not None:\n242\t            batch = self.preprocess_fn(batch)\n243\t        output = self(batch)\n244\t        val_losses, val_loss_weights = self.validation_loss(output, target)\n245\t        loss = self._combine_losses(val_losses, val_loss_weights)\n246\t\n247\t        # Log aggregate loss and component losses.\n248\t        self.log(\"val_loss\", loss, prog_bar=True, batch_size=self.batch_size, sync_dist=True)\n249\t        for key in val_losses.keys():\n250\t            self.log(f\"val_loss_{key}\", val_losses[key], prog_bar=False, batch_size=self.batch_size, sync_dist=True)\n251\t\n252\t        # Log evaluation metrics (optional).\n253\t        val_evaluation_metrics, val_evaluation_weights = self.validation_evaluation(output, target)\n254\t        if len(val_evaluation_weights) > 0:\n255\t            for key in val_evaluation_metrics.keys():\n256\t                self.log(f\"val_metric_{key}\", val_evaluation_metrics[key], prog_bar=False, batch_size=self.batch_size, sync_dist=True)\n257\t\n258\t    def configure_optimizers(self) -> torch.optim.Optimizer:\n259\t        \"\"\"\n260\t        Configure the optimizer used by Lightning.\n261\t\n262\t        Returns\n263\t        -------\n264\t        torch.optim.Optimizer\n265\t            Adam optimizer over all module parameters with learning rate `self.lr`.\n266\t        \"\"\"\n267\t        return torch.optim.Adam(self.parameters(), lr=self.lr)\n268\t",
            "title": "Read lightning_modules/pl_simple_baseline.py",
