                "new_text": "        # Rearrange in preparation for linear layer\n        x = rearrange(x, \"b c t -> b (c t)\")\n\n No newline at end of file\n        return self.linear(x)\n\n\nclass ConstantProbabilityModel(nn.Module):\n    \"\"\"Trainable baseline: a single learned logit, independent of the input.\n\n    Learns the class base rate (the wave / no-wave prior) and nothing else \u2014 the\n    simplest possible baseline against which any input-dependent model should be judged.\n    \"\"\"\n\n    def __init__(self):\n        super().__init__()\n        self.logit = nn.Parameter(torch.zeros(1))\n\n    def forward(self, batch: dict) -> torch.Tensor:\n        \"\"\"\n        Args:\n            batch (dict): Batch dict; only used to read the batch size from\n                ``batch[\"forecast\"]`` (the target), since the model itself ignores\n                the input entirely.\n        \"\"\"\n        batch_size = batch[\"forecast\"].shape[0]\n        return self.logit.expand(batch_size, 1)\n\n\nclass RunningDifferenceLogisticModel(nn.Module):\n    \"\"\"Trainable baseline: AIA193 running difference, mean-pooled, then logistic regression.\n\n    Computes AIA193(now) - AIA193(one cadence step earlier), applies a 32x32 mean pool\n    (uniform kernel weights 1/1024), and feeds the flattened pooled map into a linear\n    layer (BCEWithLogitsLoss supplies the logistic/sigmoid).\n\n    Note:\n        Expects 'ts' in the batch dict with shape (B, C, T=2, H, W), where T is ordered\n        [t_prev, t_now] \u2014 see HelioNetCDFDataset.__getitem__ sampling, where the last T\n        index is always the \"now\" (offset 0) frame.\n\n        This model expects 'ts' in **signum-log** space (channel z-scores undone, log\n        compression retained), same convention as RegressionFlareModel. Use\n        destandardize_channels() to pre-process normalized SDO inputs before passing them\n        here (e.g., via the preprocess_fn argument of FlareLightningModule).\n    \