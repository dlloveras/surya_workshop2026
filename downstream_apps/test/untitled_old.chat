            "title": "Read utils.py",
            "raw_output": "1\timport functools\n2\timport os\n3\timport logging\n4\timport sys\n5\timport urllib.request\n6\timport urllib.error\n7\tfrom pathlib import Path\n8\tfrom typing import Dict, Optional\n9\t\n10\timport torch\n11\timport torch.distributed as dist\n12\timport lightning as L\n13\tfrom lightning.pytorch.callbacks import ModelCheckpoint\n14\tfrom workshop_infrastructure.configs import LoraAdapterConfig\n15\t\n16\t# Optional: S3 helpers below degrade to a clear ImportError when boto3 is absent.\n17\ttry:\n18\t    import boto3\n19\t    from botocore import UNSIGNED\n20\t    from botocore.config import Config as BotoConfig\n21\texcept Exception:  # pragma: no cover\n22\t    boto3 = None\n23\t    UNSIGNED = None\n24\t    BotoConfig = None\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# AWS / infrastructure utilities\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@functools.lru_cache(maxsize=1)\n32\tdef detect_ec2_region() -> str | None:\n33\t    \"\"\"Return the AWS region of the current EC2 instance, or None if not on EC2.\n34\t\n35\t    Queries the IMDSv2 endpoint (169.254.169.254), which is only reachable from\n36\t    within an EC2 instance.  The 1-second timeout makes this a no-op on any\n37\t    other machine.  Results are cached so the network round-trip happens at most\n38\t    once per process.\n39\t    \"\"\"\n40\t    try:\n41\t        token_req = urllib.request.Request(\n42\t            \"http://169.254.169.254/latest/api/token\",\n43\t            method=\"PUT\",\n44\t            headers={\"X-aws-ec2-metadata-token-ttl-seconds\": \"21600\"},\n45\t        )\n46\t        with urllib.request.urlopen(token_req, timeout=1) as resp:\n47\t            token = resp.read().decode()\n48\t        region_req = urllib.request.Request(\n49\t            \"http://169.254.169.254/latest/meta-data/placement/region\",\n50\t            headers={\"X-aws-ec2-metadata-token\": token},\n51\t        )\n52\t        with urllib.request.urlopen(region_req, timeout=1) as resp:\n53\t            return resp.read().decode()\n54\t    except Exception:\n55\t        return None\n56\t\n57\t\n58\tdef parse_s3_uri(uri: str) -> tuple[str, str]:\n59\t    \"\"\"Split ``s3://bucket/key`` into ``(bucket, key)``.\n60\t\n61\t    Raises:\n62\t        ValueError: If ``uri`` is not an S3 URI, or has no key component.\n63\t    \"\"\"\n64\t    if not isinstance(uri, str) or not uri.startswith(\"s3://\"):\n65\t        raise ValueError(f\"Expected an s3:// URI, got: {uri!r}\")\n66\t    remainder = uri[len(\"s3://\"):]\n67\t    if \"/\" not in remainder:\n68\t        raise ValueError(f\"S3 URI is missing a key: {uri!r} (expected s3://bucket/key)\")\n69\t    bucket, key = remainder.split(\"/\", 1)\n70\t    return bucket, key\n71\t\n72\t\n73\tdef make_s3_client(\n74\t    anon: bool = False,\n75\t    region: str | None = None,\n76\t    pool_size: int = 32,\n77\t    max_attempts: int = 10,\n78\t):\n79\t    \"\"\"Return a configured boto3 S3 client.\n80\t\n81\t    Shared by the dataset loader and the S3 benchmark so both use identical connection\n82\t    pooling and retry behaviour.\n83\t\n84\t    Args:\n85\t        anon: If True, sign requests anonymously (public buckets).\n86\t        region: AWS region. Pass ``None`` to let boto3 resolve it.\n87\t        pool_size: Max connections in the client's connection pool. Should be at least\n88\t            twice the download concurrency, or threads will contend for connections.\n89\t        max_attempts: Retry attempts in adaptive mode. The dataset uses a high value\n90\t            because a failed read kills a training run; the benchmark uses a low one so\n91\t            throughput measurements are not skewed by retries.\n92\t    \"\"\"\n93\t    if boto3 is None:\n94\t        raise ImportError(\"boto3 is required for S3 access. Install via: pip install boto3\")\n95\t\n96\t    retry_cfg = {\"max_attempts\": max_attempts, \"mode\": \"adaptive\"}\n97\t    if anon:\n98\t        config = BotoConfig(\n99\t            signature_version=UNSIGNED,\n100\t            max_pool_connections=pool_size,\n101\t            retries=retry_cfg,\n102\t        )\n103\t    else:\n104\t        config = BotoConfig(max_pool_connections=pool_size, retries=retry_cfg)\n105\t    return boto3.client(\"s3\", region_name=region, config=config)\n106\t\n107\t\n108\t# ---------------------------------------------------------------------------\n109\t# Distributed utilities\n110\t# ---------------------------------------------------------------------------\n111\t\n112\tdef is_dist_avail_and_initialized() -> bool:\n113\t    return dist.is_available() and dist.is_initialized()\n114\t\n115\t\n116\tdef get_rank() -> int:\n117\t    if not is_dist_avail_and_initialized():\n118\t        return 0\n119\t    return dist.get_rank()\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Logging utilities\n124\t# ---------------------------------------------------------------------------\n125\t\n126\tdef create_logger(output_dir: str, dist_rank: int, name: str) -> logging.Logger:\n127\t    \"\"\"Create a file+console logger identified by name and rank.\"\"\"\n128\t    logger = logging.getLogger(name)\n129\t    logger.setLevel(logging.DEBUG)\n130\t    logger.propagate = False\n131\t\n132\t    fmt = \"[%(asctime)s %(name)s]: %(levelname)s %(message)s\"\n133\t\n134\t    if name.endswith(\"main\"):\n135\t        console_handler = logging.StreamHandler(sys.stdout)\n136\t        console_handler.setLevel(logging.INFO)\n137\t        console_handler.setFormatter(logging.Formatter(fmt=fmt, datefmt=\"%Y-%m-%d %H:%M:%S\"))\n138\t        logger.addHandler(console_handler)\n139\t\n140\t    file_handler = logging.FileHandler(os.path.join(output_dir, f\"{name}.log\"), mode=\"a\")\n141\t    file_handler.setLevel(logging.DEBUG)\n142\t    file_handler.setFormatter(logging.Formatter(fmt=fmt, datefmt=\"%Y-%m-%d %H:%M:%S\"))\n143\t    logger.addHandler(file_handler)\n144\t\n145\t    return logger\n146\t\n147\t\n148\t# ---------------------------------------------------------------------------\n149\t# Scaler utilities\n150\t# ---------------------------------------------------------------------------\n151\t\n152\tdef class_from_name(module_name: str, class_name: str):\n153\t    \"\"\"Import and return a class by its module and class name strings.\"\"\"\n154\t    m = __import__(module_name, globals(), locals(), [class_name])\n155\t    return getattr(m, class_name)\n156\t\n157\t\n158\tdef build_scalers(info) -> Dict:\n159\t    \"\"\"Reconstruct per-channel scaler objects from a scalers YAML file or dict.\n160\t\n161\t    Args:\n162\t        info: Path to a scalers YAML file, or an already-loaded dict mapping\n163\t            channel name -> scaler parameters.\n164\t\n165\t    Returns:\n166\t        Dict mapping channel name -> scaler instance (e.g. ``StandardScaler``), each\n167\t        exposing ``.mean``, ``.std``, ``.epsilon`` and ``.sl_scale_factor``.\n168\t\n169\t    On the ``base:`` field\n170\t    ---------------------\n171\t    Every entry records the module the scaler was originally fitted in \u2014 in the\n172\t    shipped ``scalers.yaml`` that is ``surya.datasets.transformations``, which does not\n173\t    exist in this repo (the Surya code is vendored under ``workshop_infrastructure/``).\n174\t\n175\t    That field is deliberately **ignored**. Classes are always resolved from\n176\t    ``workshop_infrastructure.datasets.transformations``, never imported from the\n177\t    recorded path, so normalization does not depend on what happens to be installed in\n178\t    the environment: were a real ``surya`` package ever added, honoring ``base`` would\n179\t    silently switch which ``StandardScaler`` implementation runs, and results could move\n180\t    because of an unrelated install. Determinism matters more here than deference to a\n181\t    stale field. This is not warned about at runtime \u2014 the field is stale in every entry\n182\t    of a file fetched from HuggingFace that nobody can edit, so a warning would fire\n183\t    always and invite no action.\n184\t    \"\"\"\n185\t    import yaml\n186\t    import workshop_infrastructure.datasets.transformations as _transformations\n187\t\n188\t    source = \"<dict>\"\n189\t    if not isinstance(info, dict):\n190\t        source = str(info)\n191\t        if not os.path.isfile(source):\n192\t            raise FileNotFoundError(\n193\t                f\"Scalers file not found: {source}\\n\"\n194\t                \"This is the data.scalers_path entry in your config. It is downloaded \"\n195\t                \"automatically on the first run; to fetch it explicitly:\\n\"\n196\t                \"    python -m workshop_infrastructure.assets --scalers --dest <assets dir>\"\n197\t            )\n198\t        with open(source, \"r\", encoding=\"utf-8\") as f:\n199\t            info = yaml.safe_load(f)\n200\t\n201\t    if not isinstance(info, dict):\n202\t        raise ValueError(f\"Scalers source {source} must contain a mapping of channel name -> parameters.\")\n203\t\n204\t    available = sorted(\n205\t        name for name in dir(_transformations)\n206\t        if isinstance(getattr(_transformations, name), type)\n207\t    )\n208\t\n209\t    ret_dict = {}\n210\t    for p_key, p_val in info.items():\n211\t        if not isinstance(p_val, dict) or \"class\" not in p_val:\n212\t            raise ValueError(\n213\t                f\"Scalers entry {p_key!r} in {source} is malformed: expected a mapping \"\n214\t                f\"with a 'class' key, got {type(p_val).__name__}.\"\n215\t            )\n216\t        class_name = p_val[\"class\"]\n217\t        # Note: p_val[\"base\"] is intentionally not consulted \u2014 see the docstring.\n218\t        if not hasattr(_transformations, class_name):\n219\t            raise ValueError(\n220\t                f\"Scalers entry {p_key!r} in {source} names class {class_name!r}, which does \"\n221\t                \"not exist in workshop_infrastructure.datasets.transformations.\\n\"\n222\t                f\"Available classes: {', '.join(available)}.\"\n223\t            )\n224\t        ret_dict[p_key] = getattr(_transformations, class_name).from_dict(p_val)\n225\t    return ret_dict\n226\t\n227\t\n228\tHEAD_PREFIX = \"head_\"\n229\t\n230\t\n231\tdef discover_head_modules(model: torch.nn.Module) -> list[str]:\n232\t    \"\"\"Find the fine-tuning head modules to keep trainable under LoRA.\n233\t\n234\t    Convention: every trainable component of a fine-tuning head is a **direct\n235\t    child** of the top-level model whose attribute name starts with ``head_``\n236\t    (e.g. ``head_linear``, ``head_unembed``, ``head_cls_token``).  The backbone\n237\t    stays at ``backbone``.  Learners therefore never hand-maintain a list of\n238\t    head layers -- adding ``self.head_foo = nn.Linear(...)`` is enough.\n239\t\n240\t    Only modules that own parameters are returned, so parameter-free layers\n241\t    such as ``head_dropout`` are not needlessly duplicated by PEFT.\n242\t\n243\t    Raises:\n244\t        ValueError: if the model violates the convention, with a message\n245\t            naming the exact attribute to rename.\n246\t    \"\"\"\n247\t    head_names = []\n248\t    missing_prefix = []\n249\t    for name, module in model.named_children():\n250\t        has_params = any(True for _ in module.parameters())\n251\t        if name.startswith(HEAD_PREFIX):\n252\t            if has_params:\n253\t                head_names.append(name)\n254\t        elif name != \"backbone\" and has_params:\n255\t            missing_prefix.append(name)\n256\t\n257\t    if missing_prefix:\n258\t        raise ValueError(\n259\t            \"Fine-tuning head modules must be named with the \"\n260\t            f\"{HEAD_PREFIX!r} prefix so LoRA can keep them trainable.\\n\"\n261\t            f\"Rename these top-level attributes: \"\n262\t            + \", \".join(f\"self.{n} -> self.{HEAD_PREFIX}{n}\" for n in missing_prefix)\n263\t            + \"\\nWithout the prefix they are frozen during LoRA fine-tuning and \"\n264\t            \"the model trains against a random readout.\"\n265\t        )\n266\t\n267\t    # PEFT's modules_to_save cannot cover a bare nn.Parameter on the top-level\n268\t    # model -- it would stay frozen.  Wrap it in a tiny module instead.\n269\t    bare = [n for n, _ in model.named_parameters(recurse=False)]\n270\t    if bare:\n271\t        raise ValueError(\n272\t            \"Top-level bare parameters cannot be kept trainable by PEFT, which \"\n273\t            \"matches module names only, so these would be silently frozen: \"\n274\t            + \", \".join(bare)\n275\t            + \"\\nWrap each one in a small nn.Module (see ClassToken in \"\n276\t            \"workshop_infrastructure/models/finetune_models.py) and name the \"\n277\t            f\"attribute with the {HEAD_PREFIX!r} prefix.\"\n278\t        )\n279\t\n280\t    # PEFT matches modules_to_save entries with a bare ``key.endswith(name)``\n281\t    # -- no dot boundary -- so a head name that happens to be a suffix of any\n282\t    # backbone module name would wrap that backbone module too.\n283\t    backbone = getattr(model, \"backbone\", None)\n284\t    if backbone is not None:\n285\t        collisions = [\n286\t            (head, f\"backbone.{qualified}\")\n287\t            for head in head_names\n288\t            for qualified, _ in backbone.named_modules()\n289\t            if qualified and f\"backbone.{qualified}\".endswith(head)\n290\t        ]\n291\t        if collisions:\n292\t            raise ValueError(\n293\t                \"Head module names must not be a suffix of any backbone module \"\n294\t                \"name, because PEFT would make the backbone module trainable \"\n295\t                \"too:\\n\"\n296\t                + \"\\n\".join(f\"  {h} collides with {q}\" for h, q in collisions)\n297\t                + \"\\nRename the head attribute to something more specific.\"\n298\t            )\n299\t\n300\t    return head_names\n301\t\n302\t\n303\tdef apply_peft_lora(\n304\t    model: torch.nn.Module,\n305\t    lora_config: LoraAdapterConfig,\n306\t) -> torch.nn.Module:\n307\t    \"\"\"\n308\t    Applies PEFT LoRA adapters to a model.\n309\t\n310\t    Adapters go on the modules named by ``lora_config.target_modules``.  Every\n311\t    fine-tuning head module (see :func:`discover_head_modules`) is passed to\n312\t    PEFT as ``modules_to_save``, so it stays **trainable** -- without this the\n313\t    head is frozen at its random initialisation and LoRA fits adapters to a\n314\t    random readout.\n315\t\n316\t    Args:\n317\t        model: The model to apply LoRA to.\n318\t        lora_config: A LoraAdapterConfig instance (from workshop_infrastructure.configs).\n319\t\n320\t    Returns:\n321\t        Model with PEFT LoRA adapters applied.\n322\t    \"\"\"\n323\t    modules_to_save = discover_head_modules(model)\n324\t\n325\t    print(\n326\t        f\"Applying PEFT LoRA: r={lora_config.r}, alpha={lora_config.lora_alpha}, \"\n327\t        f\"dropout={lora_config.lora_dropout}, modules={lora_config.target_modules}\"\n328\t    )\n329\t\n330\t    from peft import LoraConfig, get_peft_model\n331\t    peft_config = LoraConfig(\n332\t        r=lora_config.r,\n333\t        lora_alpha=lora_config.lora_alpha,\n334\t        target_modules=lora_config.target_modules,\n335\t        lora_dropout=lora_config.lora_dropout,\n336\t        bias=lora_config.bias,\n337\t        modules_to_save=modules_to_save,\n338\t    )\n339\t\n340\t    model = get_peft_model(model, peft_config)\n341\t\n342\t    # Show exactly what is being trained, so a misconfigured run is visible\n343\t    # in the log instead of only in the loss curve.\n344\t    adapted = sorted(\n345\t        {\n346\t            name.split(\".lora_A\")[0].replace(\"base_model.model.\", \"\")\n347\t            for name, _ in model.named_parameters()\n348\t            if \".lora_A\" in name\n349\t        }\n350\t    )\n351\t    print(f\"[LoRA] Adapted modules ({len(adapted)}):\")\n352\t    for name in adapted:\n353\t        print(f\"[LoRA]   {name}\")\n354\t    print(f\"[LoRA] Trainable head modules (modules_to_save): {modules_to_save}\")\n355\t\n356\t    # Defensive: current PEFT excludes modules_to_save from adapter injection.\n357\t    # If that ever changes, a head module would get both, so fail loudly.\n358\t    head_adapted = [n for n in adapted if n.split(\".\")[0].startswith(HEAD_PREFIX)]\n359\t    if head_adapted:\n360\t        raise RuntimeError(\n361\t            \"PEFT applied LoRA adapters to fine-tuning head modules, which \"\n362\t            f\"should be fully trainable instead: {head_adapted}. \"\n363\t            \"Narrow lora_config.target_modules so it cannot match head layers.\"\n364\t        )\n365\t\n366\t    # Log the number of trainable parameters\n367\t    trainable_params = 0\n368\t    all_param = 0\n369\t    for _, param in model.named_parameters():\n370\t        all_param += param.numel()\n371\t        if param.requires_grad:\n372\t            trainable_params += param.numel()\n373\t\n374\t    print(\n375\t        f\"trainable params: {trainable_params:,} || \"\n376\t        f\"all params: {all_param:,} || \"\n377\t        f\"trainable%: {100 * trainable_params / all_param:.2f}%\"\n378\t    )\n379\t\n380\t    return model\n381\t\n382\t\n383\tdef load_pretrained_weights(model: torch.nn.Module, pretrained_path: Optional[str]) -> None:\n384\t    \"\"\"Load pretrained weights into a fine-tuning model, skipping shape-mismatched keys.\n385\t\n386\t    The pretrained checkpoint was saved from HelioSpectFormer directly, so its keys\n387\t    are flat (e.g. ``embedding.proj.weight``).  The composed fine-tuning models\n388\t    (HelioSpectformer1D, HelioSpectformer2D) nest the backbone under ``backbone.*``,\n389\t    so we try both the original key and the ``backbone.``-prefixed key when matching\n390\t    against the current model's state dict.\n391\t\n392\t    Args:\n393\t        model: The fine-tuning model to load weights into.\n394\t        pretrained_path: Path to the pretrained checkpoint (.pt file). No-op if None.\n395\t    \"\"\"\n396\t    if not pretrained_path:\n397\t        return\n398\t    print(f\"Loading pretrained weights from {pretrained_path}.\")\n399\t    model_state = model.state_dict()\n400\t    checkpoint_state = torch.load(pretrained_path, weights_only=True, map_location=\"cpu\")\n401\t\n402\t    remapped = {}\n403\t    for k, v in checkpoint_state.items():\n404\t        for candidate in (k, f\"backbone.{k}\"):\n405\t            if candidate in model_state and hasattr(v, \"shape\") and v.shape == model_state[candidate].shape:\n406\t                remapped[candidate] = v\n407\t                break\n408\t\n409\t    model_state.update(remapped)\n410\t    model.load_state_dict(model_state, strict=True)\n411\t    print(f\"Loaded {len(remapped)} / {len(checkpoint_state)} pretrained weights.\")\n412\t\n413\t\n414\tclass UploadBestCheckpointToS3(L.Callback):\n415\t    \"\"\"Lightning callback that uploads the best checkpoint to S3 after each validation epoch.\n416\t\n417\t    - No-op unless ``bucket`` is set (mirrors the ``output.s3_bucket: null`` YAML default).\n418\t    - Only runs from global rank 0 under DDP to avoid duplicate uploads.\n419\t    - Uses a stable S3 key (``fixed_key_name``) so the latest best is always at a\n420\t      predictable location regardless of epoch number.\n421\t\n422\t    Args:\n423\t        checkpoint_cb: The ModelCheckpoint callback whose ``best_model_path`` to watch.\n424\t        bucket: S3 bucket name. Pass ``None`` to disable uploads entirely.\n425\t        prefix: Key prefix (folder) within the bucket, e.g. ``\"flare/exp_001\"``.\n426\t        fixed_key_name: Object name within the prefix. Defaults to ``\"best.ckpt\"``.\n427\t    \"\"\"\n428\t\n429\t    def __init__(\n430\t        self,\n431\t        checkpoint_cb: ModelCheckpoint,\n432\t        bucket: Optional[str],\n433\t        prefix: str = \"\",\n434\t        fixed_key_name: Optional[str] = \"best.ckpt\",\n435\t    ):\n436\t        super().__init__()\n437\t        self.checkpoint_cb = checkpoint_cb\n438\t        self.bucket = bucket\n439\t        self.prefix = prefix.strip(\"/\")\n440\t        self.fixed_key_name = fixed_key_name\n441\t        self.last_uploaded_best = None\n442\t        self._s3 = None\n443\t\n444\t    def _upload_if_new_best(self, trainer) -> None:\n445\t        if not self.bucket:\n446\t            return\n447\t        if hasattr(trainer, \"is_global_zero\") and not trainer.is_global_zero:\n448\t            return\n449\t\n450\t        best_path = getattr(self.checkpoint_cb, \"best_model_path\", None)\n451\t        if not best_path or best_path == self.last_uploaded_best:\n452\t            return\n453\t\n454\t        ckpt_path = Path(best_path)\n455\t        if not ckpt_path.exists():\n456\t            return\n457\t\n458\t        if self._s3 is None:\n459\t            try:\n460\t                import boto3\n461\t            except ImportError as e:\n462\t                raise RuntimeError(\n463\t                    \"boto3 is required for S3 uploads. Install with: pip install boto3\"\n464\t                ) from e\n465\t            self._s3 = boto3.client(\"s3\")\n466\t\n467\t        object_name = self.fixed_key_name or ckpt_path.name\n468\t        s3_key = f\"{self.prefix}/{object_name}\" if self.prefix else object_name\n469\t\n470\t        print(f\"[S3] Uploading {ckpt_path} -> s3://{self.bucket}/{s3_key}\")\n471\t        self._s3.upload_file(str(ckpt_path), self.bucket, s3_key)\n472\t        print(\"[S3] Upload complete.\")\n473\t        self.last_uploaded_best = str(ckpt_path)\n474\t\n475\t    def on_validation_end(self, trainer, pl_module) -> None:\n476\t        self._upload_if_new_best(trainer)\n477\t\n478\t    def on_fit_end(self, trainer, pl_module) -> None:\n479\t        # Final check in case the last best update happens near fit end.\n480\t        self._upload_if_new_best(trainer)",
            "locations": [
