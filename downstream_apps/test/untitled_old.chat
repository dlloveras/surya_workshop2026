t((1 - labels).sum())} no wave), \" f\"events {dates[0]}..{dates[-1]}\")''' assert s.count(old) == 1 s = s.replace(old, new) # extract_split reads df_valid_indices for events/labels; that works for repro unchanged. old = ''' summary = { name: { \"n_samples\": int(info.n_samples),''' new = ''' summary = { name: { \"n_samples\": int(info.n_samples),''' s = s.replace( ''' summary = { name: { \"n_samples\": int(info.n_samples), \"n_events\": int(info.n_events), \"n_positive\": int(info.n_positive), \"n_negative\": int(info.n_negative), \"n_dropped_unpaired\": int(info.n_dropped_unpaired), \"n_events_available\": int(info.n_events_available), } for name, (_, info) in subsets.items() }''', ''' summary = { name: { \"n_samples\": int(info.n_samples), \"n_events\": int(info.n_events), \"n_positive\": int(info.n_positive), \"n_negative\": int(info.n_negative), \"n_dropped_unpaired\": int(info.n_dropped_unpaired), \"n_events_available\": int(info.n_events_available), } for name, (_, info) in subsets.items() if info is not None }''') s = s.replace( ' p.add_argument(\"--splits\", default=\"train,val,test\")\\n', ' p.add_argument(\"--splits\", default=\"train,val,test\",\\n' ' help=\"Comma-separated. Add \\'repro\\' for the pseudo-split that \"\\n' ' \"reproduces what data.max_samples selects.\")\\n' ' p.add_argument(\"--repro-samples\", type=int, default=10,\\n' ' help=\"Size of the \\'repro\\' pseudo-split, matching the max_samples \"\\n' ' \"value being reproduced.\")\\n') p.write_text(s) print(\"repro pseudo-split added\") PY python -m py_compile experiments/extract_baseline_features.py && echo \"compiles ok\""
