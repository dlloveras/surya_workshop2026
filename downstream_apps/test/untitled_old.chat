          {
            "raw_input": {
              "command": "python - <<'PY'\nfrom pathlib import Path\n\n# Clamp the cache budget to what the filesystem can actually give, minus a reserve for\n# checkpoints. Six full-model checkpoints at ~1.45 GB each is ~9 GB.\np = Path(\"experiments/wave_common.py\")\ns = p.read_text()\nold = '''    import copy\n\n    val_uris = [u for u in dataset_frame_uris(val_dataset) if u.startswith(\"s3://\")]\n    budget_frames = int(budget_gb / FRAME_GB)'''\nnew = '''    import copy\n    import shutil\n\n    # Clamp to what the cache filesystem can actually give. Lightning checkpoints hold the\n    # frozen backbone as well as the adapters (~1.45 GB each), and a schedule of six runs\n    # therefore needs ~9 GB that must not be eaten by cached frames.\n    cache_root = getattr(val_dataset, \"local_cache_dir\", None)\n    if cache_root and os.path.isdir(cache_root):\n        free_gb = shutil.disk_usage(cache_root).free / 2**30\n        already_gb = sum(\n            e.stat().st_size for e in os.scandir(cache_root) if e.is_file()) / 2**30\n        allowed = already_gb + max(free_gb - RESERVE_GB, 0.0)\n        if budget_gb > allowed:\n            print(f\"[cache] budget {budget_gb:.0f} GB exceeds what {cache_root} can give \"\n                  f\"({free_gb:.0f} GB free, {already_gb:.0f} GB already cached, \"\n                  f\"{RESERVE_GB:.0f} GB reserved for checkpoints); using {allowed:.0f} GB\")\n            budget_gb = allowed\n\n    val_uris = [u for u in dataset_frame_uris(val_dataset) if u.startswith(\"s3://\")]\n    budget_frames = int(budget_gb / FRAME_GB)'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''FRAME_GB = 0.59\n'''\nnew = '''FRAME_GB = 0.59\n\n# Space to keep free on the cache filesystem. A Lightning checkpoint of this model is ~1.45 GB\n# (the state dict carries the frozen backbone, not only the adapters), and a full schedule\n# writes one per run.\nRESERVE_GB = 15.0\n'''\nassert s.count(old) == 1\ns = s.replace(old, new)\np.write_text(s)\nprint(\"  ok  budget clamp\")\n\n# Lower the default budget: measured, run A is GPU-bound whether or not its train frames are\n# cached, so the value is almost all in val.\np = Path(\"4_finetune_wave_1D.py\")\ns = p.read_text()\nold = '''    p.add_argument(\"--cache-budget-gb\", type=float, default=60.0,\n                   help=\"Bytes of fast local storage to spend on pinned frames. Must \"\n                        \"stay under the free space on data.s3_cache_dir's filesystem.\")'''\nnew = '''    p.add_argument(\"--cache-budget-gb\", type=float, default=34.0,\n                   help=\"Fast local storage to spend on pinned frames, in GB. Clamped to the \"\n                        \"filesystem's free space less a checkpoint reserve. 34 GB covers the \"\n                        \"48-frame validation split (~28 GB) plus a few training frames, which \"\n                        \"is where nearly all the value is: at 380 MB/s the smallest training \"\n                        \"run is GPU-bound whether or not its frames are cached, whereas \"\n                        \"validation is re-read on every epoch of every run.\")'''\nassert s.count(old) == 1\ns = s.replace(old, new)\np.write_text(s)\nprint(\"  ok  default budget 34 GB\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile experiments/wave_common.py 4_finetune_wave_1D.py && echo \"compiles ok\"; tail -1 /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/phase1_extract.log; grep -cE \"\\[S3\\] retry\" /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/phase1_extract.log",
              "description": "Clamp cache budget to free space"
            },
            "raw_output": "  ok  budget clamp\n  ok  default budget 34 GB\ncompiles ok\n[train] 26/384 samples  0.08 samples/s  eta 74.8 min\n0",
            "kind": "execute",
            "title": "python - <<'PY' from pathlib import Path # Clamp the cache budget to what the filesystem can actually give, minus a reserve for # checkpoints. Six full-model checkpoints at ~1.45 GB each is ~9 GB. p = Path(\"experiments/wave_common.py\") s = p.read_text() old = ''' import copy val_uris = [u for u in dataset_frame_uris(val_dataset) if u.startswith(\"s3://\")] budget_frames = int(budget_gb / FRAME_GB)''' new = ''' import copy import shutil # Clamp to what the cache filesystem can actually give. Lightning checkpoints hold the # frozen backbone as well as the adapters (~1.45 GB each), and a schedule of six runs # therefore needs ~9 GB that must not be eaten by cached frames. cache_root = getattr(val_dataset, \"local_cache_dir\", None) if cache_root and os.path.isdir(cache_root): free_gb = shutil.disk_usage(cache_root).free / 2**30 already_gb = sum( e.stat().st_size for e in os.scandir(cache_root) if e.is_file()) / 2**30 allowed = already_gb + max(free_gb - RESERVE_GB, 0.0) if budget_gb > allowed: print(f\"[cache] budget {budget_gb:.0f} GB exceeds what {cache_root} can give \" f\"({free_gb:.0f} GB free, {already_gb:.0f} GB already cached, \" f\"{RESERVE_GB:.0f} GB reserved for checkpoints); using {allowed:.0f} GB\") budget_gb = allowed val_uris = [u for u in dataset_frame_uris(val_dataset) if u.startswith(\"s3://\")] budget_frames = int(budget_gb / FRAME_GB)''' assert s.count(old) == 1 s = s.replace(old, new) old = '''FRAME_GB = 0.59 ''' new = '''FRAME_GB = 0.59 # Space to keep free on the cache filesystem. A Lightning checkpoint of this model is ~1.45 GB # (the state dict carries the frozen backbone, not only the adapters), and a full schedule # writes one per run. RESERVE_GB = 15.0 ''' assert s.count(old) == 1 s = s.replace(old, new) p.write_text(s) print(\" ok budget clamp\") # Lower the default budget: measured, run A is GPU-bound whether or not its train frames are # cached, so the value is almost all in val. p = Path(\"4_finetune_wave_1D.py\") s = p.read_text() old = ''' p.add_argument(\"--cache-budget-gb\", type=float, default=60.0, help=\"Bytes of fast local storage to spend on pinned frames. Must \" \"stay under the free space on data.s3_cache_dir's filesystem.\")''' new = ''' p.add_argument(\"--cache-budget-gb\", type=float, default=34.0, help=\"Fast local storage to spend on pinned frames, in GB. Clamped to the \" \"filesystem's free space less a checkpoint reserve. 34 GB covers the \" \"48-frame validation split (~28 GB) plus a few training frames, which \" \"is where nearly all the value is: at 380 MB/s the smallest training \" \"run is GPU-bound whether or not its frames are cached, whereas \" \"validation is re-read on every epoch of every run.\")''' assert s.count(old) == 1 s = s.replace(old, new) p.write_text(s) print(\" ok default budget 34 GB\") PY python -m py_compile experiments/wave_common.py 4_finetune_wave_1D.py && echo \"compiles ok\"; tail -1 phase1_extract.log; grep -cE \"\\[S3\\] retry\" phase1_extract.log",
