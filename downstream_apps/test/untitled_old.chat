            "raw_output": "41:from __future__ import annotations\n43:import argparse\n44:import json\n45:import os\n46:import sys\n48:# Must be set BEFORE torch is imported: cuBLAS reads this once, when it initializes, so\n52:from pathlib import Path\n53:from typing import Tuple\n55:import lightning as L\n56:import numpy as np\n57:import torch\n58:from lightning.pytorch.callbacks import ModelCheckpoint\n59:from lightning.pytorch.loggers import CSVLogger, WandbLogger\n60:from torch.utils.data import DataLoader\n62:from downstream_apps.test.configs import TrainingConfig, load_wave_config\n63:from downstream_apps.test.experiments import wave_common as wc\n64:from downstream_apps.test.lightning_modules.pl_simple_baseline import WaveLightningModule\n65:from downstream_apps.test.metrics.template_metrics import WaveMetrics\n66:from workshop_infrastructure.assets import ensure_assets\n67:from workshop_infrastructure.utils import (\n215:        import psutil\n335:    \"\"\"The four metric modes. ``val_loss`` is what ModelCheckpoint monitors.\"\"\"\n337:        \"train_loss\": WaveMetrics(\"train_loss\"),\n338:        \"val_loss\": WaveMetrics(\"val_loss\"),\n339:        \"train_metrics\": WaveMetrics(\"train_metrics\"),\n340:        \"val_metrics\": WaveMetrics(\"val_metrics\"),\n349:        from functools import partial\n351:        from downstream_apps.test.models.simple_baseline import (\n359:        preprocess_fn = partial(\n364:        return WaveLightningModule(model, metrics, lr=cfg.learning_rate,\n365:                                   batch_size=cfg.batch_size, preprocess_fn=preprocess_fn)\n367:    from workshop_infrastructure.models.finetune_models import HelioSpectformer1D\n394:    return WaveLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size)\n401:) -> Tuple[L.Trainer, ModelCheckpoint, ResourceGuard, CSVLogger]:\n404:    The CSVLogger is returned explicitly rather than being fished back out of the Trainer:\n411:        loggers.append(