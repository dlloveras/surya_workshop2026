              "command": "cd /home/jovyan/surya_workshop2026 && /home/jovyan/envs/surya_WS/bin/python - <<'PY'\nimport pandas as pd, numpy as np\ncat = pd.read_csv('downstream_apps/test/data/lcpf_aia_waves.csv', usecols=['start_time'])\nst = pd.to_datetime(cat['start_time'])\nonmin = st.dt.minute % 12\nprint(\"start_time minute mod 12 (0 = on the 12-min Surya grid):\")\nprint(onmin.value_counts().sort_index().to_string())\nprint(f\"\\nfraction on-grid: {(onmin==0).mean():.3f}\")\nidx = pd.read_csv('data/indices/surya_aws_s3_train.csv', usecols=['timestep','present'])\nts = pd.to_datetime(idx[idx['present']==1]['timestep'])\nprint(\"index timestep minute mod 12:\", sorted(set(ts.dt.minute % 12))[:5])\nPY",
