            "raw_input": {
              "command": "python3 - <<'EOF'\nimport numpy as np, pandas as pd\n\nWAVE='/home/jovyan/surya_workshop2026/downstream_apps/test/data/lcpf_aia_waves.csv'\nIDX={'train':'/home/jovyan/surya_workshop2026/data/indices/surya_aws_s3_train.csv',\n     'val':'/home/jovyan/surya_workshop2026/data/indices/surya_aws_s3_val.csv'}\n\ndef valid_indices(path):\n    # mimic HelioNetCDFDataset: present==1, to_datetime, set_index, sort_index,\n    # then _filter_valid_indices with time_deltas=[0] (load_forecast_frames=False)\n    idx = pd.read_csv(path)\n    idx = idx[idx['present']==1]\n    idx['timestep']=pd.to_datetime(idx['timestep']).values.astype('datetime64[ns]')\n    idx=idx.set_index('timestep').sort_index()\n    deltas=[np.timedelta64(0,'m')]\n    return [ts for ts in idx.index if all(ts+dt in idx.index for dt in deltas)]\n\nds = pd.read_csv(WAVE, low_memory=False)\nds['ds_index']=pd.to_datetime(ds['mid_time']).values.astype('datetime64[ns]')\nds=ds.sort_values('ds_index')\nds['label']=ds['class']\nds=ds[['ds_index','label','start_time','mid_time','GOES','Location']]\n\nfor split,p in IDX.items():\n    vi = valid_indices(p)\n    print(f'### {split}: valid_indices (Surya) = {len(vi)}  range {vi[0]} .. {vi[-1]}')\n    dfv = pd.DataFrame({'valid_indices':vi}).sort_values('valid_indices')\n    m = pd.merge_asof(dfv, ds, right_on='ds_index', left_on='valid_indices', direction='forward')\n    m['index_delta']=np.abs(m['valid_indices']-m['ds_index'])\n    m = m.sort_values(['ds_index','index_delta'])\n    m = m.drop_duplicates(subset='ds_index', keep='first')\n    print(f'  after merge_asof(forward)+dedupe on ds_index: {len(m)} rows '\n          f'(non-null ds_index: {m[\"ds_index\"].notna().sum()})')\n    for tol in ['15min','1h','12h','4d','30d','365d']:\n        f = m.loc[m['index_delta']<=pd.Timedelta(tol)]\n        vc = f['label'].value_counts().to_dict()\n        print(f\"  tol={tol:>6}: n={len(f):5d}  class_counts={vc}  \"\n              f\"delta_median={f['index_delta'].median()} delta_max={f['index_delta'].max()}\")\n    f4=m.loc[m['index_delta']<=pd.Timedelta('4d')]\n    print('  4d matched ds_index range:', f4['ds_index'].min(),'..',f4['ds_index'].max())\n    print('  4d index_delta distribution:')\n    print('   ', f4['index_delta'].describe().to_string().replace('\\n','\\n    '))\n    big=f4[f4['index_delta']>pd.Timedelta('1h')]\n    print(f'  4d rows with delta > 1h: {len(big)}  ({len(big)/max(len(f4),1):.1%}) ; >12h: {(f4[\"index_delta\"]>pd.Timedelta(\"12h\")).sum()}')\n    print()\nEOF\n",
