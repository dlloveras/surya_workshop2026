            "raw_output": "max_time normalization added\n'01:50:00'       -> '00:01:50:00'\n'00:04:40:00'    -> '00:04:40:00'\n'25:00'          -> '00:00:25:00'\n'00:25:00'       -> '00:00:25:00'\nNone             -> None\nbogus -> --max-time 'bogus' is not a duration. Use DD:HH:MM:SS, HH:MM:SS or MM:SS.",
            "status": "completed",
            "kind": "execute",
            "raw_input": {
              "description": "Add and test max_time normalization",
              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"4_finetune_wave_1D.py\")\ns = p.read_text()\n\nold = '''    p.add_argument(\"--max-time\", default=None,\n                   help='Hard wall-clock cap, \"HH:MM:SS\" or \"DD:HH:MM:SS\". Training stops '\n                        \"cleanly at the cap with the best checkpoint intact, so one \"\n                        \"overrunning run cannot starve the rest of a schedule.\")'''\nnew = '''    p.add_argument(\"--max-time\", default=None,\n                   help='Hard wall-clock cap. Accepts \"HH:MM:SS\" or \"MM:SS\" as well as the '\n                        '\"DD:HH:MM:SS\" Lightning itself requires. Training stops cleanly at '\n                        \"the cap with the best checkpoint intact, so one overrunning run \"\n                        \"cannot starve the rest of a schedule.\")'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = '''class ResourceGuard(L.Callback):'''\nnew = '''def normalize_max_time(value: str | None) -> str | None:\n    \"\"\"Pad a duration to the ``DD:HH:MM:SS`` that ``Trainer(max_time=...)`` demands.\n\n    Lightning rejects ``\"01:50:00\"`` outright \u2014 it wants four fields, so an hours-minutes-\n    seconds duration has to carry an explicit day count. That is a surprising failure to hit\n    after a model has loaded, and a schedule of runs written in the obvious ``HH:MM:SS`` would\n    fail one run at a time, so the shorter forms are accepted and padded here instead.\n\n    >>> normalize_max_time(\"01:50:00\")\n    '00:01:50:00'\n    >>> normalize_max_time(\"00:04:40:00\")\n    '00:04:40:00'\n    \"\"\"\n    if value is None:\n        return None\n    parts = str(value).strip().split(\":\")\n    if not 2 <= len(parts) <= 4 or not all(p.isdigit() for p in parts):\n        raise ValueError(\n            f\"--max-time {value!r} is not a duration. Use DD:HH:MM:SS, HH:MM:SS or MM:SS.\"\n        )\n    parts = [\"0\"] * (4 - len(parts)) + parts\n    return \":\".join(f\"{int(p):02d}\" for p in parts)\n\n\nclass ResourceGuard(L.Callback):'''\nassert s.count(old) == 1\ns = s.replace(old, new)\n\nold = \"        max_time=args.max_time,\"\nnew = \"        max_time=normalize_max_time(args.max_time),\"\nassert s.count(old) == 1\ns = s.replace(old, new)\np.write_text(s)\nprint(\"max_time normalization added\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -c \"\nimport sys; sys.path.insert(0,'/home/jovyan/surya_workshop2026')\nimport importlib.util as u\nspec = u.spec_from_file_location('ft','/home/jovyan/surya_workshop2026/downstream_apps/test/4_finetune_wave_1D.py')\nm = u.module_from_spec(spec); spec.loader.exec_module(m)\nfor v in ['01:50:00','00:04:40:00','25:00','00:25:00',None]:\n    print(f'{v!r:16} -> {m.normalize_max_time(v)!r}')\ntry: m.normalize_max_time('bogus')\nexcept ValueError as e: print('bogus ->', e)\n\" 2>&1 | grep -v Warning"
            },
