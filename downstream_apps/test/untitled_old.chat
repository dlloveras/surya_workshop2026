              "command": "python - <<'PY'\nfrom pathlib import Path\np = Path(\"4_finetune_wave_1D.py\")\ns = p.read_text()\nold = '''Usage \u2014 the LR probe, then a scaling run:\n    python -m downstream_apps.test.4_finetune_wave_1D --lr 1e-4 --max-steps 60 \\\\\n        --accum 1 --train-n 96 --run-name probe_lr1e-4\n\n    python -m downstream_apps.test.4_finetune_wave_1D --train-n 384 --max-epochs 14 \\\\\n        --max-time 05:30:00 --run-name surya_D_n384\n\"\"\"'''\nnew = '''Usage \u2014 an LR probe run, then a scaling run. ``experiments/run_surya_schedule.sh`` drives\nthe whole sequence; these are what it invokes.\n\n    python -m downstream_apps.test.4_finetune_wave_1D --run-name probe_lr1e-4 \\\\\n        --lr 1e-4 --max-steps 60 --accum 1 --train-n 48 \\\\\n        --max-time 00:25:00 --no-eval-test --no-checkpoint\n\n    python -m downstream_apps.test.4_finetune_wave_1D --run-name surya_D_n384 \\\\\n        --train-n 384 --max-epochs 12 --max-time 04:40:00 --accum 4 --lr 1e-4\n\"\"\"'''\nassert s.count(old) == 1\np.write_text(s.replace(old, new))\nprint(\"usage examples aligned with the schedule\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile 4_finetune_wave_1D.py && echo ok; date; tail -1 /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/phase1_extract.log",
