  def _get_client(self):\n189:    def _reset_client(self) -> None:\n202:    def _transfer_config(self):\n216:    def _local_cache_path(self, s3_uri: str) -> str:\n217:        \"\"\"Local path for a cached frame, using the parent's naming so it is recognizable.\"\"\"\n218:        return os.path.join(self.local_cache_dir, os.path.basename(self._s3_cache_path(s3_uri)))\n220:    def _cache_dir_bytes(self) -> int:\n222:            with os.scandir(self.local_cache_dir) as it:\n227:    def _fetch_to_memory(self, s3_uri: str) -> io.BytesIO:\n250:            def _download() -> None:\n280:    def _maybe_write_cache(self, s3_uri: str, buf: io.BytesIO) -> None:\n282:        if not self.local_cache_dir or s3_uri not in self.cache_paths:\n284:        path = self._local_cache_path(s3_uri)\n288:        if self._cache_dir_bytes() + size > self.local_cache_budget_bytes:\n300:    def load_nc_data(self, filepath: str, timestep, channels: list[str]) -> np.ndarray:\n311:        cached = self._local_cache_path(filepath) if self.local_cache_dir else None\n312:        if cached and os.path.exists(cached):",
