eplace(old, new) p.write_text(s) print(\"plot_task_1_1 cleaned\") PY python -m py_compile experiments/plot_task_1_1.py && echo ok; grep -vE \"Warning|warn|^\\[LoRA\\] \" smoke_n8.log | tail -4",
