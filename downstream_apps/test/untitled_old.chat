8305799168\",\n      \"cudaCores\":  18176,\n      \"architecture\":  \"Ada\",\n      \"uuid\":  \"GPU-6329be93-2349-33af-1c4e-8a0b6749582d\"\n    }\n  ],\n  \"cudaVersion\":  \"13.0\",\n  \"writerId\":  \"c31bdeiubocwog90v0hcvhzrc9wpmrvx\"\n}",
