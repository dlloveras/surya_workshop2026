            "title": "Read models/simple_baseline.py",
            "raw_output": "1\t\"\"\"\n2\tA simple linear regression model to be used as a baseline for flare forecasting.\n3\t\"\"\"\n4\t\n5\timport torch\n6\timport torch.nn as nn\n7\tfrom einops import rearrange\n8\timport torch.nn.functional as F\n9\t\n10\t\n11\tdef destandardize_channels(batch: dict, channel_order: list, scalers: dict) -> dict:\n12\t    \"\"\"Return a new batch dict with 'ts' moved from normalized space to signum-log space.\n13\t\n14\t    This undoes the per-channel z-score ONLY. The signum-log compression applied by the\n15\t    dataset is deliberately left in place, so the result is\n16\t    ``sign(x*s) * log1p(|x*s|)`` \u2014 not raw DN/Gauss. Values spanning many orders of\n17\t    magnitude make poor features for a single linear layer, so log space is what the\n18\t    baseline wants.\n19\t\n20\t    If you need true physical units (plotting, a physical-space loss), use\n21\t    ``HelioNetCDFDataset.inverse_transform_data()`` instead, which undoes both stages.\n22\t    See the \"THE THREE SPACES\" block in ``workshop_infrastructure/datasets/helio.py``.\n23\t\n24\t    Args:\n25\t        batch: Batch dict containing at minimum a 'ts' key with shape (B, C, T, H, W).\n26\t        channel_order: Channel names in the same order as the C dimension of 'ts'.\n27\t        scalers: Dict mapping channel name -> scaler with an inverse_transform method.\n28\t\n29\t    Returns:\n30\t        A new batch dict with 'ts' replaced by the de-standardized (signum-log) tensor.\n31\t    \"\"\"\n32\t    x = batch[\"ts\"].clone()\n33\t    with torch.no_grad():\n34\t        for i, channel in enumerate(channel_order):\n35\t            x[:, i, ...] = scalers[channel].inverse_transform(x[:, i, ...])\n36\t    return {**batch, \"ts\": x}\n37\t\n38\t\n39\tclass RegressionFlareModel(nn.Module):\n40\t    def __init__(self, input_dim: int):\n41\t        \"\"\"\n42\t        Initializes the RegressionFlareModel.\n43\t\n44\t        Args:\n45\t            input_dim (int): The size of the input vector after channel and time dimensions are flattened.\n46\t\n47\t        Note:\n48\t            This model expects 'ts' in the batch dict to already be in **signum-log** space\n49\t            (channel z-scores undone, log compression retained). Use\n50\t            destandardize_channels() to pre-process normalized SDO inputs before passing\n51\t            them here (e.g., via the preprocess_fn argument of FlareLightningModule).\n52\t        \"\"\"\n53\t        super().__init__()\n54\t        self.linear = nn.Linear(input_dim, 1)\n55\t\n56\t    def forward(self, x: dict) -> torch.Tensor:\n57\t        \"\"\"\n58\t        Performs a forward pass through the model.\n59\t\n60\t        Args:\n61\t            x (dict): Batch dict with 'ts' of shape (B, C, T, H, W) in signum-log space.\n62\t\n63\t        B - Batch size\n64\t        C - Channels\n65\t        T - Time steps\n66\t        H - Height\n67\t        W - Width\n68\t        \"\"\"\n69\t        x = x[\"ts\"]\n70\t\n71\t        # Collapse input stack spatially and take absolute value for strictly positive flare fluxes\n72\t        x = x.abs().mean(dim=[3, 4])\n73\t\n74\t        # Rearrange in preparation for linear layer\n75\t        x = rearrange(x, \"b c t -> b (c t)\")\n76\t\n77\t        return self.linear(x)\n78\t\n79\t\n80\tclass ConstantProbabilityModel(nn.Module):\n81\t    \"\"\"Trainable baseline: a single learned logit, independent of the input.\n82\t\n83\t    Learns the class base rate (the wave / no-wave prior) and nothing else \u2014 the\n84\t    simplest possible baseline against which any input-dependent model should be judged.\n85\t    \"\"\"\n86\t\n87\t    def __init__(self):\n88\t        super().__init__()\n89\t        self.logit = nn.Parameter(torch.zeros(1))\n90\t\n91\t    def forward(self, batch: dict) -> torch.Tensor:\n92\t        \"\"\"\n93\t        Args:\n94\t            batch (dict): Batch dict; only used to read the batch size from\n95\t                ``batch[\"forecast\"]`` (the target), since the model itself ignores\n96\t                the input entirely.\n97\t        \"\"\"\n98\t        batch_size = batch[\"forecast\"].shape[0]\n99\t        return self.logit.expand(batch_size, 1)\n100\t\n101\tdef mean_abs_pooled_running_difference(\n102\t    ts_signum_log: torch.Tensor,\n103\t    channel_index: int,\n104\t    pool_kernel: int,\n105\t    ) -> torch.Tensor:\n106\t    \"\"\"Collapse a running-difference image into one scalar per sample.\n107\t\n108\t    ``mean(|pool_K(now - prev)|)``: mean-pool the running difference by ``pool_kernel``,\n109\t    take the absolute value, then average over the whole frame. Pooling first is the\n110\t    point \u2014 a wave front is a coherent, low-amplitude brightening spread over many\n111\t    pixels, so a 32x32 block mean adds it up while averaging pixel noise down.\n112\t\n113\t    **The order is not interchangeable.** Mean pooling composes (pooling a kernel-8 map\n114\t    by a further 4 equals pooling the original by 32), which is what lets\n115\t    ``extract_baseline_features.py`` cache one resolution and serve a whole kernel sweep.\n116\t    ``abs()`` does not: ``mean(|pool8(d)|) != mean(|pool32(d)|)``, because the absolute\n117\t    value stops opposite-signed blocks from cancelling. Any code deriving this scalar\n118\t    from a cached map must therefore re-pool to ``pool_kernel`` *first*, then ``abs``,\n119\t    then the spatial mean.\n120\t\n121\t    Args:\n122\t        ts_signum_log: ``(B, C, T, H, W)`` in **signum-log** space (channel z-score\n123\t            undone, log compression retained) \u2014 see ``destandardize_channels()``.\n124\t        channel_index: Index of the channel to difference within the C dimension.\n125\t        pool_kernel: Mean-pool kernel size (and stride).\n126\t\n127\t    Returns:\n128\t        ``(B, 1)`` \u2014 one scalar per sample, shaped ready for ``nn.Linear(1, 1)``.\n129\t    \"\"\"\n130\t    x = ts_signum_log[:, channel_index]                                   # (B, T, H, W)\n131\t    diff = x[:, -1] - x[:, 0]                                             # (B, H, W)\n132\t    pooled = F.avg_pool2d(diff.unsqueeze(1), kernel_size=pool_kernel)     # (B, 1, S, S)\n133\t    return pooled.abs().mean(dim=(-2, -1))                                # (B, 1)\n134\t\n135\tclass RunningDifferenceLogisticModel(nn.Module):\n136\t    \"\"\"Trainable baseline: logistic regression on ONE scalar per sample.\n137\t\n138\t    The scalar is ``mean(|32x32 mean pool of AIA193(now) - AIA193(prev)|)`` in signum-log\n139\t    space \u2014 see ``mean_abs_pooled_running_difference()``. A single ``nn.Linear(1, 1)``\n140\t    turns it into a logit; ``BCEWithLogitsLoss`` supplies the sigmoid.\n141\t\n142\t    Two parameters, which is the whole idea. The previous version fed the entire 128x128\n143\t    pooled map into ``nn.Linear(16384, 1)`` and memorized its 384 training samples\n144\t    (train loss -> 0.0065, validation AUROC frozen at 0.4). The pooled *image* is a good\n145\t    picture of a wave; it is a poor design matrix at this sample size.\n146\t\n147\t    Because the readout is monotone in a single feature, the model is a threshold detector:\n148\t    the learned weight sets the sign and the scale, the bias sets the threshold, and\n149\t    ranking metrics (AUROC) are a fixed property of the feature rather than something\n150\t    training can improve. Only the loss and the calibration are learned.\n151\t\n152\t    Note:\n153\t        Expects 'ts' with shape (B, C, T=2, H, W), where T is ordered [t_prev, t_now] \u2014\n154\t        ``HelioNetCDFDataset._get_index_data`` always places the offset-0 (\"now\") frame\n155\t        last, so ``x[:, -1] - x[:, 0]`` is the forward-in-time difference.\n156\t\n157\t        Expects 'ts' in **signum-log** space (channel z-scores undone, log compression\n158\t        retained), same convention as ``RegressionFlareModel``. Use\n159\t        ``destandardize_channels()`` to get there from what the dataset returns (e.g. via\n160\t        the ``preprocess_fn`` argument of ``WaveLightningModule``).\n161\t\n162\t        The feature is small \u2014 a mean of absolute log-space differences, order 0.1 \u2014 while\n163\t        the logit needs a weight of order 10-100 to separate the classes. Adam moves a\n164\t        parameter by roughly ``lr`` per step, so the ``learning_rate: 0.01`` that suited a\n165\t        16384-dimensional input is too small here by a couple of orders of magnitude.\n166\t        This affects the loss and the threshold only; AUROC is unchanged either way.\n167\t    \"\"\"\n168\t\n169\t    def __init__(self, channel_index: int, pool_kernel: int = 32):\n170\t        \"\"\"\n171\t        Args:\n172\t            channel_index (int): Index of AIA193 within the C dimension of 'ts'. Note this\n173\t                differs per config \u2014 3 in the 13-channel configs, 0 when a caller narrows\n174\t                ``data.channels`` to ``[\"aia193\"]`` \u2014 so pass\n175\t                ``cfg.data.channels.index(\"aia193\")`` rather than a literal.\n176\t            pool_kernel (int): Mean-pool kernel size (and stride) applied before the\n177\t                absolute value. Defaults to 32, the scale at which the wave front is\n178\t                visible by eye in the task 1.1 figures.\n179\t        \"\"\"\n180\t        super().__init__()\n181\t        self.channel_index = channel_index\n182\t        self.pool_kernel = pool_kernel\n183\t        # 1 -> 1: two parameters, a slope and a threshold. img_size is irrelevant now,\n184\t        # because the readout width no longer depends on the image resolution.\n185\t        self.linear = nn.Linear(1, 1)\n186\t\n187\t    def forward(self, batch: dict) -> torch.Tensor:\n188\t        \"\"\"\n189\t        Args:\n190\t            batch (dict): Batch dict with 'ts' of shape (B, C, T=2, H, W) in signum-log space.\n191\t\n192\t        Returns:\n193\t            ``(B, 1)`` logits.\n194\t        \"\"\"\n195\t        feature = mean_abs_pooled_running_difference(\n196\t            batch[\"ts\"], self.channel_index, self.pool_kernel\n197\t        )\n198\t        return self.linear(feature)",
