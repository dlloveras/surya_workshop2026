ence/aia_0193_bdiff_0144_sum_20100408_0215/AIA_0193_BDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0211_0144_sum_20100408_0215/AIA_0211_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0211_rdiff_0144_sum_20100408_0215/AIA_0211_RDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0211_bdiff_0144_sum_20100408_0215/AIA_0211_BDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0304_0144_sum_20100408_0215/AIA_0304_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0304_rdiff_0144_sum_20100408_0215/AIA_0304_RDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0304_bdiff_0144_sum_20100408_0215/AIA_0304_BDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0335_0144_sum_20100408_0215/AIA_0335_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0335_rdiff_0144_sum_20100408_0215/AIA_0335_RDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_cadence/aia_0335_bdiff_0144_sum_20100408_0215/AIA_0335_BDIFF_0144_SUM_20100408_0215.html,https://aia.lmsal.com/aia_euvi/20100408_0215_aia0193_euvib195_euvi/AIA0193_EUVIB195_EUVI_20100408_0215.html,https://aia.lmsal.com/aia_euvi/20100408_0215_aia0193_euvib195_rdiff_euvi/AIA0193_EUVIB195_RDIFF_EUVI_20100408_0215.html,https://aia.lmsal.com/aia_euvi/20100408_0215_aia0193_euvib195_bdiff_euvi/AIA0193_EUVIB195_BDIFF_EUVI_20100408_0215.html,https://aia.lmsal.com/aia_euvi/20100408_0215_aia0193_euvia195_euvi/AIA0193_EUVIA195_EUVI_20100408_0215.html,https://aia.lmsal.com/aia_euvi/20100408_0215_aia0193_euvia195_rdiff_euvi/AIA0193_EUVIA195_RDIFF_EUVI_20100408_0215.html,https://aia.lmsal.com/aia_euvi/20100408_0215_aia0193_euvia195_bdiff_euvi/AIA0193_EUVIA195_BDIFF_EUVI_20100408_0215.html,2010-04-08T02:30:00,2010-04-08T03:00:00,wave\n2010/05/04,06:30,B1.3,S26E04,11066,https://aia.lmsal.com/aia_cadence/aia_0094_0144_sum_20100504_0620/AIA_0094_0144_SUM_20100504_0620.html,https://aia.lmsal.com/aia_cadence/a