'' train_ds, val_ds, test_ds = wc.build_wave_datasets(cfg, scalers, include_test=True) stats = {}''' new = ''' train_ds, val_ds, test_ds = wc.build_wave_datasets( cfg, scalers, include_test=True, in_memory=not args.disk_cache ) print(f\"[DATA] read path: \" f\"{'stock s3_mode=' + cfg.data.s3_mode if args.disk_cache else 'in-memory (BytesIO -> h5netcdf)'}\") stats = {}''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' if args.train_n is not None and stats[\"train\"][\"n_samples\"] != args.train_n:''' new = ''' # Pin only the validation frames: val is re-read every epoch, and 48 frames is ~28 GB # against 77 GB of local disk. The train split is far too large to cache, so leaving it # streaming is also what stops it evicting val. n_pinned = wc.pin_frames(val_ds, extra_datasets=(train_ds, test_ds)) if n_pinned: print(f\"[DATA] pinned {n_pinned} validation frames to {cfg.data.s3_cache_dir}\") if args.train_n is not None and stats[\"train\"][\"n_samples\"] != args.train_n:''' assert s.count(old) == 1 s = s.replace(old, new) s = s.replace( ' p.add_argument(\"--rss-ceiling-gb\", type=float, default=70.0,\\n', ' p.add_argument(\"--disk-cache\", action=\"store_true\",\\n' ' help=\"Use the stock s3_mode read path (every frame written to \"\\n' ' \"s3_cache_dir) instead of reading through RAM. The configured \"\\n' ' \"cache is on an EFS mount measured at 9 MB/s against 400 MB/s \"\\n' ' \"for the memory path, so this is for debugging only.\")\\n' ' p.add_argument(\"--rss-ceiling-gb\", type=float, default=70.0,\\n') p.write_text(s) print(\"trainer updated\") PY python -m py_compile 4_finetune_wave_1D.py experiments/extract_baseline_features.py && echo \"compiles ok\"",
