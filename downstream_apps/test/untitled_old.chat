          {
            "raw_input": {
              "command": "rm -rf /tmp/sumtest; python - <<'PY'\nfrom pathlib import Path\np = Path(\"experiments/summarize_results.py\")\ns = p.read_text()\nold = '''def load_summaries(results_dir: Path) -> list[dict]:\n    \"\"\"Every finished run's summary JSON, probes excluded.\"\"\"\n    out = []\n    for path in sorted(results_dir.glob(\"*_summary.json\")):\n        if path.name.startswith(\"probe_\"):\n            continue'''\nnew = '''# Runs that are not points on the scaling curve. Probes deliberately stop after 60 steps, and\n# the smoke test is one epoch on 8 samples; plotting either alongside the real runs would put a\n# point on the curve that was never trying to fit anything.\n_EXCLUDED_PREFIXES = (\"probe_\", \"smoke_\")\n\n\ndef load_summaries(results_dir: Path) -> list[dict]:\n    \"\"\"Every finished run's summary JSON, excluding probes and smoke tests.\"\"\"\n    out = []\n    for path in sorted(results_dir.glob(\"*_summary.json\")):\n        if path.name.startswith(_EXCLUDED_PREFIXES):\n            continue'''\nassert s.count(old) == 1\np.write_text(s.replace(old, new))\nprint(\"smoke/probe runs excluded from the curve\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile experiments/summarize_results.py && echo ok; date; tail -1 /home/jovyan/surya_workshop2026/downstream_apps/test/experiments/results/logs/phase1_extract.log",
