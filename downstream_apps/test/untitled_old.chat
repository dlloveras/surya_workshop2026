            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop2026 && timeout 600 /home/jovyan/envs/surya_WS/bin/python - <<'EOF' 2>&1 | tail -30\nimport boto3, time, pandas as pd, re, glob, threading\nfrom botocore import UNSIGNED\nfrom botocore.config import Config as BotoConfig\nfrom boto3.s3.transfer import TransferConfig\nfrom concurrent.futures import ThreadPoolExecutor\n\ncached = set()\nfor f in glob.glob(\"/home/jovyan/scratch_space/surya_cache/*.nc\"):\n    m = re.search(r\"__(\\d{8})_(\\d{4})\\.nc$\", f)\n    if m: cached.add(f\"{m.group(1)}_{m.group(2)}\")\n\nidx = pd.read_csv(\"data/indices/surya_aws_s3_train.csv\")\nidx = idx[idx[\"present\"]==1]\npaths = [p for p in idx[\"path\"] if re.search(r\"(\\d{8}_\\d{4})\\.nc$\", p).group(1) not in cached][:40]\nprint(f\"picked {len(paths)} uncached objects\")\n\ncli = boto3.client(\"s3\", config=BotoConfig(signature_version=UNSIGNED, max_pool_connections=64,\n                                           retries={\"max_attempts\":10,\"mode\":\"adaptive\"}))\ntc = TransferConfig(max_concurrency=4, multipart_chunksize=64*1024*1024)\n\nclass Null:\n    def __init__(self): self.n=0; self.l=threading.Lock()\n    def write(self,b):\n        with self.l: self.n+=len(b)\n        return len(b)\n\ndef fetch(uri):\n    b,k = uri[5:].split(\"/\",1)\n    s=Null(); cli.download_fileobj(b,k,s,Config=tc); return s.n\n\ndef bench(n, label):\n    sel = paths[:n]\n    t0=time.time()\n    with ThreadPoolExecutor(max_workers=n) as ex:\n        tot = sum(ex.map(fetch, sel))\n    dt=time.time()-t0\n    mbs = tot/1e6/dt\n    print(f\"  {label:22s}: {n} files, {tot/1e9:.2f} GB in {dt:.1f}s = {mbs:.0f} MB/s \"\n          f\"| {dt/n:.1f} s/file | 1.43 TB would take {1427/(mbs/1000)/3600:.1f} h\")\n    return mbs\n\nprint(\"\\n=== S3 -> memory throughput (nasa-surya-bench, anon) ===\")\nbench(1,  \"serial (1 file)\")\nbench(4,  \"4 parallel files\")\nbench(8,  \"8 parallel files\")\nbench(16, \"16 parallel files\")\nEOF"
            },
            "title": "cd surya_workshop2026 && timeout 600 python - <<'EOF' 2>&1 | tail -30 import boto3, time, pandas as pd, re, glob, threading from botocore import UNSIGNED from botocore.config import Config as BotoConfig from boto3.s3.transfer import TransferConfig from concurrent.futures import ThreadPoolExecutor cached = set() for f in glob.glob(\"/home/jovyan/scratch_space/surya_cache/*.nc\"): m = re.search(r\"__(\\d{8})_(\\d{4})\\.nc$\", f) if m: cached.add(f\"{m.group(1)}_{m.group(2)}\") idx = pd.read_csv(\"data/indices/surya_aws_s3_train.csv\") idx = idx[idx[\"present\"]==1] paths = [p for p in idx[\"path\"] if re.search(r\"(\\d{8}_\\d{4})\\.nc$\", p).group(1) not in cached][:40] print(f\"picked {len(paths)} uncached objects\") cli = boto3.client(\"s3\", config=BotoConfig(signature_version=UNSIGNED, max_pool_connections=64, retries={\"max_attempts\":10,\"mode\":\"adaptive\"})) tc = TransferConfig(max_concurrency=4, multipart_chunksize=64*1024*1024) class Null: def __init__(self): self.n=0; self.l=threading.Lock() def write(self,b): with self.l: self.n+=len(b) return len(b) def fetch(uri): b,k = uri[5:].split(\"/\",1) s=Null(); cli.download_fileobj(b,k,s,Config=tc); return s.n def bench(n, label): sel = paths[:n] t0=time.time() with ThreadPoolExecutor(max_workers=n) as ex: tot = sum(ex.map(fetch, sel)) dt=time.time()-t0 mbs = tot/1e6/dt print(f\" {label:22s}: {n} files, {tot/1e9:.2f} GB in {dt:.1f}s = {mbs:.0f} MB/s \" f\"| {dt/n:.1f} s/file | 1.43 TB would take {1427/(mbs/1000)/3600:.1f} h\") return mbs print(\"\\n=== S3 -> memory throughput (nasa-surya-bench, anon) ===\") bench(1, \"serial (1 file)\") bench(4, \"4 parallel files\") bench(8, \"8 parallel files\") bench(16, \"16 parallel files\") EOF",
            "raw_output": "picked 40 uncached objects\n\n=== S3 -> memory throughput (nasa-surya-bench, anon) ===\n  serial (1 file)       : 1 files, 0.59 GB in 4.9s = 119 MB/s | 4.9 s/file | 1.43 TB would take 3.3 h\n  4 parallel files      : 4 files, 2.34 GB in 4.7s = 494 MB/s | 1.2 s/file | 1.43 TB would take 0.8 h\n  8 parallel files      : 8 files, 4.69 GB in 7.7s = 608 MB/s | 1.0 s/file | 1.43 TB would take 0.7 h\n  16 parallel files     : 16 files, 9.38 GB in 15.6s = 601 MB/s | 1.0 s/file | 1.43 TB would take 0.7 h\nShell cwd was reset to /home/jovyan/surya_workshop2026/downstream_apps/test"
