fset_min\"].median() best_offset = float(x.loc[med.idxmax()]) at_30 = float(np.interp(30, x.to_numpy(dtype=float), med.to_numpy())) verdict = { \"offsets\": offsets, \"achieved_offsets_median\": {int(k): float(v) for k, v in x.items()},''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' \"n_events\": len(usable), \"events\": [str(e) for e in usable], \"median_pooled_snr_by_offset\": {int(k): float(v) for k, v in med.items()}, \"best_offset_min\": best_offset,''' new = ''' \"n_events\": int(df[\"event\"].nunique()), \"events\": sorted(df[\"event\"].unique().tolist()), \"median_pooled_snr_by_offset\": {int(k): float(v) for k, v in med.items()}, \"best_offset_min\": best_offset,''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' \"verdict\": ( f\"Signal peaks at +{best_offset} min (median pooled SNR \"''' new = ''' \"verdict\": ( f\"Signal peaks at +{best_offset:.0f} min (median pooled SNR \"''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' Path(args.out).write_text(json.dumps(verdict, indent=2)) print(f\"\\\\n[scan] {verdict['verdict']}\") print(f\"[out] {args.out}\") plot(df, med, best_offset, at_30)''' new = ''' (RESULTS_DIR / \"wave_visibility.json\").write_text(json.dumps(verdict, indent=2)) print(f\"\\\\n[scan] {verdict['verdict']}\") print(f\"[out] {RESULTS_DIR / 'wave_visibility.json'}\") plot(df, med, x, best_offset, at_30)''' assert s.count(old) == 1 s = s.replace(old, new) old = '''def plot(df: pd.DataFrame, med: pd.Series, best_offset: int, at_30: float) -> None:''' new = '''def plot(df: pd.DataFrame, med: pd.Series, x: pd.Series, best_offset: float, at_30: float) -> None:''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' m = df.groupby(\"offset_min\")[key].median() ax.plot(m.index, m.values, \"-o\", lw=2.5, color=\"C0\", label=\"median\")''' new = ''' m = df.groupby(\"offset_min\")[key].median() # Median plotted at the median ACHIEVED offset, so it lies on the same axis as the # per-event traces above rather than up to 6 min away from them. ax.plot(x.reindex(m.index).to_numpy(), m.to_numpy(), \"-o\", lw=2.5, color=\"C0\", label=\"median\")''' assert s.count(old) == 1 s = s.replace(old, new) old = ''' fig.suptitle(\"Running-difference contrast vs where the positive sample is taken \" f\"(peak +{best_offset} min, +30 min at {at_30:.2f})\")''' new = ''' fig.suptitle(\"Running-difference contrast vs where the positive sample is taken \" f\"(peak +{best_offset:.0f} min, +30 min at {at_30:.2f})\")''' assert s.count(old) == 1 s = s.replace(old, new) # A --replot mode, so the verdict and figure can be redrawn from the CSV without re-reading # ~7 GB of frames from S3. old = '''def main() -> None: args = parse_args() offsets = [int(o) for o in args.offsets.split(\",\")]''' new = '''def main() -> None: args = parse_args() offsets = [int(o) for o in args.offsets.split(\",\")] if args.replot: csv = RESULTS_DIR / \"wave_visibility.csv\" if not csv.is_file(): raise SystemExit(f\"--replot needs {csv}, which does not exist yet.\") print(f\"[scan] redrawing from {csv} \u2014 no frames read\") report(pd.read_csv(csv), offsets) return ''' assert s.count(old) == 1 s = s.replace(old, new) s = s.replace(' p.add_argument(\"--out\", default=str(RESULTS_DIR / \"wave_visibility.json\"))', ' p.add_argument(\"--replot\", action=\"store_true\",\\n' ' help=\"Recompute the verdict and redraw the figure from the \"\\n' ' \"existing wave_visibility.csv, reading no frames.\")') p.write_text(s) print(\"verdict and plot now share the achieved-offset axis; --replot added\") PY python -m py_compile experiments/wave_visibility_scan.py && echo \"compiles ok\"",
