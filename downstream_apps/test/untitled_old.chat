            "raw_input": {
              "description": "Stop extractor and make it restartable per split",
              "command": "ps -eo pid,args | grep '[e]xtract_baseline_features' | awk '{print $1}' | xargs -r kill; sleep 4; ps -eo pid,args | grep -c '[s]pawn_main'; ps -eo pid,args | grep '[s]pawn_main' | awk '{print $1}' | xargs -r kill 2>/dev/null; echo \"stopped\"; python - <<'PY'\nfrom pathlib import Path\np = Path(\"experiments/extract_baseline_features.py\")\ns = p.read_text()\n\nold = '''    out = {}\n    wanted = [s.strip() for s in args.splits.split(\",\") if s.strip()]\n    for name in wanted:\n        ds, info = subsets[name]\n        X, y, idx, events = extract_split(\n            name, ds, args, scalers, figure_events if name == \"train\" else set(), figures_dir\n        )\n        out[f\"X_{name}\"] = X\n        out[f\"y_{name}\"] = y\n        out[f\"index_{name}\"] = idx\n        out[f\"event_{name}\"] = events.astype(str)\n'''\nnew = '''    # Each split is written as soon as it finishes, and reused if it is already on disk.\n    # This pass is long enough (and shares bandwidth with enough else) that losing a\n    # completed split to a kill or a restart is a real cost, and the splits are independent.\n    out = {}\n    out_path = Path(args.out)\n    wanted = [s.strip() for s in args.splits.split(\",\") if s.strip()]\n    for name in wanted:\n        part_path = out_path.with_name(f\"{out_path.stem}_{name}.npz\")\n        if part_path.exists() and not args.force:\n            part = np.load(part_path, allow_pickle=False)\n            out.update({k: part[k] for k in part.files})\n            print(f\"[{name}] reusing {part_path.name} \"\n                  f\"({part[f'X_{name}'].shape[0]} samples) \u2014 pass --force to re-extract\")\n            continue\n        ds, info = subsets[name]\n        X, y, idx, events = extract_split(\n            name, ds, args, scalers, figure_events if name == \"train\" else set(), figures_dir\n        )\n        part = {\n            f\"X_{name}\": X,\n            f\"y_{name}\": y,\n            f\"index_{name}\": idx,\n            f\"event_{name}\": events.astype(str),\n        }\n        part_path.parent.mkdir(parents=True, exist_ok=True)\n        np.savez(part_path, **part)\n        print(f\"[{name}] wrote {part_path.name}\")\n        out.update(part)\n'''\nassert s.count(old) == 1\ns = s.replace(old, new)\ns = s.replace(\n    '    p.add_argument(\"--disk-cache\", action=\"store_true\",\\n',\n    '    p.add_argument(\"--force\", action=\"store_true\",\\n'\n    '                   help=\"Re-extract a split even if its per-split .npz already exists.\")\\n'\n    '    p.add_argument(\"--disk-cache\", action=\"store_true\",\\n')\np.write_text(s)\nprint(\"extractor now restartable per split\")\nPY\n/home/jovyan/envs/surya_WS/bin/python -m py_compile experiments/extract_baseline_features.py && echo \"compiles ok\""
