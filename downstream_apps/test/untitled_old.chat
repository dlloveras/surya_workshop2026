            "raw_output": "1\t\"\"\"\n2\tTemplate metrics for wave classification.\n3\t\n4\tWaveMetrics defines four metric sets:\n5\t- \"train_loss\"    \u2014 differentiable loss that drives backpropagation (BCE-with-logits).\n6\t- \"val_loss\"      \u2014 the quantity logged as `val_loss` and used to select checkpoints.\n7\t                    Defaults to the same BCE as \"train_loss\"; override it when your task\n8\t                    needs a different validation objective.\n9\t- \"train_metrics\" \u2014 non-differentiable metrics logged during training (accuracy).\n10\t- \"val_metrics\"   \u2014 metrics logged at validation for reporting only (accuracy + AUROC).\n11\t                    These do NOT influence checkpoint selection \u2014 \"val_loss\" does.\n12\t\n13\tThe __call__ method selects the appropriate metric set based on the mode passed at\n14\tconstruction time. The dictionary keys returned by each method become the metric names\n15\tpropagated to the logger (e.g. WandB, CSV).\n16\t\"\"\"\n17\t\n18\timport torch\n19\timport torchmetrics as tm  # Lots of possible metrics in here https://lightning.ai/docs/torchmetrics/stable/all-metrics.html\n20\t\n21\t# Shape contract: predictions arrive as (B,) from HelioSpectformer1D or (B, 1) from the\n22\t# linear baseline, while targets are always (B, 1). Every metric below flattens both with\n23\t# reshape(-1) rather than squeeze(-1): squeeze is shape-dependent and collapses a\n24\t# batch of one to a 0-d scalar, which then fails to broadcast against a (1,) target.\n25\t#\n26\t# All preds below are raw logits (no sigmoid applied). torchmetrics' Binary* metrics\n27\t# auto-apply sigmoid whenever inputs fall outside [0, 1], matching what\n28\t# binary_cross_entropy_with_logits sees, so no explicit .sigmoid() call is needed.\n29\tclass WaveMetrics:\n30\t    def __init__(self, mode: str):\n31\t        \"\"\"\n32\t        Initialize WaveMetrics class.\n33\t\n34\t        Args:\n35\t            mode (str): Mode to use for metric evaluation. One of \"train_loss\",\n36\t                        \"val_loss\", \"train_metrics\", or \"val_metrics\".\n37\t        \"\"\"\n38\t        self.mode = mode\n39\t\n40\t        # Cache torchmetrics instances once (instead of recreating each call)\n41\t        self._accuracy = tm.classification.BinaryAccuracy()\n42\t        self._auroc = tm.classification.BinaryAUROC()\n43\t\n44\t    def _ensure_device(self, preds: torch.Tensor) -> None:\n45\t        \"\"\"Move torchmetrics modules to the same device as ``preds``, if needed.\"\"\"\n46\t        if self._accuracy.device != preds.device:\n47\t            self._accuracy = self._accuracy.to(preds.device)\n48\t        if self._auroc.device != preds.device:\n49\t            self._auroc = self._auroc.to(preds.device)\n50\t\n51\t    def train_loss(\n52\t        self, preds: torch.Tensor, target: torch.Tensor\n53\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n54\t        \"\"\"\n55\t        Calculate loss metrics for training.\n56\t\n57\t        Args:\n58\t            preds (torch.Tensor): Model predictions.\n59\t            target (torch.Tensor): Ground truth labels.\n60\t\n61\t        Returns:\n62\t            tuple[dict[str, torch.Tensor], list[float]]:\n63\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n64\t                                        Keys are metric names (e.g., \"bce\"), and values are the\n65\t                                        corresponding torch.Tensor values.\n66\t                - list[float]: List of weights for each calculated metric.\n67\t        \"\"\"\n68\t\n69\t        output_metrics = {}\n70\t        output_weights = []\n71\t\n72\t        output_metrics[\"bce\"] = torch.nn.functional.binary_cross_entropy_with_logits(\n73\t            preds.reshape(-1), target.reshape(-1)\n74\t        )\n75\t        output_weights.append(1)\n76\t\n77\t        return output_metrics, output_weights\n78\t\n79\t    def val_loss(\n80\t        self, preds: torch.Tensor, target: torch.Tensor\n81\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n82\t        \"\"\"\n83\t        Calculate the validation loss \u2014 the quantity logged as ``val_loss`` and used by\n84\t        ModelCheckpoint to select the best model.\n85\t\n86\t        By default this delegates to ``train_loss``, so the monitored quantity has the same\n87\t        form as the training objective and the two cannot drift apart by accident. This is\n88\t        the hook to override when your task needs a different validation objective (a\n89\t        different weighting, a metric that is meaningful only on held-out data, etc.).\n90\t\n91\t        Note that this is deliberately separate from ``val_metrics``: those are reported\n92\t        for information only and do not affect checkpoint selection.\n93\t\n94\t        Args:\n95\t            preds (torch.Tensor): Model predictions.\n96\t            target (torch.Tensor): Ground truth labels.\n97\t\n98\t        Returns:\n99\t            tuple[dict[str, torch.Tensor], list[float]]:\n100\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n101\t                - list[float]: List of weights for each calculated metric.\n102\t        \"\"\"\n103\t        return self.train_loss(preds, target)\n104\t\n105\t    def train_metrics(\n106\t        self, preds: torch.Tensor, target: torch.Tensor\n107\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n108\t        \"\"\"\n109\t        Calculate evaluation metrics for training.\n110\t        IMPORTANT:  These metrics are only for reporting purposes and do not\n111\t                    contribute to the training loss. Use only if you want to\n112\t                    monitor additional metrics during training.\n113\t\n114\t        Args:\n115\t            preds (torch.Tensor): Model predictions.\n116\t            target (torch.Tensor): Ground truth labels.\n117\t\n118\t        Returns:\n119\t            tuple[dict[str, torch.Tensor], list[float]]:\n120\t                - dict[str, torch.Tensor]: Dictionary containing the calculated evaluation metrics.\n121\t                                        Keys are metric names, and values are the corresponding torch.Tensor values.\n122\t                - list[float]: List of weights for each calculated metric.\n123\t        \"\"\"\n124\t        output_metrics = {}\n125\t        output_weights = []\n126\t\n127\t        self._ensure_device(preds)\n128\t        output_metrics[\"accuracy\"] = self._accuracy(preds.reshape(-1), target.reshape(-1).long())\n129\t        output_weights.append(1)\n130\t\n131\t        return output_metrics, output_weights\n132\t\n133\t    def val_metrics(\n134\t        self, preds: torch.Tensor, target: torch.Tensor\n135\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n136\t        \"\"\"\n137\t        Calculate metrics for validation.\n138\t\n139\t        Args:\n140\t            preds (torch.Tensor): Model predictions.\n141\t            target (torch.Tensor): Ground truth labels.\n142\t\n143\t        Returns:\n144\t            tuple[dict[str, torch.Tensor], list[float]]:\n145\t                - dict[str, torch.Tensor]: Dictionary containing the calculated metrics.\n146\t                                        Keys are metric names (e.g., \"accuracy\"), and values are\n147\t                                        the corresponding torch.Tensor values.\n148\t                - list[float]: List of weights for each calculated metric.\n149\t        \"\"\"\n150\t\n151\t        output_metrics = {}\n152\t        output_weights = []\n153\t\n154\t        self._ensure_device(preds)\n155\t        output_metrics[\"accuracy\"] = self._accuracy(preds.reshape(-1), target.reshape(-1).long())\n156\t        output_weights.append(1)\n157\t\n158\t        output_metrics[\"auroc\"] = self._auroc(preds.reshape(-1), target.reshape(-1).long())\n159\t        output_weights.append(1)\n160\t\n161\t        return output_metrics, output_weights\n162\t\n163\t    def __call__(\n164\t        self, preds: torch.Tensor, target: torch.Tensor\n165\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n166\t        \"\"\"Evaluate metrics for the mode set at construction time.\n167\t\n168\t        Args:\n169\t            preds: Model output tensor. Shape depends on the application.\n170\t            target: Ground truth tensor to compare against.\n171\t\n172\t        Returns:\n173\t            tuple[dict[str, torch.Tensor], list[float]]:\n174\t                - Metric dictionary. Keys become logger metric names; values are\n175\t                  scalar tensors aggregated over the batch.\n176\t                - List of per-metric weights (used by WaveLightningModule to\n177\t                  combine multiple loss terms into a single scalar).\n178\t        \"\"\"\n179\t\n180\t        match self.mode.lower():\n181\t\n182\t            case \"train_loss\":\n183\t                return self.train_loss(preds, target)\n184\t\n185\t            # No torch.no_grad() here, matching \"train_loss\": Lightning already disables\n186\t            # gradients during validation, so wrapping it would differ gratuitously from\n187\t            # the loss case this mirrors.\n188\t            case \"val_loss\":\n189\t                return self.val_loss(preds, target)\n190\t\n191\t            case \"train_metrics\":\n192\t                with torch.no_grad():\n193\t                    return self.train_metrics(preds, target)\n194\t\n195\t            case \"val_metrics\":\n196\t                with torch.no_grad():\n197\t                    return self.val_metrics(preds, target)\n198\t\n199\t            case _:\n200\t                raise NotImplementedError(\n201\t                    f\"{self.mode} is not implemented as a valid metric case.\"\n202\t                )\n203\t",
            "locations": [
              "/home/jovyan/surya_workshop2026/downstream_apps/test/metrics/template_metrics.py"
